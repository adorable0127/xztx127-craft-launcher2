<Project DefaultTargets="Publish">
  <PropertyGroup>
    <XclSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</XclSourceRoot>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <PackageOutput Condition="'$(PackageOutput)' == ''">$(XclSourceRoot)artifacts\XCL2</PackageOutput>
    <XclDotNetExe Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</XclDotNetExe>
    <XclDotNetExe Condition="'$(XclDotNetExe)' == ''">dotnet</XclDotNetExe>
    <SkipNativePreview Condition="'$(SkipNativePreview)' == ''">false</SkipNativePreview>
    <XclPackageDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(XclSourceRoot)', '$(PackageOutput)'))))</XclPackageDirectory>
  </PropertyGroup>
  <Target Name="CheckWindows">
    <Error Condition="'$(OS)' != 'Windows_NT'" Text="WPF / WinUI 3 发布需要 Windows、.NET 8 SDK 和 Windows SDK。" />
  </Target>
  <Target Name="Test">
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\FeatureSearchRegression\FeatureSearchRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\AiActivityRegression\AiActivityRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\FeatureRegression\FeatureRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Condition="Exists('$(XclSourceRoot)Tests\AiFileDiffRegression\AiFileDiffRegression.csproj')" Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\AiFileDiffRegression\AiFileDiffRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Condition="Exists('$(XclSourceRoot)Tests\AiUsageRegression\AiUsageRegression.csproj')" Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\AiUsageRegression\AiUsageRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\AiCommandRegression\AiCommandRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\AiEndpointRegression\AiEndpointRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\AiReasoningRegression\AiReasoningRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\AiHttpRegression\AiHttpRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\DownloadQueueRegression\DownloadQueueRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\DownloadMirrorRegression\DownloadMirrorRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\PluginManagementRegression\PluginManagementRegression.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="&quot;$(XclDotNetExe)&quot; run --project &quot;$(XclSourceRoot)Tests\WebView2Regression\WebView2Regression.csproj&quot; -c &quot;$(Configuration)&quot;" />
  </Target>
  <Target Name="Build" DependsOnTargets="CheckWindows">
    <!-- CLI build/publish 在 Restore 后重新评估项目，且不继承外层项目的全局属性。 -->
    <Exec Command="&quot;$(XclDotNetExe)&quot; build &quot;$(XclSourceRoot)XCL2.App.csproj&quot; -c &quot;$(Configuration)&quot;" />
  </Target>
  <Target Name="Publish" DependsOnTargets="CheckWindows;Test">
    <Exec Command="&quot;$(XclDotNetExe)&quot; publish &quot;$(XclSourceRoot)XCL2.App.csproj&quot; -c &quot;$(Configuration)&quot; -r win-x64 --self-contained true -p:SkipNativePreview=$(SkipNativePreview) --output &quot;$(XclPackageDirectory)\.&quot;" />
    <Message Importance="high" Text="发布完成：$(XclPackageDirectory)\XCL2.exe（请分发完整目录，包括 WinUI.Preview）" />
  </Target>
</Project>
