  <system:String x:Key="Str_Ui_Double_Click_An_Account_To_Launch_Straig">انقر نقرًا مزدوجًا على حساب للتشغيل مباشرة؛ أو حدده واضغط “التشغيل بهذا الحساب” أدناه. إذا لم تجد الحساب المطلوب، يمكنك إضافته أدناه.</system:String>
  <system:String x:Key="Str_Ui_A_Beginner_S_Wizard_That_Takes_You_From_">معالج للمبتدئين من الحساب حتى التشغيل: اختر الإصدار/loader، وأضف Mod وحزم الموارد/shader اختياريًا، ثم يتم التنزيل والتشغيل تلقائيًا</system:String>
  <system:String x:Key="Str_Ui_A_Development_Stage_Idea_Install_The_Sam">ميزة في مرحلة التطوير/الفكرة فقط — تثبت كل loader محدد لنفس إصدار Minecraft بشكل منفصل في instance واحد.</system:String>
  <system:String x:Key="Str_Ui_Optional_If_A_Newer_Official_Build_Is_Ou">اختياري: إذا صدر إصدار رسمي جديد ولم يتم تحديث الإصدار المدمج بعد، يمكنك مؤقتًا اختيار ملف exe الذي نزّلته لاستبدال الإصدار المدمج</system:String>
  <system:String x:Key="Str_Ui_Guest_Mode_Only_Affects_Temporary_Accoun">وضع الضيف يؤثر فقط في الحسابات المؤقتة وتنظيف الجلسة؛ لا يغير ألوان الواجهة. الألوان تتبع دائمًا “سمة اللون” + اختيار “إعدادات الوضع” الحالي.</system:String>
  <system:String x:Key="Str_Ui_Contains_Features_Still_In_Development_O">يتضمن ميزات في مرحلة التطوير/الفكرة؛ قد تكون غير مستقرة ولا يوصى بها للمستخدمين العاديين. عند الدخول لأول مرة يجب قراءة تحذير لمدة 10 ثوانٍ.</system:String>
  <system:String x:Key="Str_Ui_Pick_One_From_The_Java_List_Above_As_The">اختر Java الافتراضية العامة من القائمة أعلاه؛ “(غير محدد، اكتشاف تلقائي)” يحافظ على منطق الاكتشاف/التنزيل التلقائي الحالي</system:String>
  <system:String x:Key="Str_Ui_Also_Install_Qsl_Quilt_Standard_Librarie">تثبيت QSL أيضًا (Quilt Standard Libraries؛ تعتمد عليها العديد من Quilt Mod، موصى به)</system:String>
  <system:String x:Key="Str_Ui_Right_Now_Your_Server_Is_Only_Reachable_">يمكن الوصول إلى خادمك حاليًا من الشبكة المحلية فقط. لتمكين أصدقاء ليسوا على نفس WiFi/الشبكة من الاتصال، استخدم إحدى الطرق أدناه.</system:String>
  <system:String x:Key="Str_Ui_Note_Custom_Skins_Need_Customskinloader_">ملاحظة: لعرض skin المخصص بشكل صحيح في الوضع غير المتصل، يلزم CustomSkinLoader؛ تتم معالجته تلقائيًا أثناء تنزيل/تشغيل اللعبة ولا يلزم تدخل يدوي.</system:String>
  <system:String x:Key="Str_Ui_Type_A_Command_And_Press_Enter_E_G_Say_H">اكتب الأمر واضغط Enter؛ مثل say hello / list / gamemode creative Steve</system:String>
  <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Instance_From_The_J">اختر Java منفصلة لهذا الإصدار من قائمة Java في “الإعدادات”؛ إذا اخترت “(غير محدد)” فستتم المطابقة تلقائيًا حسب رقم الإصدار الرئيسي أدناه</system:String>
  <system:String x:Key="Str_Ui_When_On_The_Game_Launches_With_A_Tempora">عند التمكين، تستخدم اللعبة حسابًا مؤقتًا موجودًا لهذا التشغيل فقط ولا تستخدم الحسابات المحفوظة؛ وعند الإغلاق تُنظف سجلات/ملفات التنزيل المؤقتة لهذه الجلسة</system:String>
  <system:String x:Key="Str_Ui_Switch_To_Dark_Mode_At_This_Hour_Each_Da">كل يوم عند الوصول إلى هذه الساعة (0~23)، يتحول تلقائيًا إلى الوضع الداكن ويبقى حتى ساعة “بدء الوضع الفاتح” (يتم التعامل مع عبور منتصف الليل بشكل صحيح).</system:String>
  <system:String x:Key="Str_Ui_Note_The_Officially_Released_Versions_Ar">ملاحظة: الإصدارات المستقرة الرسمية الرئيسية هي 8 / 11 / 17 / 21 / 25 / 26؛ قد لا توجد builds رسمية لأرقام أخرى.</system:String>
  <system:String x:Key="Str_Ui_E_G_Xx_Useg1gc_Dsomething_Quot_Value_Wit">مثال: -XX:+UseG1GC -Dsomething="value with spaces"</system:String>
  <system:String x:Key="Str_Ui_Joining_A_Server_Automatically_Needs_Min">الانضمام التلقائي إلى الخادم يتطلب Minecraft 1.20.6 أو أحدث؛ في الإصدارات الأقدم لا يؤثر هذا الخيار وتفتح القائمة الرئيسية بشكل عادي</system:String>
  <system:String x:Key="Str_Ui_About_The_Disk_Limit_Windows_Can_T_Enfor">حول حد القرص: لا يستطيع Windows فرض حصة قرص صارمة على مجلد واحد؛ هذا الخيار يراقب السعة ويحذر فقط أثناء التشغيل ولا يمنع الكتابة بالقوة.</system:String>
  <system:String x:Key="Str_Ui_Offline_Accounts_Set_To_Use_A_Custom_Ski">الحسابات غير المتصلة التي تختار “skin مخصص” في إدارة الحسابات تعرض skin عبر الخدمة الموجودة في هذا العنوان. افتراضيًا تُستخدم الخدمة العامة المدمجة؛ اتركه فارغًا للعودة إلى الافتراضي.</system:String>
  <system:String x:Key="Str_Ui_When_On_Xms_And_Xmx_Are_Recalculated_Fro">عند التمكين، تتم إعادة حساب -Xms/-Xmx قبل كل تشغيل حسب ذاكرة النظام المتاحة، وتستبدل القيم الثابتة المدخلة يدويًا في الإعدادات.</system:String>
  <system:String x:Key="Str_Ui_Install_Vanilla_Or_The_Fabric_Forge_Neof">يثبت Vanilla أو client loader من Fabric / Forge / NeoForge؛ عند الانتهاء يظهر تلقائيًا في قائمة “الإصدارات المثبتة”.</system:String>
  <system:String x:Key="Str_Ui_A_Modpack_Overwrites_The_Mods_And_Config">سيستبدل modpack محتويات مثل mods/config في مجلد التثبيت؛ لتجنب الخلط مع Mod الموجودة يوصى بالتثبيت في مجلد إصدار جديد منفصل.</system:String>
  <system:String x:Key="Str_Ui_Changes_The_Launcher_S_Colour_Family_Eac">يغير درجة لون launcher؛ لكل عائلة ألوان نسختان فاتحة وداكنة. ما يتم عرضه يحدده “إعدادات الوضع” في الصفحة الرئيسية أو التبديل التلقائي أدناه.</system:String>
  <system:String x:Key="Str_Ui_Takes_You_From_Account_To_Launch_In_One_">أكمل المسار كله من الحساب إلى التشغيل وابدأ اللعب؛ يمكن تخطي كل خطوة (Mod/حزمة الموارد/shader). كما يمكن استيراد modpack لتخطي جميع الاختيارات التالية.</system:String>
  <system:String x:Key="Str_Ui_2_Create_A_Tcp_Tunnel_And_Set_The_Local_">2. أنشئ TCP tunnel جديدًا؛ أدخل منفذ الخادم كمنفذ محلي (الافتراضي 25565؛ القيمة الدقيقة تظهر في عنوان الاتصال ببطاقة “قائمة الخوادم”).</system:String>
  <system:String x:Key="Str_Ui_1_Sign_In_To_Your_Router_S_Admin_Page_Us">1. سجّل الدخول إلى صفحة إدارة router (عادة 192.168.1.1 أو 192.168.0.1 في المتصفح؛ العنوان الدقيق موجود على ملصق router).</system:String>
  <system:String x:Key="Str_Ui_Resource_Packs_Shader_Packs_Data_Packs_W">حزم الموارد وshader والبيانات والعوالم وmodpack كلها بصيغة .zip؛ تعذر تحديد النوع من المحتوى. الاختيار الخاطئ سيثبت في المجلد الخطأ، لذلك يسأل launcher.</system:String>
  <system:String x:Key="Str_Ui_Bedrock_Dedicated_Server_Is_Published_Fr">يُنشر Bedrock Dedicated Server مجانًا بواسطة Mojang على الموقع الرسمي؛ لا يحتاج إلى حساب أو ترخيص ويمكن تنزيله مباشرة.</system:String>
  <system:String x:Key="Str_Ui_Switches_Between_Light_And_Dark_Automati">عند التمكين، يتغير الوضع الفاتح/الداكن تلقائيًا حسب وقت النظام (الافتراضي 08:00-19:00 فاتح والباقي داكن)؛ يمكن تغيير الأوقات من “الإعدادات”.</system:String>
  <system:String x:Key="Str_Ui_In_Game_Watermark_Text_Shown_In_The_Bott">نص العلامة المائية داخل اللعبة (يظهر أسفل اليسار، مثل “XCL2”؛ إذا كان فارغًا يظهر النص الرسمي “release”)</system:String>
  <system:String x:Key="Str_Ui_Turning_This_Off_Restores_The_Old_Behavi">عند التعطيل يعود السلوك القديم: يتم فقط فك محتوى modpack إلى instance الموجود المحدد مع الاستبدال دون تنزيل اللعبة/loader؛ إذا لم تتطابق الإصدارات قد يحدث crash مباشرة.</system:String>
  <system:String x:Key="Str_Ui_Installing_The_Fabric_Client_Doesn_T_Run">تثبيت client Fabric لا يحتاج إلى تشغيل برنامج تثبيت محلي، ويمكن تثبيته دون مسار Java. Java المطلوبة للتشغيل ستتم مطابقتها/تنزيلها تلقائيًا على أي حال.</system:String>
  <system:String x:Key="Str_Ui_Keep_Resource_Data_And_Shader_Packs_Sepa">فصل حزم الموارد/البيانات/shader حسب الإصدار (مفعّل افتراضيًا؛ معطل = نسخة مشتركة لكل الإصدارات؛ يمكن تجاوز الإعداد لإصدار واحد من “اختيار الإصدار”)</system:String>
  <system:String x:Key="Str_Ui_Already_Have_A_Minecraft_Folder_From_The">إذا كان لديك مجلد .minecraft بالفعل (مثلًا من launcher الرسمي/آخر)، حدده مباشرة؛ سيتم تخطي التنزيل ومطابقة Java تلقائيًا ثم التشغيل.</system:String>
  <system:String x:Key="Str_Ui_Keep_Mods_Resource_Packs_Data_Packs_And_">افتراضيًا فصل mods / حزم الموارد / حزم البيانات / العوالم حسب الإصدار (موصى به، مثل launcher الرسمي؛ يمكن تجاوز الإعداد لإصدار واحد من “اختيار الإصدار”)</system:String>
  <system:String x:Key="Str_Ui_Colour_Themes_Blue_Yellow_Purple_Pink_An">سمات ألوان الواجهة (أزرق، أصفر، بنفسجي، وردي، إلخ) أصبحت ميزة رسمية وليست تجريبية؛ يمكن استخدامها بأمان من صفحة “الإعدادات”.</system:String>
  <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Server_From_The_Lis">اختر Java لهذا الخادم من القائمة المحفوظة في “الإعدادات”؛ إذا اخترت “(غير محدد، اكتشاف/تنزيل تلقائي)” فسيستخدم مربع المسار أدناه ويطابق/ينزل تلقائيًا عند الحاجة</system:String>
  <system:String x:Key="Str_Ui_Normal_Mode_Shows_Only_The_Essentials_An">الوضع العادي: يعرض الخيارات اللازمة فقط ويكتشف/ينزل Java تلقائيًا؛ وضع الخبير: يتيح إعداد إصدار/بنية/نوع تثبيت Java والمعلمات المخصصة، إلخ</system:String>
  <system:String x:Key="Str_Ui_Sign_In_With_A_Third_Party_Auth_Server_A">تسجيل الدخول بحساب خادم مصادقة طرف ثالث (Unified Pass/blessing-skin، إلخ، يتطلب بروتوكول Yggdrasil)؛ ثم يستخدم skin من ذلك الخادم تلقائيًا.</system:String>
  <system:String x:Key="Str_Ui_Quickly_Checks_The_Usual_Places_For_Inst">يعثر سريعًا على Java المثبتة في المواقع الشائعة (مجلد portable/JAVA_HOME/registry/PATH) ويضيفها دفعة واحدة للقائمة؛ لا يفحص القرص بالكامل وينتهي خلال ثوانٍ</system:String>
  <system:String x:Key="Str_Ui_Switches_Between_Dark_And_Light_It_Only_">يبدل بين الوضع الداكن/الفاتح؛ يؤثر في السطوع فقط ولا يغير درجة “سمة اللون”. إذا كان “التبديل التلقائي” مفعّلًا فالاختيار اليدوي مؤقت حتى التبديل التلقائي التالي.</system:String>
  <system:String x:Key="Str_Ui_This_Feature_Is_Locked_By_Default_And_Ne">هذه الميزة مقفلة افتراضيًا؛ تحتاج إلى token صحيح للمتابعة (غير حساس لحالة الأحرف). إذا لم يكن لديك token فهذه الميزة ليست لك حاليًا؛ استخدم الميزات المستقرة.</system:String>
  <system:String x:Key="Str_Ui_Once_Several_Java_Runtimes_Are_Registere">عند حفظ عدة Java runtime، يمكن اختيار Java منفصلة من القائمة لكل إصدار client ولكل server instance.</system:String>
  <system:String x:Key="Str_Ui_Separate_Arguments_With_Spaces_And_Wrap_">افصل المعلمات المتعددة بمسافات؛ ضع القيم التي تحتوي مسافات بين علامتي اقتباس مزدوجتين. تضاف المعلمات بعد المعلمات المدمجة وقبل classpath؛ عند التعارض تكون قيمك هي السارية. الفراغ يعني عدم التطبيق.</system:String>
  <system:String x:Key="Str_Ui_A_Loader_Forked_From_Fabric_It_Runs_Most">loader متفرع من Fabric؛ متوافق مع معظم Fabric Mod ويوفر ميزات إضافية لتطوير Mod. مثل Fabric لا يحتاج إلى Java محلية.</system:String>
  <system:String x:Key="Str_Ui_Enables_The_Auto_Cycle_Button_On_The_Mai">عند التمكين، يعمل زر “التبديل التلقائي” في الصفحة الرئيسية ويبدل الفاتح/الداكن حسب الأوقات أدناه. يمكن التبديل يدويًا لكن الأتمتة تستعيد التحكم عند الوقت التالي.</system:String>
  <system:String x:Key="Str_Ui_Blank_Means_Auto_Match_The_Version_S_Own">فارغ = مطابقة تلقائية (الأعلى من متطلبات Java للإصدار وMod المثبتة)؛ رقم (مثل 25) = فرض استخدام هذا Java major دائمًا لهذا الإصدار</system:String>
  <system:String x:Key="Str_Ui_Search_By_Keyword_In_English_Or_Chinese_">البحث بكلمة مفتاحية إنجليزية أو صينية، مثل “JEI” أو “钠” (تتم الترجمة تلقائيًا للبحث عن Sodium)؛ الفراغ يعرض Mod الشائعة والكتابة تبدأ البحث تلقائيًا</system:String>
  <system:String x:Key="Str_Ui_Note_The_Bedrock_Client_Is_Distributed_T">ملاحظة: عميل Bedrock Edition يوزع عبر Microsoft Store ويرتبط بترخيص حساب Microsoft؛ لا يوجد عنوان تنزيل عام. يستطيع launcher فتح النسخة المثبتة فقط ولا يمكنه تنزيلها أو تغيير إصدارها.</system:String>
  <system:String x:Key="Str_Ui_Supports_Mcworld_Worlds_Mcpack_Resource_">يدعم .mcworld (عالم)، .mcpack (حزمة موارد/سلوك)، .mcaddon (حزمة add-on)، .mctemplate (قالب عالم). يمكن أيضًا سحب هذه الملفات إلى نافذة launcher.</system:String>
  <system:String x:Key="Str_Ui_3_The_Tunnelling_Tool_Gives_You_A_Public">3. ستمنحك أداة tunnel عنوانًا عامًا مثل xxx.xxx.com:12345؛ أرسله لصديقك واطلب منه في Minecraft فتح “اللعب الجماعي - إضافة خادم”.</system:String>
  <system:String x:Key="Str_Ui_Removes_Temporary_Files_From_This_Minecr">ينظف الملفات المؤقتة الآمنة للحذف في مجلد .minecraft الحالي مثل أرشيفات السجلات القديمة وتقارير crash القديمة وweb cache ومخرجات Mixin debug وJVM crash dumps؛ لا يؤثر في العوالم/Mod/الموارد/الإعدادات.</system:String>
  <system:String x:Key="Str_Ui_Security_Note_Whichever_Method_You_Use_T">ملاحظة أمنية: أيًا كانت طريقة فتح الخادم للإنترنت، يوصى بتمكين المصادقة عبر الإنترنت في “إعدادات الخادم” لمنع الغرباء؛ وإذا كنت تلعب مع الأصدقاء فقط يمكنك استخدام القائمة البيضاء.</system:String>
  <system:String x:Key="Str_Ui_Experimental_Features_May_Also_Include_J">قد تتضمن الميزات التجريبية أشياء للمرح أو ميزات غير مكتملة قيد التطوير أو محتوى لم يتم التحقق منه بما يكفي. لم يُقرر بعد إن كانت ستصبح رسمية، لذلك قد تُحذف أو تتغير كثيرًا.</system:String>
  <system:String x:Key="Str_Ui_Experimental_Features_Currently_Include_">من الميزات التجريبية الحالية وظائف متقدمة منخفضة المستوى مثل تثبيت عدة loader معًا في إصدار واحد (أكثر من واحد من Fabric/Forge/NeoForge)؛ الاستخدام الخاطئ قد يفسد الإصدار ويتطلب إعادة التنزيل.</system:String>
  <system:String x:Key="Str_Ui_When_On_The_Launch_Button_Always_Uses_A_">عند التمكين، يستخدم “تشغيل اللعبة” في الصفحة الرئيسية دائمًا حسابًا غير متصل مؤقتًا لهذا التشغيل فقط ولا يقرأ/يكتب الحسابات الحقيقية المحفوظة؛ عند الإغلاق تُنظف سجلات اللعبة/التنزيلات المؤقتة دون التأثير في اللعبة/Mod/العوالم المثبتة.</system:String>
  <system:String x:Key="Str_Ui_Drag_Mods_Resource_Packs_Shaders_Worlds_">اسحب ملفات Mod / حزم الموارد / shader / العوالم / modpack مباشرة إلى نافذة launcher لتثبيتها. بما أنها قد تكون جميعًا .zip، يفحص launcher المحتوى؛ إذا تعذر تحديد النوع يتصرف حسب الإعداد أدناه.</system:String>
  <system:String x:Key="Str_Ui_3_Friends_Connect_Using_Your_Public_Ip_A">3. يمكن للأصدقاء الاتصال باستخدام IP عام + منفذ. إذا تغير IP العام (وهذا شائع في الاتصالات المنزلية)، استخدم DDNS لربط اسم نطاق تلقائيًا بالـ IP الحالي.</system:String>
