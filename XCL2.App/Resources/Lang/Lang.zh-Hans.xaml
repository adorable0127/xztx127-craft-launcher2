<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- 简体中文（zh-Hans）：启动器 UI 语言资源，默认语言。
         这是所有其它语言文件 key 集合的"基准/权威来源"——LocalizationService 启动时会
         用这个文件的 key 列表去校验其它语言文件是否有遗漏，所以新增文案时必须先加在这里。
         详见同目录 README.md。 -->

    <!-- ============ 语言选择弹窗自身 ============ -->
    <system:String x:Key="Str_Lang_DialogTitle">选择语言</system:String>
    <system:String x:Key="Str_Lang_EntryButton">语言/Language</system:String>
    <system:String x:Key="Str_Lang_ExperimentalNotice">部分实验性功能仅对简体中文界面开放；切换到其它语言后，这些实验性功能会暂时隐藏（功能本身不受影响，只是尚未提供对应语言的界面翻译）。</system:String>
    <system:String x:Key="Str_Lang_Ok">确定</system:String>
    <system:String x:Key="Str_Lang_Cancel">取消</system:String>

    <!-- ============ 首页 HomePage ============ -->
    <system:String x:Key="Str_Home_Welcome">欢迎使用 XCL2</system:String>
    <system:String x:Key="Str_Home_Subtitle">xztx127-craft-launcher 2</system:String>
    <system:String x:Key="Str_Home_Toggle_DarkMode">深色模式</system:String>
    <system:String x:Key="Str_Home_Toggle_LightMode">浅色模式</system:String>
    <system:String x:Key="Str_Home_Toggle_AutoCycle">自动循环</system:String>
    <system:String x:Key="Str_Home_Toggle_AutoCycleOn">自动循环：已开启</system:String>
    <system:String x:Key="Str_Home_Toggle_NormalMode">普通模式</system:String>
    <system:String x:Key="Str_Home_Toggle_ExpertMode">专家模式</system:String>
    <system:String x:Key="Str_Home_Toggle_GuestMode">访客模式</system:String>
    <system:String x:Key="Str_Home_Toggle_GuestModeOn">访客模式：已开启</system:String>
        <system:String x:Key="Str_Home_Tile_Account_Title">账户登录</system:String>
    <system:String x:Key="Str_Home_Tile_Account_Desc">离线账户 / 微软账户，随时切换</system:String>
    <system:String x:Key="Str_Home_Tile_Launch_Title">开始游戏</system:String>
    <system:String x:Key="Str_Home_Tile_Launch_Desc">使用当前选中的版本和账户直接开玩</system:String>
    <system:String x:Key="Str_Home_Tile_QuickStart_Title">一键开始游戏</system:String>
    <system:String x:Key="Str_Home_Tile_QuickStart_Desc">版本、加载器、Mod 一步到位</system:String>
    <system:String x:Key="Str_Home_Tile_Download_Title">下载中心</system:String>
    <system:String x:Key="Str_Home_Tile_Download_Desc">下载游戏核心、Mod、地图、资源包</system:String>
    <system:String x:Key="Str_Home_Tile_ServerManager_Title">服务器管理</system:String>
    <system:String x:Key="Str_Home_Tile_ServerManager_Desc">创建/启动本地服务器，内含联机/内网穿透教程</system:String>
    <system:String x:Key="Str_Home_Tile_Settings_Title">设置</system:String>
    <system:String x:Key="Str_Home_Tile_Settings_Desc">Java、模式切换、窗口大小等</system:String>

    <!-- ============ 顶部窗口标题 / 侧边导航（MainWindow） ============ -->
    <system:String x:Key="Str_Main_WindowTitlePrefix">XCL2 - xztx127-craft-launcher 2</system:String>
    <system:String x:Key="Str_Nav_Home">主页</system:String>
    <system:String x:Key="Str_Nav_Versions">版本选择</system:String>
    <system:String x:Key="Str_Nav_Download">下载</system:String>
    <system:String x:Key="Str_Nav_Multiplayer">联机</system:String>
    <system:String x:Key="Str_Nav_ModManager">Mod 管理</system:String>
    <system:String x:Key="Str_Nav_ServerManager">服务端管理</system:String>
    <system:String x:Key="Str_Nav_Accounts">账户管理</system:String>
    <system:String x:Key="Str_Nav_Settings">设置</system:String>
    <system:String x:Key="Str_Nav_Logs">日志</system:String>
    <system:String x:Key="Str_Nav_Experimental">实验性功能</system:String>
    <system:String x:Key="Str_Nav_Toolbox">百宝箱</system:String>

    <!-- ============ 设置页新增的"启动器界面语言"区块 ============ -->
    <system:String x:Key="Str_Settings_LanguageSection_Title">启动器界面语言</system:String>
    <system:String x:Key="Str_Settings_LanguageSection_Hint">切换后立即生效，不需要重启启动器；这里选的是「启动器界面」使用的语言，跟下面「游戏内语言」是两回事。</system:String>
    <system:String x:Key="Str_Settings_LanguageSection_OpenPicker">🌐 选择语言</system:String>

</ResourceDictionary>
