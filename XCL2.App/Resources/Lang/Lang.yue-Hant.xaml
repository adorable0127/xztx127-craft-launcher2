<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- 粵語（yue-Hant，用繁體字書寫口語粵語）。key 集合必须跟 Lang.zh-Hans.xaml 完全一致。
         注：粵語書面口語化程度目前只做到"日常常见用词"级别（如"睇" "嘅" "唔"），
         专业术语（Mod、Java、启动器等）保留原词，这是粤语技术文案的通行做法。 -->

    <system:String x:Key="Str_Lang_DialogTitle">揀語言</system:String>
    <system:String x:Key="Str_Lang_EntryButton">語言</system:String>
    <system:String x:Key="Str_Lang_ExperimentalNotice">部分實驗性功能淨係開放俾簡體中文介面；轉去其他語言之後，呢啲實驗性功能會暫時隱藏（功能本身冇受影響，淨係未有對應語言嘅介面翻譯）。</system:String>
    <system:String x:Key="Str_Lang_Ok">確定</system:String>
    <system:String x:Key="Str_Lang_Cancel">取消</system:String>

