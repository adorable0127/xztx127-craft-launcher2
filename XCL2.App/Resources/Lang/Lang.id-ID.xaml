    <system:String x:Key="Str_Ui_The_Modpack_S_Files_Are_Merged_Into_The_">Konten modpack akan digabung ke folder versi yang dipilih; file dengan nama sama ditimpa dan dapat bentrok dengan Mod yang ada.</system:String>
    <system:String x:Key="Str_Ui_Press_Save_Settings_Below_To_Apply_The_R">Harus klik «Simpan pengaturan» di bawah agar berlaku; pratinjau diterapkan segera setelah disimpan tanpa restart launcher.</system:String>
    <system:String x:Key="Str_Ui_Open_A_Separate_Console_Window_On_Launch">Buka jendela CMD terpisah saat game diluncurkan untuk menampilkan log secara real time (berguna untuk melihat langsung di command line)</system:String>
    <system:String x:Key="Str_Ui_The_Log_Panel_Is_Hidden_Tick_The_Box_Abo">Panel log sedang disembunyikan. Centang kotak di atas untuk melihat log game, log launcher, analisis crash, dan pemindaian injeksi.</system:String>
    <system:String x:Key="Str_Ui_The_Mods_Below_Are_Missing_Required_Depe">Mod di bawah kehilangan dependensi wajib; menjalankan langsung kemungkinan besar membuat game crash atau macet saat loading.</system:String>
    <system:String x:Key="Str_Ui_How_To_Let_Friends_Connect_From_Outside_">Cara agar teman di luar jaringan dapat terhubung ke server: tunneling jaringan / port forwarding router / relay server cloud</system:String>
    <system:String x:Key="Str_Ui_Server_Address_E_G_Play_Example_Com_Or_1">Alamat server, misalnya play.example.com atau 1.2.3.4:25565</system:String>
    <system:String x:Key="Str_Ui_Experimental_Features_Are_Still_Being_Wo">Fitur eksperimental masih dalam tahap penyempurnaan; setelah diaktifkan Anda mungkin menemui masalah tampilan, konflik pengaturan,</system:String>
    <system:String x:Key="Str_Ui_Supports_Minecraft_Colour_And_Formatting">Mendukung kode warna/format Minecraft; misalnya §a untuk teks hijau dan §l untuk tebal.</system:String>
    <system:String x:Key="Str_Ui_Nothing_Saved_Yet_Try_The_Button_In_The_">Belum ada favorit. Buka «Versi game» / «Mod» / «Paket tekstur», dll. lalu klik ☆ Favorit.</system:String>
    <system:String x:Key="Str_Ui_New_Here_Or_Setting_Up_A_Fresh_Version_O">Baru pertama kali atau ingin memasang versi/modpack baru? Ikuti wizard untuk memilih akun, versi, dan Mod langkah demi langkah.</system:String>
    <system:String x:Key="Str_Ui_Edit_The_Common_Server_Properties_Entrie">Edit grafis opsi umum server.properties seperti motd, jumlah pemain maksimum, dan verifikasi online</system:String>
    <system:String x:Key="Str_Ui_You_Can_Hide_Pages_You_Don_T_Need_Or_Swi">Anda dapat menyembunyikan halaman yang tidak diperlukan atau mematikan fitur tertentu. Tekan F12 di layar mana pun untuk menampilkan fitur tersembunyi sementara.</system:String>
    <system:String x:Key="Str_Ui_Turn_On_Version_Isolation_For_This_Insta">Aktifkan «isolasi versi» untuk versi ini (mods/resource/world terpisah, sama seperti launcher resmi)</system:String>
    <system:String x:Key="Str_Ui_Switch_To_Light_Mode_At_This_Hour_Each_D">Setiap hari saat mencapai jam ini (0~23), otomatis beralih ke mode terang sampai waktu «Mode gelap mulai pukul».</system:String>
    <system:String x:Key="Str_Ui_The_Embedded_Sign_In_Component_Failed_To">Gagal menginisialisasi komponen login terintegrasi (mungkin WebView2 Runtime belum terpasang). Gunakan tombol «Login browser».</system:String>
    <system:String x:Key="Str_Ui_The_Server_S_World_Folder_Name_World_By_">Nama folder world server, default world; jika admin mengubah level-name, gunakan nama tersebut</system:String>
    <system:String x:Key="Str_Ui_When_Ticked_Search_Results_Include_Beta_">Jika dicentang, hasil pencarian menyertakan versi beta / alpha yang belum resmi dirilis. Default hanya versi stabil.</system:String>
    <system:String x:Key="Str_Ui_The_Oldest_Loader_With_The_Largest_Ecosy">Loader tertua dengan ekosistem terbesar; banyak modpack teknologi/magic besar bergantung padanya. Installer memerlukan Java lokal.</system:String>
    <system:String x:Key="Str_Ui_These_Options_Are_Still_Being_Polished_A">Opsi ini masih disempurnakan dan mungkin tidak stabil. Kesalahan warna tidak memengaruhi game/world/Mod; selalu dapat kembali ke default.</system:String>
    <system:String x:Key="Str_Ui_Builds_A_Separate_Instance_From_Scratch_">Membuat instance terpisah dari nol: mengunduh game dan loader lebih dulu, lalu memasang modpack. Instance yang sudah ada tidak diubah.</system:String>
    <system:String x:Key="Str_Ui_A_Newer_Loader_Forked_From_Forge_The_Mod">Loader baru hasil fork dari Forge; ekosistem Mod versi baru perlahan berpindah ke sini. Juga memerlukan Java lokal.</system:String>
    <system:String x:Key="Str_Ui_However_Many_You_Tick_Is_However_Many_Ge">Jumlah loader yang dipasang sama dengan yang dicentang; angka sebenarnya mengikuti «Loader dipilih» di bawah. Teks ini hanya petunjuk dan tidak perlu diselaraskan manual.</system:String>
    <system:String x:Key="Str_Ui_Only_Affects_Offline_Accounts_Set_To_Use">Hanya memengaruhi akun offline dengan «Skin khusus»; skin default Steve/Alex dan skin akun Microsoft tidak terpengaruh.</system:String>
    <system:String x:Key="Str_Ui_Guest_Mode_Launches_With_A_Temporary_Acc">Mode tamu (hanya sesi ini; game memakai akun sementara, bukan akun tersimpan; setelah launcher dimulai ulang, otomatis kembali ke mode normal)</system:String>
    <system:String x:Key="Str_Ui_Download_Any_Direct_Link_Note_That_Some_">Unduh file apa pun dari direct link. Beberapa situs (misalnya Baidu Netdisk) dapat memberi error 403 dan memblokir unduhan.</system:String>
    <system:String x:Key="Str_Ui_Get_A_Key_From_Console_Curseforge_Com_Th">Dapatkan key dari console.curseforge.com, lalu tempel dan simpan di «Pengaturan».</system:String>
    <system:String x:Key="Str_Ui_Opens_The_Copy_Of_Minecraft_For_Windows_">Membuka Minecraft for Windows (Bedrock Edition) yang sudah terpasang; hanya membuka, tidak mengunduh atau mengelola versi</system:String>
    <system:String x:Key="Str_Ui_Smart_Throttling_Watches_What_Other_Prog">Pembatasan cerdas (mendeteksi penggunaan jaringan aplikasi lain agar tidak merebut bandwidth; dapat dipakai bersama batas di atas dan memakai yang lebih konservatif)</system:String>
    <system:String x:Key="Str_Ui_Only_Applies_When_No_Specific_Java_Is_Ch">Hanya berlaku jika tidak memilih Java tertentu di atas: kosong = cocokkan otomatis (disarankan); angka (mis. 25) = paksa versi utama</system:String>
    <system:String x:Key="Str_Ui_Auth_Server_Api_Root_E_G_Https_Example_C">Root API server autentikasi, misalnya https://example.com/api/yggdrasil</system:String>
    <system:String x:Key="Str_Ui_Show_Mod_Icons_In_Search_Results_Fetched">Tampilkan ikon Mod pada hasil Pusat unduhan (diambil dari Modrinth/CurseForge, aktif secara default)</system:String>
    <system:String x:Key="Str_Ui_Note_Java_8_Defaults_To_32_Bit_And_Every">Catatan: Java 8 memakai 32-bit secara default; versi lain 64-bit. Jika tidak yakin, gunakan pengaturan yang disarankan.</system:String>
    <system:String x:Key="Str_Ui_Default_Light_Mode_From_08_00_To_19_00_A">Default: mode terang 08:00–19:00, sisanya mode gelap. Klik «Simpan pengaturan» agar berlaku.</system:String>
    <system:String x:Key="Str_Ui_Double_Click_An_Account_To_Launch_Straig">Klik dua kali akun untuk langsung menjalankan; atau pilih lalu klik «Jalankan dengan akun ini». Tidak ada akun yang diinginkan? Tambahkan di bawah.</system:String>
    <system:String x:Key="Str_Ui_A_Beginner_S_Wizard_That_Takes_You_From_">Wizard pemula dari akun sampai peluncuran: pilih versi/loader, opsional Mod dan paket resource/shader, lalu otomatis unduh dan jalankan</system:String>
    <system:String x:Key="Str_Ui_A_Development_Stage_Idea_Install_The_Sam">Fitur tahap pengembangan/konsep: memasang versi Minecraft yang sama dengan setiap loader pilihan dalam satu instance.</system:String>
    <system:String x:Key="Str_Ui_Optional_If_A_Newer_Official_Build_Is_Ou">Opsional: jika versi resmi baru keluar sebelum versi bawaan diperbarui, pilih file exe yang Anda unduh untuk menggantinya sementara</system:String>
    <system:String x:Key="Str_Ui_Guest_Mode_Only_Affects_Temporary_Accoun">Mode tamu hanya memengaruhi akun sementara dan pembersihan sesi; warna antarmuka selalu mengikuti «Tema warna» + «Pengaturan mode» saat ini.</system:String>
    <system:String x:Key="Str_Ui_Contains_Features_Still_In_Development_O">Berisi fitur yang masih dikembangkan/konsep, mungkin tidak stabil dan tidak disarankan untuk pengguna biasa. Saat pertama masuk, wajib membaca peringatan 10 detik.</system:String>
    <system:String x:Key="Str_Ui_Pick_One_From_The_Java_List_Above_As_The">Pilih Java dari daftar di atas sebagai default global; «(tidak ditentukan, gunakan deteksi otomatis)» mempertahankan logika deteksi/unduhan otomatis sebelumnya</system:String>
    <system:String x:Key="Str_Ui_Also_Install_Qsl_Quilt_Standard_Librarie">Instal juga QSL (Quilt Standard Libraries; banyak Mod Quilt membutuhkannya; disarankan)</system:String>
    <system:String x:Key="Str_Ui_Right_Now_Your_Server_Is_Only_Reachable_">Saat ini server hanya dapat diakses dalam jaringan lokal. Agar teman di WiFi/jaringan lain bisa terhubung, gunakan salah satu metode di bawah.</system:String>
    <system:String x:Key="Str_Ui_Note_Custom_Skins_Need_Customskinloader_">Catatan: skin khusus memerlukan CustomSkinLoader agar tampil benar dalam mode offline. Ini ditangani otomatis saat mengunduh/menjalankan game.</system:String>
    <system:String x:Key="Str_Ui_Type_A_Command_And_Press_Enter_E_G_Say_H">Ketik perintah lalu tekan Enter untuk mengirim, misalnya say hello / list / gamemode creative Steve</system:String>
    <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Instance_From_The_J">Pilih Java khusus untuk versi ini dari daftar Java di «Pengaturan»; «(tidak ditentukan)» memakai nomor versi utama di bawah untuk pencocokan otomatis</system:String>
    <system:String x:Key="Str_Ui_When_On_The_Game_Launches_With_A_Tempora">Jika aktif, game berjalan dengan akun sementara yang hanya ada pada peluncuran ini dan tidak memakai akun tersimpan; saat ditutup, log/unduhan sementara sesi dibersihkan</system:String>
    <system:String x:Key="Str_Ui_Switch_To_Dark_Mode_At_This_Hour_Each_Da">Setiap hari pada jam ini (0~23), otomatis beralih ke mode gelap sampai waktu «Mode terang mulai pukul» (tetap benar saat melewati tengah malam).</system:String>
    <system:String x:Key="Str_Ui_Note_The_Officially_Released_Versions_Ar">Catatan: versi stabil resmi utama adalah 8 / 11 / 17 / 21 / 25 / 26; nomor lain mungkin tidak memiliki build resmi.</system:String>
    <system:String x:Key="Str_Ui_E_G_Xx_Useg1gc_Dsomething_Quot_Value_Wit">Misalnya: -XX:+UseG1GC -Dsomething="value with spaces"</system:String>
    <system:String x:Key="Str_Ui_Joining_A_Server_Automatically_Needs_Min">Masuk server otomatis memerlukan Minecraft 1.20.6 atau lebih baru; pada versi lama opsi ini tidak berpengaruh dan game tetap masuk menu utama</system:String>
    <system:String x:Key="Str_Ui_About_The_Disk_Limit_Windows_Can_T_Enfor">Tentang batas disk: Windows tidak dapat menerapkan kuota keras pada satu folder; opsi ini hanya memantau ukuran saat berjalan dan memberi peringatan, tidak memblokir penulisan.</system:String>
    <system:String x:Key="Str_Ui_Offline_Accounts_Set_To_Use_A_Custom_Ski">Akun offline dengan «Skin khusus» memakai layanan skin dari alamat ini. Default memakai layanan publik bawaan; kosongkan untuk memulihkan default otomatis.</system:String>
    <system:String x:Key="Str_Ui_When_On_Xms_And_Xmx_Are_Recalculated_Fro">Jika aktif, sebelum setiap peluncuran -Xms/-Xmx dihitung ulang berdasarkan memori sistem yang benar-benar tersedia, menggantikan nilai tetap yang diisi manual.</system:String>
    <system:String x:Key="Str_Ui_Install_Vanilla_Or_The_Fabric_Forge_Neof">Instal Vanilla atau loader klien Fabric / Forge / NeoForge; setelah selesai otomatis muncul di «Versi terpasang».</system:String>
    <system:String x:Key="Str_Ui_A_Modpack_Overwrites_The_Mods_And_Config">Modpack menimpa isi seperti mods/config di folder instalasi. Disarankan memasangnya pada folder versi baru dan terpisah agar tidak bercampur dengan Mod yang ada.</system:String>
    <system:String x:Key="Str_Ui_Changes_The_Launcher_S_Colour_Family_Eac">Mengubah keluarga warna launcher; tiap tema punya varian terang dan gelap. Mode yang tampil ditentukan tombol «Pengaturan mode» di Beranda atau siklus otomatis di bawah.</system:String>
    <system:String x:Key="Str_Ui_Takes_You_From_Account_To_Launch_In_One_">Dari akun sampai peluncuran, selesaikan proses dan langsung bermain; setiap langkah (Mod/resource/shader) dapat dilewati. Anda juga bisa mengimpor modpack langsung dan melewati pilihan berikutnya.</system:String>
    <system:String x:Key="Str_Ui_2_Create_A_Tcp_Tunnel_And_Set_The_Local_">2. Buat tunnel TCP dan isi port lokal dengan port server (default 25565; lihat alamat koneksi pada kartu «Daftar server» untuk nilai sebenarnya).</system:String>
    <system:String x:Key="Str_Ui_1_Sign_In_To_Your_Router_S_Admin_Page_Us">1. Masuk ke halaman admin router (biasanya 192.168.1.1 atau 192.168.0.1 di browser; lihat label router untuk alamat tepat).</system:String>
    <system:String x:Key="Str_Ui_Resource_Packs_Shader_Packs_Data_Packs_W">Paket tekstur, shader, data, world, dan modpack semuanya .zip dan jenisnya tidak dapat ditentukan dari isi. Pilihan salah memasang ke folder yang salah, jadi tentukan di sini.</system:String>
    <system:String x:Key="Str_Ui_Bedrock_Dedicated_Server_Is_Published_Fr">Bedrock Dedicated Server disediakan gratis secara publik di situs resmi Mojang; tidak memerlukan akun atau lisensi dan dapat diunduh langsung.</system:String>
    <system:String x:Key="Str_Ui_Switches_Between_Light_And_Dark_Automati">Jika aktif, otomatis beralih mode terang/gelap sesuai waktu sistem (default terang 08:00–19:00); waktunya dapat diubah di «Pengaturan».</system:String>
    <system:String x:Key="Str_Ui_In_Game_Watermark_Text_Shown_In_The_Bott">Teks watermark dalam game (kiri bawah, misalnya "XCL2"; kosong menampilkan teks resmi "release")</system:String>
    <system:String x:Key="Str_Ui_Turning_This_Off_Restores_The_Old_Behavi">Jika dimatikan, kembali ke perilaku lama: hanya mengekstrak dan menimpa isi modpack ke instance yang sudah ada tanpa mengunduh game/loader; jika versinya tidak cocok, game bisa crash.</system:String>
    <system:String x:Key="Str_Ui_Installing_The_Fabric_Client_Doesn_T_Run">Instalasi klien Fabric tidak memerlukan menjalankan installer lokal, jadi dapat dipasang tanpa menentukan Java; saat versi dijalankan, Java yang diperlukan tetap dicocokkan/diunduh otomatis.</system:String>
    <system:String x:Key="Str_Ui_Keep_Resource_Data_And_Shader_Packs_Sepa">Pisahkan paket resource/data/shader per versi agar tidak berbagi (aktif default; hapus centang = satu salinan global untuk menghindari unduhan duplikat; dapat dioverride per versi)</system:String>
    <system:String x:Key="Str_Ui_Already_Have_A_Minecraft_Folder_From_The">Jika sudah memiliki folder .minecraft (misalnya dari launcher resmi/lain), pilih langsung untuk melewati unduhan dan jalankan setelah Java dicocokkan otomatis.</system:String>
    <system:String x:Key="Str_Ui_Keep_Mods_Resource_Packs_Data_Packs_And_">Pisahkan mods / resource / data / world, dll. per versi secara default (disarankan, sama seperti launcher resmi; dapat dioverride per versi)</system:String>
    <system:String x:Key="Str_Ui_Colour_Themes_Blue_Yellow_Purple_Pink_An">Tema warna antarmuka (biru, kuning, ungu, merah muda, dll.) sudah menjadi fitur stabil, bukan eksperimental; gunakan langsung dari «Pengaturan».</system:String>
    <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Server_From_The_Lis">Pilih Java langsung dari daftar yang terdaftar di «Pengaturan» untuk server ini; «(tidak ditentukan, deteksi/unduh otomatis)» memakai kolom path di bawah dan mencocokkan saat dibuat</system:String>
    <system:String x:Key="Str_Ui_Normal_Mode_Shows_Only_The_Essentials_An">Mode normal: hanya opsi penting, Java dideteksi/diunduh otomatis; mode lanjutan: atur versi/arsitektur/metode instalasi Java, argumen khusus, dll.</system:String>
    <system:String x:Key="Str_Ui_Sign_In_With_A_Third_Party_Auth_Server_A">Masuk dengan akun server autentikasi pihak ketiga (mis. Unified Pass/blessing-skin yang mendukung Yggdrasil); setelah login, skin dari server tersebut otomatis digunakan.</system:String>
    <system:String x:Key="Str_Ui_Quickly_Checks_The_Usual_Places_For_Inst">Mencari Java terpasang dengan cepat di lokasi umum (folder portabel/JAVA_HOME/registry/PATH) dan menambahkannya sekaligus; tidak memindai seluruh disk dan selesai dalam beberapa detik</system:String>
    <system:String x:Key="Str_Ui_Switches_Between_Dark_And_Light_It_Only_">Beralih mode gelap/terang; hanya memengaruhi kecerahan, bukan keluarga «Tema warna». Saat «Siklus otomatis» aktif, pilihan manual hanya sementara sampai jadwal berikutnya.</system:String>
    <system:String x:Key="Str_Ui_This_Feature_Is_Locked_By_Default_And_Ne">Fitur ini terkunci secara default dan memerlukan token yang benar (tidak membedakan huruf besar/kecil). Tidak punya token? Berarti fitur ini belum cocok untuk Anda; gunakan fitur stabil dulu.</system:String>
    <system:String x:Key="Str_Ui_Once_Several_Java_Runtimes_Are_Registere">Setelah mendaftarkan beberapa Java, Anda dapat memilih Java berbeda untuk setiap versi klien di «Pilih versi» dan untuk tiap instance server saat membuat/mengedit.</system:String>
    <system:String x:Key="Str_Ui_Separate_Arguments_With_Spaces_And_Wrap_">Pisahkan beberapa argumen dengan spasi; nilai yang mengandung spasi harus diapit tanda kutip ganda. Argumen ditambahkan setelah argumen bawaan dan sebelum classpath; jika konflik, milik Anda berlaku. Kosong = tidak berlaku.</system:String>
    <system:String x:Key="Str_Ui_A_Loader_Forked_From_Fabric_It_Runs_Most">Loader fork dari Fabric, kompatibel dengan sebagian besar Mod Fabric dan menyediakan fitur tambahan untuk pengembangan Mod. Cara instalasinya sama seperti Fabric dan tidak memerlukan Java lokal.</system:String>
    <system:String x:Key="Str_Ui_Enables_The_Auto_Cycle_Button_On_The_Mai">Jika aktif, tombol «Siklus otomatis» di Beranda bekerja: mode terang/gelap berubah pada waktu di bawah. Anda tetap dapat beralih manual, tetapi jadwal berikutnya akan mengambil alih lagi.</system:String>
    <system:String x:Key="Str_Ui_Blank_Means_Auto_Match_The_Version_S_Own">Kosong = pencocokan otomatis (persyaratan versi + persyaratan Java dari mod terpasang, ambil yang lebih tinggi); angka (mis. 25) = selalu paksa versi utama Java ini</system:String>
    <system:String x:Key="Str_Ui_Search_By_Keyword_In_English_Or_Chinese_">Cari kata kunci dalam Inggris atau Tionghoa, misalnya "JEI" atau "钠" (otomatis diterjemahkan menjadi Sodium saat mencari); kosong untuk Mod populer; otomatis mencari saat mengetik</system:String>
    <system:String x:Key="Str_Ui_Note_The_Bedrock_Client_Is_Distributed_T">Catatan: klien Bedrock Edition didistribusikan melalui Microsoft Store dan lisensinya terkait akun Microsoft. Tidak ada URL publik, jadi launcher hanya dapat membuka salinan yang sudah terpasang, bukan mengunduh atau mengganti versi.</system:String>
    <system:String x:Key="Str_Ui_Supports_Mcworld_Worlds_Mcpack_Resource_">Mendukung .mcworld (world), .mcpack (paket resource/behavior), .mcaddon (add-on), .mctemplate (template world). File ini juga dapat diseret ke launcher.</system:String>
    <system:String x:Key="Str_Ui_3_The_Tunnelling_Tool_Gives_You_A_Public">3. Alat tunneling akan memberikan alamat publik seperti xxx.xxx.com:12345. Kirim ke teman agar mereka memasukkannya di Minecraft pada «Multiplayer - Tambah server».</system:String>
    <system:String x:Key="Str_Ui_Removes_Temporary_Files_From_This_Minecr">Membersihkan file sementara yang aman dari folder .minecraft saat ini: arsip log lama, laporan crash, cache web, output debug Mixin, dump crash JVM, dll. Tidak menyentuh world/Mod/resource/pengaturan.</system:String>
    <system:String x:Key="Str_Ui_Security_Note_Whichever_Method_You_Use_T">Peringatan keamanan: apa pun metode membuka server ke Internet, disarankan mengaktifkan «Verifikasi online» di «Pengaturan server» agar orang asing tidak masuk; whitelist juga dapat digunakan.</system:String>
    <system:String x:Key="Str_Ui_Experimental_Features_May_Also_Include_J">Fitur eksperimental juga dapat berisi lelucon, pekerjaan setengah jadi, atau konten yang belum cukup diuji. Fitur dapat dihapus atau berubah besar kapan saja; pahami hal ini sebelum digunakan.</system:String>
    <system:String x:Key="Str_Ui_Experimental_Features_Currently_Include_">Saat ini fitur eksperimental termasuk instalasi gabungan beberapa loader (beberapa Fabric/Forge/NeoForge pada satu versi) dan fitur tingkat rendah lainnya. Penggunaan salah dapat merusak versi dan memerlukan unduhan ulang.</system:String>
    <system:String x:Key="Str_Ui_When_On_The_Launch_Button_Always_Uses_A_">Jika aktif, «Mulai game» di Beranda selalu memakai akun offline sementara hanya untuk peluncuran ini dan tidak membaca/menulis akun asli tersimpan; saat launcher ditutup, log dan unduhan sementara dibersihkan tanpa memengaruhi game/Mod/world terpasang.</system:String>
    <system:String x:Key="Str_Ui_Drag_Mods_Resource_Packs_Shaders_Worlds_">Seret Mod / paket tekstur / shader / world / modpack ke jendela launcher untuk memasang. Karena banyak berformat .zip, launcher memeriksa isi untuk mendeteksi jenis dan hanya memakai pengaturan di bawah jika tidak dikenali.</system:String>
    <system:String x:Key="Str_Ui_3_Friends_Connect_Using_Your_Public_Ip_A">3. Teman terhubung menggunakan IP publik + port Anda. Jika IP berubah (umum pada Internet rumah), gunakan DDNS agar domain otomatis mengikuti IP dinamis dan Anda tidak perlu memberi tahu setiap perubahan.</system:String>
    <system:String x:Key="Str_Ui_The_Toolbox_Advancement_Images_Skin_Avat">«Kotak alat» (pembuat achievement, avatar skin, unduhan khusus, skin premium, pembersihan, shortcut, hitung peluncuran, unduh Jar loader, optimasi memori, dll.) adalah fitur stabil yang tersedia dari navigasi alat.</system:String>
    <system:String x:Key="Str_Ui_2_Find_Port_Forwarding_Port_Mapping_Or_V">2. Cari «Port Forwarding/Port Mapping/Virtual Server» (nama berbeda tiap merek) dan buat aturan: port eksternal dan internal = port server (default 25565); IP internal = IP LAN PC ini, terlihat di sistem/router.</system:String>
    <system:String x:Key="Str_Ui_A_Tunnelling_Tool_Gives_You_A_Temporary_">Alat tunneling memberi alamat publik sementara dan meneruskan traffic ke port server di PC tanpa login router atau IP publik. Setup hanya beberapa menit; paket gratis biasanya membatasi bandwidth/koneksi dan kurang stabil untuk jangka panjang.</system:String>
    <system:String x:Key="Str_Ui_For_Reference_Java_8_Covers_Versions_Bef">Referensi: Java 8 untuk versi sebelum 1.16; Java 17 sebelum 1.20.5; Java 21 sebelum 1.21.11; Java 25 untuk 26.1+. Java 8 default 32-bit, lainnya 64-bit; pilih sesuai kebutuhan.</system:String>
    <system:String x:Key="Str_Ui_Rent_A_Cheap_Cloud_Server_It_Comes_With_">Sewa server cloud murah (Alibaba Cloud/Tencent Cloud/Huawei Cloud, dll.) dengan IP publik dan gunakan frp untuk relay traffic server lokal, atau jalankan core server langsung di cloud. Biasanya lebih stabil/cepat, tetapi berbayar dan lebih rumit.</system:String>
    <system:String x:Key="Str_Ui_If_Your_Connection_Has_A_Public_Ipv4_Or_">Jika koneksi memiliki IPv4/IPv6 publik (cek ISP atau «WAN status» router; alamat 100.x/10.x/192.168.x biasanya berarti NAT operator), Anda dapat melakukan port forwarding ke PC ini. Tidak bergantung pihak ketiga atau batas bandwidth, tetapi setup lebih sulit.</system:String>
