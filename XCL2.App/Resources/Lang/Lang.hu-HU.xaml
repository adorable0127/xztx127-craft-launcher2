  <system:String x:Key="Str_Cs_No_Usable_Java_Was_Found_Download_Or_Con">Nem található használható Java. Először tölts le/állíts be Java-t a „Beállítások” oldalon, vagy add meg kézzel az útvonalat.</system:String>
  <system:String x:Key="Str_Cs_Embedded_Sign_In_Cancelled_You_Can_Use_B">A beágyazott bejelentkezés megszakítva; a rendszerböngésző használatához kattints a „Bejelentkezés böngészőben” gombra.</system:String>
