  <system:String x:Key="Str_Ui_Auth_Server_Api_Root_E_G_Https_Example_C">Địa chỉ gốc API của máy chủ xác thực, ví dụ https://example.com/api/yggdrasil</system:String>
  <system:String x:Key="Str_Ui_Show_Mod_Icons_In_Search_Results_Fetched">Hiển thị icon Mod trong kết quả tìm kiếm Trung tâm tải xuống (lấy từ Modrinth/CurseForge, mặc định bật)</system:String>
  <system:String x:Key="Str_Ui_Note_Java_8_Defaults_To_32_Bit_And_Every">Lưu ý: Java 8 mặc định là 32-bit, các phiên bản khác là 64-bit. Nếu không chắc, hãy dùng cài đặt khuyến nghị.</system:String>
  <system:String x:Key="Str_Ui_Default_Light_Mode_From_08_00_To_19_00_A">Mặc định: 08:00-19:00 chế độ sáng, thời gian khác chế độ tối. Nhấp “Lưu cài đặt” để áp dụng.</system:String>
  <system:String x:Key="Str_Ui_Double_Click_An_Account_To_Launch_Straig">Nhấp đúp một tài khoản để khởi chạy trực tiếp; hoặc chọn rồi nhấn “Khởi chạy bằng tài khoản này” bên dưới. Nếu chưa có tài khoản mong muốn, có thể thêm ở dưới.</system:String>
  <system:String x:Key="Str_Ui_A_Beginner_S_Wizard_That_Takes_You_From_">Trình hướng dẫn cho người mới từ tài khoản đến khởi chạy: chọn phiên bản/loader, tùy chọn thêm Mod và gói tài nguyên/shader, sau đó tự tải và khởi chạy</system:String>
  <system:String x:Key="Str_Ui_A_Development_Stage_Idea_Install_The_Sam">Chỉ là tính năng đang phát triển/ý tưởng — cài riêng từng loader đã chọn cho cùng phiên bản Minecraft vào cùng một instance.</system:String>
  <system:String x:Key="Str_Ui_Optional_If_A_Newer_Official_Build_Is_Ou">Tùy chọn: nếu phiên bản chính thức mới đã phát hành nhưng bản đi kèm chưa cập nhật, bạn có thể tạm chọn tệp exe đã tải để ghi đè bản đi kèm</system:String>
  <system:String x:Key="Str_Ui_Guest_Mode_Only_Affects_Temporary_Accoun">Chế độ khách chỉ ảnh hưởng tài khoản tạm thời và dọn phiên; không thay đổi màu giao diện. Màu luôn theo “Chủ đề màu” + lựa chọn “Cài đặt chế độ” hiện tại.</system:String>
  <system:String x:Key="Str_Ui_Contains_Features_Still_In_Development_O">Bao gồm tính năng đang phát triển/ý tưởng; có thể không ổn định và không khuyến nghị người dùng thường. Lần đầu vào bắt buộc đọc cảnh báo 10 giây.</system:String>
  <system:String x:Key="Str_Ui_Pick_One_From_The_Java_List_Above_As_The">Chọn Java mặc định toàn cục từ danh sách trên; “(Không chỉ định, tự động phát hiện)” giữ nguyên logic tự phát hiện/tải hiện tại</system:String>
  <system:String x:Key="Str_Ui_Also_Install_Qsl_Quilt_Standard_Librarie">Cài cả QSL (Quilt Standard Libraries; nhiều Quilt Mod phụ thuộc, khuyến nghị)</system:String>
  <system:String x:Key="Str_Ui_Right_Now_Your_Server_Is_Only_Reachable_">Hiện máy chủ chỉ truy cập được từ mạng LAN. Để bạn bè không cùng WiFi/mạng kết nối, hãy dùng một trong các cách bên dưới.</system:String>
  <system:String x:Key="Str_Ui_Note_Custom_Skins_Need_Customskinloader_">Lưu ý: để skin tùy chỉnh hiển thị đúng ở chế độ ngoại tuyến cần CustomSkinLoader; khi tải/khởi chạy game sẽ tự xử lý, không cần thao tác thủ công.</system:String>
  <system:String x:Key="Str_Ui_Type_A_Command_And_Press_Enter_E_G_Say_H">Nhập lệnh rồi nhấn Enter; ví dụ say hello / list / gamemode creative Steve</system:String>
  <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Instance_From_The_J">Chọn Java riêng cho phiên bản này từ danh sách Java trong “Cài đặt”; chọn “(Không chỉ định)” thì tự khớp theo số phiên bản chính bên dưới</system:String>
  <system:String x:Key="Str_Ui_When_On_The_Game_Launches_With_A_Tempora">Khi bật, game chỉ dùng tài khoản tạm thời tồn tại cho lần chạy này và không dùng tài khoản đã lưu; khi đóng sẽ dọn nhật ký/tệp tải tạm của phiên này</system:String>
  <system:String x:Key="Str_Ui_Switch_To_Dark_Mode_At_This_Hour_Each_Da">Mỗi ngày khi đến giờ này (0~23), tự động chuyển sang chế độ tối và duy trì đến giờ “Bắt đầu chế độ sáng” (xử lý đúng khi qua nửa đêm).</system:String>
  <system:String x:Key="Str_Ui_Note_The_Officially_Released_Versions_Ar">Lưu ý: các phiên bản ổn định chính thức chủ yếu là 8 / 11 / 17 / 21 / 25 / 26; các số khác có thể không có bản build chính thức.</system:String>
  <system:String x:Key="Str_Ui_E_G_Xx_Useg1gc_Dsomething_Quot_Value_Wit">Ví dụ: -XX:+UseG1GC -Dsomething="value with spaces"</system:String>
  <system:String x:Key="Str_Ui_Joining_A_Server_Automatically_Needs_Min">Tự động vào máy chủ yêu cầu Minecraft 1.20.6 trở lên; ở phiên bản cũ, chọn tùy chọn này không có hiệu lực và menu chính vẫn mở bình thường</system:String>
  <system:String x:Key="Str_Ui_About_The_Disk_Limit_Windows_Can_T_Enfor">Về giới hạn đĩa: Windows không thể áp quota cứng cho một thư mục; tùy chọn này chỉ theo dõi dung lượng và cảnh báo khi chạy, không cưỡng chế chặn ghi.</system:String>
  <system:String x:Key="Str_Ui_Offline_Accounts_Set_To_Use_A_Custom_Ski">Tài khoản ngoại tuyến chọn “skin tùy chỉnh” trong quản lý tài khoản sẽ hiển thị skin qua dịch vụ tại địa chỉ này. Mặc định dùng dịch vụ công cộng tích hợp; để trống sẽ về mặc định.</system:String>
  <system:String x:Key="Str_Ui_When_On_Xms_And_Xmx_Are_Recalculated_Fro">Khi bật, trước mỗi lần khởi chạy game, -Xms/-Xmx được tính lại theo bộ nhớ khả dụng của hệ thống và ghi đè giá trị cố định nhập thủ công trong cài đặt.</system:String>
  <system:String x:Key="Str_Ui_Install_Vanilla_Or_The_Fabric_Forge_Neof">Cài Vanilla hoặc loader client Fabric / Forge / NeoForge; hoàn tất sẽ tự xuất hiện trong danh sách “Phiên bản đã cài”.</system:String>
  <system:String x:Key="Str_Ui_A_Modpack_Overwrites_The_Mods_And_Config">Modpack sẽ ghi đè nội dung như mods/config trong thư mục cài; để tránh trộn với Mod hiện có, khuyến nghị cài vào thư mục phiên bản mới riêng.</system:String>
  <system:String x:Key="Str_Ui_Changes_The_Launcher_S_Colour_Family_Eac">Thay đổi tông màu launcher; mỗi họ màu có bản sáng và tối. Bản nào hiển thị do “Cài đặt chế độ” trên trang chủ hoặc tự động chuyển bên dưới quyết định.</system:String>
  <system:String x:Key="Str_Ui_Takes_You_From_Account_To_Launch_In_One_">Hoàn tất toàn bộ từ tài khoản đến khởi chạy để chơi; mỗi bước (Mod/gói tài nguyên/shader) đều có thể bỏ qua. Nhập modpack cũng có thể bỏ qua mọi lựa chọn sau đó.</system:String>
  <system:String x:Key="Str_Ui_2_Create_A_Tcp_Tunnel_And_Set_The_Local_">2. Tạo tunnel TCP mới; nhập cổng máy chủ làm cổng local (mặc định 25565; giá trị chính xác hiển thị trong địa chỉ kết nối trên thẻ “Danh sách máy chủ”).</system:String>
  <system:String x:Key="Str_Ui_1_Sign_In_To_Your_Router_S_Admin_Page_Us">1. Đăng nhập trang quản trị router (thường là 192.168.1.1 hoặc 192.168.0.1 trong trình duyệt; địa chỉ chính xác nằm trên nhãn router).</system:String>
  <system:String x:Key="Str_Ui_Resource_Packs_Shader_Packs_Data_Packs_W">Gói tài nguyên, shader, dữ liệu, world và modpack đều ở dạng .zip; không xác định được loại từ nội dung. Chọn sai sẽ cài vào thư mục sai nên launcher cần hỏi.</system:String>
  <system:String x:Key="Str_Ui_Bedrock_Dedicated_Server_Is_Published_Fr">Bedrock Dedicated Server được Mojang phát hành miễn phí trên trang chính thức; không cần tài khoản hay giấy phép và có thể tải trực tiếp.</system:String>
  <system:String x:Key="Str_Ui_Switches_Between_Light_And_Dark_Automati">Khi bật, chế độ sáng/tối tự chuyển theo giờ hệ thống (mặc định 08:00-19:00 sáng, còn lại tối); có thể đổi giờ trong “Cài đặt”.</system:String>
  <system:String x:Key="Str_Ui_In_Game_Watermark_Text_Shown_In_The_Bott">Văn bản watermark trong game (hiển thị góc trái dưới, ví dụ “XCL2”; để trống sẽ hiển thị chữ “release” chính thức)</system:String>
  <system:String x:Key="Str_Ui_Turning_This_Off_Restores_The_Old_Behavi">Khi tắt, quay về hành vi cũ: chỉ giải nén nội dung modpack vào instance hiện có đã chọn và ghi đè, không tải game/loader; nếu phiên bản không khớp game có thể crash ngay.</system:String>
  <system:String x:Key="Str_Ui_Installing_The_Fabric_Client_Doesn_T_Run">Cài client Fabric không cần chạy installer cục bộ; có thể cài không có đường dẫn Java. Java cần để khởi chạy phiên bản vẫn sẽ tự khớp/tải.</system:String>
  <system:String x:Key="Str_Ui_Keep_Resource_Data_And_Shader_Packs_Sepa">Giữ riêng gói tài nguyên/dữ liệu/shader theo phiên bản (mặc định bật; tắt = dùng chung một bản cho mọi phiên bản; có thể ghi đè từng phiên bản trong “Chọn phiên bản”)</system:String>
  <system:String x:Key="Str_Ui_Already_Have_A_Minecraft_Folder_From_The">Nếu đã có thư mục .minecraft (ví dụ từ launcher chính thức/khác), chọn trực tiếp; sẽ bỏ qua tải xuống và tự khớp Java để khởi chạy.</system:String>
  <system:String x:Key="Str_Ui_Keep_Mods_Resource_Packs_Data_Packs_And_">Mặc định tách mods / gói tài nguyên / gói dữ liệu / world theo phiên bản (khuyến nghị, giống launcher chính thức; có thể ghi đè từng phiên bản trong “Chọn phiên bản”)</system:String>
  <system:String x:Key="Str_Ui_Colour_Themes_Blue_Yellow_Purple_Pink_An">Chủ đề màu giao diện (xanh dương, vàng, tím, hồng, v.v.) giờ là tính năng chính thức, không phải thử nghiệm; có thể dùng an toàn trong trang “Cài đặt”.</system:String>
  <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Server_From_The_Lis">Chọn Java cho máy chủ này từ danh sách đã lưu trong “Cài đặt”; nếu chọn “(Không chỉ định, tự động phát hiện/tải)”, dùng ô đường dẫn bên dưới và tự khớp/tải khi cần</system:String>
  <system:String x:Key="Str_Ui_Normal_Mode_Shows_Only_The_Essentials_An">Chế độ thường: chỉ hiện tùy chọn cần thiết và tự phát hiện/tải Java; Chế độ chuyên gia: có thể cấu hình phiên bản/kiến trúc/loại cài Java, tham số tùy chỉnh, v.v.</system:String>
  <system:String x:Key="Str_Ui_Sign_In_With_A_Third_Party_Auth_Server_A">Đăng nhập bằng tài khoản máy chủ xác thực bên thứ ba (Unified Pass/blessing-skin, v.v., cần giao thức Yggdrasil); sau đó tự dùng skin trên máy chủ đó.</system:String>
  <system:String x:Key="Str_Ui_Quickly_Checks_The_Usual_Places_For_Inst">Nhanh chóng tìm Java đã cài ở các vị trí phổ biến (thư mục portable/JAVA_HOME/registry/PATH) và thêm hàng loạt vào danh sách; không quét toàn ổ đĩa, hoàn tất trong vài giây</system:String>
  <system:String x:Key="Str_Ui_Switches_Between_Dark_And_Light_It_Only_">Chuyển chế độ tối/sáng; chỉ ảnh hưởng độ sáng, không đổi tông “Chủ đề màu”. Nếu bật “Tự động chuyển”, lựa chọn thủ công chỉ tạm thời đến lần chuyển tự động tiếp theo.</system:String>
  <system:String x:Key="Str_Ui_This_Feature_Is_Locked_By_Default_And_Ne">Tính năng này mặc định bị khóa; cần token đúng để tiếp tục (không phân biệt hoa thường). Nếu không có token thì tính năng này hiện chưa dành cho bạn; hãy dùng các tính năng ổn định.</system:String>
  <system:String x:Key="Str_Ui_Once_Several_Java_Runtimes_Are_Registere">Khi lưu nhiều runtime Java, có thể chọn Java riêng từ danh sách cho từng phiên bản client và từng instance máy chủ.</system:String>
  <system:String x:Key="Str_Ui_Separate_Arguments_With_Spaces_And_Wrap_">Phân cách nhiều tham số bằng dấu cách; giá trị có dấu cách đặt trong dấu ngoặc kép. Tham số được thêm sau tham số tích hợp và trước classpath; khi xung đột, giá trị của bạn được ưu tiên. Để trống thì không áp dụng.</system:String>
  <system:String x:Key="Str_Ui_A_Loader_Forked_From_Fabric_It_Runs_Most">Loader tách từ Fabric; tương thích với phần lớn Fabric Mod và cung cấp thêm tính năng phát triển Mod. Giống Fabric, không cần Java cục bộ.</system:String>
  <system:String x:Key="Str_Ui_Enables_The_Auto_Cycle_Button_On_The_Mai">Khi bật, nút “Tự động chuyển” trên trang chủ hoạt động và chuyển sáng/tối theo các giờ bên dưới. Có thể chuyển thủ công nhưng tại mốc giờ tiếp theo tự động sẽ tiếp quản lại.</system:String>
  <system:String x:Key="Str_Ui_Blank_Means_Auto_Match_The_Version_S_Own">Trống = tự động khớp (lấy yêu cầu Java cao hơn giữa phiên bản và Mod đã cài); số (ví dụ 25) = luôn buộc phiên bản này dùng major Java đó</system:String>
  <system:String x:Key="Str_Ui_Search_By_Keyword_In_English_Or_Chinese_">Tìm bằng từ khóa tiếng Anh hoặc Trung, ví dụ “JEI” hoặc “钠” (tự dịch để tìm Sodium); để trống hiển thị Mod phổ biến, nhập sẽ tự tìm</system:String>
  <system:String x:Key="Str_Ui_Note_The_Bedrock_Client_Is_Distributed_T">Lưu ý: client Bedrock Edition được phân phối qua Microsoft Store và gắn với giấy phép tài khoản Microsoft; không có địa chỉ tải công khai. Launcher chỉ có thể mở bản đã cài, không thể tải hoặc đổi phiên bản.</system:String>
  <system:String x:Key="Str_Ui_Supports_Mcworld_Worlds_Mcpack_Resource_">Hỗ trợ .mcworld (world), .mcpack (gói tài nguyên/hành vi), .mcaddon (gói add-on), .mctemplate (template world). Các tệp này cũng có thể kéo vào cửa sổ launcher.</system:String>
  <system:String x:Key="Str_Ui_3_The_Tunnelling_Tool_Gives_You_A_Public">3. Công cụ tunnel sẽ cung cấp địa chỉ công khai như xxx.xxx.com:12345; gửi cho bạn bè và bảo họ vào Minecraft “Chơi nhiều người - Thêm máy chủ”.</system:String>
  <system:String x:Key="Str_Ui_Removes_Temporary_Files_From_This_Minecr">Dọn các tệp tạm có thể xóa an toàn trong thư mục .minecraft hiện tại như archive nhật ký cũ, báo cáo crash cũ, web cache, output debug Mixin, dump crash JVM; không ảnh hưởng world/Mod/tài nguyên/cài đặt.</system:String>
  <system:String x:Key="Str_Ui_Security_Note_Whichever_Method_You_Use_T">Lưu ý bảo mật: dù mở máy chủ ra Internet bằng cách nào, khuyến nghị bật xác thực trực tuyến trong “Cài đặt máy chủ” để ngăn người lạ; nếu chỉ chơi với bạn bè có thể dùng whitelist.</system:String>
  <system:String x:Key="Str_Ui_Experimental_Features_May_Also_Include_J">Tính năng thử nghiệm có thể gồm nội dung vui, tính năng dở dang đang phát triển hoặc nội dung chưa được xác minh đầy đủ. Chưa quyết định có trở thành tính năng chính thức hay không nên có thể bị xóa hoặc thay đổi lớn.</system:String>
  <system:String x:Key="Str_Ui_Experimental_Features_Currently_Include_">Tính năng thử nghiệm hiện có các chức năng nâng cao cấp thấp như cài chung nhiều loader vào cùng phiên bản (hơn một trong Fabric/Forge/NeoForge); dùng sai có thể làm hỏng phiên bản và phải tải lại.</system:String>
  <system:String x:Key="Str_Ui_When_On_The_Launch_Button_Always_Uses_A_">Khi bật, “Khởi chạy game” trên trang chủ luôn dùng tài khoản ngoại tuyến tạm thời chỉ cho lần chạy đó, không đọc/ghi tài khoản thật đã lưu; khi đóng sẽ dọn nhật ký game/tệp tải tạm của lần chạy, không ảnh hưởng game/Mod/world đã cài.</system:String>
  <system:String x:Key="Str_Ui_Drag_Mods_Resource_Packs_Shaders_Worlds_">Kéo trực tiếp tệp Mod / gói tài nguyên / shader / world / modpack vào cửa sổ launcher để cài. Vì tất cả có thể là .zip, launcher sẽ kiểm tra nội dung; nếu không xác định được loại sẽ làm theo cài đặt bên dưới.</system:String>
  <system:String x:Key="Str_Ui_3_Friends_Connect_Using_Your_Public_Ip_A">3. Bạn bè có thể kết nối bằng IP công cộng + cổng. Nếu IP công cộng thay đổi (phổ biến ở mạng gia đình), hãy dùng DDNS để tên miền tự động trỏ tới IP hiện tại.</system:String>
  <system:String x:Key="Str_Ui_The_Toolbox_Advancement_Images_Skin_Avat">“Công cụ” (...) là tính năng chính thức, không phải thử nghiệm. Bao gồm tạo ảnh thành tựu, avatar skin, tải tùy chỉnh, skin người chơi premium, dọn dẹp, lối tắt, số lần khởi chạy, tải Jar loader và tối ưu bộ nhớ; luôn có trong “Công cụ”.</system:String>
  <system:String x:Key="Str_Ui_2_Find_Port_Forwarding_Port_Mapping_Or_V">2. Tìm chuyển tiếp cổng / ánh xạ cổng / virtual server; đặt cổng ngoài và trong là cổng máy chủ (mặc định 25565), IP nội bộ là IP LAN của PC này.</system:String>
