  <system:String x:Key="Str_Ui_The_Log_Panel_Is_Hidden_Tick_The_Box_Abo">Панель журналу зараз прихована. Позначте поле вище, щоб переглядати журнал гри, журнал лаунчера, аналіз аварій і сканування ін’єкцій.</system:String>
  <system:String x:Key="Str_Ui_The_Mods_Below_Are_Missing_Required_Depe">Наведеним нижче Mod бракує потрібних залежностей; прямий запуск, найімовірніше, спричинить аварію або зависання на екрані завантаження.</system:String>
  <system:String x:Key="Str_Ui_How_To_Let_Friends_Connect_From_Outside_">Щоб друзі могли підключатися до сервера через Інтернет: NAT-тунелювання / переадресація портів маршрутизатора / ретрансляція через хмарний сервер</system:String>
  <system:String x:Key="Str_Ui_Server_Address_E_G_Play_Example_Com_Or_1">Адреса сервера, напр. play.example.com або 1.2.3.4:25565</system:String>
