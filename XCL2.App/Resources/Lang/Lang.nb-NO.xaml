  <system:String x:Key="Str_Ui_The_Log_Panel_Is_Hidden_Tick_The_Box_Abo">Loggpanelet er skjult akkurat nå. Merk av boksen ovenfor for å se spillogg, launcherlogg, crashanalyse og injection-skanning.</system:String>
  <system:String x:Key="Str_Ui_The_Mods_Below_Are_Missing_Required_Depe">Modene nedenfor mangler nødvendige avhengigheter for å fungere; direkte oppstart vil svært sannsynlig crashe eller henge på lasteskjermen.</system:String>
  <system:String x:Key="Str_Ui_How_To_Let_Friends_Connect_From_Outside_">Slik lar du venner koble til serveren via Internett: NAT traversal / port forwarding på ruteren / videresending via cloudserver</system:String>
  <system:String x:Key="Str_Ui_Server_Address_E_G_Play_Example_Com_Or_1">Serveradresse, for eksempel play.example.com eller 1.2.3.4:25565</system:String>
  <system:String x:Key="Str_Ui_Experimental_Features_Are_Still_Being_Wo">Eksperimentelle funksjoner er fortsatt under utvikling; etter aktivering kan det oppstå visningsfeil i grensesnittet, innstillingskonflikter,</system:String>
  <system:String x:Key="Str_Ui_Supports_Minecraft_Colour_And_Formatting">Støtter Minecraft-farge- og formateringskoder; for eksempel er §a grønn tekst og §l fet.</system:String>
  <system:String x:Key="Str_Ui_Nothing_Saved_Yet_Try_The_Button_In_The_">Ingen favoritter ennå; klikk ☆ Favoritt i kategoriene “Spillversjoner” / “Mod” / “Ressurspakker”.</system:String>
  <system:String x:Key="Str_Ui_New_Here_Or_Setting_Up_A_Fresh_Version_O">Er du ny, eller vil du installere en ny versjon / Mod? Veiviseren hjelper deg trinn for trinn med å velge konto, versjon og Mod.</system:String>
  <system:String x:Key="Str_Ui_Edit_The_Common_Server_Properties_Entrie">Rediger vanlige server.properties-felt grafisk, som motd, maksimalt antall spillere og online-modus</system:String>
  <system:String x:Key="Str_Ui_You_Can_Hide_Pages_You_Don_T_Need_Or_Swi">Du kan skjule sider du ikke trenger eller slå av bestemte funksjoner. Trykk F12 på hvilken som helst skjerm for midlertidig å vise skjulte funksjoner.</system:String>
  <system:String x:Key="Str_Ui_Turn_On_Version_Isolation_For_This_Insta">Aktiver “versjonsisolering” bare for denne versjonen (mods/ressurser/worlds holdes atskilt, som i den offisielle launcheren)</system:String>
  <system:String x:Key="Str_Ui_Switch_To_Light_Mode_At_This_Hour_Each_D">Bytt automatisk til lys modus hver dag på dette klokkeslettet (0~23), og behold den til tidspunktet “Start mørk modus”.</system:String>
  <system:String x:Key="Str_Ui_The_Embedded_Sign_In_Component_Failed_To">Den innebygde innloggingskomponenten kunne ikke starte (WebView2 Runtime er kanskje ikke installert). Bruk knappen “Logg inn i nettleser”.</system:String>
  <system:String x:Key="Str_Ui_The_Server_S_World_Folder_Name_World_By_">Navnet på serverens world-mappe, standard world; hvis servereieren har endret level-name, skriv inn det tilsvarende navnet</system:String>
  <system:String x:Key="Str_Ui_When_Ticked_Search_Results_Include_Beta_">Når avmerket, inkluderer søkeresultatene beta-/alpha-versjoner som ennå ikke er offisielt utgitt. Som standard vises bare stabile versjoner.</system:String>
  <system:String x:Key="Str_Ui_The_Oldest_Loader_With_The_Largest_Ecosy">Den eldste loaderen med det største økosystemet; mange store teknologi-/magi-modpacks er avhengige av den. Lokal Java kreves for å kjøre installer.</system:String>
  <system:String x:Key="Str_Ui_These_Options_Are_Still_Being_Polished_A">Alternativene her er fortsatt under utvikling og kan være ustabile. Endring av fargetema påvirker ikke spill/world/Mod; du kan alltid gå tilbake til standard.</system:String>
  <system:String x:Key="Str_Ui_Builds_A_Separate_Instance_From_Scratch_">Oppretter en separat instance fra bunnen: laster ned spillet og riktig loader og installerer deretter modpack-innholdet. Eksisterende instances berøres ikke.</system:String>
  <system:String x:Key="Str_Ui_A_Newer_Loader_Forked_From_Forge_The_Mod">En nyere loader som er forked fra Forge; Mod-økosystemet for nye versjoner flytter gradvis hit. Krever lokal Java.</system:String>
  <system:String x:Key="Str_Ui_However_Many_You_Tick_Is_However_Many_Ge">Det installeres like mange loadere som du velger; det faktiske antallet styres av “antall valgte loadere” nedenfor, og denne teksten viser bare verdien.</system:String>
  <system:String x:Key="Str_Ui_Only_Affects_Offline_Accounts_Set_To_Use">Påvirker bare offline-kontoer med “egendefinert skin”; standard Steve/Alex-skins og skins fra Microsoft-kontoer påvirkes ikke.</system:String>
  <system:String x:Key="Str_Ui_Guest_Mode_Launches_With_A_Temporary_Acc">Gjestemodus (bare denne økten; starter spillet med en midlertidig konto og bruker ikke lagrede kontoer; etter omstart av launcheren går den tilbake til normal modus)</system:String>
  <system:String x:Key="Str_Ui_Download_Any_Direct_Link_Note_That_Some_">Last ned hvilken som helst fil med en direkte lenke. Enkelte nettsteder (f.eks. Baidu Netdisk) kan blokkere og returnere feil 403, slik at vanlig nedlasting ikke fungerer.</system:String>
  <system:String x:Key="Str_Ui_Get_A_Key_From_Console_Curseforge_Com_Th">Hent en key på console.curseforge.com, lim den deretter inn på siden “Innstillinger” og lagre.</system:String>
  <system:String x:Key="Str_Ui_Opens_The_Copy_Of_Minecraft_For_Windows_">Åpner installert Minecraft for Windows (Bedrock Edition); starter bare, laster ikke ned/administrerer versjoner</system:String>
  <system:String x:Key="Str_Ui_Smart_Throttling_Watches_What_Other_Prog">Smart hastighetsbegrensning (registrerer automatisk nettverksbruk fra andre programmer for å unngå å bruke all båndbredde; kan brukes sammen med grensen ovenfor, og den strengeste verdien gjelder)</system:String>
  <system:String x:Key="Str_Ui_Only_Applies_When_No_Specific_Java_Is_Ch">Gjelder bare når ingen bestemt Java er valgt ovenfor: tomt = automatisk match (anbefalt); tall (f.eks. 25) = tving denne hovedversjonen</system:String>
  <system:String x:Key="Str_Ui_Auth_Server_Api_Root_E_G_Https_Example_C">API-rotadresse for autentiseringsserveren, for eksempel https://example.com/api/yggdrasil</system:String>
  <system:String x:Key="Str_Ui_Show_Mod_Icons_In_Search_Results_Fetched">Vis Mod-ikoner i søkeresultater i Nedlastingssenter (hentes fra Modrinth/CurseForge, aktivert som standard)</system:String>
  <system:String x:Key="Str_Ui_Note_Java_8_Defaults_To_32_Bit_And_Every">Merk: Java 8 er som standard 32-bit, mens andre versjoner er 64-bit. Hvis du er usikker, bruk anbefalt innstilling.</system:String>
  <system:String x:Key="Str_Ui_Default_Light_Mode_From_08_00_To_19_00_A">Standard: 08:00-19:00 lys modus, ellers mørk modus. Klikk “Lagre innstillinger” for å bruke.</system:String>
  <system:String x:Key="Str_Ui_Double_Click_An_Account_To_Launch_Straig">Dobbeltklikk på en konto for å starte direkte; eller velg den og trykk “Start med denne kontoen” nedenfor. Hvis ønsket konto mangler, kan du legge den til nedenfor.</system:String>
  <system:String x:Key="Str_Ui_A_Beginner_S_Wizard_That_Takes_You_From_">Nybegynnerveiviser fra konto til oppstart: velg versjon/loader, legg eventuelt til Mod og ressurspakker/shadere, og last deretter ned og start automatisk</system:String>
  <system:String x:Key="Str_Ui_A_Development_Stage_Idea_Install_The_Sam">Bare en funksjon under utvikling/idé — installerer hver valgt loader separat for samme Minecraft-versjon i samme instance.</system:String>
  <system:String x:Key="Str_Ui_Optional_If_A_Newer_Official_Build_Is_Ou">Valgfritt: hvis en nyere offisiell versjon er utgitt, men den medfølgende ennå ikke er oppdatert, kan du midlertidig velge en nedlastet exe-fil for å overskrive den medfølgende</system:String>
  <system:String x:Key="Str_Ui_Guest_Mode_Only_Affects_Temporary_Accoun">Gjestemodus påvirker bare midlertidige kontoer og opprydding av økten; den endrer ikke fargen på grensesnittet. Fargen følger alltid gjeldende “Fargetema” + valget “Modusinnstillinger”.</system:String>
  <system:String x:Key="Str_Ui_Contains_Features_Still_In_Development_O">Inneholder funksjoner/ideer under utvikling; kan være ustabilt og anbefales ikke for vanlige brukere. Første gang må advarselen leses i 10 sekunder.</system:String>
  <system:String x:Key="Str_Ui_Pick_One_From_The_Java_List_Above_As_The">Velg global standard-Java fra listen ovenfor; “(Ikke angitt, oppdag automatisk)” beholder gjeldende logikk for automatisk oppdagelse/nedlasting</system:String>
  <system:String x:Key="Str_Ui_Also_Install_Qsl_Quilt_Standard_Librarie">Installer også QSL (Quilt Standard Libraries; kreves av mange Quilt Mods, anbefalt)</system:String>
  <system:String x:Key="Str_Ui_Right_Now_Your_Server_Is_Only_Reachable_">Akkurat nå er serveren bare tilgjengelig fra LAN. For at venner utenfor samme WiFi/nettverk skal kunne koble til, bruk en av metodene nedenfor.</system:String>
  <system:String x:Key="Str_Ui_Note_Custom_Skins_Need_Customskinloader_">Merk: riktig visning av egendefinerte skins i offline-modus krever CustomSkinLoader; dette håndteres automatisk ved nedlasting/start av spillet, ingen manuell handling kreves.</system:String>
  <system:String x:Key="Str_Ui_Type_A_Command_And_Press_Enter_E_G_Say_H">Skriv inn en kommando og trykk Enter; for eksempel say hello / list / gamemode creative Steve</system:String>
  <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Instance_From_The_J">Velg en egen Java for denne versjonen fra Java-listen i “Innstillinger”; velg “(Ikke angitt)” for automatisk match basert på hovedversjonsnummeret nedenfor</system:String>
  <system:String x:Key="Str_Ui_When_On_The_Game_Launches_With_A_Tempora">Når aktivert bruker spillet bare en midlertidig konto som finnes for denne kjøringen, og ingen lagret konto; ved avslutning ryddes øktlogger/midlertidige nedlastingsfiler</system:String>
  <system:String x:Key="Str_Ui_Switch_To_Dark_Mode_At_This_Hour_Each_Da">Bytt automatisk til mørk modus hver dag på dette klokkeslettet (0~23), og behold den til tidspunktet “Start lys modus” (håndterer midnatt riktig).</system:String>
  <system:String x:Key="Str_Ui_Note_The_Officially_Released_Versions_Ar">Merk: de offisielle stabile hovedversjonene er hovedsakelig 8 / 11 / 17 / 21 / 25 / 26; andre numre har kanskje ingen offisielle builds.</system:String>
  <system:String x:Key="Str_Ui_E_G_Xx_Useg1gc_Dsomething_Quot_Value_Wit">For eksempel: -XX:+UseG1GC -Dsomething=&quot;value with spaces&quot;</system:String>
  <system:String x:Key="Str_Ui_Joining_A_Server_Automatically_Needs_Min">Automatisk tilkobling til en server krever Minecraft 1.20.6 eller nyere; i eldre versjoner har dette valget ingen effekt, og hovedmenyen åpnes normalt</system:String>
  <system:String x:Key="Str_Ui_About_The_Disk_Limit_Windows_Can_T_Enfor">Om diskgrensen: Windows kan ikke håndheve en hard kvote på én mappe; dette valget overvåker bare bruken og varsler under kjøring, men blokkerer ikke skriving.</system:String>
  <system:String x:Key="Str_Ui_Offline_Accounts_Set_To_Use_A_Custom_Ski">Offline-kontoer med “egendefinert skin” i kontoadministrasjon viser skin via tjenesten på denne adressen. Som standard brukes den innebygde offentlige tjenesten; tomt felt gjenoppretter standard.</system:String>
  <system:String x:Key="Str_Ui_When_On_Xms_And_Xmx_Are_Recalculated_Fro">Når aktivert beregnes -Xms/-Xmx på nytt før hver spillstart ut fra tilgjengelig systemminne og overskriver faste verdier som er lagt inn manuelt i innstillingene.</system:String>
  <system:String x:Key="Str_Ui_Install_Vanilla_Or_The_Fabric_Forge_Neof">Installer Vanilla eller client-loader Fabric / Forge / NeoForge; når det er ferdig, vises den automatisk i listen “Installerte versjoner”.</system:String>
  <system:String x:Key="Str_Ui_A_Modpack_Overwrites_The_Mods_And_Config">Et modpack overskriver innhold som mods/config i installasjonsmappen; for å unngå blanding med eksisterende Mods anbefales installasjon i en separat ny versjonsmappe.</system:String>
  <system:String x:Key="Str_Ui_Changes_The_Launcher_S_Colour_Family_Eac">Endrer launcherens fargefamilie; hver fargefamilie har en lys og mørk variant. Hvilken som vises bestemmes av “Modusinnstillinger” på startsiden eller automatisk bytte nedenfor.</system:String>
  <system:String x:Key="Str_Ui_Takes_You_From_Account_To_Launch_In_One_">Fullfører alt fra konto til oppstart og spilling; hvert trinn (Mod/ressurspakke/shader) kan hoppes over. Ved import av modpack kan alle etterfølgende valg også hoppes over.</system:String>
  <system:String x:Key="Str_Ui_2_Create_A_Tcp_Tunnel_And_Set_The_Local_">2. Opprett en ny TCP-tunnel; skriv inn serverporten som lokal port (standard 25565; nøyaktig verdi vises i tilkoblingsadressen på kortet “Serverliste”).</system:String>
  <system:String x:Key="Str_Ui_1_Sign_In_To_Your_Router_S_Admin_Page_Us">1. Logg inn på ruterens administrasjonsside (vanligvis 192.168.1.1 eller 192.168.0.1 i nettleseren; nøyaktig adresse står på ruterens etikett).</system:String>
  <system:String x:Key="Str_Ui_Resource_Packs_Shader_Packs_Data_Packs_W">Ressurspakker, shadere, datapakker, worlds og modpacks er alle .zip; typen kan ikke alltid bestemmes fra innholdet. Feil valg installerer i feil mappe, derfor må launcheren spørre.</system:String>
  <system:String x:Key="Str_Ui_Bedrock_Dedicated_Server_Is_Published_Fr">Bedrock Dedicated Server publiseres gratis av Mojang på den offisielle nettsiden; konto eller lisens er ikke nødvendig, og den kan lastes ned direkte.</system:String>
  <system:String x:Key="Str_Ui_Switches_Between_Light_And_Dark_Automati">Når aktivert bytter lys/mørk modus automatisk etter systemtid (standard 08:00-19:00 lys, ellers mørk); tidene kan endres i “Innstillinger”.</system:String>
  <system:String x:Key="Str_Ui_In_Game_Watermark_Text_Shown_In_The_Bott">Watermark-tekst i spillet (vises nederst til venstre, f.eks. “XCL2”; tomt felt viser den offisielle teksten “release”)</system:String>
  <system:String x:Key="Str_Ui_Turning_This_Off_Restores_The_Old_Behavi">Når deaktivert brukes gammel oppførsel: bare pakk ut modpack-innholdet i valgt eksisterende instance og overskriv, uten å laste ned spill/loader; hvis spillversjonen ikke matcher, kan spillet crashe umiddelbart.</system:String>
  <system:String x:Key="Str_Ui_Installing_The_Fabric_Client_Doesn_T_Run">Installasjon av Fabric-client krever ikke lokal kjøring av installer; den kan installeres uten Java-sti. Java som trengs for å starte versjonen matches/lastes fortsatt ned automatisk.</system:String>
  <system:String x:Key="Str_Ui_Keep_Resource_Data_And_Shader_Packs_Sepa">Hold ressurs-/data-/shaderpakker atskilt per versjon (standard aktivert; deaktivert = ett felles sett for alle versjoner; kan overstyres per versjon i “Velg versjon”)</system:String>
  <system:String x:Key="Str_Ui_Already_Have_A_Minecraft_Folder_From_The">Hvis du allerede har en .minecraft-mappe (f.eks. fra offisiell/annen launcher), velg den direkte; nedlasting hoppes over og Java matches automatisk for oppstart.</system:String>
  <system:String x:Key="Str_Ui_Keep_Mods_Resource_Packs_Data_Packs_And_">Som standard skilles mods / ressurspakker / datapakker / worlds etter versjon (anbefalt, som den offisielle launcheren; kan overstyres per versjon i “Velg versjon”)</system:String>
  <system:String x:Key="Str_Ui_Colour_Themes_Blue_Yellow_Purple_Pink_An">Fargetemaer i grensesnittet (blå, gul, lilla, rosa osv.) er nå en offisiell funksjon, ikke eksperimentell; de kan brukes trygt på siden “Innstillinger”.</system:String>
  <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Server_From_The_Lis">Velg Java for denne serveren fra den lagrede listen i “Innstillinger”; hvis “(Ikke angitt, oppdag/last ned automatisk)” velges, brukes stifeltet nedenfor og Java matches/lastes ned automatisk ved behov</system:String>
  <system:String x:Key="Str_Ui_Normal_Mode_Shows_Only_The_Essentials_An">Normal modus: viser bare nødvendige valg og oppdager/laster ned Java automatisk; Ekspertmodus: Java-versjon/arkitektur/installasjonstype, egendefinerte parametere osv. kan konfigureres.</system:String>
  <system:String x:Key="Str_Ui_Sign_In_With_A_Third_Party_Auth_Server_A">Logg inn med en konto fra en tredjeparts autentiseringsserver (Unified Pass/blessing-skin osv., krever Yggdrasil-protokoll); deretter brukes skin fra den serveren automatisk.</system:String>
  <system:String x:Key="Str_Ui_Quickly_Checks_The_Usual_Places_For_Inst">Finn raskt installert Java på vanlige steder (portable-mappe/JAVA_HOME/registry/PATH) og legg dem til i listen i bulk; skanner ikke hele disken og er ferdig på noen sekunder</system:String>
  <system:String x:Key="Str_Ui_Switches_Between_Dark_And_Light_It_Only_">Bytt mellom mørk/lys modus; påvirker bare lysstyrken, ikke nyansen i “Fargetema”. Hvis “Automatisk bytte” er aktivert, gjelder manuelt valg bare til neste automatiske bytte.</system:String>
  <system:String x:Key="Str_Ui_This_Feature_Is_Locked_By_Default_And_Ne">Denne funksjonen er låst som standard; riktig token kreves for å fortsette (ikke skille mellom store/små bokstaver). Uten token er funksjonen ikke for deg ennå; bruk de stabile funksjonene.</system:String>
  <system:String x:Key="Str_Ui_Once_Several_Java_Runtimes_Are_Registere">Når flere Java-runtimes er lagret, kan det velges en egen Java fra listen for hver client-versjon og hver serverinstance.</system:String>
  <system:String x:Key="Str_Ui_Separate_Arguments_With_Spaces_And_Wrap_">Skill flere parametere med mellomrom; verdier med mellomrom settes i doble anførselstegn. Parametere legges til etter innebygde parametere og før classpath; ved konflikt prioriteres dine verdier. Tomt = ikke bruk.</system:String>
  <system:String x:Key="Str_Ui_A_Loader_Forked_From_Fabric_It_Runs_Most">Loader forked fra Fabric; kompatibel med de fleste Fabric Mods og gir ekstra funksjoner for Mod-utvikling. Som Fabric kreves ingen lokal Java.</system:String>
  <system:String x:Key="Str_Ui_Enables_The_Auto_Cycle_Button_On_The_Mai">Når aktivert fungerer knappen “Automatisk bytte” på startsiden og bytter lys/mørk etter tidene nedenfor. Du kan bytte manuelt, men ved neste tidspunkt tar automatikken over igjen.</system:String>
  <system:String x:Key="Str_Ui_Blank_Means_Auto_Match_The_Version_S_Own">Tomt = automatisk match (bruker det høyeste Java-kravet mellom versjonen og installerte Mods); tall (f.eks. 25) = tving alltid denne versjonen til å bruke denne Java-hovedversjonen</system:String>
  <system:String x:Key="Str_Ui_Search_By_Keyword_In_English_Or_Chinese_">Søk med engelske eller kinesiske nøkkelord, f.eks. “JEI” eller “钠” (oversettes automatisk for å søke Sodium); tomt viser populære Mods, skriving starter søk automatisk</system:String>
  <system:String x:Key="Str_Ui_Note_The_Bedrock_Client_Is_Distributed_T">Merk: Bedrock Edition-client distribueres via Microsoft Store og er knyttet til en Microsoft-kontolisens; det finnes ingen offentlig nedlastingsadresse. Launcheren kan bare åpne installert versjon, ikke laste ned eller bytte versjon.</system:String>
  <system:String x:Key="Str_Ui_Supports_Mcworld_Worlds_Mcpack_Resource_">Støtter .mcworld (world), .mcpack (ressurs-/adferdspakke), .mcaddon (add-on-pakke), .mctemplate (world-mal). Disse filene kan også dras inn i launchervinduet.</system:String>
  <system:String x:Key="Str_Ui_3_The_Tunnelling_Tool_Gives_You_A_Public">3. Tunnelverktøyet gir en offentlig adresse som xxx.xxx.com:12345; send den til venner og be dem gå til Minecraft “Flerspiller - Legg til server”.</system:String>
  <system:String x:Key="Str_Ui_Removes_Temporary_Files_From_This_Minecr">Rydder midlertidige filer som trygt kan slettes i gjeldende .minecraft-mappe, som gamle loggarkiver, gamle crashrapporter, webcache, Mixin-debugoutput og JVM-crashdumps; påvirker ikke worlds/Mods/ressurser/innstillinger.</system:String>
  <system:String x:Key="Str_Ui_Security_Note_Whichever_Method_You_Use_T">Sikkerhetsmerknad: uansett hvordan serveren åpnes mot Internett, anbefales det å aktivere online-autentisering i “Serverinnstillinger” for å holde fremmede ute; hvis du bare spiller med venner, kan whitelist brukes.</system:String>
  <system:String x:Key="Str_Ui_Experimental_Features_May_Also_Include_J">Eksperimentelle funksjoner kan inneholde morsomt innhold, uferdige funksjoner under utvikling eller innhold som ikke er fullt verifisert. Det er ikke bestemt om de blir offisielle, så de kan fjernes eller endres mye.</system:String>
  <system:String x:Key="Str_Ui_Experimental_Features_Currently_Include_">Eksperimentelle funksjoner inkluderer nå avanserte low-level-funksjoner som installasjon av flere loadere i samme versjon (mer enn én av Fabric/Forge/NeoForge); feil bruk kan ødelegge versjonen og kreve ny nedlasting.</system:String>
  <system:String x:Key="Str_Ui_When_On_The_Launch_Button_Always_Uses_A_">Når aktivert bruker “Start spill” på startsiden alltid en midlertidig offline-konto bare for den kjøringen og leser/skriver ikke ekte lagrede kontoer; ved avslutning ryddes spilllogger/midlertidige nedlastinger fra kjøringen uten å påvirke installert spill/Mods/worlds.</system:String>
  <system:String x:Key="Str_Ui_Drag_Mods_Resource_Packs_Shaders_Worlds_">Dra en Mod / ressurspakke / shader / world / modpack direkte inn i launchervinduet for å installere. Siden alt kan være .zip, undersøker launcheren innholdet; hvis typen ikke kan identifiseres, følger den innstillingen nedenfor.</system:String>
  <system:String x:Key="Str_Ui_3_Friends_Connect_Using_Your_Public_Ip_A">3. Venner kan koble til med offentlig IP + port. Hvis den offentlige IP-en endres (vanlig i hjemmenettverk), bruk DDNS slik at et domenenavn automatisk peker til gjeldende IP.</system:String>
  <system:String x:Key="Str_Ui_The_Toolbox_Advancement_Images_Skin_Avat">“Verktøy” (...) er en offisiell funksjon, ikke eksperimentell. Inneholder generering av achievement-bilder, skin-avatar, egendefinert nedlasting, premium-spillerskin, opprydding, snarveier, startteller, Jar-loadernedlasting og minneoptimalisering; alltid tilgjengelig under “Verktøy”.</system:String>
  <system:String x:Key="Str_Ui_2_Find_Port_Forwarding_Port_Mapping_Or_V">2. Finn port forwarding / port mapping / virtual server; sett ekstern og intern port til serverporten (standard 25565), og intern IP til LAN-IP-en til denne PC-en.</system:String>
  <system:String x:Key="Str_Ui_A_Tunnelling_Tool_Gives_You_A_Temporary_">Et NAT traversal-verktøy gir en midlertidig offentlig adresse og videresender trafikk til serveren; krever ikke ruterinnlogging eller offentlig IP, men gratisplaner kan ha begrensninger og være mindre stabile over tid.</system:String>
