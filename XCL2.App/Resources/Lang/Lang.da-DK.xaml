  <system:String x:Key="Str_Ui_Supports_Minecraft_Colour_And_Formatting">Understøtter Minecraft-farve- og formateringskoder; f.eks. er §a grøn tekst og §l fed.</system:String>
  <system:String x:Key="Str_Ui_Nothing_Saved_Yet_Try_The_Button_In_The_">Ingen favoritter endnu; klik ☆ Favorit i kategorierne “Spilversioner” / “Mod” / “Ressourcepakker”.</system:String>
  <system:String x:Key="Str_Ui_New_Here_Or_Setting_Up_A_Fresh_Version_O">Er du ny, eller vil du installere en ny version / Mod? Guiden hjælper trin for trin med at vælge konto, version og Mod.</system:String>
  <system:String x:Key="Str_Ui_Edit_The_Common_Server_Properties_Entrie">Redigér almindelige server.properties-felter grafisk, såsom motd, maksimalt antal spillere og online-tilstand</system:String>
  <system:String x:Key="Str_Ui_You_Can_Hide_Pages_You_Don_T_Need_Or_Swi">Du kan skjule sider, du ikke har brug for, eller deaktivere bestemte funktioner. Tryk F12 på enhver skærm for midlertidigt at vise skjulte funktioner.</system:String>
  <system:String x:Key="Str_Ui_Turn_On_Version_Isolation_For_This_Insta">Aktivér “versionsisolering” kun for denne version (mods/ressourcer/worlds holdes adskilt, ligesom i den officielle launcher)</system:String>
  <system:String x:Key="Str_Ui_Switch_To_Light_Mode_At_This_Hour_Each_D">Skift automatisk til lys tilstand hver dag på dette tidspunkt (0~23), og behold den indtil tidspunktet “Start mørk tilstand”.</system:String>
  <system:String x:Key="Str_Ui_The_Embedded_Sign_In_Component_Failed_To">Den indbyggede login-komponent kunne ikke starte (WebView2 Runtime er muligvis ikke installeret). Brug knappen “Log ind i browser”.</system:String>
  <system:String x:Key="Str_Ui_The_Server_S_World_Folder_Name_World_By_">Navnet på serverens world-mappe, standard world; hvis serverejeren har ændret level-name, skal du indtaste det tilsvarende navn</system:String>
  <system:String x:Key="Str_Ui_When_Ticked_Search_Results_Include_Beta_">Når markeret, inkluderer søgeresultater beta-/alpha-versioner, der endnu ikke er officielt udgivet. Som standard vises kun stabile versioner.</system:String>
  <system:String x:Key="Str_Ui_The_Oldest_Loader_With_The_Largest_Ecosy">Den ældste loader med det største økosystem; mange store teknologi-/magi-modpacks afhænger af den. Lokal Java kræves for at køre installer.</system:String>
  <system:String x:Key="Str_Ui_These_Options_Are_Still_Being_Polished_A">Indstillingerne her er stadig under udvikling og kan være ustabile. Ændring af farvetema påvirker ikke spil/world/Mod; du kan altid vende tilbage til standard.</system:String>
  <system:String x:Key="Str_Ui_Builds_A_Separate_Instance_From_Scratch_">Opretter en separat instance fra bunden: downloader spillet og den tilsvarende loader og installerer derefter modpack-indholdet. Eksisterende instances berøres ikke.</system:String>
  <system:String x:Key="Str_Ui_A_Newer_Loader_Forked_From_Forge_The_Mod">En nyere loader, der er forked fra Forge; Mod-økosystemet for nye versioner flytter gradvist hertil. Kræver lokal Java.</system:String>
  <system:String x:Key="Str_Ui_However_Many_You_Tick_Is_However_Many_Ge">Der installeres lige så mange loaders, som du vælger; det faktiske antal styres af “antal valgte loaders” nedenfor, og denne tekst viser blot værdien.</system:String>
  <system:String x:Key="Str_Ui_Only_Affects_Offline_Accounts_Set_To_Use">Påvirker kun offline-konti med “brugerdefineret skin”; standard Steve/Alex-skins og skins fra Microsoft-konti påvirkes ikke.</system:String>
  <system:String x:Key="Str_Ui_Guest_Mode_Launches_With_A_Temporary_Acc">Gæstetilstand (kun denne session; starter spillet med en midlertidig konto og bruger ikke gemte konti; efter genstart af launcheren vender normal tilstand tilbage)</system:String>
  <system:String x:Key="Str_Ui_Download_Any_Direct_Link_Note_That_Some_">Download enhver fil med et direkte link. Nogle websteder (f.eks. Baidu Netdisk) kan blokere og returnere fejl 403, så normal download ikke virker.</system:String>
  <system:String x:Key="Str_Ui_Get_A_Key_From_Console_Curseforge_Com_Th">Hent en key på console.curseforge.com, indsæt den derefter på siden “Indstillinger”, og gem.</system:String>
  <system:String x:Key="Str_Ui_Opens_The_Copy_Of_Minecraft_For_Windows_">Åbner den installerede Minecraft for Windows (Bedrock Edition); starter kun, downloader/administrerer ikke versioner</system:String>
  <system:String x:Key="Str_Ui_Smart_Throttling_Watches_What_Other_Prog">Intelligent hastighedsbegrænsning (registrerer automatisk andre programmers netværksforbrug for at undgå at bruge al båndbredde; kan bruges sammen med grænsen ovenfor, og den strengeste værdi anvendes)</system:String>
  <system:String x:Key="Str_Ui_Only_Applies_When_No_Specific_Java_Is_Ch">Gælder kun, når ingen specifik Java er valgt ovenfor: tom = automatisk match (anbefalet); tal (f.eks. 25) = tving denne hovedversion</system:String>
  <system:String x:Key="Str_Ui_Auth_Server_Api_Root_E_G_Https_Example_C">API-rodadresse for godkendelsesserveren, f.eks. https://example.com/api/yggdrasil</system:String>
  <system:String x:Key="Str_Ui_Show_Mod_Icons_In_Search_Results_Fetched">Vis Mod-ikoner i søgeresultater i Downloadcenter (hentes fra Modrinth/CurseForge, aktiveret som standard)</system:String>
  <system:String x:Key="Str_Ui_Note_Java_8_Defaults_To_32_Bit_And_Every">Bemærk: Java 8 er som standard 32-bit, mens andre versioner er 64-bit. Hvis du er i tvivl, brug den anbefalede indstilling.</system:String>
  <system:String x:Key="Str_Ui_Default_Light_Mode_From_08_00_To_19_00_A">Standard: 08:00-19:00 lys tilstand, ellers mørk tilstand. Klik “Gem indstillinger” for at anvende.</system:String>
  <system:String x:Key="Str_Ui_Double_Click_An_Account_To_Launch_Straig">Dobbeltklik på en konto for at starte direkte; eller vælg den og tryk “Start med denne konto” nedenfor. Hvis den ønskede konto mangler, kan du tilføje den nedenfor.</system:String>
  <system:String x:Key="Str_Ui_A_Beginner_S_Wizard_That_Takes_You_From_">Begynderguide fra konto til start: vælg version/loader, tilføj valgfrit Mod og ressourcepakker/shaders, og download og start derefter automatisk</system:String>
  <system:String x:Key="Str_Ui_A_Development_Stage_Idea_Install_The_Sam">Kun en funktion under udvikling/idé — installerer hver valgt loader separat for samme Minecraft-version i samme instance.</system:String>
  <system:String x:Key="Str_Ui_Optional_If_A_Newer_Official_Build_Is_Ou">Valgfrit: hvis en nyere officiel version er udgivet, men den medfølgende endnu ikke er opdateret, kan du midlertidigt vælge en downloadet exe-fil for at overskrive den medfølgende</system:String>
  <system:String x:Key="Str_Ui_Guest_Mode_Only_Affects_Temporary_Accoun">Gæstetilstand påvirker kun midlertidige konti og sessionsoprydning; den ændrer ikke brugerfladens farve. Farven følger altid det aktuelle “Farvetema” + valget “Tilstandsindstillinger”.</system:String>
  <system:String x:Key="Str_Ui_Contains_Features_Still_In_Development_O">Indeholder funktioner/idéer under udvikling; kan være ustabilt og anbefales ikke til almindelige brugere. Første gang skal advarslen læses i 10 sekunder.</system:String>
  <system:String x:Key="Str_Ui_Pick_One_From_The_Java_List_Above_As_The">Vælg global standard-Java fra listen ovenfor; “(Ikke angivet, registrér automatisk)” bevarer den nuværende logik for automatisk registrering/download</system:String>
  <system:String x:Key="Str_Ui_Also_Install_Qsl_Quilt_Standard_Librarie">Installér også QSL (Quilt Standard Libraries; kræves af mange Quilt Mods, anbefalet)</system:String>
  <system:String x:Key="Str_Ui_Right_Now_Your_Server_Is_Only_Reachable_">Lige nu kan serveren kun nås fra LAN. For at lade venner uden for samme WiFi/netværk forbinde, brug en af metoderne nedenfor.</system:String>
  <system:String x:Key="Str_Ui_Note_Custom_Skins_Need_Customskinloader_">Bemærk: korrekt visning af brugerdefinerede skins i offline-tilstand kræver CustomSkinLoader; dette håndteres automatisk ved download/start af spillet, ingen manuel handling er nødvendig.</system:String>
  <system:String x:Key="Str_Ui_Type_A_Command_And_Press_Enter_E_G_Say_H">Skriv en kommando og tryk Enter; f.eks. say hello / list / gamemode creative Steve</system:String>
  <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Instance_From_The_J">Vælg en separat Java til denne version fra Java-listen i “Indstillinger”; vælg “(Ikke angivet)” for automatisk match efter hovedversionsnummeret nedenfor</system:String>
  <system:String x:Key="Str_Ui_When_On_The_Game_Launches_With_A_Tempora">Når aktiveret bruger spillet kun en midlertidig konto, der findes til denne kørsel, og ingen gemt konto; ved lukning ryddes sessionslogs/midlertidige downloadfiler</system:String>
  <system:String x:Key="Str_Ui_Switch_To_Dark_Mode_At_This_Hour_Each_Da">Skift automatisk til mørk tilstand hver dag på dette tidspunkt (0~23), og behold den indtil tidspunktet “Start lys tilstand” (håndterer midnat korrekt).</system:String>
  <system:String x:Key="Str_Ui_Note_The_Officially_Released_Versions_Ar">Bemærk: de officielle stabile hovedversioner er primært 8 / 11 / 17 / 21 / 25 / 26; andre numre har muligvis ingen officielle builds.</system:String>
  <system:String x:Key="Str_Ui_E_G_Xx_Useg1gc_Dsomething_Quot_Value_Wit">For eksempel: -XX:+UseG1GC -Dsomething=&quot;value with spaces&quot;</system:String>
  <system:String x:Key="Str_Ui_Joining_A_Server_Automatically_Needs_Min">Automatisk tilslutning til en server kræver Minecraft 1.20.6 eller nyere; i ældre versioner har denne indstilling ingen effekt, og hovedmenuen åbnes normalt</system:String>
  <system:String x:Key="Str_Ui_About_The_Disk_Limit_Windows_Can_T_Enfor">Om diskgrænsen: Windows kan ikke håndhæve en hård kvote på én mappe; denne indstilling overvåger kun forbruget og advarer under kørsel, men blokerer ikke skrivning.</system:String>
  <system:String x:Key="Str_Ui_Offline_Accounts_Set_To_Use_A_Custom_Ski">Offline-konti med “brugerdefineret skin” i kontohåndtering viser skin via tjenesten på denne adresse. Som standard bruges den indbyggede offentlige tjeneste; tomt felt gendanner standard.</system:String>
  <system:String x:Key="Str_Ui_When_On_Xms_And_Xmx_Are_Recalculated_Fro">Når aktiveret genberegnes -Xms/-Xmx før hver spilstart ud fra tilgængelig systemhukommelse og overskriver de faste værdier, der er indtastet manuelt i indstillingerne.</system:String>
  <system:String x:Key="Str_Ui_Install_Vanilla_Or_The_Fabric_Forge_Neof">Installér Vanilla eller client-loader Fabric / Forge / NeoForge; når det er færdigt, vises det automatisk på listen “Installerede versioner”.</system:String>
  <system:String x:Key="Str_Ui_A_Modpack_Overwrites_The_Mods_And_Config">Et modpack overskriver indhold som mods/config i installationsmappen; for at undgå blanding med eksisterende Mods anbefales installation i en separat ny versionsmappe.</system:String>
  <system:String x:Key="Str_Ui_Changes_The_Launcher_S_Colour_Family_Eac">Ændrer launcherens farvefamilie; hver farvefamilie har en lys og mørk variant. Hvilken der vises, bestemmes af “Tilstandsindstillinger” på startsiden eller automatisk skift nedenfor.</system:String>
  <system:String x:Key="Str_Ui_Takes_You_From_Account_To_Launch_In_One_">Gennemfører alt fra konto til start og spil; hvert trin (Mod/ressourcepakke/shader) kan springes over. Ved import af modpack kan alle efterfølgende valg også springes over.</system:String>
  <system:String x:Key="Str_Ui_2_Create_A_Tcp_Tunnel_And_Set_The_Local_">2. Opret en ny TCP-tunnel; indtast serverporten som lokal port (standard 25565; den præcise værdi vises i forbindelsesadressen på kortet “Serverliste”).</system:String>
  <system:String x:Key="Str_Ui_1_Sign_In_To_Your_Router_S_Admin_Page_Us">1. Log ind på routerens administrationsside (normalt 192.168.1.1 eller 192.168.0.1 i browseren; den præcise adresse står på routerens mærkat).</system:String>
  <system:String x:Key="Str_Ui_Resource_Packs_Shader_Packs_Data_Packs_W">Ressourcepakker, shaders, datapakker, worlds og modpacks er alle .zip; typen kan ikke altid bestemmes ud fra indholdet. Forkert valg installerer i forkert mappe, så launcheren skal spørge.</system:String>
  <system:String x:Key="Str_Ui_Bedrock_Dedicated_Server_Is_Published_Fr">Bedrock Dedicated Server udgives gratis af Mojang på den officielle side; ingen konto eller licens kræves, og den kan downloades direkte.</system:String>
  <system:String x:Key="Str_Ui_Switches_Between_Light_And_Dark_Automati">Når aktiveret skifter lys/mørk tilstand automatisk efter systemtid (standard 08:00-19:00 lys, ellers mørk); tiderne kan ændres i “Indstillinger”.</system:String>
  <system:String x:Key="Str_Ui_In_Game_Watermark_Text_Shown_In_The_Bott">Watermark-tekst i spillet (vises nederst til venstre, f.eks. “XCL2”; tomt felt viser den officielle tekst “release”)</system:String>
  <system:String x:Key="Str_Ui_Turning_This_Off_Restores_The_Old_Behavi">Når deaktiveret bruges den gamle adfærd: kun udpak modpack-indholdet i den valgte eksisterende instance og overskriv, uden at downloade spil/loader; hvis spilversionen ikke matcher, kan spillet crashe med det samme.</system:String>
  <system:String x:Key="Str_Ui_Installing_The_Fabric_Client_Doesn_T_Run">Installation af Fabric-client kræver ikke lokal kørsel af installer; den kan installeres uden Java-sti. Java til start af versionen matches/downloades stadig automatisk.</system:String>
  <system:String x:Key="Str_Ui_Keep_Resource_Data_And_Shader_Packs_Sepa">Hold ressource-/data-/shaderpakker adskilt pr. version (standard aktiveret; deaktiveret = ét fælles sæt til alle versioner; kan tilsidesættes pr. version i “Vælg version”)</system:String>
  <system:String x:Key="Str_Ui_Already_Have_A_Minecraft_Folder_From_The">Hvis du allerede har en .minecraft-mappe (f.eks. fra den officielle/anden launcher), vælg den direkte; download springes over, og Java matches automatisk til start.</system:String>
  <system:String x:Key="Str_Ui_Keep_Mods_Resource_Packs_Data_Packs_And_">Som standard adskilles mods / ressourcepakker / datapakker / worlds efter version (anbefalet, som den officielle launcher; kan tilsidesættes pr. version i “Vælg version”)</system:String>
  <system:String x:Key="Str_Ui_Colour_Themes_Blue_Yellow_Purple_Pink_An">Brugerfladens farvetemaer (blå, gul, lilla, pink osv.) er nu en officiel funktion, ikke eksperimentel; de kan bruges sikkert på siden “Indstillinger”.</system:String>
  <system:String x:Key="Str_Ui_Pick_A_Java_For_This_Server_From_The_Lis">Vælg Java til denne server fra den gemte liste i “Indstillinger”; hvis du vælger “(Ikke angivet, registrér/download automatisk)”, bruges stifeltet nedenfor, og der matches/downloades automatisk efter behov</system:String>
  <system:String x:Key="Str_Ui_Normal_Mode_Shows_Only_The_Essentials_An">Normal tilstand: viser kun nødvendige indstillinger og registrerer/downloader Java automatisk; Eksperttilstand: Java-version/arkitektur/installationstype, brugerdefinerede parametre osv. kan konfigureres.</system:String>
  <system:String x:Key="Str_Ui_Sign_In_With_A_Third_Party_Auth_Server_A">Log ind med en konto fra en tredjeparts-godkendelsesserver (Unified Pass/blessing-skin osv., kræver Yggdrasil-protokol); derefter bruges skinnet fra den server automatisk.</system:String>
  <system:String x:Key="Str_Ui_Quickly_Checks_The_Usual_Places_For_Inst">Finder hurtigt installeret Java på almindelige placeringer (portable-mappe/JAVA_HOME/registry/PATH) og tilføjer dem i bulk til listen; scanner ikke hele disken og er færdig på få sekunder</system:String>
  <system:String x:Key="Str_Ui_Switches_Between_Dark_And_Light_It_Only_">Skift mellem mørk/lys tilstand; påvirker kun lysstyrken, ikke nuancen i “Farvetema”. Hvis “Automatisk skift” er aktiveret, gælder manuelt valg kun indtil næste automatiske skift.</system:String>
  <system:String x:Key="Str_Ui_This_Feature_Is_Locked_By_Default_And_Ne">Denne funktion er låst som standard; korrekt token kræves for at fortsætte (ikke forskel på store/små bogstaver). Uden token er funktionen ikke til dig endnu; brug de stabile funktioner.</system:String>
  <system:String x:Key="Str_Ui_Once_Several_Java_Runtimes_Are_Registere">Når flere Java-runtimes er gemt, kan der vælges en separat Java fra listen for hver client-version og hver serverinstance.</system:String>
  <system:String x:Key="Str_Ui_Separate_Arguments_With_Spaces_And_Wrap_">Adskil flere parametre med mellemrum; værdier med mellemrum sættes i dobbelte anførselstegn. Parametre tilføjes efter indbyggede parametre og før classpath; ved konflikt har dine værdier prioritet. Tomt = anvend ikke.</system:String>
  <system:String x:Key="Str_Ui_A_Loader_Forked_From_Fabric_It_Runs_Most">Loader forked fra Fabric; kompatibel med de fleste Fabric Mods og giver ekstra funktioner til Mod-udvikling. Ligesom Fabric kræves ingen lokal Java.</system:String>
  <system:String x:Key="Str_Ui_Enables_The_Auto_Cycle_Button_On_The_Mai">Når aktiveret fungerer knappen “Automatisk skift” på startsiden og skifter lys/mørk efter tiderne nedenfor. Du kan skifte manuelt, men ved næste tidspunkt tager automatikken over igen.</system:String>
  <system:String x:Key="Str_Ui_Blank_Means_Auto_Match_The_Version_S_Own">Tomt = automatisk match (bruger det højere Java-krav mellem versionen og installerede Mods); tal (f.eks. 25) = tving altid denne version til at bruge denne Java-hovedversion</system:String>
  <system:String x:Key="Str_Ui_Search_By_Keyword_In_English_Or_Chinese_">Søg med engelske eller kinesiske nøgleord, f.eks. “JEI” eller “钠” (oversættes automatisk for at søge Sodium); tomt viser populære Mods, indtastning starter automatisk søgning</system:String>
  <system:String x:Key="Str_Ui_Note_The_Bedrock_Client_Is_Distributed_T">Bemærk: Bedrock Edition-client distribueres via Microsoft Store og er knyttet til en Microsoft-kontolicens; der findes ingen offentlig downloadadresse. Launcheren kan kun åbne den installerede version, ikke downloade eller skifte version.</system:String>
  <system:String x:Key="Str_Ui_Supports_Mcworld_Worlds_Mcpack_Resource_">Understøtter .mcworld (world), .mcpack (ressource-/adfærdspakke), .mcaddon (add-on-pakke), .mctemplate (world-skabelon). Disse filer kan også trækkes ind i launchervinduet.</system:String>
  <system:String x:Key="Str_Ui_3_The_Tunnelling_Tool_Gives_You_A_Public">3. Tunnelværktøjet giver en offentlig adresse som xxx.xxx.com:12345; send den til vennerne og bed dem gå til Minecraft “Multiplayer - Tilføj server”.</system:String>
  <system:String x:Key="Str_Ui_Removes_Temporary_Files_From_This_Minecr">Rydder midlertidige filer, der sikkert kan slettes i den aktuelle .minecraft-mappe, såsom gamle logarkiver, gamle crashrapporter, webcache, Mixin-debugoutput og JVM-crashdumps; påvirker ikke worlds/Mods/ressourcer/indstillinger.</system:String>
  <system:String x:Key="Str_Ui_Security_Note_Whichever_Method_You_Use_T">Sikkerhedsnote: uanset hvordan serveren åbnes mod Internet, anbefales det at aktivere online-godkendelse i “Serverindstillinger” for at holde fremmede ude; hvis du kun spiller med venner, kan whitelist bruges.</system:String>
  <system:String x:Key="Str_Ui_Experimental_Features_May_Also_Include_J">Eksperimentelle funktioner kan omfatte sjovt indhold, ufærdige funktioner under udvikling eller indhold, der endnu ikke er fuldt verificeret. Det er ikke besluttet, om de bliver officielle, så de kan fjernes eller ændres markant.</system:String>
  <system:String x:Key="Str_Ui_Experimental_Features_Currently_Include_">Eksperimentelle funktioner omfatter nu avancerede low-level-funktioner som installation af flere loaders i samme version (mere end én af Fabric/Forge/NeoForge); forkert brug kan beskadige versionen og kræve ny download.</system:String>
  <system:String x:Key="Str_Ui_When_On_The_Launch_Button_Always_Uses_A_">Når aktiveret bruger “Start spil” på startsiden altid en midlertidig offline-konto kun til den kørsel og læser/skriver ikke rigtige gemte konti; ved lukning ryddes spillogs/midlertidige downloads fra kørslen uden at påvirke installeret spil/Mods/worlds.</system:String>
  <system:String x:Key="Str_Ui_Drag_Mods_Resource_Packs_Shaders_Worlds_">Træk en Mod / ressourcepakke / shader / world / modpack direkte ind i launchervinduet for at installere. Da alt kan være .zip, undersøger launcheren indholdet; hvis typen ikke kan identificeres, følger den indstillingen nedenfor.</system:String>
  <system:String x:Key="Str_Ui_3_Friends_Connect_Using_Your_Public_Ip_A">3. Venner kan forbinde med offentlig IP + port. Hvis den offentlige IP ændres (almindeligt på hjemmenetværk), brug DDNS så et domæne automatisk peger på den aktuelle IP.</system:String>
  <system:String x:Key="Str_Ui_The_Toolbox_Advancement_Images_Skin_Avat">“Værktøjer” (...) er en officiel funktion, ikke eksperimentel. Indeholder generering af achievement-billeder, skin-avatar, brugerdefineret download, premium-spillerskin, oprydning, genveje, starttæller, Jar-loaderdownload og hukommelsesoptimering; altid tilgængelig under “Værktøjer”.</system:String>
  <system:String x:Key="Str_Ui_2_Find_Port_Forwarding_Port_Mapping_Or_V">2. Find port forwarding / port mapping / virtual server; sæt ekstern og intern port til serverporten (standard 25565), og intern IP til denne PCs LAN-IP.</system:String>
  <system:String x:Key="Str_Ui_A_Tunnelling_Tool_Gives_You_A_Temporary_">Et NAT traversal-værktøj giver en midlertidig offentlig adresse og videresender trafik til serveren; kræver ikke router-login eller offentlig IP, men gratis planer kan have begrænsninger og være mindre stabile over længere tid.</system:String>
  <system:String x:Key="Str_Ui_For_Reference_Java_8_Covers_Versions_Bef">Reference: Java 8 til før 1.16; Java 17 til før 1.20.5; Java 21 til før 1.21.11; Java 25 til 26.1+; Java 8 er standard 32-bit, andre er 64-bit.</system:String>
  <system:String x:Key="Str_Ui_Rent_A_Cheap_Cloud_Server_It_Comes_With_">Lej en billig cloudserver med offentlig IP som frp-relay eller kør Minecraft-serveren direkte i cloud; mere stabilt og hurtigere, men koster og er mere komplekst.</system:String>
