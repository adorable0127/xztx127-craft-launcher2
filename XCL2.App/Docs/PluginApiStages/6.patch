+            backgrounds.SelectedItem = backgrounds.Items.OfType<ComboBoxItem>().FirstOrDefault(i => (i.Tag as string) == _owner.ConfigService.Config.PluginBackgroundId) ?? backgrounds.Items[0];
+            backgrounds.SelectionChanged += (_, _) =>
