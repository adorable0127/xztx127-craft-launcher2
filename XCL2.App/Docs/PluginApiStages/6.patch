+{
+    private void InitializePluginSettings()
+    {
+        var area = new StackPanel { Margin = new Thickness(0, 20, 0, 12) }; SettingsRootPanel.Children.Add(area);
+        void Refresh()
+        {
+            if (!Dispatcher.CheckAccess()) { Dispatcher.BeginInvoke(new Action(Refresh)); return; }
+            area.Children.Clear();
+            area.Children.Add(new TextBlock { Text = Loc.T("Str_Plugin_CustomSettings", "插件设置与背景"), FontSize = 16, FontWeight = FontWeights.Bold });
+            var backgrounds = new ComboBox { MinWidth = 280, HorizontalAlignment = HorizontalAlignment.Left, Margin = new Thickness(0, 10, 0, 12) };
+            backgrounds.Items.Add(new ComboBoxItem { Content = Loc.T("Str_Plugin_BuiltInBackground", "使用启动器原背景"), Tag = "" });
+            foreach (var entry in PluginUiContributionRegistry.Snapshot("background"))
