<local:OverlayDialogControl x:Class="XCL2.App.Views.DropJarTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        MaxWidth="480">
    <!-- 内嵌 Overlay 弹窗（不是独立 Window），由 OverlayDialogService 显示在主窗口内部。 -->
    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource Str_Ui_Where_Should_This_Mod_Go}" FontSize="18" FontWeight="Bold"/>

        <TextBlock x:Name="FileNameText" FontSize="13" Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <StackPanel Margin="0,18,0,0">
            <RadioButton x:Name="ChoiceClient" GroupName="JarTarget" IsChecked="True" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Current_Game_Instance}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ClientHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ChoiceServer" GroupName="JarTarget">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Server_Instance}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ServerHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <CheckBox x:Name="RememberCheck" Margin="0,18,0,0" FontSize="12"
                  Content="{DynamicResource Str_Ui_Remember_This_Choice_And_Stop_Asking_You}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource Str_Common_Cancel}" Style="{StaticResource SecondaryButton}" Padding="18,7" Click="Cancel_Click"/>
            <Button Content="{DynamicResource Str_Common_Ok}" Style="{StaticResource PrimaryButton}" Padding="24,7" Margin="10,0,0,0"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</local:OverlayDialogControl>
