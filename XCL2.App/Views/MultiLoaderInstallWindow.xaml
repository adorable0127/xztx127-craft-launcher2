<local:OverlayDialogControl x:Class="XCL2.App.Views.MultiLoaderInstallWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="560"
                            MaxWidth="560"
                            MinHeight="640"
                            MaxHeight="640">
                            <!-- MinHeight 必须给：这个弹窗的布局里有 RowDefinition Height="*"。
                                 原来是 Window 且有固定 Height 时，"*"行能拿到剩余高度；
                                 改成挂在自适应 OverlayCard 里的 UserControl 之后，
                                 测量高度是无穷大，"*"行会塌陷成内容的期望高度——
                                 列表为空/WebView2 这种没有期望尺寸的控件会直接塌成 0，
                                 表现就是弹窗里一片空白。MinHeight 用回原来的设计高度即可。 -->
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Str_Ui_Install_Multiple_Loaders}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_A_Development_Stage_Idea_Install_The_Sam}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>

                <!-- ============ 第一屏：风险提示 + Token 校验（未通过前，下面的安装区不可见） ============ -->
                <Border x:Name="RiskPanel" Background="#22D64545" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Ui_Please_Read_This_In_Full_Before_Continui}" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RiskText" TextWrapping="Wrap" FontSize="12" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="TokenPanel">
                    <TextBlock Text="{DynamicResource Str_Ui_Enter_The_User_Token_Id}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Str_Ui_This_Feature_Is_Locked_By_Default_And_Ne}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TokenBox" Grid.Column="0" Style="{StaticResource SearchTextBox}"
                                 Height="34" ToolTip="{DynamicResource Str_Ui_Paste_Or_Type_The_Token_Not_Case_Sensiti}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Str_Ui_Unlock}" Style="{StaticResource PrimaryButton}"
                                Click="UnlockToken_Click"/>
                    </Grid>
                    <TextBlock x:Name="TokenStatusText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ============ 第二屏：安装配置（token 通过后才显示） ============ -->
                <StackPanel x:Name="InstallPanel" Visibility="Collapsed" Margin="0,10,0,0">

                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                    <TextBlock Text="{DynamicResource Str_Ui_Choose_A_Minecraft_Version}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Str_Ui_Type_A_Version_Number_E_G_1_20_1_It_Will}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBox x:Name="McVersionBox" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,0,16"
                             ToolTip="{DynamicResource Str_Ui_E_G_1_20_1}"/>

                    <TextBlock Text="{DynamicResource Str_Ui_How_Many_Loaders_Do_You_Want}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Str_Ui_However_Many_You_Tick_Is_However_Many_Ge}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectedCountText" Text="{DynamicResource Str_Ui_Loaders_Selected_0}" FontSize="12" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Str_Ui_Select_Loaders}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkFabric" Content="Fabric" Margin="0,0,0,6" Checked="LoaderCheck_Changed" Unchecked="LoaderCheck_Changed"/>
                    <CheckBox x:Name="ChkQuilt" Content="Quilt" Margin="0,0,0,6" Checked="LoaderCheck_Changed" Unchecked="LoaderCheck_Changed"/>
                    <CheckBox x:Name="ChkForge" Content="{DynamicResource Str_Ui_Forge_Requires_Local_Java}" Margin="0,0,0,6" Checked="LoaderCheck_Changed" Unchecked="LoaderCheck_Changed"/>
                    <CheckBox x:Name="ChkNeoForge" Content="{DynamicResource Str_Ui_Neoforge_Requires_Local_Java}" Margin="0,0,0,16" Checked="LoaderCheck_Changed" Unchecked="LoaderCheck_Changed"/>

                    <TextBlock Text="{DynamicResource Str_Ui_Java_Path_Needed_For_Forge_Neoforge}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="JavaPathBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="34"/>
                        <Button Grid.Column="2" Content="{DynamicResource Str_Ui_Auto_Detect}" Click="AutoDetectJava_Click"/>
                    </Grid>

                    <Button x:Name="InstallBtn" Content="{DynamicResource Str_Ui_Start_Combined_Install}" Style="{StaticResource PrimaryButton}"
                            Padding="0,10" Click="Install_Click" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource SideBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarCtl" Height="16" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ProgressStageText" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ProgressDetailText" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="EasterEggText" FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource Str_Ui_You_Can_Close_This_At_Any_Time_Anything_}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="{DynamicResource Str_Common_Close}" Click="Close_Click"/>
        </Grid>
    </Grid>
</local:OverlayDialogControl>
