<Window x:Class="XCL2.App.Views.MultiLoaderInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:XCL2.App.Services"
        Title="实验性内容1：安装多个加载器"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🧬 安装多个加载器" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="仅处于开发或想法版功能——把同一个 Minecraft 版本，用你选的每一种加载器分别装进同一个实例里。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>

                <!-- ============ 第一屏：风险提示 + Token 校验（未通过前，下面的安装区不可见） ============ -->
                <Border x:Name="RiskPanel" Background="#22D64545" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚠️ 开始之前，请完整看完这段说明" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RiskText" TextWrapping="Wrap" FontSize="12" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="TokenPanel">
                    <TextBlock Text="输入 User Token ID" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="这个功能默认锁定，需要先输入正确的 token 才能继续（不区分大小写）。没有 token？说明这个功能暂时不适合你，先去用启动器里已经稳定的功能吧。"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TokenBox" Grid.Column="0" Style="{StaticResource SearchTextBox}"
                                 Height="34" ToolTip="粘贴或输入 token，不区分大小写"/>
                        <Button Grid.Column="2" Content="解锁" Style="{StaticResource PrimaryButton}"
                                Click="UnlockToken_Click"/>
                    </Grid>
                    <TextBlock x:Name="TokenStatusText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ============ 第二屏：安装配置（token 通过后才显示） ============ -->
                <StackPanel x:Name="InstallPanel" Visibility="Collapsed" Margin="0,10,0,0">

                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                    <TextBlock Text="① 选择 Minecraft 版本" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="直接填写版本号（例如 1.20.1），会作为所有加载器的共同底座版本。"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBox x:Name="McVersionBox" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,0,16"
                             ToolTip="例如 1.20.1"/>

                    <TextBlock Text="② 选择要安装的加载器数量" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="勾选几个就装几个，实际会按下面「已选加载器数」为准，跟这里只是文字提示保持一致，不需要手动对齐。"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectedCountText" Text="已选加载器数：0" FontSize="12" Margin="0,0,0,12"/>

                    <TextBlock Text="③ 勾选加载器" FontWeight="Bold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkFabric" Content="Fabric" Margin="0,0,0,6" Checked="LoaderCheck_Changed" Unchecked="LoaderCheck_Changed"/>
                    <CheckBox x:Name="ChkQuilt" Content="Quilt" Margin="0,0,0,6" Checked="LoaderCheck_Changed" Unchecked="LoaderCheck_Changed"/>
                    <CheckBox x:Name="ChkForge" Content="Forge（需要本地 Java）" Margin="0,0,0,6" Checked="LoaderCheck_Changed" Unchecked="LoaderCheck_Changed"/>
                    <CheckBox x:Name="ChkNeoForge" Content="NeoForge（需要本地 Java）" Margin="0,0,0,16" Checked="LoaderCheck_Changed" Unchecked="LoaderCheck_Changed"/>

                    <TextBlock Text="④ Java 路径（Forge/NeoForge 需要）" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="JavaPathBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="34"/>
                        <Button Grid.Column="2" Content="自动检测" Click="AutoDetectJava_Click"/>
                    </Grid>

                    <Button x:Name="InstallBtn" Content="开始合装" Style="{StaticResource PrimaryButton}"
                            Padding="0,10" Click="Install_Click" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource SideBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarCtl" Height="16" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ProgressStageText" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ProgressDetailText" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="EasterEggText" FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="随时可以关闭这个窗口；已经装好的版本不会因为关窗口而消失。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="关闭" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
