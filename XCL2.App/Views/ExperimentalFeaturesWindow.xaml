<Window x:Class="XCL2.App.Views.ExperimentalFeaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:XCL2.App.Services"
        Title="实验性功能"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🧪 实验性功能" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="这里的选项仍在打磨中，可能不稳定。改坏了配色不会影响游戏本体/存档/Mod，随时可以改回默认。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>

                <!-- 换肤功能已经全部做完（白/蓝/黄/紫/粉五个色系，各自都有浅色版/深色版），
                     不再是"实验性"的了，已经搬到「设置」页正式的「配色皮肤」下拉框 + 首页
                     「模式设置」按钮，这里不再重复放这个入口，避免同一个功能出现在两个地方、
                     显示口径还可能不一致（比如这里之前只解锁了蓝色系，容易让人以为紫色/粉色
                     还没做完）。 -->

                <TextBlock Text="⚠️ 初步测试版功能" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="仅处于开发或想法版：这里的功能随时可能出问题，请在了解风险后再打开。"
                           Foreground="{DynamicResource WarningTextBrush}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <Button HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,8"
                        Click="MultiLoaderFeature_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧬" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="实验性内容1：安装多个加载器" FontWeight="Bold"/>
                            <TextBlock Text="把所有加载器安装在同一个实例当中（想法阶段，需要 Token）"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 需求："能不能让我的启动器启动基岩版" —— 基岩版是完全不同的引擎/分发方式
                     （C++ 原生 + Microsoft Store 打包，跟这个启动器整套 Java 版逻辑不兼容），
                     这里只做"轻量跳转"：检测系统是否已安装 Minecraft for Windows，已安装就
                     唤起它，不下载/不管理版本/不接管 mod，见 BedrockLaunchService 类注释。
                     放进"实验性功能"而不是首页/正式导航栏，是因为这只是一个跳转快捷方式，
                     不是这个启动器的核心能力，跟"安装多个加载器"一样归为初步测试性质的附加功能。 -->
                <Button HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,8"
                        Click="LaunchBedrockFeature_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧱" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="实验性内容2：启动基岩版" FontWeight="Bold"/>
                            <TextBlock Text="唤起已安装的 Minecraft for Windows（基岩版），仅跳转打开，不下载/不管理版本"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="想切换配色？去「设置」页的「配色皮肤」，或者首页的「模式设置」按钮切深浅色。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Content="关闭" Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
