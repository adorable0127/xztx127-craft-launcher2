<Window x:Class="XCL2.App.Views.InputModeSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择操作模式"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#FF202124"
        Foreground="White">
    <StackPanel Margin="24">
        <TextBlock Text="本次启动使用哪种操作方式？" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="#FFBDBDBD" FontSize="12" Margin="0,0,0,16"
                   Text="触屏模式会在游戏画面上叠加一层虚拟按键（方向、跳跃、潜行、丢弃、ESC/F3/DEL 等），适合在平板上不接键鼠直接玩。"/>

        <Button x:Name="KeyboardButton" Height="52" Margin="0,0,0,10" Click="Keyboard_Click">
            <StackPanel>
                <TextBlock x:Name="KeyboardTitleText" Text="键鼠模式（默认）" FontWeight="SemiBold"/>
                <TextBlock Text="不加任何覆盖层，跟平时一样用键盘和鼠标" FontSize="11" Foreground="#FF616161"/>
            </StackPanel>
        </Button>

        <Button x:Name="TouchButton" Height="52" Margin="0,0,0,12" Click="Touch_Click">
            <StackPanel>
                <TextBlock Text="触屏模式" FontWeight="SemiBold"/>
                <TextBlock Text="加载虚拟按键悬浮层，适合微软平板等触摸设备" FontSize="11" Foreground="#FF616161"/>
            </StackPanel>
        </Button>

        <!-- 倒计时提示：明确告诉用户"不选会发生什么、还剩多久"，避免窗口默默自己关掉时
             用户以为启动器出了问题。任何一次鼠标/触摸/键盘交互都会取消倒计时。 -->
        <TextBlock x:Name="CountdownText" Foreground="#FF9E9E9E" FontSize="12" Margin="0,0,0,10"
                   TextWrapping="Wrap"/>

        <CheckBox x:Name="RememberCheck" Foreground="#FFBDBDBD"
                  Content="记住这次选择，以后不再询问（可在设置里改回来）"/>
    </StackPanel>
</Window>
