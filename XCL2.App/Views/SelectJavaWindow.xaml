<Window x:Class="XCL2.App.Views.SelectJavaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择 Java"
        Width="480" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="从 Java 列表里选择要使用的 Java：" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <ListBox x:Name="JavaListBox" Height="140" DisplayMemberPath="DisplayText"/>
        <TextBlock Text="没有想要的选项？先去「设置」页的 Java 列表里添加。" FontSize="11"
                   Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Content="确定" Width="80" Style="{DynamicResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
