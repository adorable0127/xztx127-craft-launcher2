<UserControl x:Class="XCL2.App.Views.ModDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:XCL2.App.Models"
             xmlns:services="clr-namespace:XCL2.App.Services">
    <!-- 根因修复（"穿模"：详情页内容和下层列表/搜索框/分页按钮混叠在一起）：
         这个 UserControl 是以"整页覆盖层"的方式塞进宿主页面的 DetailHost(ContentControl) 里，
         直接叠加显示在原有的列表面板（搜索框、分页按钮等）之上，靠肉眼视觉制造"整页跳转"的
         假象——见 DownloadCenterPage.xaml 里 DetailHost 的注释。但这个根 Grid 之前完全没有
         设置 Background，是透明的；下面 ScrollViewer 区域同样透明，只有顶部那条 Border 有实色
         背景。结果下层列表面板里还留着的搜索框、分页按钮、未收起的滚动条等内容会直接透过这些
         透明区域和当前详情页内容混在一起显示，就是所谓的"穿模"。
         修复：根 Grid 补上跟随主题的 PanelBrush 不透明背景，整页覆盖时彻底遮住下层内容。 -->
    <Grid Background="{DynamicResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏：返回箭头 + 标题，仿视频/CurseForge 里"整页跳转详情"的样式，
             取代之前的"列表原地手风琴展开"。点返回箭头回到进入详情页之前的列表状态
             （由宿主页面/窗口在构造本控件时传入 onBack 回调，回调内部负责恢复筛选条件、
             搜索关键词、滚动位置、当前分页页码——本控件自己不关心"回哪"，只负责触发返回）。 -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="10,10,0,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="←" FontSize="16" Padding="10,4" Margin="0,0,10,0"
                        Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand"
                        Click="Back_Click" ToolTip="{DynamicResource Str_Ui_Back_To_List}"/>
                <TextBlock Grid.Column="1" x:Name="TitleText" Text="{DynamicResource Str_Ui_Details}" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- ===== 主体内容：滚动区域，依次是"简介卡片"和"版本分组列表"。 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,10,0,0" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel Margin="0,0,0,10">

                <!-- 简介卡片：图标 + 标题 + 简介 + 元信息一行，下面是操作按钮行
                     （转到 Modrinth/CurseForge 原页、复制名称、以及一键开服清单模式下的
                     "加入清单"提示）。 -->
                <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8" Margin="0,0,14,0"
                                    Background="{DynamicResource PanelBrush}" VerticalAlignment="Top">
                                <Image x:Name="IconImage" Width="56" Height="56" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="NameText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DescriptionText" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="MetaText" FontSize="12" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="OpenSourceButton" Content="{DynamicResource Str_Ui_Open_Source_Page}" Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Margin="0,0,8,0" Click="OpenSource_Click"/>
                            <Button x:Name="CopyNameButton" Content="{DynamicResource Str_Ui_Copy_Name}" Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Margin="0,0,8,0" Click="CopyName_Click"/>
                            <Button x:Name="FavoriteButton" Content="{DynamicResource Str_Ui_Favorite}" Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Click="Favorite_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 数据包场景：选择要安装到哪个存档，清单模式/直接下载模式都需要，
                     放在版本列表上方，跟原展开面板里的位置保持一致。 -->
                <Border x:Name="SaveNamePanel" Background="{DynamicResource SideBrush}" CornerRadius="8"
                        Padding="14" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str_Ui_Install_To_World}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SaveNameCombo" Width="220" SelectionChanged="SaveNameCombo_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="LoadingText" Text="{DynamicResource Str_Ui_Fetching_Versions}" FontSize="13" Margin="4,10"
                           Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="NoResultText" Text="{DynamicResource Str_Ui_No_Matching_Versions_Found_The_Game_Vers}"
                           FontSize="13" Margin="4,10" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>

                <!-- 游戏版本筛选 Tab 条 + "显示/隐藏预览版"按钮，同一行左右分布。
                     Tab 条：仿截图5/6/7顶部"全部 26.2 26.1 1.21 1.20..."样式，Tag 里放的是从
                     GroupTitle 提取出的版本前缀（比如 "1.21"、"26.2"），由 code-behind 的
                     BuildVersionFilterTabs 按当前这个 mod 实际有哪些版本动态生成——不是写死的
                     固定版本号列表，避免出现"点了个版本但这个 mod 根本没有对应分组"的空 Tab。
                     只有一个版本时不显示这条筛选（没有筛选的意义）。
                     预览版按钮：只在 Mod 场景（isMod=true）且这批版本里确实存在预览版时才显示，
                     见 ModDetailPage.xaml.cs 里 isMod 参数和 UpdatePreviewToggleVisibility 的注释——
                     资源包/数据包/光影包/地图详情页不显示这个按钮，维持之前"去掉这些按钮"的现状。 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel x:Name="VersionFilterPanel" Grid.Column="0" Visibility="Collapsed"/>
                    <Button x:Name="PreviewToggleButton" Grid.Column="1" Content="{DynamicResource Str_Ui_Show_Pre_Releases}"
                            Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12"
                            Margin="8,0,0,0" VerticalAlignment="Top" Click="TogglePreview_Click"
                            Visibility="Collapsed"/>
                </Grid>

                <!-- 版本分组列表：直接复用现有 VersionGroup/InlineVersionEntry 数据结构和
                     ModVersionGrouping 分组逻辑，跟旧的"卡片内联展开面板"是同一套数据，
                     只是现在整页展示、不需要再套一层"展开/收起外层卡片"。 -->
                <ItemsControl x:Name="GroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:VersionGroup}">
                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Margin="0,0,0,6" Padding="0">
                                <StackPanel>
                                    <Grid Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                          MouseLeftButtonUp="VersionGroupHeader_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding GroupTitle}" FontSize="14" FontWeight="SemiBold"
                                                   Padding="12,12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Padding="12,12" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⌄"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="⌃"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                Margin="12,0,12,12">
                                        <StackPanel Visibility="{Binding HasRequiredDependencies, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,8,0,4">
                                            <TextBlock Text="{DynamicResource Str_Ui_Dependencies}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding RequiredDependencies}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ModrinthDependency}">
                                                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Margin="0,2" Padding="8,6">
                                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                                                <Run Text="{DynamicResource Str_Ui_Project_Id}"/><Run Text="{Binding ProjectId, Mode=OneWay}"/>
                                                                <Run Text="{DynamicResource Str_Ui_File}"/><Run Text="{Binding FileName, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock Text="{DynamicResource Str_Ui_Versions}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:InlineVersionEntry}">
                                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Margin="0,2" Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                                    <Run Text="{Binding VersionNumber, Mode=OneWay}"/>
                                                                    <Run Text="{DynamicResource Str_Ui_Supports}"/><Run Text="{Binding GameVersionsText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <!-- 按钮文案跟随宿主详情页的模式（下载中心=直接下载 / 一键开服=加入清单），
                                                                 绑定到 UserControl 自身的 EntryActionLabel 依赖属性上，
                                                                 由 code-behind 在构造函数里按 mode 一次性设好。 -->
                                                            <!-- 修复：同 DownloadCenterPage 里"下载"按钮的问题——这里原来也覆盖了
                                                                 Padding="14,6" FontSize="13"，比 PrimaryButton 默认的
                                                                 Padding="12,8" FontSize="15" 小，去掉覆盖统一大小。 -->
                                                            <Button Grid.Column="1" x:Name="EntryActionButton"
                                                                    Content="{Binding EntryActionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Style="{StaticResource PrimaryButton}"
                                                                    Tag="{Binding}"
                                                                    Click="EntryAction_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
