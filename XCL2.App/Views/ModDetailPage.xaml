<UserControl x:Class="XCL2.App.Views.ModDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:XCL2.App.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏：返回箭头 + 标题，仿视频/CurseForge 里"整页跳转详情"的样式，
             取代之前的"列表原地手风琴展开"。点返回箭头回到进入详情页之前的列表状态
             （由宿主页面/窗口在构造本控件时传入 onBack 回调，回调内部负责恢复筛选条件、
             搜索关键词、滚动位置、当前分页页码——本控件自己不关心"回哪"，只负责触发返回）。 -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="10,10,0,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="←" FontSize="16" Padding="10,4" Margin="0,0,10,0"
                        Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand"
                        Click="Back_Click" ToolTip="返回列表"/>
                <TextBlock Grid.Column="1" x:Name="TitleText" Text="详情" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- ===== 主体内容：滚动区域，依次是"简介卡片"和"版本分组列表"。 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
            <StackPanel Margin="0,0,0,10">

                <!-- 简介卡片：图标 + 标题 + 简介 + 元信息一行，下面是操作按钮行
                     （转到 Modrinth/CurseForge 原页、复制名称、以及一键开服清单模式下的
                     "加入清单"提示）。 -->
                <Border Background="{StaticResource SideBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8" Margin="0,0,14,0"
                                    Background="{StaticResource PanelBrush}" VerticalAlignment="Top">
                                <Image x:Name="IconImage" Width="56" Height="56" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="NameText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DescriptionText" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="MetaText" FontSize="12" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="OpenSourceButton" Content="转到来源页" Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Margin="0,0,8,0" Click="OpenSource_Click"/>
                            <Button x:Name="CopyNameButton" Content="复制名称" Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Margin="0,0,8,0" Click="CopyName_Click"/>
                            <Button x:Name="FavoriteButton" Content="☆ 收藏" Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Click="Favorite_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 数据包场景：选择要安装到哪个存档，清单模式/直接下载模式都需要，
                     放在版本列表上方，跟原展开面板里的位置保持一致。 -->
                <Border x:Name="SaveNamePanel" Background="{StaticResource SideBrush}" CornerRadius="8"
                        Padding="14" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="安装到存档：" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SaveNameCombo" Width="220" SelectionChanged="SaveNameCombo_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="LoadingText" Text="正在获取版本列表..." FontSize="13" Margin="4,10"
                           Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="NoResultText" Text="没有找到匹配的版本（可能是筛选的游戏版本不匹配）。"
                           FontSize="13" Margin="4,10" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>

                <!-- 版本分组列表：直接复用现有 VersionGroup/InlineVersionEntry 数据结构和
                     ModVersionGrouping 分组逻辑，跟旧的"卡片内联展开面板"是同一套数据，
                     只是现在整页展示、不需要再套一层"展开/收起外层卡片"。 -->
                <ItemsControl x:Name="GroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:VersionGroup}">
                            <Border Background="{StaticResource SideBrush}" CornerRadius="6" Margin="0,0,0,6" Padding="0">
                                <StackPanel>
                                    <Grid Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                          MouseLeftButtonUp="VersionGroupHeader_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding GroupTitle}" FontSize="14" FontWeight="SemiBold"
                                                   Padding="12,12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Padding="12,12" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⌄"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="⌃"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                Margin="12,0,12,12">
                                        <StackPanel Visibility="{Binding HasRequiredDependencies, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,8,0,4">
                                            <TextBlock Text="前置资源" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding RequiredDependencies}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ModrinthDependency}">
                                                        <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Margin="0,2" Padding="8,6">
                                                            <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                                                <Run Text="项目 ID: "/><Run Text="{Binding ProjectId, Mode=OneWay}"/>
                                                                <Run Text="  文件名: "/><Run Text="{Binding FileName, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock Text="版本列表" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:InlineVersionEntry}">
                                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Margin="0,2" Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                                    <Run Text="{Binding VersionNumber, Mode=OneWay}"/>
                                                                    <Run Text=" · 支持: "/><Run Text="{Binding GameVersionsText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <!-- 按钮文案跟随宿主详情页的模式（下载中心=直接下载 / 一键开服=加入清单），
                                                                 绑定到 UserControl 自身的 EntryActionLabel 依赖属性上，
                                                                 由 code-behind 在构造函数里按 mode 一次性设好。 -->
                                                            <Button Grid.Column="1" x:Name="EntryActionButton"
                                                                    Content="{Binding EntryActionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Style="{StaticResource PrimaryButton}"
                                                                    Padding="14,6" FontSize="13" Tag="{Binding}"
                                                                    Click="EntryAction_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
