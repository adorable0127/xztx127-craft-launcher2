<local:OverlayDialogControl x:Class="XCL2.App.Views.SkinModelViewerDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:XCL2.App.Views" MinWidth="560" MaxWidth="640" MinHeight="550" MaxHeight="640">
 <StackPanel Margin="20">
  <DockPanel Margin="0,0,0,10">
   <Button DockPanel.Dock="Right" Content="关闭" Padding="12,6" Click="Close_Click"/>
   <TextBlock Text="3D 皮肤纸娃娃" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
  </DockPanel>
  <!-- 说明：本弹窗永远挂在 MainWindow 的 OverlayContentHost 下面（见 OverlayDialogControl /
       OverlayDialogService），跟它同一个 Grid 里的 OverlayCard/OverlayCardBackgroundLayer
       分别挂着 DropShadowEffect 和 PopupBlurEffect（哪怕 Radius=0）。WPF 的 Viewport3D 是
       走独立的 Direct3D 表面合成的，只要同一窗口里有 Effect 需要软件/中间表面合成，
       Viewport3D 就可能出现纹理错位、撕裂、甚至背后内容透出来的花屏（3D 纸娃娃拼装显示
       混乱、背后能看到"登录/皮肤/导入头像照片"这类别的页面文字，都是这个已知问题的
       典型症状）——不管是从"账户"页的微软账户还是皮肤站(AuthServer)账户入口打开本弹窗，
       只要弹窗本身是以 Overlay 形式显示，就会踩中同一个坑，不是分别两个独立 bug。
       修法：给 Viewport3D 所在的整块内容加 CacheMode="BitmapCache"，强制 WPF 先把这块
       3D 内容整体栅格化成一张位图再参与外层合成，绕开"3D 表面 + Effect 表面"直接混合
       导致的错位/透花问题。 -->
  <Border Background="{DynamicResource SideBrush}" CornerRadius="12" ClipToBounds="True"
          CacheMode="BitmapCache">
   <Viewport3D x:Name="ModelViewport" Height="390" Cursor="Hand" CacheMode="BitmapCache"
               MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
               MouseMove="Viewport_MouseMove" MouseWheel="Viewport_MouseWheel">
    <Viewport3D.Camera>
     <PerspectiveCamera x:Name="ModelCamera" Position="0,2.2,8" LookDirection="0,0,-8" FieldOfView="38"/>
    </Viewport3D.Camera>
    <ModelVisual3D><ModelVisual3D.Content><Model3DGroup>
     <AmbientLight Color="#777777"/>
     <DirectionalLight Color="White" Direction="-1,-2,-3"/>
    </Model3DGroup></ModelVisual3D.Content></ModelVisual3D>
   </Viewport3D>
  </Border>
  <TextBlock x:Name="SkinSourceText" Margin="0,8,0,10" TextWrapping="Wrap" FontSize="11"/>
  <StackPanel Orientation="Horizontal">
   <TextBlock Text="动作：" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <ComboBox x:Name="MotionCombo" SelectedIndex="0" Width="170" SelectionChanged="MotionCombo_SelectionChanged">
    <ComboBoxItem Content="站立" Tag="idle"/>
    <ComboBoxItem Content="走动" Tag="walk"/>
    <ComboBoxItem Content="攻击" Tag="attack"/>
    <ComboBoxItem Content="被攻击" Tag="hurt"/>
    <ComboBoxItem Content="疾跑" Tag="sprint"/>
   </ComboBox>
   <TextBlock Text="按住鼠标左键拖动旋转，滚轮缩放" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
  </StackPanel>
 </StackPanel>
</local:OverlayDialogControl>