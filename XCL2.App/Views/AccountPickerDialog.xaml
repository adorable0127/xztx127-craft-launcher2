<local:OverlayDialogControl x:Class="XCL2.App.Views.AccountPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="460" Height="480">
    <!-- 迁移自原 AccountPickerWindow（独立 Window）。原版内部自带一层
         Border(PanelBrush)+外层 Window(SideBrush) 的"卡中卡"效果，是因为独立 Window
         需要自己撑出弹窗卡片的视觉观感；现在 OverlayCard 已经统一提供了圆角卡片背景+
         阴影（见 MainWindow.xaml），这里去掉内层多余的 Border，直接用 DockPanel，
         避免出现"卡片里又是一层圆角卡片"的双层观感。 -->
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="选择要用来启动游戏的账户" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="点两下账户可以直接启动；也可以选中后点下方「使用这个账户启动」。没有想要的账户？可以在下面直接添加一个。"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <CheckBox DockPanel.Dock="Bottom" x:Name="RememberChoiceCheck"
                  Margin="0,12,0,8" VerticalContentAlignment="Top">
            <TextBlock Text="记住这次选择，以后启动不再询问（可在「账户管理」页随时切换）"
                       TextWrapping="Wrap" Margin="4,0,0,0"/>
        </CheckBox>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Padding="14,8" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="ConfirmBtn" Content="使用这个账户启动" Style="{StaticResource PrimaryButton}"
                    Padding="14,8" Click="Confirm_Click"/>
        </StackPanel>

        <!-- 添加账户区域：离线/浏览器登录/内嵌登录三种方式都直接放在这个弹窗里，不需要
             用户先取消这个弹窗、跳去"账户管理"页添加完账户、再重新点一次启动才能回到这里。
             新建/登录成功后不会自动选中（见 AccountPickerDialog.xaml.cs 里对应事件处理器的
             注释），只是刷新下面的列表，由用户自己点选。 -->
        <Expander DockPanel.Dock="Bottom" Header="添加账户" Margin="0,10,0,0" x:Name="AddAccountExpander">
            <StackPanel Margin="4,10,4,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="OfflineNameBox" Width="140" Padding="6" VerticalContentAlignment="Center" Text="Player"/>
                    <Button Content="添加离线账户" Margin="8,0,0,0" Padding="8,6" Click="AddOffline_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="添加微软账户（浏览器登录）" Padding="8,6" Click="AddMicrosoft_Click"/>
                    <Button Content="添加微软账户（内嵌登录）" Margin="8,0,0,0" Padding="8,6" Click="AddMicrosoftEmbedded_Click"/>
                </StackPanel>
                <TextBlock x:Name="AddAccountStatusText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Expander>

        <ListBox x:Name="AccountListBox" DisplayMemberPath="DisplayLabel"
                 MouseDoubleClick="AccountListBox_MouseDoubleClick"/>
    </DockPanel>
</local:OverlayDialogControl>
