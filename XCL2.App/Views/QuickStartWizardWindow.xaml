<Window x:Class="XCL2.App.Views.QuickStartWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一键开始游戏" Height="640" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SideBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="一键开始游戏" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="从账户到启动，一路走完就能开玩；每一步（Mod/资源包/光影包）都可以跳过。也可以直接导入整合包，跳过后面所有选择步骤。"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 步骤指示条：第 0 步（选择来源）不点亮任何格子，进入下载流程后从第 1 步开始点亮 -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <Border x:Name="StepDot1" CornerRadius="6" Height="6" Margin="0,0,4,0" Background="#DDDDDD"/>
            <Border x:Name="StepDot2" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="#DDDDDD"/>
            <Border x:Name="StepDot3" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="#DDDDDD"/>
            <Border x:Name="StepDot4" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="#DDDDDD"/>
            <Border x:Name="StepDot5" CornerRadius="6" Height="6" Margin="4,0,0,0" Background="#DDDDDD"/>
        </UniformGrid>

        <!-- 步骤内容区 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- 步骤 0：选择来源（新下载 / 使用现有实例 / 傻瓜式启动 / 导入整合包） -->
                <StackPanel x:Name="Step0Panel" Visibility="Visible">
                    <TextBlock Text="开始之前：怎么玩？" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16">
                        选一种最适合你的方式，选完就会跳到对应的准备步骤。
                    </TextBlock>

                    <RadioButton x:Name="SourceModeDownload" GroupName="SourceMode" IsChecked="True"
                                 Checked="SourceMode_Changed" Margin="0,0,0,10">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="🚀 一键下载游戏" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="第一次玩，或者想装一个全新版本 / Mod 整合，跟着向导一步步选账户、版本、Mod。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SourceModeSimple" GroupName="SourceMode"
                                 Checked="SourceMode_Changed" Margin="0,0,0,10">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="⚡ 傻瓜式启动游戏" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="SimpleModeHintText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- “傻瓜式启动”子面板：只能从已经导入过的文件夹(cfg.Folders)里选，跟下面
                         “使用现有实例”(任意 .minecraft 目录，包括其它启动器的)是两回事——
                         这里体现的是"用户必须已经导入安装文件夹才可以选择"这条要求。 -->
                    <Border x:Name="SimpleModePanel" Visibility="Collapsed" Background="{StaticResource SideBrush}"
                            CornerRadius="8" Padding="14" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock Text="选择一个已导入的文件夹" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="SimpleFolderCombo" Style="{StaticResource FilterComboBox}" Height="34" Margin="0,0,0,10"
                                      SelectionChanged="SimpleFolderCombo_SelectionChanged"/>
                            <TextBlock Text="选择要启动的版本" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="SimpleVersionCombo" Style="{StaticResource FilterComboBox}" Height="34" Margin="0,0,0,8"/>
                            <TextBlock x:Name="SimpleModeStatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <RadioButton x:Name="SourceModeExisting" GroupName="SourceMode"
                                 Checked="SourceMode_Changed" Margin="0,0,0,10">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="📁 使用现有实例" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="已经有一个 .minecraft 文件夹（比如以前用过官方启动器/其它启动器），直接指过去，跳过下载，自动匹配 Java 就能启动。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SourceModeModpack" GroupName="SourceMode"
                                 Checked="SourceMode_Changed" Margin="0,0,0,10">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="📦 导入整合包（Modrinth / .zip / .xclpack）" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="已经下载好了一个整合包文件，直接导入，跳过选版本/选 Mod 这些步骤。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- “使用现有实例”子面板：选文件夹 + 扫描出的版本列表 -->
                    <Border x:Name="ExistingInstancePanel" Visibility="Collapsed" Background="{StaticResource SideBrush}"
                            CornerRadius="8" Padding="14" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text=".minecraft 文件夹位置" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ExistingFolderCombo" Grid.Column="0" Style="{StaticResource FilterComboBox}"
                                          Height="34" SelectionChanged="ExistingFolderCombo_SelectionChanged"/>
                                <Button Grid.Column="1" Content="浏览其它位置..." Margin="8,0,0,0" Padding="12,8" Click="BrowseExistingFolder_Click"/>
                            </Grid>
                            <TextBlock Text="选择这个文件夹里已装好的版本" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ExistingVersionCombo" Style="{StaticResource FilterComboBox}" Height="34" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ExistingInstanceStatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- “导入整合包”子面板 -->
                    <Border x:Name="ModpackImportPanel" Visibility="Collapsed" Background="{StaticResource SideBrush}"
                            CornerRadius="8" Padding="14" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10">
                                支持 .xclpack（本启动器的整合包格式）、Modrinth 的 .mrpack，以及普通 .zip 整合包。
                                导入完成后会直接跳到「账户」步骤，账户选好即可启动。
                            </TextBlock>
                            <Button x:Name="ImportModpackBtn" Content="选择整合包文件..." HorizontalAlignment="Left"
                                    Padding="12,8" Click="ImportModpackShortcut_Click"/>
                            <TextBlock x:Name="ModpackImportStatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 步骤 1：账户 -->
                <StackPanel x:Name="Step1Panel" Visibility="Collapsed">
                    <TextBlock Text="第一步：账户" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16">
                        没有正版账户也没关系，可以先用离线账户体验（仅能进单机/离线服务器）；也可以直接在这里登录微软正版账户。
                    </TextBlock>
                    <TextBlock x:Name="AccountStatusText" Text="" Margin="0,0,0,12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>

                    <!-- 内联账户选择框：已有账户时可以直接从下拉框里选一个，不需要重新创建/登录 -->
                    <StackPanel x:Name="ExistingAccountPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="选择一个已有账户" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ExistingAccountCombo" Grid.Column="0" Style="{StaticResource FilterComboBox}"
                                      Height="34" DisplayMemberPath="DisplayLabel" SelectionChanged="ExistingAccountCombo_SelectionChanged"/>
                            <Button Grid.Column="1" Content="＋新增账户" Margin="8,0,0,0" Padding="12,8" Click="ShowNewAccountPanel_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="NewAccountPanel" Visibility="Visible">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="AccountModeOffline" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                                         Content="离线账户" Checked="AccountMode_Checked" Margin="0,0,6,0"/>
                            <RadioButton x:Name="AccountModeMicrosoft" Style="{StaticResource DownloadCategoryButton}"
                                         Content="微软正版账户" Checked="AccountMode_Checked"/>
                        </StackPanel>

                    <StackPanel x:Name="OfflineAccountPanel" Visibility="Visible">
                        <TextBlock Text="离线用户名" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OfflineNameBox" Padding="8" Text="Player"/>
                            <Button Grid.Column="1" Content="创建离线账户" Margin="8,0,0,0" Padding="12,8" Click="CreateOffline_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="MicrosoftAccountPanel" Visibility="Collapsed">
                        <Button x:Name="MicrosoftLoginBtn" Content="登录微软账户" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="0,0,0,8" Click="MicrosoftLogin_Click"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            会弹出一个设备代码窗口，按提示在浏览器里完成登录即可，登录成功后账户会自动保存，
                            以后在「账户管理」页也能看到它。
                        </TextBlock>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 步骤 2：版本 + 加载器 -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="第二步：选择版本 &amp; 加载器" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16">
                        不确定选什么就用默认的原版最新正式版；想装 Mod 就选一个加载器（Fabric 最简单，新手推荐）。
                    </TextBlock>

                    <TextBlock Text="游戏文件夹" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPathBox" Grid.Column="0" Padding="8"/>
                        <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Padding="12,8" Click="BrowseFolder_Click"/>
                    </Grid>

                    <TextBlock Text="加载器" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton x:Name="LoaderVanilla" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                                     Content="原版（不装加载器）" Checked="LoaderType_Checked" Tag="Vanilla" Margin="0,0,6,0"/>
                        <RadioButton x:Name="LoaderFabric" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Fabric" Checked="LoaderType_Checked" Tag="Fabric" Margin="0,0,6,0"/>
                        <RadioButton x:Name="LoaderForge" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Forge" Checked="LoaderType_Checked" Tag="Forge" Margin="0,0,6,0"/>
                        <RadioButton x:Name="LoaderNeoForge" Style="{StaticResource DownloadCategoryButton}"
                                     Content="NeoForge" Checked="LoaderType_Checked" Tag="NeoForge"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Minecraft 版本" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="McVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"
                                      SelectionChanged="McVersionCombo_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" x:Name="BuildVersionPanel" Visibility="Collapsed">
                            <TextBlock x:Name="BuildVersionLabel" Text="加载器版本" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="BuildVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="InstallFabricApiCheck" Content="同时安装 Fabric API（很多 Fabric 模组依赖它，建议勾选）"
                              IsChecked="True" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <!-- 高级选项：默认折叠，避免新手第一眼就被一堆参数吓到；勾选后展开，
                         对应用户截图里要求补齐的"游戏参数""启动前执行命令""默认版本隔离""窗口大小"。 -->
                    <CheckBox x:Name="ShowAdvancedOptionsCheck" Content="高级选项（自定义启动参数 / 窗口大小 / 版本隔离等）"
                              Checked="ShowAdvancedOptions_Changed" Unchecked="ShowAdvancedOptions_Changed" Margin="0,4,0,0"/>

                    <Border x:Name="AdvancedOptionsPanel" Visibility="Collapsed" Background="{StaticResource SideBrush}"
                            CornerRadius="8" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="自定义游戏/JVM 参数" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="CustomJvmArgsBox" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,0,10"
                                     ToolTip="例如：-Dfile.encoding=UTF-8，多个参数用空格分隔"/>

                            <TextBlock Text="启动前执行命令（可选）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PreLaunchCommandBox" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,0,10"
                                     ToolTip="启动游戏前自动执行的命令行，例如同步配置的脚本；执行失败不影响游戏正常启动"/>

                            <CheckBox x:Name="IsolateVersionCheck" Content="为这个版本单独启用「版本隔离」(mods/资源包/存档等独立存放，与官方启动器行为一致)"
                                      IsChecked="True" Margin="0,0,0,10"/>

                            <TextBlock Text="窗口大小" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WindowWidthBox" Grid.Column="0" Padding="8" Text="854"/>
                                <TextBox x:Name="WindowHeightBox" Grid.Column="2" Padding="8" Text="480"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="Step2StatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 步骤 3：Mod（可跳过） -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="第三步：选 Mod（可跳过）" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="Step3HintText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12">
                        搜索想要的 Mod，勾选后会在最后统一下载。原版（没选加载器）无法装 Mod，这一步会自动跳过。
                    </TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ModSearchBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,8,0"
                                 KeyDown="ModSearchBox_KeyDown"/>
                        <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButton}" Click="ModSearch_Click"/>
                    </Grid>
                    <ListBox x:Name="ModResultsList" Height="260" SelectionMode="Multiple" BorderThickness="1"
                             BorderBrush="{StaticResource BorderBrush2}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ModSelectedCountText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 步骤 4：资源包/光影包（可跳过） -->
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <TextBlock Text="第四步：选资源包 / 光影包（可跳过）" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12">
                        搜索想要的材质包或光影包，勾选后会在最后统一下载。
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="ResTypeResourcePack" GroupName="ResType" Content="材质包" IsChecked="True"
                                     Checked="ResourceType_Changed" Margin="0,0,16,0"/>
                        <RadioButton x:Name="ResTypeShader" GroupName="ResType" Content="光影包" Checked="ResourceType_Changed"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ResourceSearchBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,8,0"
                                 KeyDown="ResourceSearchBox_KeyDown"/>
                        <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButton}" Click="ResourceSearch_Click"/>
                    </Grid>
                    <ListBox x:Name="ResourceResultsList" Height="240" SelectionMode="Multiple" BorderThickness="1"
                             BorderBrush="{StaticResource BorderBrush2}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ResourceSelectedCountText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 步骤 5：下载 + 启动 -->
                <StackPanel x:Name="Step5Panel" Visibility="Collapsed">
                    <TextBlock Text="第五步：确认 &amp; 一键启动" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,16"/>

                    <StackPanel x:Name="RunPanel" Visibility="Collapsed">
                        <TextBlock x:Name="RunStageText" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RunDetailText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="RunBar" Height="10" Minimum="0" Maximum="100"/>
                    </StackPanel>

                    <Button x:Name="StartAllBtn" Content="🚀 开始下载并启动游戏" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Padding="0,14" Margin="0,20,0,0" Click="StartAll_Click"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="关闭" Padding="12,8" Click="Close_Click"/>

            <Button Grid.Column="2" x:Name="BackBtn" Content="上一步" Padding="16,8" Margin="0,0,8,0" Click="Back_Click" IsEnabled="False"/>
            <Button Grid.Column="3" x:Name="NextBtn" Content="下一步" Style="{StaticResource PrimaryButton}" Padding="16,8" Click="Next_Click"/>
        </Grid>
    </Grid>
</Window>
