<local:OverlayDialogControl x:Class="XCL2.App.Views.QuickStartWizardWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="760"
                            MaxWidth="760"
                            MinHeight="640"
                            MaxHeight="640">
                            <!-- MinHeight 必须给：这个弹窗的布局里有 RowDefinition Height="*"。
                                 原来是 Window 且有固定 Height 时，"*"行能拿到剩余高度；
                                 改成挂在自适应 OverlayCard 里的 UserControl 之后，
                                 测量高度是无穷大，"*"行会塌陷成内容的期望高度——
                                 列表为空/WebView2 这种没有期望尺寸的控件会直接塌成 0，
                                 表现就是弹窗里一片空白。MinHeight 用回原来的设计高度即可。 -->
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Str_Home_Tile_QuickStart_Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource Str_Ui_Takes_You_From_Account_To_Launch_In_One_}"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 步骤指示条：第 0 步（选择来源）不点亮任何格子，进入下载流程后从第 1 步开始点亮 -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <Border x:Name="StepDot1" CornerRadius="6" Height="6" Margin="0,0,4,0" Background="{DynamicResource DividerBrush}"/>
            <Border x:Name="StepDot2" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="{DynamicResource DividerBrush}"/>
            <Border x:Name="StepDot3" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="{DynamicResource DividerBrush}"/>
            <Border x:Name="StepDot4" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="{DynamicResource DividerBrush}"/>
            <Border x:Name="StepDot5" CornerRadius="6" Height="6" Margin="4,0,0,0" Background="{DynamicResource DividerBrush}"/>
        </UniformGrid>

        <!-- 步骤内容区 -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- 整页详情容器：点击步骤3的 Mod 条目时盖住整个步骤内容区，展示 ModDetailPage
                     （AddToWizardList 模式，选具体版本后加入下面的"已选清单"，不在这里直接下载）。
                     跟 DownloadCenterPage.xaml 里 DetailHost 是同一个模式。 -->
                <ContentControl x:Name="DetailHost" Visibility="Collapsed"/>

                <!-- 步骤 0：选择来源（新下载 / 使用现有实例 / 傻瓜式启动 / 导入整合包） -->
                <StackPanel x:Name="Step0Panel" Visibility="Visible">
                    <TextBlock Text="{DynamicResource Str_Ui_Before_You_Start_How_Does_This_Work}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                        选一种最适合你的方式，选完就会跳到对应的准备步骤。
                    </TextBlock>

                    <RadioButton x:Name="SourceModeDownload" GroupName="SourceMode" IsChecked="True"
                                 Checked="SourceMode_Changed" Margin="0,0,0,10">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="{DynamicResource Str_Ui_One_Click_Download}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{DynamicResource Str_Ui_New_Here_Or_Setting_Up_A_Fresh_Version_O}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SourceModeSimple" GroupName="SourceMode"
                                 Checked="SourceMode_Changed" Margin="0,0,0,10">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="{DynamicResource Str_Ui_Guided_Launch}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="SimpleModeHintText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- “傻瓜式启动”子面板：只能从已经导入过的文件夹(cfg.Folders)里选，跟下面
                         “使用现有实例”(任意 .minecraft 目录，包括其它启动器的)是两回事——
                         这里体现的是"用户必须已经导入安装文件夹才可以选择"这条要求。 -->
                    <Border x:Name="SimpleModePanel" Visibility="Collapsed" Background="{DynamicResource SideBrush}"
                            CornerRadius="8" Padding="14" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Ui_Choose_A_Folder_You_Have_Already_Added}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="SimpleFolderCombo" Style="{StaticResource FilterComboBox}" Height="34" Margin="0,0,0,10"
                                      SelectionChanged="SimpleFolderCombo_SelectionChanged"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Choose_A_Version_To_Launch}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="SimpleVersionCombo" Style="{StaticResource FilterComboBox}" Height="34" Margin="0,0,0,8"/>
                            <TextBlock x:Name="SimpleModeStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <RadioButton x:Name="SourceModeExisting" GroupName="SourceMode"
                                 Checked="SourceMode_Changed" Margin="0,0,0,10">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="{DynamicResource Str_Ui_Use_An_Existing_Instance}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Already_Have_A_Minecraft_Folder_From_The}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SourceModeModpack" GroupName="SourceMode"
                                 Checked="SourceMode_Changed" Margin="0,0,0,10">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="{DynamicResource Str_Ui_Import_A_Modpack_Modrinth_Zip_Xclpack}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Already_Have_A_Modpack_File_Import_It_Di}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- “使用现有实例”子面板：选文件夹 + 扫描出的版本列表 -->
                    <Border x:Name="ExistingInstancePanel" Visibility="Collapsed" Background="{DynamicResource SideBrush}"
                            CornerRadius="8" Padding="14" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Ui_Minecraft_Folder_Location}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ExistingFolderCombo" Grid.Column="0" Style="{StaticResource FilterComboBox}"
                                          Height="34" SelectionChanged="ExistingFolderCombo_SelectionChanged"/>
                                <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Browse_Another_Location}" Margin="8,0,0,0" Padding="12,8" Click="BrowseExistingFolder_Click"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Str_Ui_Pick_A_Version_Already_Installed_In_This}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ExistingVersionCombo" Style="{StaticResource FilterComboBox}" Height="34" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ExistingInstanceStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- “导入整合包”子面板 -->
                    <Border x:Name="ModpackImportPanel" Visibility="Collapsed" Background="{DynamicResource SideBrush}"
                            CornerRadius="8" Padding="14" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10">
                                支持 .xclpack（本启动器的整合包格式）、Modrinth 的 .mrpack，以及普通 .zip 整合包。
                                导入完成后会直接跳到「账户」步骤，账户选好即可启动。
                            </TextBlock>
                            <Button x:Name="ImportModpackBtn" Content="{DynamicResource Str_Ui_Choose_A_Modpack_File}" HorizontalAlignment="Left"
                                    Padding="12,8" Click="ImportModpackShortcut_Click"/>
                            <TextBlock x:Name="ModpackImportStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 步骤 1：账户 -->
                <StackPanel x:Name="Step1Panel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Ui_Step_1_Account}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                        没有正版账户也没关系，可以先用离线账户体验（仅能进单机/离线服务器）；也可以直接在这里登录微软正版账户。
                    </TextBlock>
                    <TextBlock x:Name="AccountStatusText" Text="" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>

                    <!-- 内联账户选择框：已有账户时可以直接从下拉框里选一个，不需要重新创建/登录 -->
                    <StackPanel x:Name="ExistingAccountPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Str_Ui_Choose_An_Existing_Account}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ExistingAccountCombo" Grid.Column="0" Style="{StaticResource FilterComboBox}"
                                      Height="34" DisplayMemberPath="DisplayLabel" SelectionChanged="ExistingAccountCombo_SelectionChanged"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Add_Account_2}" Margin="8,0,0,0" Padding="12,8" Click="ShowNewAccountPanel_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="NewAccountPanel" Visibility="Visible">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="AccountModeOffline" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                                         Content="{DynamicResource Str_Ui_Offline_Account}" Checked="AccountMode_Checked" Margin="0,0,6,0"/>
                            <RadioButton x:Name="AccountModeMicrosoft" Style="{StaticResource DownloadCategoryButton}"
                                         Content="{DynamicResource Str_Ui_Microsoft_Account}" Checked="AccountMode_Checked"/>
                        </StackPanel>

                    <StackPanel x:Name="OfflineAccountPanel" Visibility="Visible">
                        <TextBlock Text="{DynamicResource Str_Ui_Offline_Username}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OfflineNameBox" Padding="8" Text="Player"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Create_Offline_Account}" Margin="8,0,0,0" Padding="12,8" Click="CreateOffline_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="MicrosoftAccountPanel" Visibility="Collapsed">
                        <Button x:Name="MicrosoftLoginBtn" Content="{DynamicResource Str_Ui_Sign_In_With_Microsoft}" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="0,0,0,8" Click="MicrosoftLogin_Click"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                            会弹出一个设备代码窗口，按提示在浏览器里完成登录即可，登录成功后账户会自动保存，
                            以后在「账户管理」页也能看到它。
                        </TextBlock>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 步骤 2：版本 + 加载器 -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Ui_Step_2_Choose_A_Version_Amp_Loader}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                        不确定选什么就用默认的原版最新正式版；想装 Mod 就选一个加载器（Fabric 最简单，新手推荐）。
                    </TextBlock>

                    <TextBlock Text="{DynamicResource Str_Ui_Game_Folder}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPathBox" Grid.Column="0" Padding="8"/>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Browse}" Margin="8,0,0,0" Padding="12,8" Click="BrowseFolder_Click"/>
                    </Grid>

                    <!-- 需求修复："在一键启动游戏页面里没法显示自定义设置实例名"。
                         InstallClientLoaderWindow（下载中心里单独安装加载器的窗口）早就支持
                         自定义实例名（customInstanceName 参数，见 InstanceNameBox），但"一键启动"
                         这个向导页面之前完全没有暴露对应的输入框，用户没有任何地方能在一键流程里
                         设置实例名，装完只能拿到默认命名（比如 "fabric-loader-xxx-1.20.1"）。
                         这里补上同样的输入框，留空表示不自定义、退回默认命名，跟原有行为完全兼容。 -->
                    <TextBlock Text="{DynamicResource Str_Ui_Instance_Name}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="QuickStartInstanceNameBox" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource Str_Ui_Loader}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton x:Name="LoaderVanilla" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                                     Content="{DynamicResource Str_Ui_Vanilla_No_Loader}" Checked="LoaderType_Checked" Tag="Vanilla" Margin="0,0,6,0"/>
                        <RadioButton x:Name="LoaderFabric" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Fabric" Checked="LoaderType_Checked" Tag="Fabric" Margin="0,0,6,0"/>
                        <RadioButton x:Name="LoaderForge" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Forge" Checked="LoaderType_Checked" Tag="Forge" Margin="0,0,6,0"/>
                        <RadioButton x:Name="LoaderNeoForge" Style="{StaticResource DownloadCategoryButton}"
                                     Content="NeoForge" Checked="LoaderType_Checked" Tag="NeoForge"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Str_Ui_Minecraft_Version}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="McVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"
                                      SelectionChanged="McVersionCombo_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" x:Name="BuildVersionPanel" Visibility="Collapsed">
                            <TextBlock x:Name="BuildVersionLabel" Text="{DynamicResource Str_Ui_Loader_Version}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="BuildVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="InstallFabricApiCheck" Content="{DynamicResource Str_Ui_Also_Install_Fabric_Api_Many_Fabric_Mods}"
                              IsChecked="True" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <!-- 高级选项：默认折叠，避免新手第一眼就被一堆参数吓到；勾选后展开，
                         对应用户截图里要求补齐的"游戏参数""启动前执行命令""默认版本隔离""窗口大小"。 -->
                    <CheckBox x:Name="ShowAdvancedOptionsCheck" Content="{DynamicResource Str_Ui_Advanced_Options_Custom_Arguments_Window}"
                              Checked="ShowAdvancedOptions_Changed" Unchecked="ShowAdvancedOptions_Changed" Margin="0,4,0,0"/>

                    <Border x:Name="AdvancedOptionsPanel" Visibility="Collapsed" Background="{DynamicResource SideBrush}"
                            CornerRadius="8" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Ui_Custom_Game_Jvm_Arguments}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="CustomJvmArgsBox" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,0,10"
                                     ToolTip="{DynamicResource Str_Ui_E_G_Dfile_Encoding_Utf_8_Separate_Multip}"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Command_To_Run_Before_Launch_Optional}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PreLaunchCommandBox" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,0,10"
                                     ToolTip="{DynamicResource Str_Ui_A_Command_Run_Automatically_Before_Launc}"/>

                            <CheckBox x:Name="IsolateVersionCheck" Content="{DynamicResource Str_Ui_Turn_On_Version_Isolation_For_This_Insta}"
                                      IsChecked="True" Margin="0,0,0,10"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Window_Size}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WindowWidthBox" Grid.Column="0" Padding="8" Text="854"/>
                                <TextBox x:Name="WindowHeightBox" Grid.Column="2" Padding="8" Text="480"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="Step2StatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 步骤 3：Mod（可跳过）—— 点击条目跳转 ModDetailPage 选具体版本，选完加入下面的
                     "已选清单"；不再是"勾选 + 自动匹配最新版"，清单里锁定的是具体版本文件。 -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Ui_Step_3_Pick_Mods_Optional}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="Step3HintText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12">
                        搜索想要的 Mod，点进条目选择具体版本后会加入下面的"已选清单"，最后按清单里锁定的版本下载。
                        原版（没选加载器）无法装 Mod，这一步会自动跳过。
                    </TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ModSearchBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,8,0"
                                 KeyDown="ModSearchBox_KeyDown"/>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Common_Search}" Style="{StaticResource PrimaryButton}" Click="ModSearch_Click"/>
                    </Grid>
                    <ListBox x:Name="ModResultsList" Height="180" BorderThickness="1"
                             BorderBrush="{DynamicResource BorderBrush2}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4" Tag="{Binding}" MouseLeftButtonUp="ModResultItem_Click" Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{DynamicResource Str_Ui_Selected_Items}" FontWeight="Bold" FontSize="13" Margin="0,14,0,6"/>
                    <ListBox x:Name="ModSelectedList" Height="140" BorderThickness="1"
                             BorderBrush="{DynamicResource BorderBrush2}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding VersionLabel}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Remove}" Tag="{Binding}" Click="RemoveModSelection_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ModSelectedCountText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 步骤 4：资源包/光影包（可跳过） -->
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Ui_Step_4_Pick_Resource_And_Shader_Packs_Op}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12">
                        搜索想要的材质包或光影包，勾选后会在最后统一下载。
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="ResTypeResourcePack" GroupName="ResType" Content="{DynamicResource Str_Ui_Resource_Packs}" IsChecked="True"
                                     Checked="ResourceType_Changed" Margin="0,0,16,0"/>
                        <RadioButton x:Name="ResTypeShader" GroupName="ResType" Content="{DynamicResource Str_Ui_Shader_Packs}" Checked="ResourceType_Changed"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ResourceSearchBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,8,0"
                                 KeyDown="ResourceSearchBox_KeyDown"/>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Common_Search}" Style="{StaticResource PrimaryButton}" Click="ResourceSearch_Click"/>
                    </Grid>
                    <ListBox x:Name="ResourceResultsList" Height="240" SelectionMode="Multiple" BorderThickness="1"
                             BorderBrush="{DynamicResource BorderBrush2}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ResourceSelectedCountText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 步骤 5：下载 + 启动 -->
                <StackPanel x:Name="Step5Panel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Ui_Step_5_Review_Amp_Launch}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,16"/>

                    <StackPanel x:Name="RunPanel" Visibility="Collapsed">
                        <TextBlock x:Name="RunStageText" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RunDetailText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="RunBar" Height="10" Minimum="0" Maximum="100"/>
                    </StackPanel>

                    <Button x:Name="StartAllBtn" Content="{DynamicResource Str_Ui_Download_And_Launch}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Padding="0,14" Margin="0,20,0,0" Click="StartAll_Click"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{DynamicResource Str_Common_Close}" Padding="12,8" Click="Close_Click"/>

            <Button Grid.Column="2" x:Name="BackBtn" Content="{DynamicResource Str_Ui_Back}" Padding="16,8" Margin="0,0,8,0" Click="Back_Click" IsEnabled="False"/>
            <Button Grid.Column="3" x:Name="NextBtn" Content="{DynamicResource Str_Common_Next}" Style="{StaticResource PrimaryButton}" Padding="16,8" Click="Next_Click"/>
        </Grid>
    </Grid>
</local:OverlayDialogControl>
