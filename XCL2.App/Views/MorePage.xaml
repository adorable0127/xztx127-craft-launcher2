<UserControl x:Class="XCL2.App.Views.MorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 磁贴样式直接从 HomePage.xaml 复制过来一份（那几个 Style 目前只在 HomePage.xaml
         内部定义，没有挪到 App.xaml 全局资源），保持跟首页磁贴完全一致的视觉风格。
         如果以后要挪成全局资源，记得同时把 HomePage.xaml 里的本地定义删掉，避免样式冲突。 -->
    <UserControl.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TileTranslate" Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource GlowBrush}"/>
                                <Setter TargetName="TileBorder" Property="Effect" Value="{StaticResource GlowEffect}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource SideBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileIconBadge" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="TileIconText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TileDescText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="更多" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="简洁模式下，以下功能从侧边栏收起，可以在这里找到" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <UniformGrid x:Name="TileGrid" Grid.Row="1" Columns="3" Margin="0,0,-10,-6">
                <Button x:Name="MultiplayerTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="MultiplayerTile_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeBlueBrush}">
                            <TextBlock Text="&#127760;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="联机大厅" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="多人游戏、陶瓦联机、局域网" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ModManagerTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="ModManagerTile_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeIndigoBrush}">
                            <TextBlock Text="&#129513;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="Mod 管理" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="本地 Mod 管理" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ServerManagerTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="ServerManagerTile_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgePurpleBrush}">
                            <TextBlock Text="&#128423;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="服务器管理" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="开服、服务器管理" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ToolboxTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="ToolboxTile_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeOrangeBrush}">
                            <TextBlock Text="&#128230;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="百宝箱" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="工具箱、计算器、数据包转换、结构查询、便签" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BedrockTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="BedrockTile_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeGreenBrush}">
                            <TextBlock Text="&#128337;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="基岩版启动" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="Bedrock 基岩版" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AboutHelpTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="AboutHelpTile_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource SideBrush}">
                            <TextBlock Text="&#8505;" Style="{StaticResource TileIconText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock Text="鸣谢与帮助" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="关于、帮助、赞助、开源仓库" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="LogsTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="LogsTile_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeBlueBrush}">
                            <TextBlock Text="&#128220;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="日志" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="崩溃日志、报错" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AiAssistantTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="AiAssistantTile_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeIndigoBrush}">
                            <TextBlock Text="&#129302;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="AI 助手" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="智能助手、聊天" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ExperimentalTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="ExperimentalTile_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeOrangeBrush}">
                            <TextBlock Text="&#129514;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="实验性功能" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="实验室、测试功能" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
