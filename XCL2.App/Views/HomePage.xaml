<UserControl x:Class="XCL2.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 磁贴统一样式：白底卡片 + 细描边，跟 App.xaml 里 GlowEffect/GlowSoftBrush 那套
             "边缘发光"科技感悬浮语言保持一致（原来 hover 时整块背景变成 AccentBrush 太生硬，
             跟输入框/按钮的 hover 效果不是一套视觉体系，这里改成跟它们一致的描边发光 + 轻微上浮）。 -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TileTranslate" Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource GlowBrush}"/>
                                <Setter TargetName="TileBorder" Property="Effect" Value="{StaticResource GlowEffect}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource SideBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 磁贴图标徽标：圆角小方块背景 + emoji 图标，每个磁贴一个独立强调色，
             让六个功能在视觉上一眼可分辨，而不是全部同一种灰底图标堆在一起。 -->
        <Style x:Key="TileIconBadge" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="TileIconText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TileDescText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>

        <!-- 「语言」按钮外观跟访客模式那组胶囊按钮保持一致，但它是普通 Button（点击打开
             语言选择弹窗，不是"开/关"状态），不能直接复用 GuestModeToggleStyle——那个样式
             TargetType 是 ToggleButton，里面还有一个 IsChecked 触发器，Button 没有 IsChecked
             这个属性，把 ToggleButton 专用样式套到 Button 上会在运行时抛
             InvalidOperationException("TargetType 与元素类型不匹配")。这里单独复制一份同样的
             胶囊外观，只去掉 IsChecked 触发器，其余（背景/圆角/hover 发光）完全一致。 -->
        <Style x:Key="LanguageEntryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Effect" Value="{StaticResource GlowEffect}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 访客模式开关（及本页其它同风格胶囊按钮）用的 GuestModeToggleStyle 已挪到
             App.xaml 全局资源，方便 AgreementsWindow 等其它地方复用，这里不再重复定义，
             直接引用全局的即可。 -->
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 右上角访客模式开关：原来在「设置」页里一个不起眼的勾选框，访客模式是"临时用一下、
                 用完就走"的场景，藏在设置页里太深，挪到首页最显眼的右上角，开关状态直接可见
                 （ToggleButton 本身当"当前是否访客模式"的状态展示，不用额外加文字说明）。
                 从左到右依次是：模式设置(深/浅色)、自动循环、普通模式/高级模式切换、访客模式，
                 全部做成同一个 GuestModeToggleStyle 胶囊按钮风格，保持视觉一致；点击立即写回
                 对应配置项并保存，跟「设置」页里的对应控件保持双向同步。 -->
            <!-- 修复：原来是不换行的横向 StackPanel，窗口没有足够宽度时（比如缩窄到
                 MinWidth=820，或者语言切换后某个按钮文案变长，像"访客模式：已开启"）
                 这一整条会被挤出右边界甚至互相压住文字。改成 WrapPanel：宽度不够时自动
                 换到第二行，而不是挤压/裁切；Grid.Row="0" 是 Auto 高度，换行后行高自动
                 增大，不会跟下面 Row="1" 的欢迎文案重叠。每个按钮统一补上 10px 下边距，
                 换行后两行之间也留出同样的间隙。 -->
            <WrapPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <!-- 「语言」按钮：放在整条按钮带最左边（其余按钮都是"深/浅色、自动循环、
                     专家/访客模式"这类跟当前会话相关的临时性开关，语言是更底层、更少切换
                     的设置，放在最左边跟其它开关拉开一点视觉区分）。点击打开独立的语言
                     选择弹窗（LanguageSelectDialog），选择后立即切换+保存，弹窗自己关闭，
                     这里不需要维护选中状态。 -->
                <Button x:Name="LanguageEntryButton" Margin="0,0,10,10"
                        Style="{StaticResource LanguageEntryButtonStyle}"
                        Click="LanguageEntryButton_Click"
                        ToolTip="{DynamicResource Str_Ui_Changes_The_Launcher_S_Language_Only_The}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#127760;" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Str_Lang_EntryButton}" FontSize="13"/>
                    </StackPanel>
                </Button>

                <!-- 「模式设置」按钮：切换深色/浅色模式，跟「配色皮肤」选的色系是独立维度——
                     只切明暗，色相不变（比如色系选了蓝色，这里切换只是在"蓝色系-浅"和
                     "蓝色系-深"之间切）。点击立即写回 cfg.IsDarkMode 并保存、立即应用。
                     如果「自动循环」是开启状态，这里点击只是"临时覆盖"：到下一个自动切换
                     时间点，还是会被自动循环按计划重新接管——不会因为点了这个按钮就把
                     自动循环关掉。 -->
                <ToggleButton x:Name="DarkModeToggle" Margin="0,0,10,10"
                              Style="{StaticResource GuestModeToggleStyle}"
                              Checked="DarkModeToggle_Changed" Unchecked="DarkModeToggle_Changed"
                              ToolTip="{DynamicResource Str_Ui_Switches_Between_Dark_And_Light_It_Only_}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DarkModeToggleIcon" Text="&#9728;" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock x:Name="DarkModeToggleText" Text="{DynamicResource Str_Home_Toggle_LightMode}" FontSize="13"/>
                    </StackPanel>
                </ToggleButton>

                <!-- 「自动循环」按钮：开启后由系统当前时间自动决定深浅色模式，具体切换时间点
                     在「设置」页可自行调整（默认早 8:00~晚 19:00 浅色，其余深色）。 -->
                <ToggleButton x:Name="AutoThemeCycleToggle" Margin="0,0,10,10"
                              Style="{StaticResource GuestModeToggleStyle}"
                              Checked="AutoThemeCycleToggle_Changed" Unchecked="AutoThemeCycleToggle_Changed"
                              ToolTip="{DynamicResource Str_Ui_Switches_Between_Light_And_Dark_Automati}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#128260;" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock x:Name="AutoThemeCycleToggleText" Text="{DynamicResource Str_Home_Toggle_AutoCycle}" FontSize="13"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="ModeToggle" Margin="0,0,10,10"
                              Style="{StaticResource GuestModeToggleStyle}"
                              Checked="ModeToggle_Changed" Unchecked="ModeToggle_Changed"
                              ToolTip="{DynamicResource Str_Ui_Normal_Mode_Shows_Only_The_Essentials_An}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#9881;" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ModeToggleText" Text="{DynamicResource Str_Home_Toggle_NormalMode}" FontSize="13"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="GuestModeToggle" Margin="0,0,0,10"
                              Style="{StaticResource GuestModeToggleStyle}"
                              Checked="GuestModeToggle_Changed" Unchecked="GuestModeToggle_Changed"
                              ToolTip="{DynamicResource Str_Ui_When_On_The_Game_Launches_With_A_Tempora}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#128100;" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock x:Name="GuestModeToggleText" Text="{DynamicResource Str_Home_Toggle_GuestMode}" FontSize="13"/>
                    </StackPanel>
                </ToggleButton>
            </WrapPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Str_Home_Welcome}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource Str_Home_Subtitle}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,24"/>

            <!-- 磁贴总控台：首页不再放"普通模式/高手模式"这种设置项(已经搬到「设置」页，
                 见 SettingsPage.xaml 的 AdvancedModeCheck)，改成一排功能磁贴，点哪个就直接
                 去做哪件事，首页只承担"入口枢纽"这一个角色，不再展示任何需要用户"配置"的内容。 -->
            <!-- 修复：原来每个磁贴的 Margin 各不相同（有的 "0,0,10,10"，有的 "0,0,0,10"，
                 最后一个"设置"磁贴甚至完全没有 Margin）。UniformGrid 会把每个单元格强制拉成
                 完全一样的大小，但格子里 Button 各自的 Margin 不同，导致 Button 实际可见的
                 大小不一样——少了右/下 Margin 的那几块（"下载中心""设置"）看起来比别的磁贴小，
                 而且和右边/下边的磁贴之间几乎没有留白，贴在一起。现在统一每个磁贴都用同一个
                 Margin="0,0,10,10"，最右列/最下行多出来的这一圈间距，通过给 UniformGrid 本身
                 加一个负的右/下 Margin 抵消掉，这样六个磁贴大小、间距完全一致，右边界和下边界
                 也不会比左边界/上边界宽。 -->
            <UniformGrid x:Name="TileGrid" Columns="3" Rows="2" Margin="0,0,-10,-6">
                <Button x:Name="LaunchTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="TileLaunch_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeBlueBrush}">
                            <TextBlock Text="&#9654;" Style="{StaticResource TileIconText}" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Str_Home_Tile_Launch_Title}" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="{DynamicResource Str_Home_Tile_Launch_Desc}" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AccountsTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="TileAccounts_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeIndigoBrush}">
                            <TextBlock Text="&#128100;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Str_Home_Tile_Account_Title}" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="{DynamicResource Str_Home_Tile_Account_Desc}" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="DownloadTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="TileDownload_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeGreenBrush}">
                            <TextBlock Text="&#8681;" Style="{StaticResource TileIconText}" Foreground="{DynamicResource SuccessTextBrush}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Str_Home_Tile_Download_Title}" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Download_Game_Versions_Mods_Maps_Resourc}" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuickStartTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="TileQuickStart_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeOrangeBrush}">
                            <TextBlock Text="&#128640;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Str_Home_Tile_QuickStart_Title}" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Account_Version_Loader_And_Mods_In_One_P}" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ServerManagerTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="TileServerManager_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgePurpleBrush}">
                            <TextBlock Text="&#128423;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Str_Home_Tile_ServerManager_Title}" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="{DynamicResource Str_Home_Tile_ServerManager_Desc}" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SettingsTile" Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="TileSettings_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource SideBrush}">
                            <TextBlock Text="&#9881;" Style="{StaticResource TileIconText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Str_Settings_Title}" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="{DynamicResource Str_Home_Tile_Settings_Desc}" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,16,0,0">
                左侧导航栏可以直接跳转到以上功能，也可以打开「日志」页查看游戏/启动器日志和崩溃报告分析——默认隐藏，勾选后才显示。
            </TextBlock>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
