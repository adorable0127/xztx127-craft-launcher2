<UserControl x:Class="XCL2.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 磁贴统一样式：白底卡片 + 细描边，跟 App.xaml 里 GlowEffect/GlowSoftBrush 那套
             "边缘发光"科技感悬浮语言保持一致（原来 hover 时整块背景变成 AccentBrush 太生硬，
             跟输入框/按钮的 hover 效果不是一套视觉体系，这里改成跟它们一致的描边发光 + 轻微上浮）。 -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TileTranslate" Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="TileBorder" Property="Background" Value="{StaticResource GlowSoftBrush}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource GlowBrush}"/>
                                <Setter TargetName="TileBorder" Property="Effect" Value="{StaticResource GlowEffect}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{StaticResource SideBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 磁贴图标徽标：圆角小方块背景 + emoji 图标，每个磁贴一个独立强调色，
             让六个功能在视觉上一眼可分辨，而不是全部同一种灰底图标堆在一起。 -->
        <Style x:Key="TileIconBadge" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="TileIconText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TileDescText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>

        <!-- 访客模式开关：未开启时是普通描边小胶囊按钮；开启后整体变成强调色填充，
             一眼就能看出"当前是访客模式"，不需要额外文字提示。 -->
        <Style x:Key="GuestModeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource SideBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Effect" Value="{StaticResource GlowEffect}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 右上角访客模式开关：原来在「设置」页里一个不起眼的勾选框，访客模式是"临时用一下、
                 用完就走"的场景，藏在设置页里太深，挪到首页最显眼的右上角，开关状态直接可见
                 （ToggleButton 本身当"当前是否访客模式"的状态展示，不用额外加文字说明）。 -->
            <ToggleButton x:Name="GuestModeToggle" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Style="{StaticResource GuestModeToggleStyle}"
                          Checked="GuestModeToggle_Changed" Unchecked="GuestModeToggle_Changed"
                          ToolTip="开启后启动游戏使用一个只存在于本次运行的临时账户，不使用已保存的账户；关闭时清理本次会话产生的日志/临时下载文件">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#128100;" FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock x:Name="GuestModeToggleText" Text="访客模式" FontSize="13"/>
                </StackPanel>
            </ToggleButton>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="欢迎使用 XCL2" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="xztx127-craft-launcher 2" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,24"/>

            <!-- 磁贴总控台：首页不再放"普通模式/高手模式"这种设置项(已经搬到「设置」页，
                 见 SettingsPage.xaml 的 AdvancedModeCheck)，改成一排功能磁贴，点哪个就直接
                 去做哪件事，首页只承担"入口枢纽"这一个角色，不再展示任何需要用户"配置"的内容。 -->
            <UniformGrid Columns="3" Rows="2" Margin="0,0,0,4">
                <Button Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="TileLaunch_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="#E3F7FC">
                            <TextBlock Text="&#9654;" Style="{StaticResource TileIconText}" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="启动游戏" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="用当前选中的版本和账户直接开玩" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="TileAccounts_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="#EAF1FF">
                            <TextBlock Text="&#128100;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="账户登录" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="离线账户 / 微软账户，随时切换" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,0,10" Click="TileDownload_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="#E7F6EC">
                            <TextBlock Text="&#8681;" Style="{StaticResource TileIconText}" Foreground="#1E9E4F"/>
                        </Border>
                        <TextBlock Text="下载中心" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="下载游戏核心、Mod、地图、资源包" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,10,0" Click="TileQuickStart_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="#FFF1E3">
                            <TextBlock Text="&#128640;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="一键开始游戏" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="账户、版本、加载器、Mod 一步到位" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,10,0" Click="TileServerManager_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="#F1E9FF">
                            <TextBlock Text="&#128423;" Style="{StaticResource TileIconText}"/>
                        </Border>
                        <TextBlock Text="服务器管理" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="创建/启动本地服务器，内含联机/内网穿透教程" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Click="TileSettings_Click">
                    <StackPanel>
                        <Border Style="{StaticResource TileIconBadge}" Background="#F4F7FB">
                            <TextBlock Text="&#9881;" Style="{StaticResource TileIconText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock Text="设置" Style="{StaticResource TileTitleText}"/>
                        <TextBlock Text="Java、模式切换、窗口大小等" Style="{StaticResource TileDescText}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,16,0,0">
                左侧导航栏可以直接跳转到以上功能，也可以打开「日志」页查看游戏/启动器日志和崩溃报告分析——默认隐藏，勾选后才显示。
            </TextBlock>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
