<local:OverlayDialogControl x:Class="XCL2.App.Views.HiddenInstancesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="380">
    <!-- "从列表中删除"过的实例在这里列出来，勾选后点确定 = 取消隐藏，重新出现在主列表里。
         注意：这里显示的名字是隐藏时保存的复合 key 还原出来的版本 id，统一是小写形式
         （见 InstanceDeletionService.BuildKey 的大小写归一化），如果原始文件夹名带大写字母，
         这里显示的可能跟磁盘上实际的文件夹名大小写不完全一致，但不影响功能——取消隐藏
         只是把黑名单条目摘掉，重新扫描时列表项本身仍然是 FolderService.ScanVersions 直接
         读到的真实文件夹名（大小写完全正确），这里的显示只是"提醒你大概是哪个"。 -->
    <StackPanel Margin="20">
        <TextBlock Text="已隐藏的实例" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="勾选要恢复显示的实例，磁盘上的文件全程没有被移动过。" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HiddenListControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Id}" IsChecked="{Binding IsChecked}" Margin="0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Content="恢复选中项" Width="100" Style="{DynamicResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</local:OverlayDialogControl>
