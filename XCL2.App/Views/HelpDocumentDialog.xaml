<local:OverlayDialogControl x:Class="XCL2.App.Views.HelpDocumentDialog"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            MinWidth="360" Width="780" MaxHeight="680">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <local:MarkdownViewer x:Name="DocumentViewer"/>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="导出 MD…" Padding="12,6" Margin="0,0,10,0" Click="Export_Click"/>
            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</local:OverlayDialogControl>
