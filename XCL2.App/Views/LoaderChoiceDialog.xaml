<local:OverlayDialogControl x:Class="XCL2.App.Views.LoaderChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        xmlns:services="clr-namespace:XCL2.App.Services"
        Width="420">
    <!--
        迁移自原 LoaderChoiceWindow（独立 Window），改造成进程内 Overlay 弹窗，
        见 IOverlayDialog.cs / OverlayDialogService.cs 顶部注释。原来的 Width/Height/
        WindowStartupLocation/ResizeMode/Background 这些"窗口级"属性全部不需要了——
        居中/圆角卡片背景/阴影都是 OverlayCard 统一提供的。

        Round 修复的滚动结构原样保留：标题/说明固定在顶部，中间选项区域包一层
        ScrollViewer（滚轮在这个区域内总是有效），按钮组固定在底部、始终可见可点。
        原来给 ScrollViewer 设置 MaxHeight 是靠外层 Window Height=420 天然限制的，
        Overlay 弹窗没有固定窗口高度了，改成显式 MaxHeight="360"，避免选项很多时
        整个卡片撑得比 MainWindow 还高。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Text="安装 1.20.1" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="选择要安装的方式：原版可以直接游玩；如果要装 Mod，需要选择一个加载器。"
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>
                <RadioButton x:Name="OptVanilla" GroupName="LoaderChoice" IsChecked="True" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="原版 (Vanilla)" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="官方原版游戏，不支持安装 Mod。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OptFabric" GroupName="LoaderChoice" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="Fabric" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="轻量加载器，安装快、启动快，多数优化类/内容类 Mod 首选。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OptForge" GroupName="LoaderChoice" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="Forge" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="历史最久、生态最大的加载器，很多大型科技/魔法整合包依赖它。需要本地 Java 运行安装器。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OptNeoForge" GroupName="LoaderChoice" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="NeoForge" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="从 Forge 分支出来的新加载器，新版本 Mod 生态逐步迁移到这里。同样需要本地 Java。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OptQuilt" GroupName="LoaderChoice" Margin="0,0,0,4">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="Quilt" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="从 Fabric 分支出来的加载器，兼容大部分 Fabric Mod，同时提供一些额外的模组开发特性。安装方式和 Fabric 一样，不需要本地 Java。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Content="下一步" Width="90" Style="{DynamicResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</local:OverlayDialogControl>
