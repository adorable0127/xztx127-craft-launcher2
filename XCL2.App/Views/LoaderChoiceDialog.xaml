<local:OverlayDialogControl x:Class="XCL2.App.Views.LoaderChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        xmlns:services="clr-namespace:XCL2.App.Services"
        Width="420">
    <!--
        迁移自原 LoaderChoiceWindow（独立 Window），改造成进程内 Overlay 弹窗，
        见 IOverlayDialog.cs / OverlayDialogService.cs 顶部注释。原来的 Width/Height/
        WindowStartupLocation/ResizeMode/Background 这些"窗口级"属性全部不需要了——
        居中/圆角卡片背景/阴影都是 OverlayCard 统一提供的。

        Round 修复的滚动结构原样保留：标题/说明固定在顶部，中间选项区域包一层
        ScrollViewer（滚轮在这个区域内总是有效），按钮组固定在底部、始终可见可点。
        原来给 ScrollViewer 设置 MaxHeight 是靠外层 Window Height=420 天然限制的，
        Overlay 弹窗没有固定窗口高度了，改成显式 MaxHeight="360"，避免选项很多时
        整个卡片撑得比 MainWindow 还高。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Text="{DynamicResource Str_Ui_Install_1_20_1}" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Choose_What_To_Install_Vanilla_Is_Playab}"
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>
                <RadioButton x:Name="OptVanilla" GroupName="LoaderChoice" IsChecked="True" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="{DynamicResource Str_Ui_Vanilla_2}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Str_Ui_The_Official_Unmodified_Game_Mods_Are_No}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OptFabric" GroupName="LoaderChoice" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="Fabric" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Str_Ui_A_Lightweight_Loader_Quick_To_Install_Qu}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OptForge" GroupName="LoaderChoice" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="Forge" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Str_Ui_The_Oldest_Loader_With_The_Largest_Ecosy}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OptNeoForge" GroupName="LoaderChoice" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="NeoForge" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Str_Ui_A_Newer_Loader_Forked_From_Forge_The_Mod}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OptQuilt" GroupName="LoaderChoice" Margin="0,0,0,4">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="Quilt" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Str_Ui_A_Loader_Forked_From_Fabric_It_Runs_Most}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Content="{DynamicResource Str_Common_Next}" Width="90" Style="{DynamicResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</local:OverlayDialogControl>
