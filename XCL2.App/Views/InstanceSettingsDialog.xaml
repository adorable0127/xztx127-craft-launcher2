<local:OverlayDialogControl x:Class="XCL2.App.Views.InstanceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="440">
    <!-- 实例条目右侧⚙️图标点开的设置弹窗。内容跟原来页面下方 3/7 区域(PerVersionSettingsPanel)
         完全一致，两处控件名字不同（这边加了 Dlg 后缀避免跟页面上原控件重名），但填充/保存逻辑
         是 VersionSelectPage.xaml.cs 里同一套方法（LoadPerVersionSettings/SavePerVersionSettings_Click
         等），只是判断"往哪组控件读写"时根据当前是弹窗上下文还是页面内嵌上下文分流——具体做法见
         .xaml.cs 里的说明。先复用逻辑而不是复制一份，避免以后改一处漏改另一处。 -->
    <StackPanel Margin="20">
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"/>
        </Grid>

        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Ui_Java_Version_Used_By_This_Instance}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="VersionJavaListComboDlg" Margin="0,0,0,4" Padding="6"
                          DisplayMemberPath="DisplayText"
                          ToolTip="{DynamicResource Str_Ui_Pick_A_Java_For_This_Instance_From_The_J}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="VersionJavaOverrideBoxDlg" Width="80" Padding="6"
                             ToolTip="{DynamicResource Str_Ui_Blank_Means_Auto_Match_The_Version_S_Own}"/>
                    <TextBlock Text="{DynamicResource Str_Ui_Only_Applies_When_No_Specific_Java_Is_Ch}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Margin="10,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <CheckBox x:Name="VersionIsolationOverrideCheckDlg" Content="{DynamicResource Str_Ui_Turn_On_Version_Isolation_Just_For_This_}"
                          Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Str_Ui_Leave_Unchecked_To_Follow_The_Global_Def}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                <CheckBox x:Name="VersionResourcePackIsolationOverrideCheckDlg" Content="{DynamicResource Str_Ui_Keep_This_Instance_S_Resource_And_Shader}"
                          Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Str_Ui_Independent_Of_The_Version_Isolation_Swi}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <CheckBox x:Name="AutoJoinServerCheckDlg" Content="{DynamicResource Str_Ui_Join_A_Specific_Server_On_Launch_Connect}"
                          Margin="0,0,0,4" Checked="AutoJoinServerCheckDlg_Changed" Unchecked="AutoJoinServerCheckDlg_Changed"/>
                <TextBox x:Name="AutoJoinServerAddressBoxDlg" Style="{StaticResource SearchTextBox}" Height="30"
                         Margin="0,0,0,4" IsEnabled="False"
                         ToolTip="{DynamicResource Str_Ui_Server_Address_E_G_Play_Example_Com_Or_1}"/>
                <TextBlock Text="{DynamicResource Str_Ui_Joining_A_Server_Automatically_Needs_Min}"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="实例目录 (versions/&lt;版本&gt;/xcl/)" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="InstanceXclDirTextDlg" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        <Button Content="导出这个版本的启动脚本" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Padding="10,6" Click="ExportInstanceLaunchScriptDlg_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="{DynamicResource Str_Ui_Save_Settings_For_This_Version}" Style="{StaticResource PrimaryButton}"
                    Padding="14,8" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</local:OverlayDialogControl>
