<UserControl x:Class="XCL2.App.Views.VersionSelectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:XCL2.App.Services">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 文件夹列表（类似 PCL 左侧） -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0" Padding="16">
            <!-- 同上：加 ScrollViewer 防止窗口矮的时候"添加已有文件夹"按钮被裁到看不见、点不到。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Folders}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <ListBox x:Name="FolderListBox" BorderThickness="0" Background="Transparent"
                             SelectionChanged="FolderListBox_SelectionChanged" MaxHeight="260">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Name}" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{DynamicResource Str_Ui_Add_Or_Import}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,20,0,8"/>
                    <Button Content="{DynamicResource Str_Ui_Add_Existing_Folder}" Style="{StaticResource SideNavButton}" Click="AddFolder_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 版本列表 -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
            <!-- 需求："让已安装版本的版本列表只占页面的 4/7，剩下的 3/7 留作点击后的设置区域。
                 如果没有点击版本，该区域就留白。"
                 原来标题+"一键安装"按钮那一行、"本机已安装的版本"这行小标题、版本列表、
                 单个版本的设置面板全部塞在同一个 DockPanel 里从上往下顺序排列，属于"内容多高
                 就占多高"的流式布局，没有固定比例可言。改成外层一个两行 Grid：
                 第 0 行放"标题栏 + 小标题 + 版本列表"（这部分本身仍然是内部一个独立的
                 DockPanel：标题栏/小标题贴顶，列表占满剩余空间），高度按 4* 分配；
                 第 1 行整行都是"单个版本设置区域"，高度按 3* 分配，没有选中任何版本时
                 这一整行内容留空（面板 Visibility=Collapsed），但行本身仍然按 3/7 的比例
                 占着位置——不会因为面板收起就被上面的列表区域挤占，符合"该区域就留白"
                 而不是"该区域被列表吃掉"的要求。
                 4* / 3* 是 GridLength 的星号（比例）单位：两行按 4:3 分配 Grid 除去自身内容
                 之外的可用高度，等价于"4/7 + 3/7"。 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <!-- 上半区（4/7）：标题栏 + 版本列表，内容超出这部分高度时单独滚动，
                     不影响下半区设置面板的比例。 -->
                <DockPanel Grid.Row="0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_Ui_Installed_Versions}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Install_New_Version}" Style="{StaticResource PrimaryButton}"
                                Padding="12,6" Click="InstallNewVersion_Click"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_Ui_Installed_On_This_Pc}" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <!-- 原来靠 ListBox 自己的 MinHeight="240" 撑出"版本列表是页面主角"的视觉效果，
                         现在这个高度已经由外层 Grid 的 4* 行整体控制，ListBox 改成撑满这一行
                         剩余空间（不再需要 DockPanel.Dock="Top" + MinHeight 这套手动撑高度的写法），
                         内容比这一行还高时用自己的 ScrollViewer（ListBox 默认自带）单独滚动。 -->
                    <ListBox x:Name="InstalledListBox" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}"
                             SelectionChanged="InstalledListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <StackPanel.ContextMenu>
                                        <!-- 右键菜单：查看这个版本对应的中文 Minecraft Wiki 页面。
                                             Tag="{Binding}" 把当前行绑定的 GameVersion 传给菜单项，
                                             点击时从 Tag 里取回 Id 拼 Wiki 搜索链接，见 ViewOnWiki_Click。 -->
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource Str_Ui_Open_On_The_Chinese_Minecraft_Wiki}"
                                                      Tag="{Binding}" Click="ViewOnWiki_Click"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Text="🧊" FontSize="18" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Id}" FontSize="15"/>
                                        <TextBlock Text="{Binding SubTitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- 下半区（3/7）：当前选中版本的单独设置。Java 版本覆盖 + 版本隔离覆盖等。
                     只有选中了某个已安装版本时面板本身才可见（Visibility=Collapsed/Visible
                     由 InstalledListBox_SelectionChanged / LoadPerVersionSettings 控制，逻辑
                     不变）；没有选中版本时这一整行 Grid.Row="1" 仍然按 3/7 占着高度，只是
                     里面空空如也，就是需求里说的"该区域就留白"。
                     内容一旦比这一行高（比较少见，正常情况下这几个控件用不了那么高），
                     靠自带的 ScrollViewer 在这一行内部单独滚动，不会撑开整行把上面 4/7 的
                     列表区域挤小。 -->
                <Border x:Name="PerVersionSettingsPanel" Grid.Row="1" Background="{DynamicResource SideBrush}"
                        CornerRadius="6" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel>
                            <TextBlock x:Name="PerVersionTitleText" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Java_Version_Used_By_This_Instance}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="VersionJavaListCombo" Margin="0,0,0,4" Padding="6"
                                      DisplayMemberPath="DisplayText"
                                      ToolTip="{DynamicResource Str_Ui_Pick_A_Java_For_This_Instance_From_The_J}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="VersionJavaOverrideBox" Width="80" Padding="6"
                                         ToolTip="{DynamicResource Str_Ui_Blank_Means_Auto_Match_The_Version_S_Own}"/>
                                <TextBlock Text="{DynamicResource Str_Ui_Only_Applies_When_No_Specific_Java_Is_Ch}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <CheckBox x:Name="VersionIsolationOverrideCheck" Content="{DynamicResource Str_Ui_Turn_On_Version_Isolation_Just_For_This_}"
                                      Margin="0,0,0,4" Checked="VersionIsolationOverrideCheck_Changed" Unchecked="VersionIsolationOverrideCheck_Changed"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Leave_Unchecked_To_Follow_The_Global_Def}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                            <CheckBox x:Name="VersionResourcePackIsolationOverrideCheck" Content="{DynamicResource Str_Ui_Keep_This_Instance_S_Resource_And_Shader}"
                                      Margin="0,0,0,4" Checked="VersionResourcePackIsolationOverrideCheck_Changed" Unchecked="VersionResourcePackIsolationOverrideCheck_Changed"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Independent_Of_The_Version_Isolation_Swi}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <CheckBox x:Name="AutoJoinServerCheck" Content="{DynamicResource Str_Ui_Join_A_Specific_Server_On_Launch_Connect}"
                                      Margin="0,0,0,4" Checked="AutoJoinServerCheck_Changed" Unchecked="AutoJoinServerCheck_Changed"/>
                            <TextBox x:Name="AutoJoinServerAddressBox" Style="{StaticResource SearchTextBox}" Height="30"
                                     Margin="0,0,0,4" IsEnabled="False"
                                     ToolTip="{DynamicResource Str_Ui_Server_Address_E_G_Play_Example_Com_Or_1}"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Joining_A_Server_Automatically_Needs_Min}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <Button Content="{DynamicResource Str_Ui_Save_Settings_For_This_Version}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Padding="10,6" Click="SavePerVersionSettings_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
