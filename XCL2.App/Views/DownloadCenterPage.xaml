                                     现在统一改成跳 ModDetailPage，跟 Mod/资源包同一套交互。 -->
                                <Grid Margin="4,8" Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                      MouseLeftButtonUp="MapListItem_Click" ToolTip="{DynamicResource Str_Ui_Click_For_Details_And_Downloadable_Versi}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
