                                   VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Grid.Column="2" x:Name="MapNextPageButton" Content="{DynamicResource Str_Ui_Next}" Style="{StaticResource SecondaryButton}"
