                                    <ComboBoxItem Content="{DynamicResource Str_Ui_Shader_Packs}" Tag="Shader"/>
                                    <ComboBoxItem Content="{DynamicResource Str_Ui_Modpacks}" Tag="Modpack"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="{DynamicResource Str_Common_Search}" Style="{StaticResource PrimaryButton}" Padding="20,8" Click="ResourceSearch_Click"
                                        ToolTip="{DynamicResource Str_Ui_The_List_Refreshes_Automatically_Click_H}"/>
                                <Button Content="{DynamicResource Str_Ui_Reset_Filters}" Style="{StaticResource SecondaryButton}" Padding="20,8" Margin="10,0,0,0"
                                        Click="ResourceFilterReset_Click" ToolTip="{DynamicResource Str_Ui_Clear_The_Name_And_Version_Filters_And_B}"/>
