                                             TextChanged="ModFilter_Changed"
                                             ToolTip="{DynamicResource Str_Ui_Search_By_Keyword_In_English_Or_Chinese_}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Str_Ui_Source}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
