<UserControl x:Class="XCL2.App.Views.DownloadCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:XCL2.App.Models"
             xmlns:services="clr-namespace:XCL2.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- ===== [已废弃，仅作参照，无任何引用] 卡片内联展开面板：点击条目后卡片下方直接展开版本/文件列表。
                 已被"整页跳转详情"(ModDetailPage，见 ModListItem_Click/ResourceListItem_Click/
                 MapListItem_Click)取代，不再有任何 DataTemplate 引用这两个 Key。保留只是因为
                 ModDetailPage.xaml 里的分组展示模板就是从这里原样搬过去的，留作参照，随时可删，
                 不影响编译。 -->
            <DataTemplate x:Key="InlineVersionExpandPanel_Mod" DataType="{x:Type models:UnifiedModItem}">
                <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SideBrush}" CornerRadius="6" Margin="0,6,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="正在加载版本列表..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding IsLoadingVersions, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="没有找到匹配的版本（可能是筛选的游戏版本不匹配）。" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"
                                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"/>

                        <!-- 按"加载器 + 游戏版本"分组展示(仿截图2/3)：每组一个可折叠标题条("NeoForge 26.2"这种)，
                             点击标题条通过 VersionGroupHeader_Click(宿主 code-behind 实现，约定名跟
                             InlineVersionDownload_Click 同一套约定) 翻转 VersionGroup.IsExpanded；组内展开时
                             依次显示"前置资源"(该组必需依赖，没有依赖时这块完全不显示，不留空白)和"版本列表"
                             (具体可下载文件)。 -->
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:VersionGroup}">
                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Margin="0,3" Padding="0">
                                        <StackPanel>
                                            <!-- 分组标题条：整条可点击展开/收起，右侧箭头随 IsExpanded 状态旋转，
                                                 视觉上跟截图2里"Fabric 26.2 ⌄/⌃"的交互一致。 -->
                                            <Grid Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                                  MouseLeftButtonUp="VersionGroupHeader_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding GroupTitle}" FontSize="14" FontWeight="SemiBold"
                                                           Padding="10,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Padding="10,10" FontSize="13" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="⌄"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="⌃"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- 分组展开内容：前置资源 + 版本列表，只有 IsExpanded 时占用空间显示。 -->
                                            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                        Margin="10,0,10,10">

                                                <!-- 前置资源：只有这组至少有一项 required 依赖时才显示这一块，避免对没有前置的
                                                     Mod（大多数 Mod 都没有）也画出一个空的"前置资源"标题，造成视觉噪音。
                                                     每一项目前只能展示 Modrinth 依赖返回的 project_id/file_name 原始信息——
                                                     依赖的具体名称/图标需要额外反查对应项目详情，这里先展示已有的真实字段，
                                                     不为了好看而编造一个"图标+简介"卡片(那样会显示假数据)。 -->
                                                <StackPanel Visibility="{Binding HasRequiredDependencies, Converter={StaticResource BoolToVis}}"
                                                            Margin="0,8,0,4">
                                                    <TextBlock Text="前置资源" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding RequiredDependencies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:ModrinthDependency}">
                                                                <Border Background="{DynamicResource SideBrush}" CornerRadius="4" Margin="0,2" Padding="8,6">
                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                                                        <Run Text="项目 ID: "/><Run Text="{Binding ProjectId, Mode=OneWay}"/>
                                                                        <Run Text="  文件名: "/><Run Text="{Binding FileName, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <TextBlock Text="版本列表" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:InlineVersionEntry}">
                                                            <Border Background="{DynamicResource SideBrush}" CornerRadius="4" Margin="0,2" Padding="8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                                            <Run Text="{Binding VersionNumber, Mode=OneWay}"/>
                                                                            <Run Text=" · 支持: "/><Run Text="{Binding GameVersionsText, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <!-- 修复：这里之前单独覆盖了 Padding="14,6" FontSize="13"，比 PrimaryButton
                                                                         默认的 Padding="12,8" FontSize="15"（见"下载安装"按钮）还小，导致同一个
                                                                         页面里"下载"按钮比其它主按钮明显小一圈。现在去掉这个覆盖，改用样式默认值，
                                                                         跟"下载安装""搜索"等按钮保持同样大小。 -->
                                                                    <Button Grid.Column="1" Content="下载" Style="{StaticResource PrimaryButton}"
                                                                            Tag="{Binding}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧分类栏（仿 PCL 下载页的竖排分类图标）。修复：之前左侧用 Margin="0,0,10,0" 撑出间距，
             右侧面板紧贴列边界，两侧 Padding/CornerRadius 渲染基准不同导致视觉上相差 1px 且不对称；
             现在改为用一列宽度恰好 10 的空 Column 隔开两个面板，左右面板各自都不再带不对称 Margin，
             间距由 Grid 布局保证，不会再有像素级偏差。 -->
        <Border x:Name="ListRootLeft" Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="10">
            <StackPanel>
                <TextBlock Text="下载" FontSize="18" FontWeight="Bold" Margin="8,4,0,16" Foreground="{DynamicResource AccentBrush}"/>

                <Button Style="{StaticResource PrimaryButton}" Padding="6,10"
                        Margin="0,0,0,8" HorizontalAlignment="Stretch" Click="QuickStartWizard_Click"
                        ToolTip="从账户到启动一路走完的新手向导：选版本/加载器，可选装 Mod 和资源包/光影包，最后自动下载并启动游戏">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🚀" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Text="一键开始游戏" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <!-- 首页磁贴改版后"Mod 管理"不再单独占首页一等入口位，这里补一个次级入口，
                     避免 ModManagerPage（本地已装 Mod 的启用/禁用/删除/整合包导入导出）变得无处可去。 -->
                <Button Padding="6,8" Margin="0,0,0,14" HorizontalAlignment="Stretch"
                        Click="OpenModManager_Click"
                        ToolTip="查看/启用/禁用/删除已安装的本地 Mod，导入导出整合包">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🧰" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Text="本地 Mod 管理" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <RadioButton x:Name="CatVersion" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                             Checked="Category_Checked" Tag="version">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧊" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="游戏版本" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatMod" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="mod">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧩" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="Mod" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatResourcePack" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="resourcepack">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="材质包" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatDataPack" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="datapack">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="数据包" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatShader" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="shader">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="光影包" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <!-- 整合包分类：跟材质包/数据包/光影包共用同一个 ResourcePanel（见
                     SwitchResourceCategory 注释），只是多了一种 _currentResourceType 取值。
                     目前只接 Modrinth 一侧来源（.mrpack），下载后走 ModpackService.ImportMrpackAsync
                     解析清单逐个下载 mod，跟别的资源类型"下载即落地单个文件"的处理完全不同。 -->
                <RadioButton x:Name="CatModpack" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="modpack">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📚" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="整合包" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatMap" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="map">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗺" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="地图" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatFavorites" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="favorites" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⭐" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="我的收藏" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Border x:Name="ListRootRight" Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
            <Grid>
            <!-- 列表态：Mod/资源包/地图/游戏版本/收藏 等各分类面板，跟之前完全一样。点击某个
                 条目后"整页跳转"到详情时，靠下面同级的 DetailHost 盖住整个内容区，而不是真的
                 隐藏这些面板——原有 Category_Checked 那套"每个面板各自 Visibility"逻辑不受影响，
                 点返回时只需要把 DetailHost 收起来即可恢复原状，筛选条件/分页页码全部原地保留。 -->
            <DockPanel>

                <!-- ===== 游戏版本下载面板 ===== -->
                <Grid x:Name="VersionPanel" DockPanel.Dock="Top" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="游戏版本下载" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SourceCombo" Style="{StaticResource FilterComboBox}" Grid.Column="1" Width="150" Margin="0,0,10,0"
                                  SelectionChanged="SourceCombo_SelectionChanged">
                            <ComboBoxItem Content="官方源 (Mojang)" IsSelected="True"/>
                            <ComboBoxItem Content="BMCLAPI 镜像源"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="手动刷新" Style="{StaticResource PrimaryButton}" Click="FetchOnline_Click"
                                ToolTip="列表已自动刷新；网络失败或切换来源后可在此手动重试"/>
                    </Grid>

                    <!-- 不再有顶部"加载器筛选"预选行（之前需要先切一次顶部单选、再回来点行内按钮，
                         两步分离容易搞混，且一次只能锁定一种加载器）。现在每一行的"下载安装"按钮
                         点击后直接弹出 LoaderChoiceDialog，一步选择"原版/Fabric/Forge/NeoForge"，
                         选完立即进入对应安装流程，见 InstallVersion_Click。 -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VersionSearchBox" Style="{StaticResource SearchTextBox}" Grid.Column="0" Padding="8" FontSize="13" Margin="0,0,10,0"
                                 TextChanged="VersionFilter_Changed"
                                 ToolTip="按版本号搜索，例如 1.20 或 21w，输入后自动筛选"/>
                        <ComboBox x:Name="VersionTypeCombo" Style="{StaticResource FilterComboBox}" Grid.Column="1" SelectionChanged="VersionFilter_Changed">
                            <ComboBoxItem Content="正式版" IsSelected="True" Tag="Release"/>
                            <ComboBoxItem Content="快照版" Tag="Snapshot"/>
                            <ComboBoxItem Content="远古版本" Tag="Legacy"/>
                            <ComboBoxItem Content="愚人节版本" Tag="AprilFools"/>
                        </ComboBox>
                    </Grid>

                    <ListBox x:Name="OnlineListBox" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource DownloadListItem}" SelectionChanged="OnlineListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6" Tag="{Binding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 右键菜单：跳转到中文 Minecraft Wiki 查看这个版本的介绍/更新内容。 -->
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="在中文 Minecraft Wiki 中查看"
                                                      Tag="{Binding}" Click="ViewVersionOnWiki_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Id}" FontSize="15"/>
                                        <TextBlock Text="{Binding ReleaseTime}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding FavoriteLabel}" Margin="0,0,8,0" Padding="10,6"
                                            Style="{StaticResource SideNavButton}" Tag="{Binding}" Click="FavoriteVersion_Click"/>
                                    <Button Grid.Column="2" Content="下载安装" Style="{StaticResource PrimaryButton}"
                                            Tag="{Binding}" Click="InstallVersion_Click"
                                            ToolTip="点击后选择安装原版还是 Fabric/Forge/NeoForge 加载器"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 分页条：游戏版本清单条目非常多（官方 manifest 有上千个历史版本），
                         同样需要分页，不然列表照样被撑爆显示不全。 -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="VersionPrevPageButton" Content="◀ 上一页" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Click="VersionPrevPage_Click"/>
                        <TextBlock Grid.Column="1" x:Name="VersionPageSummaryText" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Grid.Column="2" x:Name="VersionNextPageButton" Content="下一页 ▶" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Click="VersionNextPage_Click"/>
                    </Grid>
                </Grid>

                <!-- ===== Modrinth 社区资源面板：材质包/数据包/光影包共用（靠 _currentResourceType 区分） =====
                     修复"社区资源页面太通透，看不清楚"：这个 Grid 之前没设 Background，下面的
                     ResourceListBox 又显式设成 Transparent，实际展示区域完全没有不透明底色，
                     跟外层 ListRootRight（Border，PanelBrush 纯白）之间只隔着这层透明，视觉上
                     内容区跟外层窗口背景（可能带模糊/半透明特效）混在一起，文字看不清楚。
                     这里直接给 ResourcePanel 一层纯白不透明底色（PanelBrush），列表本身的
                     Transparent 保留（用来透出这层纯白底色，而不是透到窗口背景）。 -->
                <Grid x:Name="ResourcePanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource PanelBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="ResourcePanelTitle" Text="材质包下载" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- 仿 PCL「搜索 Mod」筛选栏，跟 Mod 面板同一套两列网格+搜索/重置按钮结构。
                         这个面板"类型"其实是靠左侧导航栏(材质包/数据包/光影包三个入口)决定的，
                         不是面板内部可选项，所以这里的"类型"下拉框用来展示当前选中的类型，
                         并让用户可以在不切回左侧导航的情况下直接在这个面板内切换三种类型——
                         比如正在看材质包搜索结果时，想顺手看看光影包，不需要来回点左侧栏。 -->
                    <Border Grid.Row="1" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ResourceSearchBox" Style="{StaticResource SearchTextBox}" Padding="8" FontSize="13"
                                         TextChanged="ResourceFilter_Changed"
                                         ToolTip="搜索关键词，支持中英文，留空浏览热门资源，输入后自动搜索"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="来源" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ResourceSourceCombo" Style="{StaticResource FilterComboBox}"
                                          SelectionChanged="ResourceSourceCombo_SelectionChanged">
                                    <ComboBoxItem Content="综合(Modrinth+CurseForge)" IsSelected="True" Tag="combined"/>
                                    <ComboBoxItem Content="仅 Modrinth" Tag="modrinth"/>
                                    <ComboBoxItem Content="仅 CurseForge" Tag="curseforge"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                <TextBlock Text="版本" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ResourceGameVersionBox" Style="{StaticResource SearchTextBox}" Padding="8" FontSize="13"
                                         TextChanged="ResourceFilter_Changed"
                                         ToolTip="限定游戏版本，例如 1.20.1；留空不限定"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <!-- 版本快捷选择条：点一下直接把常见/常用游戏版本号填进上面的"版本"输入框，
                                     不用自己手打——原需求"选择的都是常见的常用的游戏版本（或者输入）"，
                                     跟输入框是同一份数据、双向不冲突：点按钮 = 帮用户填字，用户自己手打
                                     任意版本号（输入框本身没有被禁用/只读）依然完全可行。
                                     x:Name 供 ResourceVersionChip_Click 统一处理，Tag 是要填入的版本号
                                     字符串（"" 代表"全部"，即清空版本筛选）。 -->
                                <WrapPanel x:Name="ResourceVersionChipPanel">
                                    <Button Content="全部" Style="{StaticResource VersionChipButton}" Tag="" Click="ResourceVersionChip_Click"/>
                                    <Button Content="1.21" Style="{StaticResource VersionChipButton}" Tag="1.21" Click="ResourceVersionChip_Click"/>
                                    <Button Content="1.20" Style="{StaticResource VersionChipButton}" Tag="1.20" Click="ResourceVersionChip_Click"/>
                                    <Button Content="1.19" Style="{StaticResource VersionChipButton}" Tag="1.19" Click="ResourceVersionChip_Click"/>
                                    <Button Content="1.18" Style="{StaticResource VersionChipButton}" Tag="1.18" Click="ResourceVersionChip_Click"/>
                                    <Button Content="1.17" Style="{StaticResource VersionChipButton}" Tag="1.17" Click="ResourceVersionChip_Click"/>
                                    <Button Content="1.16" Style="{StaticResource VersionChipButton}" Tag="1.16" Click="ResourceVersionChip_Click"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                <TextBlock Text="类型" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ResourceTypeCombo" Style="{StaticResource FilterComboBox}"
                                          SelectionChanged="ResourceTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="材质包" IsSelected="True" Tag="ResourcePack"/>
                                    <ComboBoxItem Content="数据包" Tag="DataPack"/>
                                    <ComboBoxItem Content="光影包" Tag="Shader"/>
                                    <ComboBoxItem Content="整合包" Tag="Modpack"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="搜索" Style="{StaticResource PrimaryButton}" Padding="20,8" Click="ResourceSearch_Click"
                                        ToolTip="列表已自动刷新；网络失败或想立即按当前条件重新搜索时可点这里"/>
                                <Button Content="重置条件" Style="{StaticResource SecondaryButton}" Padding="20,8" Margin="10,0,0,0"
                                        Click="ResourceFilterReset_Click" ToolTip="清空名称/版本筛选，恢复到浏览热门资源"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="ResourceListBox" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource DownloadListItem}" SelectionChanged="ResourceListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 整页跳转：同 Mod 面板，点击后跳到 ModDetailPage，不再原地展开。 -->
                                <Grid Margin="4,8" Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                      MouseLeftButtonUp="ResourceListItem_Click" ToolTip="点击查看详情和可下载的版本">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" CornerRadius="4"
                                            Background="{DynamicResource SideBrush}" VerticalAlignment="Top">
                                        <Image Source="{Binding DisplayIconUrl}" Width="40" Height="40" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="15" FontWeight="Bold">
                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                            <Run Text="  ["/><Run Text="{Binding SourceLabel, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><Run Text="]"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="作者: "/><Run Text="{Binding Author}"/>
                                            <Run Text="  下载量: "/><Run Text="{Binding Downloads}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding FavoriteLabel}" Padding="8,5" FontSize="11"
                                            VerticalAlignment="Top" Style="{StaticResource SideNavButton}"
                                            Tag="{Binding}" Click="FavoriteResource_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 分页条：跟 Mod 面板同款样式。 -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="ResourcePrevPageButton" Content="◀ 上一页" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Click="ResourcePrevPage_Click"/>
                        <TextBlock Grid.Column="1" x:Name="ResourcePageSummaryText" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Grid.Column="2" x:Name="ResourceNextPageButton" Content="下一页 ▶" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Click="ResourceNextPage_Click"/>
                    </Grid>
                </Grid>

                <!-- ===== 我的收藏：游戏版本 + Mod + 材质包/数据包/光影包 + 地图，按类型分组展示 ===== -->
                <Grid x:Name="FavoritesPanel" DockPanel.Dock="Top" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="我的收藏" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel>
                            <TextBlock Text="游戏版本" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                            <ListBox x:Name="FavoritesListBox" BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource DownloadListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Id}" FontSize="15"/>
                                                <TextBlock Text="{Binding ReleaseTime}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding FavoriteLabel}" Margin="0,0,8,0" Padding="10,6"
                                                    Style="{StaticResource SideNavButton}" Tag="{Binding}" Click="FavoriteVersion_Click"/>
                                            <Button Grid.Column="2" Content="下载安装" Style="{StaticResource PrimaryButton}"
                                                    Tag="{Binding}" Click="InstallVersion_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="FavoriteModsHeader" Text="Mod" FontWeight="Bold" FontSize="13" Margin="0,16,0,6" Visibility="Collapsed"/>
                            <ListBox x:Name="FavoriteModsListBox" BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource DownloadListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" CornerRadius="4"
                                                    Background="{DynamicResource SideBrush}" VerticalAlignment="Top">
                                                <Image Source="{Binding DisplayIconUrl}" Width="40" Height="40" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="15" FontWeight="Bold">
                                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                                    <Run Text="  ["/><Run Text="{Binding SourceLabel, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><Run Text="]"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="作者: "/><Run Text="{Binding Author}"/>
                                                    <Run Text="  下载量: "/><Run Text="{Binding Downloads}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="取消收藏" Padding="8,5" FontSize="11"
                                                    VerticalAlignment="Top" Style="{StaticResource SideNavButton}"
                                                    Tag="{Binding}" Click="UnfavoriteItem_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="FavoriteResourcesHeader" Text="材质包 / 数据包 / 光影包" FontWeight="Bold" FontSize="13" Margin="0,16,0,6" Visibility="Collapsed"/>
                            <ListBox x:Name="FavoriteResourcesListBox" BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource DownloadListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" CornerRadius="4"
                                                    Background="{DynamicResource SideBrush}" VerticalAlignment="Top">
                                                <Image Source="{Binding DisplayIconUrl}" Width="40" Height="40" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="15" FontWeight="Bold">
                                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                                    <Run Text="  ["/><Run Text="{Binding SourceLabel, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><Run Text="]"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="作者: "/><Run Text="{Binding Author}"/>
                                                    <Run Text="  下载量: "/><Run Text="{Binding Downloads}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="取消收藏" Padding="8,5" FontSize="11"
                                                    VerticalAlignment="Top" Style="{StaticResource SideNavButton}"
                                                    Tag="{Binding}" Click="UnfavoriteItem_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="FavoriteMapsHeader" Text="地图" FontWeight="Bold" FontSize="13" Margin="0,16,0,6" Visibility="Collapsed"/>
                            <ListBox x:Name="FavoriteMapsListBox" BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource DownloadListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding Title}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="作者: "/><Run Text="{Binding Author}"/>
                                                    <Run Text="  下载量: "/><Run Text="{Binding Downloads}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="取消收藏" Padding="8,5" FontSize="11"
                                                    VerticalAlignment="Top" Style="{StaticResource SideNavButton}"
                                                    Tag="{Binding}" Click="UnfavoriteItem_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock x:Name="FavoritesEmptyHint" Grid.Row="1" Text="还没有收藏任何内容，去「游戏版本」/「Mod」/「材质包」等分类点击 ☆ 收藏 试试。"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- ===== 地图分类：接入 CurseForge（Modrinth 没有对应分类） ===== -->
                <Grid x:Name="MapPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource PanelBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="地图下载" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="数据来自 CurseForge" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MapSearchBox" Style="{StaticResource SearchTextBox}" Grid.Column="0" Padding="8" FontSize="13" Margin="0,0,10,0"
                                 TextChanged="MapFilter_Changed"
                                 ToolTip="搜索关键词，例如 地图名，留空浏览热门地图，输入后自动搜索"/>
                        <TextBox x:Name="MapGameVersionBox" Style="{StaticResource SearchTextBox}" Grid.Column="1" Padding="8" FontSize="13" Margin="0,0,10,0"
                                 TextChanged="MapFilter_Changed"
                                 ToolTip="限定游戏版本，例如 1.20.1；留空不限定"/>
                        <Button Grid.Column="2" Content="手动刷新" Style="{StaticResource PrimaryButton}" Click="MapSearch_Click"
                                ToolTip="列表已自动刷新；网络失败可在此手动重试"/>
                    </Grid>

                    <!-- 版本快捷选择条，同 Mod/Resource 面板，见 ResourceVersionChipPanel 注释。 -->
                    <WrapPanel x:Name="MapVersionChipPanel" Grid.Row="2" Margin="0,0,0,10">
                        <Button Content="全部" Style="{StaticResource VersionChipButton}" Tag="" Click="MapVersionChip_Click"/>
                        <Button Content="1.21" Style="{StaticResource VersionChipButton}" Tag="1.21" Click="MapVersionChip_Click"/>
                        <Button Content="1.20" Style="{StaticResource VersionChipButton}" Tag="1.20" Click="MapVersionChip_Click"/>
                        <Button Content="1.19" Style="{StaticResource VersionChipButton}" Tag="1.19" Click="MapVersionChip_Click"/>
                        <Button Content="1.18" Style="{StaticResource VersionChipButton}" Tag="1.18" Click="MapVersionChip_Click"/>
                        <Button Content="1.17" Style="{StaticResource VersionChipButton}" Tag="1.17" Click="MapVersionChip_Click"/>
                        <Button Content="1.16" Style="{StaticResource VersionChipButton}" Tag="1.16" Click="MapVersionChip_Click"/>
                    </WrapPanel>

                    <ListBox x:Name="MapListBox" Grid.Row="3" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource DownloadListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 整页跳转：地图之前是弹 CurseForgeMapPickerWindow 独立窗口，
                                     现在统一改成跳 ModDetailPage，跟 Mod/资源包同一套交互。 -->
                                <Grid Margin="4,8" Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                      MouseLeftButtonUp="MapListItem_Click" ToolTip="点击查看详情和可下载的版本">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="作者: "/><Run Text="{Binding AuthorsDisplay, Mode=OneWay}"/>
                                            <Run Text="  下载量: "/><Run Text="{Binding DownloadCount}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding FavoriteLabel}" Padding="8,5" FontSize="11"
                                            VerticalAlignment="Top" Style="{StaticResource SideNavButton}"
                                            Tag="{Binding}" Click="FavoriteMap_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 分页条：跟 Mod/资源包面板同款样式。 -->
                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="MapPrevPageButton" Content="◀ 上一页" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Click="MapPrevPage_Click"/>
                        <TextBlock Grid.Column="1" x:Name="MapPageSummaryText" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Grid.Column="2" x:Name="MapNextPageButton" Content="下一页 ▶" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Click="MapNextPage_Click"/>
                    </Grid>
                </Grid>

                <!-- ===== 地图分类但未配置 CurseForge Key：引导去设置页粘贴 ===== -->
                <StackPanel x:Name="MapKeyMissingPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0">
                    <TextBlock Text="地图下载需要先配置 CurseForge API Key" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="去 console.curseforge.com 申请一个 key，然后在「设置」页粘贴保存即可。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                    <Button Content="去设置页配置" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                            HorizontalAlignment="Center" Click="GoToSettingsForKey_Click"/>
                </StackPanel>

                <!-- ===== Mod 分类：综合搜索 Modrinth + CurseForge，来源可切换；右侧附 MC百科中文名搜索辅助 ===== -->
                <Grid x:Name="ModPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource PanelBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Mod 下载" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- 仿 PCL「搜索 Mod」筛选栏：名称/来源 一行，版本/类型(加载器) 一行，
                             两列网格布局，最后单独一行放"搜索"+"重置条件"两个按钮。
                             之前是"一行塞下所有筛选框+一个手动刷新按钮"，跟截图1的 PCL 布局差异较大，
                             这里改成结构一致的两列网格，同时保留原有的自动搜索(TextChanged/SelectionChanged
                             防抖触发)行为——"搜索"按钮只是补一个跟 PCL 一样的手动触发入口，不是唯一触发方式。 -->
                        <Border Grid.Row="1" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ModSearchBox" Style="{StaticResource SearchTextBox}" Padding="8" FontSize="13"
                                             TextChanged="ModFilter_Changed"
                                             ToolTip="搜索关键词，支持中英文，例如 &quot;JEI&quot; 或 &quot;钠&quot;（自动翻译成 Sodium 搜索），留空浏览热门 Mod，输入后自动搜索"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="来源" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ModSourceCombo" Style="{StaticResource FilterComboBox}" SelectionChanged="ModSourceCombo_SelectionChanged">
                                        <ComboBoxItem Content="综合(Modrinth+CurseForge)" IsSelected="True" Tag="combined"/>
                                        <ComboBoxItem Content="仅 Modrinth" Tag="modrinth"/>
                                        <ComboBoxItem Content="仅 CurseForge" Tag="curseforge"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                    <TextBlock Text="版本" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ModGameVersionBox" Style="{StaticResource SearchTextBox}" Padding="8" FontSize="13"
                                             TextChanged="ModFilter_Changed"
                                             ToolTip="限定游戏版本，例如 1.20.1；留空不限定"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                    <TextBlock Text="类型 (加载器)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ModLoaderCombo" Style="{StaticResource FilterComboBox}"
                                              SelectionChanged="ModFilter_SelectionChanged">
                                        <ComboBoxItem Content="不限加载器" IsSelected="True" Tag=""/>
                                        <ComboBoxItem Content="Fabric" Tag="fabric"/>
                                        <ComboBoxItem Content="Forge" Tag="forge"/>
                                        <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                                        <ComboBoxItem Content="Quilt" Tag="quilt"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="搜索" Style="{StaticResource PrimaryButton}" Padding="20,8" Click="ModSearch_Click"
                                            ToolTip="列表已自动刷新；网络失败或想立即按当前条件重新搜索时可点这里"/>
                                    <Button Content="重置条件" Style="{StaticResource SecondaryButton}" Padding="20,8" Margin="10,0,0,0"
                                            Click="ModFilterReset_Click" ToolTip="清空名称/版本/加载器筛选，恢复到浏览热门 Mod"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 命中中文名词典时展示"已按 XX 搜索"提示，让用户知道中文关键词生效了；
                             没命中/关键词是英文时这行不显示，不占用界面空间。 -->
                        <TextBlock x:Name="ModTranslationHintText" Grid.Row="2" Margin="0,0,0,8" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>

                        <ListBox x:Name="ModListBox" Grid.Row="3" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource DownloadListItem}" SelectionChanged="ModListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 整页跳转：点击条目不再原地展开手风琴，而是整页跳转到 ModDetailPage
                                         （仿 CurseForge/PCL：顶部返回箭头，整个内容区替换为该条目的详情），
                                         取代原来的 ContentPresenter 内联展开面板。 -->
                                    <Grid Margin="4,8" Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                          MouseLeftButtonUp="ModListItem_Click" ToolTip="点击查看详情和可下载的版本">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" CornerRadius="4"
                                                Background="{DynamicResource SideBrush}" VerticalAlignment="Top">
                                            <Image Source="{Binding DisplayIconUrl}" Width="40" Height="40" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="15" FontWeight="Bold">
                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                                <Run Text="  ["/><Run Text="{Binding SourceLabel, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><Run Text="]"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="作者: "/><Run Text="{Binding Author}"/>
                                                <Run Text="  下载量: "/><Run Text="{Binding Downloads}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding FavoriteLabel}" Padding="8,5" FontSize="11"
                                                VerticalAlignment="Top" Style="{StaticResource SideNavButton}"
                                                Tag="{Binding}" Click="FavoriteMod_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 分页条：仿 PCL，固定每页数量 + 上一页/页码/下一页，修复结果多时列表被裁切
                             显示不全的问题（之前是把整批搜索结果一次性全塞进 ListBox）。 -->
                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="ModPrevPageButton" Content="◀ 上一页" Style="{StaticResource SecondaryButton}"
                                    Padding="12,6" Click="ModPrevPage_Click"/>
                            <TextBlock Grid.Column="1" x:Name="ModPageSummaryText" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button Grid.Column="2" x:Name="ModNextPageButton" Content="下一页 ▶" Style="{StaticResource SecondaryButton}"
                                    Padding="12,6" Click="ModNextPage_Click"/>
                        </Grid>
                    </Grid>

                    <!-- MC百科中文名搜索辅助：只提供百科页面链接，不参与下载（见 McModService 类注释） -->
                    <Border Grid.Column="1" Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="MC百科 参考" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Text="中文资料辅助，点击跳转百科页面查看详情" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ListBox x:Name="McModListBox" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Title}" Style="{StaticResource SideNavButton}"
                                                HorizontalContentAlignment="Left" Padding="6,6" FontSize="12"
                                                Tag="{Binding}" Click="McModOpen_Click"
                                                ToolTip="{Binding PageUrl}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

            </DockPanel>

            <!-- 整页详情覆盖层：默认收起(Collapsed)。点击 Mod/资源包/地图任一条目时，
                 ModListItem_Click 等方法构造一个 ModDetailPage 塞进这里并把 Visibility 切成 Visible，
                 铺满整个右侧内容区，视觉上盖住上面的列表面板——即"整页跳转，顶部有返回箭头"，
                 而不是原来的"原地手风琴展开"。ModDetailPage 内部返回箭头回调(onBack)会把这里
                 收回 Collapsed、Content 清空，露出底下原封不动的列表状态。 -->
            <ContentControl x:Name="DetailHost" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
