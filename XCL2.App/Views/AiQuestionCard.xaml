<UserControl x:Class="XCL2.App.Views.AiQuestionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="620"
             Focusable="False">
    <!-- AI 提问卡片：覆盖在聊天输入框上方的同一位置（见 AiAssistantPanel.xaml 的 QuestionCard）。 -->
    <Border CornerRadius="13" Padding="14,12"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶栏：标签 + 问题 + 翻页 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="HeaderChip" Grid.Column="0" CornerRadius="12" Padding="10,2" Margin="0,0,10,0"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
                <TextBlock x:Name="QuestionText" Grid.Column="1" FontSize="13.5" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel x:Name="PagerPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,0,0" Visibility="Collapsed">
                    <Button x:Name="PrevButton" Content="‹" Width="26" Height="26" Padding="0"
                            Style="{DynamicResource IconButtonStyle}" Click="PrevButton_Click" ToolTip="上一题"/>
                    <TextBlock x:Name="PagerText" Margin="6,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="NextButton" Content="›" Width="26" Height="26" Padding="0"
                            Style="{DynamicResource IconButtonStyle}" Click="NextButton_Click" ToolTip="下一题"/>
                </StackPanel>
            </Grid>

            <!-- 选项区（行由代码生成：选项行 + 最后一行自由输入） -->
            <ScrollViewer Grid.Row="1" Margin="0,10,0,8" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="OptionsPanel" KeyboardNavigation.TabNavigation="Cycle"/>
            </ScrollViewer>

            <!-- 底栏：提示 + 忽略/提交 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" Margin="0,0,8,0"
                            BorderBrush="{DynamicResource TextSecondaryBrush}">
                        <TextBlock Text="i" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <TextBlock Text="使用 Tab / 上下键选择，回车或空格选中" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="IgnoreButton" Content="忽略" Padding="14,6" MinWidth="58"
                            Click="IgnoreButton_Click" ToolTip="跳过这个提问 (Esc)"/>
                    <Button x:Name="SubmitButton" Content="提交" Padding="14,6" MinWidth="58" Margin="8,0,0,0"
                            Click="SubmitButton_Click" ToolTip="Ctrl+Enter"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            BorderBrush="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
