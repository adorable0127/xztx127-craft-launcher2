<local:OverlayDialogControl x:Class="XCL2.App.Views.DropTypeChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        MaxWidth="520">
    <!-- 这个弹窗是内嵌 Overlay（继承 OverlayDialogControl），不是独立 Window：
         由 OverlayDialogService.ShowModal 塞进 MainWindow 的 OverlayContentHost 里，
         跟 PCL 一样在主窗口内部弹出、不会在任务栏多出一个窗口。 -->
    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource Str_Ui_What_Is_This_Archive}" FontSize="18" FontWeight="Bold"/>

        <TextBlock x:Name="FileNameText" FontSize="13" Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{DynamicResource Str_Ui_Resource_Packs_Shader_Packs_Data_Packs_W}"/>

        <StackPanel Margin="0,18,0,0">
            <RadioButton x:Name="ChoiceModpack" GroupName="DropKind" IsChecked="True" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Modpacks}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Str_Ui_Creates_A_Separate_Instance_Downloads_Th}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ChoiceResourcePack" GroupName="DropKind" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Resource_Pack}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Str_Ui_Put_It_Straight_Into_This_Instance_S_Res}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ChoiceShaderPack" GroupName="DropKind" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Shader_Packs}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Str_Ui_Put_It_In_This_Instance_S_Shaderpacks_Fo}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ChoiceWorld" GroupName="DropKind">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Worlds}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Str_Ui_Extract_Into_This_Instance_S_Saves_Folde}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <CheckBox x:Name="RememberCheck" Margin="0,18,0,0"
                  Content="{DynamicResource Str_Ui_Remember_This_Choice_And_Stop_Asking_You}"
                  FontSize="12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource Str_Common_Cancel}" Style="{StaticResource SecondaryButton}" Padding="18,7" Click="Cancel_Click"/>
            <Button Content="{DynamicResource Str_Common_Ok}" Style="{StaticResource PrimaryButton}" Padding="24,7" Margin="10,0,0,0"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</local:OverlayDialogControl>
