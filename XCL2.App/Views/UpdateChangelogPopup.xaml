<local:OverlayDialogControl x:Class="XCL2.App.Views.UpdateChangelogPopup"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            MinWidth="560" MaxWidth="560" MaxHeight="560">
    <!--
        启动器自动更新完成、重启回来的那一次自动弹出的"这次更新了什么"内嵌弹窗。
        只在 MainWindow.ApplyStartupArgs 检测到命令行参数 just-updated
        （由 UpdateCheckService 生成的重启脚本自动带上）且 AppConfig.ShowUpdateChangelogPopup
        为 true 时才会弹出一次，不影响正常双击启动的用户。

        两个按钮语义：
        - "朕知道了"：仅关闭这次弹窗，不改配置，下次更新完成后还会再弹一次。
        - "以后就不要弹出来打扰我了"：关闭弹窗的同时把 AppConfig.ShowUpdateChangelogPopup
          写成 false 并保存，之后每次更新完成都不会再自动弹出（用户仍可以随时通过设置页
          重新打开这个开关，也可以随时手动打开"XCL 更新日志"面板查看）。
    -->
    <Grid Margin="20" MaxHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🎉 更新完成" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Text="正在获取本次更新日志…"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="以后就不要弹出来打扰我了" Padding="12,7" Margin="0,0,8,0" Click="DontShowAgain_Click"/>
            <Button Content="朕知道了" Style="{StaticResource PrimaryButton}" Padding="18,7" Click="Ack_Click"/>
        </StackPanel>
    </Grid>
</local:OverlayDialogControl>
