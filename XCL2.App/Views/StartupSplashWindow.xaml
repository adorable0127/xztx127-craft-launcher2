<Window x:Class="XCL2.App.Views.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XCL2" Width="420" Height="230"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        AllowsTransparency="True" Topmost="False" Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1.15" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="1" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="1" BeginTime="0:0:0.16" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="1" BeginTime="0:0:0.32" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Border CornerRadius="22" BorderThickness="1" BorderBrush="#426A7CFF" Padding="26">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F51A1D28" Offset="0"/>
                <GradientStop Color="#F51B2031" Offset="0.55"/>
                <GradientStop Color="#F5152330" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="28" ShadowDepth="8" Opacity="0.7"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="70" Height="70" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse Stroke="#4058A6FF" StrokeThickness="2" StrokeDashArray="2,3">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" CenterX="35" CenterY="35"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Border Width="54" Height="54" CornerRadius="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4F8CFF" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="0.55"/>
                            <GradientStop Color="#22C7E8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="M12,2 L14.7,9.3 L22,12 L14.7,14.7 L12,22 L9.3,14.7 L2,12 L9.3,9.3 Z M19,3 L20,6 L23,7 L20,8 L19,11 L18,8 L15,7 L18,6 Z"
                          Width="31" Height="31" Stretch="Uniform" Fill="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="XCL2" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Minecraft Launcher" FontSize="11" Foreground="#94A7C2" Margin="1,-1,0,13"/>
                <TextBlock x:Name="StatusText" Text="正在启动…" FontSize="12.5" Foreground="#D9E3F0"/>
                <StackPanel Orientation="Horizontal" Margin="1,10,0,0">
                    <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="#79A9FF" Margin="0,0,6,0"/>
                    <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="#9E7BFF" Margin="0,0,6,0"/>
                    <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="#45D6E8"/>
                </StackPanel>
                <ProgressBar Width="240" Height="3" IsIndeterminate="True" Margin="0,13,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
