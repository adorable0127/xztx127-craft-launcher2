<local:OverlayDialogControl x:Class="XCL2.App.Views.ModpackTargetVersionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        xmlns:services="clr-namespace:XCL2.App.Services"
        Width="440">
    <!--
        整合包下载安装到哪个版本目录：默认"新建一个独立版本目录"，避免整合包自带的一整套
        mod/config 跟当前版本目录里已经装好的 mod 混在一起——这正是"整合包=一整套独立配置"
        这个直觉背后的实际诉求：两个整合包如果共用同一个版本目录，后装的整合包里同名文件会
        直接覆盖前一个整合包的文件，config 也会互相污染，最后谁都装不干净。

        同时保留"安装到已有版本目录"这个选项——用户如果就是想给某个已经建好、还没装任何 mod
        的空白版本目录装这个整合包（比如提前用「版本选择」页建好了一个 1.20.1 Fabric 的空壳），
        不需要为此重新走一遍安装核心的流程，选中已有目录直接装。

        结构跟 LoaderChoiceDialog 一致：标题+说明固定顶部，选项区域可滚动，按钮固定底部。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Text="{DynamicResource Str_Ui_Install_Modpack}" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_A_Modpack_Overwrites_The_Mods_And_Config}"
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>
                <!-- 默认选中"新建"：这是符合"整合包=独立配置"直觉的推荐路径。 -->
                <RadioButton x:Name="OptCreateNew" GroupName="ModpackTarget" IsChecked="True"
                             Checked="OptionChanged" Unchecked="OptionChanged" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="{DynamicResource Str_Ui_Create_A_Separate_Version_Folder_Recomme}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Str_Ui_The_Modpack_Goes_Into_A_Brand_New_Versio}" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <!-- 新建目录的名称输入框：只在选中"新建"时可见/可编辑，默认预填整合包名，
                     用户可以自行修改（比如同一个整合包想装两份用于对比测试）。 -->
                <StackPanel x:Name="NewNamePanel" Margin="30,0,0,14">
                    <TextBlock Text="{DynamicResource Str_Ui_New_Version_Folder_Name}" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="NewNameBox" Height="30" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="NewNameErrorText" Foreground="IndianRed" FontSize="11.5"
                               Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <RadioButton x:Name="OptExisting" GroupName="ModpackTarget"
                             Checked="OptionChanged" Unchecked="OptionChanged" Margin="0,0,0,10">
                    <StackPanel Margin="8,2">
                        <TextBlock Text="{DynamicResource Str_Ui_Install_Into_An_Existing_Version}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Str_Ui_The_Modpack_S_Files_Are_Merged_Into_The_}"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <!-- 已有版本目录下拉框：只在选中"安装到已有版本目录"时可见/可用。
                     当前文件夹下一个已装版本都没有时，这个选项本身在 code-behind 里会被禁用
                     （见 ModpackTargetVersionDialog.xaml.cs 构造函数），不会出现"选了但列表是空的"。 -->
                <StackPanel x:Name="ExistingPanel" Margin="30,0,0,4">
                    <ComboBox x:Name="ExistingVersionCombo" Height="30" DisplayMemberPath="Id"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Content="{DynamicResource Str_Common_Next}" Width="90" Style="{DynamicResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</local:OverlayDialogControl>
