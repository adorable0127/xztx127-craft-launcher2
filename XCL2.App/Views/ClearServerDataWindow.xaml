<Window x:Class="XCL2.App.Views.ClearServerDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清除服务器数据"
        Width="440" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="⚠ 清除服务器数据" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,10"/>

        <Border Background="{DynamicResource WarningBannerBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
        </Border>

        <TextBlock Text="请输入服务器名称以确认："
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="ConfirmNameBox" Height="30" VerticalContentAlignment="Center"
                 TextChanged="ConfirmNameBox_TextChanged"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                   Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelBtn" Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="ConfirmBtn" Content="永久删除" Width="100" Style="{DynamicResource PrimaryButton}"
                    IsEnabled="False" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
