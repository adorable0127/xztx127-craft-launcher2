<UserControl x:Class="XCL2.App.Views.DriverDownloadLinks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="选择显卡提供商，打开对应下载页面" FontWeight="SemiBold" Margin="0,8,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,8,8">
                <Button Content="NVIDIA 官方驱动" Tag="https://www.nvidia.com/en-us/drivers/" Click="OpenLink_Click" Padding="10,6"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,8">
                <Button Content="AMD 官方驱动" Tag="https://www.amd.com/en/support/download/drivers.html" Click="OpenLink_Click" Padding="10,6"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,8">
                <Button Content="Intel 官方驱动" Tag="https://www.intel.com/content/www/us/en/download-center/home.html" Click="OpenLink_Click" Padding="10,6"/>
            </StackPanel>
        </WrapPanel>
        <Expander Header="镜像下载站 / 自定义链接" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="第三方镜像：请在页面中选择与你的显卡、Windows 版本匹配的驱动，并核对安装包发布者。" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,8,8">
                        <Button Content="NVIDIA · TechPowerUp 镜像" Tag="https://www.techpowerup.com/download/nvidia-geforce-graphics-drivers/" Click="OpenLink_Click" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <Button Content="AMD · Guru3D 镜像" Tag="https://www.guru3d.com/files/category/videocards-ati-catalyst-windows-7-8-10" Click="OpenLink_Click" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <Button Content="TechPowerUp 驱动下载站" Tag="https://www.techpowerup.com/download/" Click="OpenLink_Click" Padding="10,6"/>
                    </StackPanel>
                </WrapPanel>
                <TextBox x:Name="CustomUrl" ToolTip="输入其它厂商或镜像站的 https 地址" Margin="0,2,0,4"/>
                <Button Content="一键打开自定义链接 ↗" Click="OpenCustom_Click" HorizontalAlignment="Left" Padding="10,6"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
