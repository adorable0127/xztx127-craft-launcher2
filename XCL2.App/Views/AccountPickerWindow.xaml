<Window x:Class="XCL2.App.Views.AccountPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择启动账户" Height="360" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource SideBrush}">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20" Margin="10">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="选择要用来启动游戏的账户" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="点两下账户可以直接启动；也可以选中后点下方「使用这个账户启动」。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <CheckBox DockPanel.Dock="Bottom" x:Name="RememberChoiceCheck"
                      Margin="0,12,0,8" VerticalContentAlignment="Top">
                <TextBlock Text="记住这次选择，以后启动不再询问（可在「账户管理」页随时切换）"
                           TextWrapping="Wrap" Margin="4,0,0,0"/>
            </CheckBox>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Padding="14,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="ConfirmBtn" Content="使用这个账户启动" Style="{StaticResource PrimaryButton}"
                        Padding="14,8" Click="Confirm_Click"/>
            </StackPanel>

            <ListBox x:Name="AccountListBox" DisplayMemberPath="DisplayLabel"
                     MouseDoubleClick="AccountListBox_MouseDoubleClick"/>
        </DockPanel>
    </Border>
</Window>
