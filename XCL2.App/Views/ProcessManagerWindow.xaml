<Window x:Class="XCL2.App.Views.ProcessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="进程管理" Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock x:Name="HintText" Grid.Row="0" FontSize="12" Margin="0,26,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

        <ListBox x:Name="ProcessListBox" Grid.Row="1" Margin="0,12,0,12" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <CheckBox x:Name="MarkCheck" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Visibility="{Binding MarkVisibility}"
                                  IsChecked="{Binding Info.ManuallyMarkedUnresponsive, Mode=TwoWay}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding TitleLine}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding SubLine}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ActionButton" Content="关闭所选" Style="{StaticResource PrimaryButton}"
                    Padding="16,8" Margin="0,0,8,0" Click="ActionButton_Click"/>
            <Button Content="取消" Style="{StaticResource SideNavButton}" Padding="16,8" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
