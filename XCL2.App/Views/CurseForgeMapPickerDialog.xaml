<local:OverlayDialogControl x:Class="XCL2.App.Views.CurseForgeMapPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="560" Height="480"
                            MinHeight="360"
                            MaxHeight="360">
                            <!-- MinHeight 必须给：这个弹窗的布局里有 RowDefinition Height="*"。
                                 原来是 Window 且有固定 Height 时，"*"行能拿到剩余高度；
                                 改成挂在自适应 OverlayCard 里的 UserControl 之后，
                                 测量高度是无穷大，"*"行会塌陷成内容的期望高度——
                                 列表为空/WebView2 这种没有期望尺寸的控件会直接塌成 0，
                                 表现就是弹窗里一片空白。MinHeight 用回原来的设计高度即可。 -->
    <!-- 迁移自原 CurseForgeMapPickerWindow（独立 Window）。 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="{DynamicResource Str_Ui_Choose_Files_To_Download}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <ListBox x:Name="FileListBox" Grid.Row="1" BorderThickness="0" Background="{DynamicResource PanelBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontSize="14"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding FileName, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Str_Ui_Supports}"/><Run Text="{Binding GameVersionsText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Common_Download}" Style="{StaticResource PrimaryButton}"
                                Tag="{Binding}" Click="Download_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</local:OverlayDialogControl>
