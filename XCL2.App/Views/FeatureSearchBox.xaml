<UserControl x:Class="XCL2.App.Views.FeatureSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Button x:Name="SearchEntry" Click="SearchEntry_Click" Padding="12,6" Height="36" MinHeight="0"
                FontSize="13" HorizontalContentAlignment="Stretch" ToolTip="搜索功能（Ctrl+K 或 Ctrl+F）"
                AutomationProperties.Name="打开功能搜索">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Width="14" Height="14" Margin="0,0,9,0" Stretch="Uniform" VerticalAlignment="Center"
                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 M 10,10 L 15,15"/>
                <TextBlock x:Name="SearchEntryText" Grid.Column="1" Text="搜索功能" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Ctrl+K" FontSize="10" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Button>
        <Border x:Name="EmptyClickHint" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,42,0,0" Padding="14"
                CornerRadius="10" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                Effect="{StaticResource GlowEffect}">
            <StackPanel>
                <TextBlock Text="如果需要将悬浮窗关闭或者移至正上方，请转到设置" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="我知道了" Padding="14,6" Margin="0,0,8,0" Click="HintDismiss_Click"/>
                    <Button Content="转到设置" Padding="14,6" Style="{StaticResource PrimaryButton}" Click="HintSettings_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchEntry}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" Closed="SearchPopup_Closed">
            <Border x:Name="FloatingSearchCard" Width="520" Padding="12" CornerRadius="8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                    PreviewKeyDown="FloatingSearch_PreviewKeyDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="QueryBox" Padding="10,5" Height="36" MinHeight="0" FontSize="13"
                                 AcceptsReturn="False" AcceptsTab="False" TextWrapping="NoWrap"
                                 VerticalContentAlignment="Center" VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Hidden" MaxLength="200" TextChanged="QueryBox_TextChanged"
                                 ToolTip="输入功能名称；↑↓ 选择，Enter 定位，Esc 关闭"
                                 AutomationProperties.Name="功能搜索关键词"/>
                        <Button Grid.Column="1" Content="×" Width="36" Height="36" MinHeight="0" Padding="0"
                                Margin="8,0,0,0" Click="Close_Click"
                                ToolTip="关闭搜索（Esc）" AutomationProperties.Name="关闭搜索"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ScopeCombo" Width="156" Height="32" MinHeight="0" FontSize="12"
                                  SelectionChanged="ScopeCombo_SelectionChanged" ToolTip="选择搜索当前主页面或全部页面"
                                  AutomationProperties.Name="功能搜索范围">
                            <ComboBoxItem Content="当前主页面"/>
                            <ComboBoxItem Content="搜索全部"/>
                        </ComboBox>
                        <TextBlock x:Name="ResultCount" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="10,0,0,0" FontSize="11" TextWrapping="NoWrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ResultList" BorderThickness="0" Background="Transparent" Padding="0" MaxHeight="275"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="ResultList_SelectionChanged" PreviewMouseLeftButtonUp="ResultList_MouseLeftButtonUp"
                                 AutomationProperties.Name="功能搜索结果">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ResultCard" Background="{DynamicResource SideBrush}" CornerRadius="6"
                                                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ResultCard" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                                        <Setter TargetName="ResultCard" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ResultCard" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                                        <Setter TargetName="ResultCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DisplayPath}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoResultsText" Text="没有匹配的功能，试试更短的词或“搜索全部”。"
                                   Visibility="Collapsed" TextWrapping="Wrap" Margin="2,8,2,4" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                    <TextBlock x:Name="SearchStatus" Grid.Row="3" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"
                               Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
