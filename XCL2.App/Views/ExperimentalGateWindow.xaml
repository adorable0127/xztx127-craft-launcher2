<Window x:Class="XCL2.App.Views.ExperimentalGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:XCL2.App.Services"
        Title="进入实验性功能前的提醒"
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="⚠ 实验性功能" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="在打开之前，请先完整看完下面这段说明。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
        </StackPanel>

        <!-- 警告正文：解释"为什么要罚站 10 秒"、"实验性功能里到底有什么"、"可能带来什么后果"，
             不是走个形式随便写两句，要让用户真正明白这是个"不建议普通用户碰"的区域。 -->
        <Border Grid.Row="1" Background="{DynamicResource WarningBannerBrush}" CornerRadius="8" Padding="16"
                VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13" LineHeight="20">
                        <Run Text="实验性功能里的东西还在打磨阶段，启用之后可能会遇到界面显示不正常、某些设置互相冲突、" FontWeight="Bold"/>
                        <Run Text="甚至偶尔崩溃这类不稳定情况。"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13" LineHeight="20"
                               Text="目前实验性功能包含：额外的界面换肤方案（蓝色系、黄色系、紫色系、粉色系等）。这些配色本身不会影响游戏存档、Mod、服务器数据等任何实际内容，最坏情况也只是&quot;界面变得难看/某处显示错位&quot;，随时可以在这里改回默认配色，不会造成数据损失。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13" LineHeight="20"
                               Text="如果你只是想正常启动游戏、正常开服，不需要打开这里任何东西——启动器默认的白色/黑色配色已经是最稳定、最经过测试的状态。"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="不建议普通用户尝试实验性功能。如果你不确定自己是否需要它，答案通常是不需要。"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 强制等待区：倒计时归零前按钮禁用+显示剩余秒数，归零后才变成可点的"我已阅读，进入"。
             这里刻意不给"跳过"入口，逼着用户至少让这段文字在屏幕上停留够 10 秒。 -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="CountdownText" Text="请等待 10 秒..." HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="取消" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"/>
                <Button Grid.Column="2" x:Name="ConfirmBtn" Content="我已阅读，进入实验性功能"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Confirm_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
