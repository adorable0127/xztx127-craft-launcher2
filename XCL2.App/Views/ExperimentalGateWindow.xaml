<local:OverlayDialogControl x:Class="XCL2.App.Views.ExperimentalGateWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="580"
                            MinHeight="480"
                            MaxWidth="580"
                            MaxHeight="480">
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Str_Ui_Experimental_Features_3}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource Str_Ui_Please_Read_The_Following_In_Full_Before}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
        </StackPanel>

        <!-- 警告正文：解释"为什么要罚站 10 秒"、"实验性功能里到底有什么"、"可能带来什么后果"，
             不是走个形式随便写两句，要让用户真正明白这是个"不建议普通用户碰"的区域。 -->
        <Border Grid.Row="1" Background="{DynamicResource WarningBannerBrush}" CornerRadius="8" Padding="16"
                VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13" LineHeight="20">
                        <Run Text="{DynamicResource Str_Ui_Experimental_Features_Are_Still_Being_Wo}" FontWeight="Bold"/>
                        <Run Text="{DynamicResource Str_Ui_And_Even_Occasional_Crashes}"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13" LineHeight="20"
                               Text="{DynamicResource Str_Ui_Experimental_Features_Currently_Include_}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13" LineHeight="20"
                               Text="{DynamicResource Str_Ui_Experimental_Features_May_Also_Include_J}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13" LineHeight="20"
                               Text="{DynamicResource Str_Ui_Colour_Themes_Blue_Yellow_Purple_Pink_An}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Str_Ui_The_Toolbox_Advancement_Images_Skin_Avat}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Str_Ui_Experimental_Features_Aren_T_Recommended}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 强制等待区：倒计时归零前按钮禁用+显示剩余秒数，归零后才变成可点的"我已阅读，进入"。
             这里刻意不给"跳过"入口，逼着用户至少让这段文字在屏幕上停留够 10 秒。 -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="CountdownText" Text="{DynamicResource Str_Ui_Please_Wait_10_Seconds}" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource Str_Common_Cancel}" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"/>
                <Button Grid.Column="2" x:Name="ConfirmBtn" Content="{DynamicResource Str_Ui_I_Ve_Read_This_Open_Experimental_Feature}"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Confirm_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</local:OverlayDialogControl>
