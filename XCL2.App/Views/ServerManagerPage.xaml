<UserControl x:Class="XCL2.App.Views.ServerManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:XCL2.App.Services">
    <UserControl.Resources>
        <!-- 磁贴样式：跟 HomePage.xaml 里那一套"首页四宫格"磁贴保持完全一致的视觉语言
             (描边发光 hover + 轻微上浮)，这里复制一份而不是共享同一个 x:Key，因为
             HomePage.xaml 里这几个样式是定义在它自己的 UserControl.Resources 里、
             没有提到 App.xaml 全局资源字典，两个 UserControl 之间不能直接互相引用对方的
             局部资源，最简单可靠的办法就是各自保留一份同名同内容的样式定义。 -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TileTranslate" Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource GlowBrush}"/>
                                <Setter TargetName="TileBorder" Property="Effect" Value="{StaticResource GlowEffect}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource SideBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileIconBadge" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="TileIconText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TileDescText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧分类栏：服务端管理模块的各项功能。目前只有"核心下载"已实现，其余先占位展示
             "即将推出"，让用户清楚整体功能范围和当前进度，而不是完全看不到规划。
             修复：同 DownloadCenterPage，去掉左侧一侧 Margin，改用独立 10px 间隔列，
             左右两个面板不再有 1px 级别的不对称间距。 -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="10">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Nav_ServerManager}" FontSize="18" FontWeight="Bold" Margin="8,4,0,16" Foreground="{DynamicResource AccentBrush}"/>

                <!-- 首页：进入"服务端管理"默认停在这里，四个磁贴对应最常用的四件事，
                     不需要用户先搞清楚"核心下载/服务器列表/插件/资源包"这几个分类各自是干什么的
                     才能上手——新手直接点"傻瓜式开服"，老用户想启动/管理已有服务器也能一步到位。 -->
                <RadioButton x:Name="CatHome" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                             Checked="Category_Checked" Tag="home">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Home}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatCoreDownload" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="core">
                    <StackPanel Orientation="Horizontal">
                        <!-- 修复"下载图标与同一栏其它图标大小不一致"：⬇ 本身是 Unicode
                             "文本样式(text-presentation)"默认呈现的符号，跟 🏠/🖥/🧩 这些天生
                             就是"emoji样式(emoji-presentation)"的字符不一样——同一个 FontFamily
                             下裸的 ⬇ 会被渲染成比 emoji 版本小一圈的纯符号字形。加上 U+FE0F
                             (VARIATION SELECTOR-16) 强制它按 emoji 呈现方式渲染，跟其它几个
                             图标使用同一套字形来源，视觉大小才会一致。 -->
                        <TextBlock Text="&#x2B07;&#xFE0F;" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Server_Core_Downloads}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatInstances" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="instances">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Server_List}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatPlugins" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="plugins">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧩" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Plugin_Downloads}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatResourcePack" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="resourcepack">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Resource_Packs_2}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
            <Grid>
            <!-- 修复：服务端"插件下载/资源包"面板之前一直用的是已废弃的"卡片内联展开"样式
                 (InlineVersionExpandPanel_Resource)，跟客户端下载中心早就换掉的旧样式一样；
                 现在统一改成跟 DownloadCenterPage 完全相同的"整页跳转详情"(ModDetailPage)。
                 DetailHost 是跟 DockPanel 同级的覆盖层，点击资源条目后盖住整个内容区显示详情，
                 点返回收起后原样恢复列表/筛选条件，跟 DownloadCenterPage 的 DetailHost 是同一套思路。 -->
            <DockPanel>

                <!-- ===== 首页面板 ===== -->
                <!-- 四个磁贴对应用户诉求的四件事，点哪个直接做哪件事：
                     1) 傻瓜式开服：复用"创建服务器"向导(CreateServerWindow)，那本身就是
                        "选核心类型+MC版本 -> 自动下载/安装 -> 自动匹配Java -> 登记实例"
                        一步到位的流程，不需要再单独做一套。
                     2) 启动所选的服务器：优先启动"默认服务器"(ServerInstance.IsDefault)，
                        没有设默认时退化为服务器列表里的第一个；一台都没有时提示先去创建。
                     3) 插件/资源包管理：跳到左侧"插件下载"分类（同一个面板内也能切资源包）。
                     4) 设置选中的服务器参数：对同一个"默认服务器优先，否则第一个"的目标实例
                        打开 ServerPropertiesWindow 图形化编辑 server.properties。 -->
                <Grid x:Name="HomePanel" DockPanel.Dock="Top" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Str_Nav_ServerManager}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource Str_Ui_Pick_What_You_Want_To_Do_And_Jump_Straig}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14"/>

                    <UniformGrid Grid.Row="2" Columns="2" Rows="2" VerticalAlignment="Top">
                        <Button Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="TileEasySetup_Click">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeOrangeBrush}">
                                    <TextBlock Text="&#128640;" Style="{StaticResource TileIconText}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Str_Ui_Guided_Server_Setup}" Style="{StaticResource TileTitleText}"/>
                                <TextBlock Text="{DynamicResource Str_Ui_Pick_A_Server_Type_And_Minecraft_Version}" Style="{StaticResource TileDescText}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TileButton}" Margin="0,0,0,10" Click="TileStartSelected_Click">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeBlueBrush}">
                                    <TextBlock Text="&#9654;" Style="{StaticResource TileIconText}" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Str_Ui_Start_Selected_Server}" Style="{StaticResource TileTitleText}"/>
                                <TextBlock Text="{DynamicResource Str_Ui_Start_The_Default_Server_Falls_Back_To_T}" Style="{StaticResource TileDescText}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TileButton}" Margin="0,0,10,0" Click="TilePluginResource_Click">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgeGreenBrush}">
                                    <TextBlock Text="&#129513;" Style="{StaticResource TileIconText}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Str_Ui_Plugins_Resource_Packs}" Style="{StaticResource TileTitleText}"/>
                                <TextBlock Text="{DynamicResource Str_Ui_Download_And_Manage_Server_Plugins_And_R}" Style="{StaticResource TileDescText}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TileButton}" Click="TileServerSettings_Click">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBadge}" Background="{DynamicResource TileBadgePurpleBrush}">
                                    <TextBlock Text="&#9881;" Style="{StaticResource TileIconText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Str_Ui_Configure_Selected_Server}" Style="{StaticResource TileTitleText}"/>
                                <TextBlock Text="{DynamicResource Str_Ui_Edit_The_Common_Server_Properties_Entrie}" Style="{StaticResource TileDescText}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>

                <!-- ===== 核心下载面板 ===== -->
                <Grid x:Name="CorePanel" DockPanel.Dock="Top" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Str_Ui_Server_Core_Downloads_2}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource Str_Ui_Choose_A_Server_Type_And_Minecraft_Versi}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14"/>

                    <!-- 核心类型选择：原本是横排 StackPanel，5 个不会溢出；现在加到 11 个换成
                         WrapPanel，放不下时自动换行，避免右边的按钮被裁掉点不到。 -->
                    <WrapPanel Grid.Row="2" Margin="0,0,0,14">
                        <RadioButton x:Name="CoreVanilla" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                                     Content="{DynamicResource Str_Ui_Vanilla}" Checked="CoreType_Checked" Tag="Vanilla" Margin="0,0,6,6"/>
                        <RadioButton x:Name="CorePaper" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Paper" Checked="CoreType_Checked" Tag="Paper" Margin="0,0,6,6"/>
                        <RadioButton x:Name="CoreFolia" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Folia" Checked="CoreType_Checked" Tag="Folia" Margin="0,0,6,6"/>
                        <RadioButton x:Name="CorePurpur" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Purpur" Checked="CoreType_Checked" Tag="Purpur" Margin="0,0,6,6"/>
                        <RadioButton x:Name="CoreSpigot" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Spigot" Checked="CoreType_Checked" Tag="Spigot" Margin="0,0,6,6"/>
                        <RadioButton x:Name="CoreFabric" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Fabric" Checked="CoreType_Checked" Tag="Fabric" Margin="0,0,6,6"/>
                        <RadioButton x:Name="CoreForge" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Forge" Checked="CoreType_Checked" Tag="Forge" Margin="0,0,6,6"/>
                        <RadioButton x:Name="CoreNeoForge" Style="{StaticResource DownloadCategoryButton}"
                                     Content="NeoForge" Checked="CoreType_Checked" Tag="NeoForge" Margin="0,0,6,6"/>
                        <RadioButton x:Name="CoreVelocity" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Velocity" Checked="CoreType_Checked" Tag="Velocity" Margin="0,0,6,6"/>
                        <RadioButton x:Name="CoreWaterfall" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Waterfall" Checked="CoreType_Checked" Tag="Waterfall" Margin="0,0,6,6"/>
                    </WrapPanel>


                    <StackPanel Grid.Row="3">
                        <!-- MC 版本 + 构建/加载器版本 选择 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Str_Ui_Minecraft_Version}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="McVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"
                                          SelectionChanged="McVersionCombo_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" x:Name="BuildVersionPanel">
                                <TextBlock x:Name="BuildVersionLabel" Text="{DynamicResource Str_Ui_Build}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="BuildVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"/>
                            </StackPanel>
                        </Grid>

                        <!-- 安装位置 -->
                        <TextBlock Text="{DynamicResource Str_Ui_Install_Location}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetDirBox" Grid.Column="0" Style="{StaticResource SearchTextBox}"
                                     Height="34" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Browse}" Style="{StaticResource PrimaryButton}"
                                    Click="BrowseTargetDir_Click"/>
                        </Grid>

                        <Button x:Name="DownloadCoreBtn" Content="{DynamicResource Str_Ui_Start_Download_2}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Padding="24,10" Click="DownloadCore_Click"/>

                        <!-- 进度展示 -->
                        <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ProgressStageText" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ProgressDetailText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="ProgressBarCtl" Height="8" Minimum="0" Maximum="1"/>
                        </StackPanel>

                        <!-- Forge/NeoForge 下载完成后的"需要本地安装"提示 -->
                        <Border x:Name="InstallRequiredPanel" Background="{DynamicResource SideBrush}" CornerRadius="8"
                                Padding="14" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Ui_Installer_Downloaded_It_Still_Needs_To_B}" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="InstallHintText" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <Button x:Name="RunInstallerBtn" Content="{DynamicResource Str_Ui_Run_Installer_Now}" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Click="RunInstaller_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ===== 服务器列表面板 ===== -->
                <Grid x:Name="InstancesPanel" DockPanel.Dock="Top" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Str_Ui_Server_List}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Start_Or_Stop_A_Server_You_Ve_Created_Or}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <!-- 内网穿透/公网访问教程的常驻入口：之前这个教程(ServerNetworkGuideWindow)只在
                             "启动服务器成功后"自动弹一次，用户点掉/关闭"下次不再提示"之后就再也找不到入口了，
                             只能靠重新触发一次自动弹窗。这里在服务器列表页顶部加一个显眼的常驻按钮，
                             随时可以手动打开，不依赖"刚启动完服务器"这个时机，也不受
                             ShowServerNetworkGuideOnStart 这个"是否自动弹"开关影响。 -->
                        <!-- 之前这里额外写了 Background="{DynamicResource AccentBrush}"，把 PrimaryButton
                             本来的浅蓝底色（ButtonBackgroundBrush）覆盖成了强调色的深蓝，导致这个按钮
                             看起来比其它同样用 PrimaryButton 样式的按钮颜色深很多。去掉这个内联覆盖，
                             跟"创建服务器"按钮保持一致的浅蓝底色。 -->
                        <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Multiplayer_Port_Forwarding_Guide}" Style="{StaticResource PrimaryButton}"
                                Padding="14,10" Margin="0,0,10,0"
                                Click="OpenNetworkGuide_Click"
                                ToolTip="{DynamicResource Str_Ui_How_To_Let_Friends_Connect_From_Outside_}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Str_Ui_Create_Server}" Style="{StaticResource PrimaryButton}"
                                Padding="16,10" Click="CreateServer_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel x:Name="InstanceListPanel"/>
                    </ScrollViewer>
                </Grid>

                <!-- ===== 服务端资源下载面板：统一承载 插件/资源包/数据包/光影包/Mod 五个分类，
                     复用同一套 Modrinth/CurseForge 搜索+下载逻辑，只是把下载目标从 .minecraft 版本
                     目录换成"选中的服务器实例目录"。之前这里只做了资源包一种，插件/数据包/光影包/Mod
                     在服务端场景下完全没有支持——现在通过顶部的类型选择器统一收敛到一个面板里，
                     避免为每种资源类型各写一份几乎一样的面板代码。
                     注意：服务端场景的"Mod"仅在核心类型是 Fabric/Forge/NeoForge（modded 服务端）时才有意义，
                     纯 Vanilla/Paper/Purpur 服务端不支持 Mod，插件(Plugin)才是这些服务端场景该用的东西——
                     两者在 Minecraft 生态里是完全不同的概念，UI 上也分开展示，不会把插件错叫成"模组"。 -->
                <Grid x:Name="ServerResourcePanel" DockPanel.Dock="Top" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="ServerResourcePanelTitle" Text="{DynamicResource Str_Ui_Server_Plugin_Downloads}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- 资源类型选择：插件(默认)/资源包/数据包/光影包/Mod。不同分类的下载入口
                         (Category_Checked 里的 tag)各自独立，但落到同一个物理面板复用逻辑，
                         这一排按钮才是真正决定"这次搜索/下载哪种资源"的开关。 -->
                    <!-- 修复"Mod(需 Fabric/Forge/NeoForge 服务端)"点不到的问题：这一项文字明显比
                         其它几项长，之前用 Orientation="Horizontal" 的 StackPanel 排列，StackPanel
                         横向排列时不会自动换行——窗口不够宽时最后一项会被挤出父容器的可视/可点击
                         范围之外（父级 Border 会裁掉溢出内容），看起来这一项"消失"或"点不到"。
                         改成 WrapPanel 后，空间不够时会自动换到下一行，任何窗口宽度下都能完整显示
                         并点击到，不会再被裁切到看不见/点不到的地方。 -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="SrvResPlugin" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                                     Content="{DynamicResource Str_Ui_Plugins}" Checked="ServerResourceType_Checked" Tag="Plugin" Margin="0,0,6,4"/>
                        <RadioButton x:Name="SrvResResourcePack" Style="{StaticResource DownloadCategoryButton}"
                                     Content="{DynamicResource Str_Ui_Resource_Packs_2}" Checked="ServerResourceType_Checked" Tag="ResourcePack" Margin="0,0,6,4"/>
                        <RadioButton x:Name="SrvResDataPack" Style="{StaticResource DownloadCategoryButton}"
                                     Content="{DynamicResource Str_Ui_Data_Packs}" Checked="ServerResourceType_Checked" Tag="DataPack" Margin="0,0,6,4"/>
                        <RadioButton x:Name="SrvResShader" Style="{StaticResource DownloadCategoryButton}"
                                     Content="{DynamicResource Str_Ui_Shader_Packs}" Checked="ServerResourceType_Checked" Tag="Shader" Margin="0,0,6,4"/>
                        <RadioButton x:Name="SrvResMod" Style="{StaticResource DownloadCategoryButton}"
                                     Content="{DynamicResource Str_Ui_Mods_Needs_A_Fabric_Forge_Neoforge_Serve}" Checked="ServerResourceType_Checked" Tag="Mod" Margin="0,0,6,4"/>
                    </WrapPanel>

                    <!-- 仿 PCL「搜索 Mod」筛选栏：名称/来源 一行，版本/(数据包场景下是"目标世界文件夹") 一行，
                         两列网格 + 搜索/重置按钮，跟 DownloadCenterPage 的 Mod/资源面板同一套结构。
                         "下载到服务器"单独放在筛选卡片上方——它决定的是"下载到哪"而不是"筛选什么"，
                         跟名称/来源/版本这几个真正的筛选条件放一起容易混淆，所以保留独立一行。 -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Ui_Download_To_Server}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ServerTargetCombo" Style="{StaticResource FilterComboBox}" Grid.Column="1"
                                  DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch"
                                  SelectionChanged="ServerTargetCombo_SelectionChanged"/>
                    </Grid>

                    <Border Grid.Row="3" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{DynamicResource Str_Ui_Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ServerResourceSearchBox" Style="{StaticResource SearchTextBox}" Padding="8" FontSize="13"
                                         TextChanged="ServerResourceFilter_Changed"
                                         ToolTip="{DynamicResource Str_Ui_Search_By_Keyword_Leave_Blank_To_Browse_}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Str_Ui_Source}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ServerResourceSourceCombo" Style="{StaticResource FilterComboBox}"
                                          SelectionChanged="ServerResourceSourceCombo_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource Str_Ui_Combined_Modrinth_Curseforge}" IsSelected="True" Tag="combined"/>
                                    <ComboBoxItem Content="{DynamicResource Str_Ui_Modrinth_Only}" Tag="modrinth"/>
                                    <ComboBoxItem Content="{DynamicResource Str_Ui_Curseforge_Only}" Tag="curseforge"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Str_Ui_Version}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ServerResourceGameVersionBox" Style="{StaticResource SearchTextBox}" Padding="8" FontSize="13"
                                         TextChanged="ServerResourceFilter_Changed"
                                         ToolTip="{DynamicResource Str_Ui_Limit_To_A_Game_Version_E_G_1_20_1_Leave}"/>
                            </StackPanel>
                            <!-- 版本快捷选择条：跟 DownloadCenterPage 的 Mod/资源面板同一套结构
                                 （ResourceVersionChipPanel/ModVersionChipPanel），点一下直接把常用
                                 版本号填进上面的"版本"输入框，不用自己手打。 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <WrapPanel x:Name="ServerResourceVersionChipPanel">
                                    <Button Content="{DynamicResource Str_Ui_All}" Style="{StaticResource VersionChipButton}" Tag="" Click="ServerResourceVersionChip_Click"/>
                                    <Button Content="1.21" Style="{StaticResource VersionChipButton}" Tag="1.21" Click="ServerResourceVersionChip_Click"/>
                                    <Button Content="1.20" Style="{StaticResource VersionChipButton}" Tag="1.20" Click="ServerResourceVersionChip_Click"/>
                                    <Button Content="1.19" Style="{StaticResource VersionChipButton}" Tag="1.19" Click="ServerResourceVersionChip_Click"/>
                                    <Button Content="1.18" Style="{StaticResource VersionChipButton}" Tag="1.18" Click="ServerResourceVersionChip_Click"/>
                                    <Button Content="1.17" Style="{StaticResource VersionChipButton}" Tag="1.17" Click="ServerResourceVersionChip_Click"/>
                                    <Button Content="1.16" Style="{StaticResource VersionChipButton}" Tag="1.16" Click="ServerResourceVersionChip_Click"/>
                                </WrapPanel>
                            </StackPanel>
                            <!-- 数据包必须落在具体存档下(world/datapacks/)，跟客户端"数据包必须选存档"是
                                 同一个道理；服务端一般只有一个 world，这里默认给出该服务器实例目录下的
                                 world 文件夹名，理论上支持多世界(Bukkit/Paper 的 world_nether 等)时用户
                                 也可以手动改这个文本框指定别的世界文件夹名。只在数据包类型时显示，
                                 其它类型这一格留空，不占用视觉重量。 -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                                        x:Name="ServerDataPackWorldPanel" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Str_Ui_Target_World_Folder}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ServerDataPackWorldBox" Style="{StaticResource SearchTextBox}"
                                         Padding="8" FontSize="13" Text="world"
                                         ToolTip="{DynamicResource Str_Ui_The_Server_S_World_Folder_Name_World_By_}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="{DynamicResource Str_Common_Search}" Style="{StaticResource PrimaryButton}" Padding="20,8" Click="ServerResourceSearch_Click"
                                        ToolTip="{DynamicResource Str_Ui_The_List_Refreshes_Automatically_Click_H}"/>
                                <Button Content="{DynamicResource Str_Ui_Reset_Filters}" Style="{StaticResource SecondaryButton}" Padding="20,8" Margin="10,0,0,0"
                                        Click="ServerResourceFilterReset_Click" ToolTip="{DynamicResource Str_Ui_Clear_The_Name_And_Version_Filters_And_B}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 修复：跟客户端下载中心一样，点击条目不再是"卡片内联展开"(旧样式)，
                         而是整页跳转到 ModDetailPage(见 code-behind ServerResourceListItem_Click /
                         OpenServerResourceDetailAsync)。下载目标目录是 ServerTargetCombo 选中的
                         服务器实例目录，跟原来的目录解析逻辑一致，只是不再需要 Button.Click 冒泡
                         处理内联下载按钮——下载按钮现在在 ModDetailPage 内部。 -->
                    <ListBox x:Name="ServerResourceListBox" Grid.Row="4" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource DownloadListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,8" Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                      MouseLeftButtonUp="ServerResourceListItem_Click" ToolTip="{DynamicResource Str_Ui_Click_For_Details_And_Downloadable_Versi}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" CornerRadius="4"
                                            Background="{DynamicResource SideBrush}" VerticalAlignment="Top">
                                        <Image Source="{Binding DisplayIconUrl}" Width="40" Height="40" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="15" FontWeight="Bold">
                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                            <Run Text="  ["/><Run Text="{Binding SourceLabel, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><Run Text="]"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{DynamicResource Str_Ui_Author}"/><Run Text="{Binding Author}"/>
                                            <Run Text="{DynamicResource Str_Ui_Downloads}"/><Run Text="{Binding Downloads}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="ServerResourceNoTargetHint" Grid.Row="4"
                               Text="{DynamicResource Str_Ui_You_Haven_T_Created_A_Server_Yet_Create_}"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

            </DockPanel>

            <!-- 服务端资源详情覆盖层：跟 DownloadCenterPage 的 DetailHost 同一套思路，
                 点击插件/资源包/数据包/光影包/Mod 条目后盖住整个内容区显示 ModDetailPage，
                 返回时收起即可，不影响下层筛选条件/已加载的搜索结果。 -->
            <ContentControl x:Name="DetailHost" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
