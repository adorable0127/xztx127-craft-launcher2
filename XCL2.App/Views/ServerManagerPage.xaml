<UserControl x:Class="XCL2.App.Views.ServerManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧分类栏：服务端管理模块的各项功能。目前只有"核心下载"已实现，其余先占位展示
             "即将推出"，让用户清楚整体功能范围和当前进度，而不是完全看不到规划。 -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0" Padding="10">
            <StackPanel>
                <TextBlock Text="服务端管理" FontSize="18" FontWeight="Bold" Margin="8,4,0,16" Foreground="{StaticResource AccentBrush}"/>

                <RadioButton x:Name="CatCoreDownload" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                             Checked="Category_Checked" Tag="core">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="核心下载" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatInstances" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="instances">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="服务器列表" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatPlugins" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="plugins">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧩" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="插件下载" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CatResourcePack" Style="{StaticResource DownloadCategoryButton}"
                             Checked="Category_Checked" Tag="resourcepack">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="资源包" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="20">
            <DockPanel>

                <!-- ===== 核心下载面板 ===== -->
                <Grid x:Name="CorePanel" DockPanel.Dock="Top" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="服务端核心下载" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="选择核心类型和 Minecraft 版本，下载可直接用于开服的服务端文件。"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14"/>

                    <!-- 核心类型选择：横排 Tab 式单选 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton x:Name="CoreVanilla" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                                     Content="Vanilla 原版" Checked="CoreType_Checked" Tag="Vanilla" Margin="0,0,6,0"/>
                        <RadioButton x:Name="CorePaper" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Paper" Checked="CoreType_Checked" Tag="Paper" Margin="0,0,6,0"/>
                        <RadioButton x:Name="CoreFabric" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Fabric" Checked="CoreType_Checked" Tag="Fabric" Margin="0,0,6,0"/>
                        <RadioButton x:Name="CoreForge" Style="{StaticResource DownloadCategoryButton}"
                                     Content="Forge" Checked="CoreType_Checked" Tag="Forge" Margin="0,0,6,0"/>
                        <RadioButton x:Name="CoreNeoForge" Style="{StaticResource DownloadCategoryButton}"
                                     Content="NeoForge" Checked="CoreType_Checked" Tag="NeoForge"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <!-- MC 版本 + 构建/加载器版本 选择 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minecraft 版本" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="McVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"
                                          SelectionChanged="McVersionCombo_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" x:Name="BuildVersionPanel">
                                <TextBlock x:Name="BuildVersionLabel" Text="构建版本" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="BuildVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"/>
                            </StackPanel>
                        </Grid>

                        <!-- 安装位置 -->
                        <TextBlock Text="安装位置" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetDirBox" Grid.Column="0" Style="{StaticResource SearchTextBox}"
                                     Height="34" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource PrimaryButton}"
                                    Click="BrowseTargetDir_Click"/>
                        </Grid>

                        <Button x:Name="DownloadCoreBtn" Content="⬇  开始下载" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Padding="24,10" Click="DownloadCore_Click"/>

                        <!-- 进度展示 -->
                        <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ProgressStageText" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ProgressDetailText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="ProgressBarCtl" Height="8" Minimum="0" Maximum="1"/>
                        </StackPanel>

                        <!-- Forge/NeoForge 下载完成后的"需要本地安装"提示 -->
                        <Border x:Name="InstallRequiredPanel" Background="{StaticResource SideBrush}" CornerRadius="8"
                                Padding="14" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="安装器已下载，还需再运行一次安装" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="InstallHintText" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <Button x:Name="RunInstallerBtn" Content="立即运行安装" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Click="RunInstaller_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ===== 服务器列表面板 ===== -->
                <Grid x:Name="InstancesPanel" DockPanel.Dock="Top" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="服务器列表" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="一键启动/停止已创建的服务器，或创建一个新的。"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <!-- 内网穿透/公网访问教程的常驻入口：之前这个教程(ServerNetworkGuideWindow)只在
                             "启动服务器成功后"自动弹一次，用户点掉/关闭"下次不再提示"之后就再也找不到入口了，
                             只能靠重新触发一次自动弹窗。这里在服务器列表页顶部加一个显眼的常驻按钮，
                             随时可以手动打开，不依赖"刚启动完服务器"这个时机，也不受
                             ShowServerNetworkGuideOnStart 这个"是否自动弹"开关影响。 -->
                        <Button Grid.Column="1" Content="🌐 如何联机/内网穿透教程" Style="{StaticResource PrimaryButton}"
                                Padding="14,10" Margin="0,0,10,0" Background="{StaticResource AccentBrush}"
                                Click="OpenNetworkGuide_Click"
                                ToolTip="教你怎么让好友从外网连进你的服务器：内网穿透 / 路由器端口映射 / 云服务器中转"/>
                        <Button Grid.Column="2" Content="＋ 创建服务器" Style="{StaticResource PrimaryButton}"
                                Padding="16,10" Click="CreateServer_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="InstanceListPanel"/>
                    </ScrollViewer>
                </Grid>

                <!-- ===== 占位面板：其余服务端管理功能尚未实现 ===== -->
                <Grid x:Name="PlaceholderPanel" DockPanel.Dock="Top" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTitle" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="该功能正在开发中，敬请期待。" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
