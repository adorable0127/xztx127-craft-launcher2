<UserControl x:Class="XCL2.App.Views.ModManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Str_Nav_ModManager}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource Str_Ui_Export_Modpack}" Style="{StaticResource SideNavButton}" Margin="0,0,8,0" Click="ExportModpack_Click"/>
                    <Button Content="{DynamicResource Str_Ui_Import_Modpack}" Style="{StaticResource SideNavButton}" Margin="0,0,8,0" Click="ImportModpack_Click"/>
                    <Button Content="{DynamicResource Str_Ui_Check_Dependencies}" Style="{StaticResource SideNavButton}" Margin="0,0,8,0" Click="AnalyzeDependencies_Click"/>
                    <Button Content="{DynamicResource Str_Common_Refresh}" Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FolderCombo" Grid.Column="0" Margin="0,0,10,0"
                          SelectionChanged="FolderCombo_SelectionChanged" DisplayMemberPath="Name"/>
                <ComboBox x:Name="VersionCombo" Grid.Column="1" SelectionChanged="VersionCombo_SelectionChanged"/>
            </Grid>

            <ListBox x:Name="ModsListBox" Grid.Row="2" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="14"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding FileName, Mode=OneWay}"/>
                                    <Run Text="  ·  "/><Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                    <Run Text="  ·  "/><Run Text="{Binding StatusLabel, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Enable}" Margin="0,0,8,0" Padding="10,6"
                                    Style="{StaticResource SideNavButton}" Tag="{Binding}"
                                    Click="EnableMod_Click" Visibility="{Binding EnableButtonVisibility}"/>
                            <Button Grid.Column="2" Content="{DynamicResource Str_Ui_Disable}" Margin="0,0,8,0" Padding="10,6"
                                    Style="{StaticResource SideNavButton}" Tag="{Binding}"
                                    Click="DisableMod_Click" Visibility="{Binding DisableButtonVisibility}"/>
                            <Button Grid.Column="3" Content="{DynamicResource Str_Common_Delete}" Padding="10,6"
                                    Style="{StaticResource SideNavButton}" Tag="{Binding}" Click="DeleteMod_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="{DynamicResource Str_Ui_No_Mods_Installed_For_This_Version_Yet_H}"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
