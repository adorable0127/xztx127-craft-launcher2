<Window x:Class="XCL2.App.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请稍候..." Height="160" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PanelBrush}">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
        <ProgressBar x:Name="Bar" Height="18" Minimum="0" Maximum="100" Value="0"/>
        <TextBlock x:Name="DetailText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</Window>
