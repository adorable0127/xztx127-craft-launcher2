<Window x:Class="XCL2.App.Views.RenameInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名服务器"
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="新名称：" Margin="0,0,0,6" />
        <TextBox x:Name="NameInputBox" Height="30" VerticalContentAlignment="Center" />
        <TextBlock x:Name="ErrorText" Foreground="IndianRed" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="OkBtn" Content="确定" Width="80" Style="{DynamicResource PrimaryButton}" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
