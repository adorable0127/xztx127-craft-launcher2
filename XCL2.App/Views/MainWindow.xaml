<Window x:Class="XCL2.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:XCL2.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Str_Main_WindowTitlePrefix}" Height="640" Width="1000"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="MainWindow_DragOver" DragLeave="MainWindow_DragLeave" Drop="MainWindow_Drop"
        Background="{DynamicResource SideBrush}"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        StateChanged="MainWindow_StateChanged">
        <!-- ===== 自绘标题栏 =====
             需求："隐藏系统默认的 Win 标题条，自己做，这样主题（深色/浅色皮肤配色）
             能完整应用到标题栏这一整条上"——系统原生标题栏是 DWM 直接绘制的，就算之前
             WindowChromeService 调用 DWMWA_USE_IMMERSIVE_DARK_MODE 让它按深色规则绘制，
             颜色也是系统给的固定深色/浅色两档，没法跟着本项目自定义的配色皮肤（白/蓝/黄/
             紫/粉五套 SideBrush）走，所以只能整条换成自己画的。

             用 WindowStyle="None" 去掉系统标题栏/边框，同时挂上 WindowChrome
             （而不是简单粗暴地只设 WindowStyle=None）是"留出任务栏空间"这个要求的关键：
             WindowChrome 会接管 WM_GETMINMAXINFO，窗口最大化时自动按当前显示器的工作区
             （排除任务栏）计算尺寸；如果不用 WindowChrome，纯 WindowStyle=None 的窗口
             Maximized 时会直接撑满整个物理屏幕，把任务栏盖住。
             CaptionHeight 要跟下面 TitleBarRow 的高度一致（32，对齐系统标题栏原生高度），WindowChrome 才知道
             屏幕最上面这一条是"标题栏"：可以拖拽移窗口、双击最大化/还原、拖到屏幕边缘
             触发 Aero 半屏贴靠——这些系统级窗口手势不用另外写代码，全由 WindowChrome
             免费提供。真正需要接管点击（而不是被当成拖拽）的最小化/最大化/关闭按钮，
             逐个标了 shell:WindowChrome.IsHitTestVisibleInChrome="True"。
             GlassFrameThickness="0" 关掉 Win7 时代的玻璃扩展效果（新系统上无影响，
             写上是为了兼容极少数场景下的默认行为）；ResizeBorderThickness 保留 6px
             让贴着窗口四边仍然能拖拽改变大小（WindowStyle=None 后系统自带的 6px
             调整边框跟着一起消失了，得自己声明一份）。 -->
        <shell:WindowChrome.WindowChrome>
            <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"
                                 ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
        </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 自绘标题栏内容：图标 + 标题 + 最小化/最大化/关闭 ===== -->
        <Border x:Name="CustomTitleBar" Grid.Row="0" Background="{DynamicResource SideBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 应用图标：跟窗口图标（任务栏/Alt-Tab 那个）用同一套浅色/深色两张 .ico，
                     由 AppIconService 在窗口加载和每次主题切换时统一赋值，见
                     MainWindow.xaml.cs 构造函数和 AppIconService.ApplyToTitleBarImage 注释。
                     双击关闭、单击弹系统菜单是 Windows 标题栏图标的通行交互，一并实现。 -->
                <Image x:Name="TitleBarIconImage" x:FieldModifier="public" Grid.Column="0" Width="18" Height="18"
                       Margin="10,0,0,0" VerticalAlignment="Center"
                       MouseLeftButtonUp="TitleBarIcon_MouseLeftButtonUp"/>

                <TextBlock x:Name="TitleBarText" Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- 三个系统按钮：整条标题栏默认落在 WindowChrome 的 CaptionHeight 拖拽区内，
                     只有这三个显式标了 IsHitTestVisibleInChrome=True 的按钮会正常吃到点击，
                     不会被当成"拖动窗口"。 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click" ToolTip="{DynamicResource Str_Ui_Minimize}">
                        <Path Style="{StaticResource CaptionIconPath}" Data="{StaticResource IconWinMinimize}"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeRestoreButton_Click" ToolTip="{DynamicResource Str_Ui_Maximize_Restore}">
                        <Path x:Name="MaximizeRestoreIcon" Style="{StaticResource CaptionIconPath}" Data="{StaticResource IconWinMaximize}"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" ToolTip="{DynamicResource Str_Ui_Close}">
                        <Path Style="{StaticResource CaptionCloseIconPath}" Data="{StaticResource IconWinClose}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <!-- 侧边栏宽度改成可变列（原来固定 180），配合 SidebarCollapseToggle_Click
                 在展开/收起(56，仅剩图标)两个宽度之间切换。 x:Name 供代码里读取/修改宽度。
                 展开态宽度随语言变化：简体中文等语言保持 180，只有微软中文（zh-microsoft）
                 的翻译文案更长，会加宽到 220 避免省略号截断（见 MainWindow.xaml.cs 里
                 SidebarExpandedWidth 的注释），所以这里不用写死具体数值。 -->
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="SidebarPanel" Margin="12">

                <!-- 顶部：Logo + 收起/展开切换按钮。收起后 Logo 隐藏，只留三横杠/圆点按钮，
                     跟图2/图6里"点了变成一个点"的交互一致。 -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LogoText" Grid.Column="0" Text="XCL2" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="6,10,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="SidebarCollapseToggle" Grid.Column="1" Style="{StaticResource SideNavButton}"
                            Padding="8,8" Click="SidebarCollapseToggle_Click" ToolTip="{DynamicResource Str_Ui_Collapse_Expand_Sidebar}"
                            HorizontalContentAlignment="Center">
                        <!-- 展开态显示"三横杠"，收起态（触发器）切换成"一个点"，跟需求描述一致。 -->
                        <Border x:Name="SidebarToggleIconBox" Style="{StaticResource NavIconBox}">
                            <Path x:Name="SidebarToggleIcon" Style="{StaticResource NavIconPath}"
                                  Data="{StaticResource IconMenu}"/>
                        </Border>
                    </Button>
                </Grid>

                <!-- 底部：账户/版本信息 + 进程控制 + 启动游戏。这一组明确不参与鼠标滚轮滑动
                     （需求原话："并不支持鼠标滚轮滑动"），所以放在 DockPanel.Dock="Bottom"，
                     不包在下面那个 ScrollViewer 里面。 -->
                <StackPanel x:Name="SidebarBottomPanel" DockPanel.Dock="Bottom">
                    <TextBlock x:Name="CurrentAccountText" Text="{DynamicResource Str_Launch_NoAccount}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CurrentVersionText" Text="{DynamicResource Str_Launch_NoVersion}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,10" TextWrapping="Wrap"/>

                    <!-- 展开态：一键关闭 / 关闭所选 / 关闭未响应 三个按钮都在（ProcessControlExpanded）。
                         收起态：按需求只保留"关闭所选"，文字缩成一个"关"字（CloseSelectedBtnCollapsed），
                         两组按钮做 Visibility 二选一联动，而不是在同一个按钮上动态换 Content，
                         这样两种状态各自的宽度/字号可以分别用最合适的写死值，不用在代码里拼字符串。 -->
                    <UniformGrid x:Name="ProcessControlExpanded" Columns="3" Margin="0,0,0,8">
                        <Button Content="{DynamicResource Str_Launch_CloseAll}" FontSize="10" Padding="2,6" Margin="0,0,2,0"
                                Style="{StaticResource SideNavButton}" Click="CloseAllGames_Click"
                                ToolTip="{DynamicResource Str_Ui_Close_All_Games_End_Every_Running_Game_P}"/>
                        <Button Content="{DynamicResource Str_Launch_CloseSelected}" FontSize="10" Padding="2,6" Margin="2,0,2,0"
                                Style="{StaticResource SideNavButton}" Click="CloseSelectedGame_Click"
                                ToolTip="{DynamicResource Str_Ui_Close_A_Specific_Game_Pick_A_Running_Gam}"/>
                        <Button Content="{DynamicResource Str_Launch_CloseUnresponsive}" FontSize="10" Padding="2,6" Margin="2,0,0,0"
                                Style="{StaticResource SideNavButton}" Click="CloseUnresponsiveGame_Click"
                                ToolTip="{DynamicResource Str_Ui_Close_An_Unresponsive_Game_Tick_It_Manua}"/>
                    </UniformGrid>
                    <Button x:Name="CloseSelectedBtnCollapsed" Content="{DynamicResource Str_Ui_Close}" FontSize="12" Padding="0,6" Margin="0,0,0,8"
                            Visibility="Collapsed" Style="{StaticResource SideNavButton}"
                            HorizontalContentAlignment="Center" Click="CloseSelectedGame_Click"
                            ToolTip="{DynamicResource Str_Ui_Close_A_Specific_Game_Pick_A_Running_Gam}"/>

                    <!-- 启动状态提示：从点击「启动游戏」到游戏窗口真正出现之间的过程展示
                         （"正在启动进程…"→"等待游戏窗口出现…"），默认隐藏，只在这段时间内可见。
                         收起态侧边栏太窄放不下这行文字，所以只在展开态显示。 -->
                    <TextBlock x:Name="LaunchStatusText" FontSize="11" Margin="6,0,0,4" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>

                    <!-- 展开态：跟原来一样的长条"启动游戏"按钮。
                         收起态：改成一个圆形的、里面是圆形图案的按钮（▶ 播放符号），
                         Visibility 二选一联动，两者共享同一个 Launch_Click 处理器。 -->
                    <Button x:Name="LaunchGameBtn" Content="{DynamicResource Str_Launch_Button}" Style="{StaticResource PrimaryButton}" FontSize="16" Padding="0,12"
                            Click="Launch_Click"/>
                    <Button x:Name="LaunchGameBtnCollapsed" Width="40" Height="40" Margin="0,0,0,0"
                            HorizontalAlignment="Center" Visibility="Collapsed" Click="Launch_Click"
                            Background="{DynamicResource AccentBrush}" BorderThickness="0"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            ToolTip="{DynamicResource Str_Launch_Button}" Cursor="Hand">
                        <!-- 不能直接复用 PrimaryButton 样式：那个模板把 CornerRadius 写死成 4，
                             不是通过 TemplateBinding 暴露出来的属性，没法在这里用 Setter 覆盖成
                             圆形。改成给这一个按钮单独写一个"圆形"的 ControlTemplate——
                             Border 用 CornerRadius="20"（等于按钮宽高的一半，正好是正圆），
                             里面放一个▶播放符号，对应需求里"里面图案是圆形的按钮"的收起态
                             启动游戏入口。 -->
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="20">
                                    <TextBlock Text="▶" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Effect" Value="{StaticResource GlowEffect}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- 中间：可滚动的导航按钮列表。用 ScrollViewer 包起来 + 附加属性开启
                     "鼠标滚轮滑动"（复用 ScrollWheelBehavior，跟设置页等长页面用的是同一套
                     快速滚轮逻辑，不用重新实现一遍）。仅限窗口模式（DockPanel 剩余空间自适应，
                     窗口够矮时才会真正出现滚动条，够高时跟原来一样不会有任何视觉变化）。 -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              services:ScrollWheelBehavior.EnableFastWheel="True">
                    <StackPanel x:Name="NavButtonsPanel">
                        <!-- 每个导航按钮内部改成 StackPanel(横排) + 独立的图标 TextBlock / 文字 TextBlock，
                             而不是原来单个 TextBlock 里塞两个 Run——收起侧边栏时只需要把"文字那一块"
                             Visibility=Collapsed，图标 TextBlock 保持不动即可，文字 TextBlock 上的
                             {DynamicResource Str_Nav_Xxx} 绑定全程不受影响，展开时自动恢复显示，
                             不需要在代码里手动缓存/还原文案字符串（避免和多语言切换出现绑定冲突）。 -->
                        <Button x:Name="NavHomeButton" Style="{StaticResource SideNavButton}" Click="NavHome_Click" ToolTip="{DynamicResource Str_Nav_Home}">
                            <StackPanel x:Name="NavHomeIconRow" Orientation="Horizontal">
                                <Border x:Name="NavHomeIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconHome}"/>
                                </Border>
                                <TextBlock x:Name="NavHomeLabel" Text="{DynamicResource Str_Nav_Home}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavVersionsButton" Style="{StaticResource SideNavButton}" Click="NavVersions_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Versions}">
                            <StackPanel x:Name="NavVersionsIconRow" Orientation="Horizontal">
                                <Border x:Name="NavVersionsIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconFolder}"/>
                                </Border>
                                <TextBlock x:Name="NavVersionsLabel" Text="{DynamicResource Str_Nav_Versions}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- 下载图标：原来是 "⬇️"（箭头 + U+FE0F 变体选择符，强制彩色渲染），
                             在不完整支持该字体特性的环境下会被渲染得比其它图标明显小一圈甚至
                             缩成一条线——跟 ServerManagerPage 里同一个图标遇到的问题一样，
                             改成不带变体选择符的纯符号写法，大小才能跟其它导航图标保持一致。 -->
                        <Button x:Name="NavDownloadButton" Style="{StaticResource SideNavButton}" Click="NavDownload_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Download}">
                            <StackPanel x:Name="NavDownloadIconRow" Orientation="Horizontal">
                                <Border x:Name="NavDownloadIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconDownload}"/>
                                </Border>
                                <TextBlock x:Name="NavDownloadLabel" Text="{DynamicResource Str_Nav_Download}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavMultiplayerButton" Style="{StaticResource SideNavButton}" Click="NavMultiplayer_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Multiplayer}">
                            <StackPanel x:Name="NavMultiplayerIconRow" Orientation="Horizontal">
                                <Border x:Name="NavMultiplayerIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconGlobe}"/>
                                </Border>
                                <TextBlock x:Name="NavMultiplayerLabel" Text="{DynamicResource Str_Nav_Multiplayer}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavModManagerButton" Style="{StaticResource SideNavButton}" Click="NavModManager_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_ModManager}">
                            <StackPanel x:Name="NavModManagerIconRow" Orientation="Horizontal">
                                <Border x:Name="NavModManagerIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconPuzzle}"/>
                                </Border>
                                <TextBlock x:Name="NavModManagerLabel" Text="{DynamicResource Str_Nav_ModManager}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavServerManagerButton" Style="{StaticResource SideNavButton}" Click="NavServerManager_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_ServerManager}">
                            <StackPanel x:Name="NavServerManagerIconRow" Orientation="Horizontal">
                                <Border x:Name="NavServerManagerIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconServer}"/>
                                </Border>
                                <TextBlock x:Name="NavServerManagerLabel" Text="{DynamicResource Str_Nav_ServerManager}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- 新增「百宝箱」导航入口，跳到 ToolboxPage。 -->
                        <Button x:Name="NavToolboxButton" Style="{StaticResource SideNavButton}" Click="NavToolbox_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Toolbox}">
                            <StackPanel x:Name="NavToolboxIconRow" Orientation="Horizontal">
                                <Border x:Name="NavToolboxIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconToolbox}"/>
                                </Border>
                                <TextBlock x:Name="NavToolboxLabel" Text="{DynamicResource Str_Nav_Toolbox}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- 新增「基岩版启动」导航入口，跳到 BedrockPage。原来分散在「百宝箱」的
                             一个 Tab（内容管理/服务端下载）和「实验性功能」弹窗（唤起本机基岩版
                             客户端）两处的基岩版相关功能，现在整合进这一个独立侧边栏页面，
                             不用再去两个不相关的地方分别找。 -->
                        <Button x:Name="NavBedrockButton" Style="{StaticResource SideNavButton}" Click="NavBedrock_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Bedrock}">
                            <StackPanel x:Name="NavBedrockIconRow" Orientation="Horizontal">
                                <Border x:Name="NavBedrockIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconBedrock}"/>
                                </Border>
                                <TextBlock x:Name="NavBedrockLabel" Text="{DynamicResource Str_Nav_Bedrock}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- 新增「鸣谢与帮助」导航入口，跳到 AboutHelpPage（登录/购买/新手/报错帮助
                             + 作者赞助信息/开源仓库/感谢名单/赞助榜/哔哩哔哩粉丝墙）。 -->
                        <Button x:Name="NavAboutHelpButton" Style="{StaticResource SideNavButton}" Click="NavAboutHelp_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_AboutHelp}">
                            <StackPanel x:Name="NavAboutHelpIconRow" Orientation="Horizontal">
                                <Border x:Name="NavAboutHelpIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconHeart}"/>
                                </Border>
                                <TextBlock x:Name="NavAboutHelpLabel" Text="{DynamicResource Str_Nav_AboutHelp}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAccountsButton" Style="{StaticResource SideNavButton}" Click="NavAccounts_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Accounts}">
                            <StackPanel x:Name="NavAccountsIconRow" Orientation="Horizontal">
                                <Border x:Name="NavAccountsIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconAccount}"/>
                                </Border>
                                <TextBlock x:Name="NavAccountsLabel" Text="{DynamicResource Str_Nav_Accounts}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettingsButton" Style="{StaticResource SideNavButton}" Click="NavSettings_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Settings}">
                            <StackPanel x:Name="NavSettingsIconRow" Orientation="Horizontal">
                                <Border x:Name="NavSettingsIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconSettings}"/>
                                </Border>
                                <TextBlock x:Name="NavSettingsLabel" Text="{DynamicResource Str_Nav_Settings}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLogsButton" Style="{StaticResource SideNavButton}" Click="NavLogs_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Logs}">
                            <StackPanel x:Name="NavLogsIconRow" Orientation="Horizontal">
                                <Border x:Name="NavLogsIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconLogs}"/>
                                </Border>
                                <TextBlock x:Name="NavLogsLabel" Text="{DynamicResource Str_Nav_Logs}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- 实验性功能导航按钮：仅当启动器界面语言是简体中文时显示（见
                             LocalizationService.ExperimentalFeaturesLanguageGate 的注释——这批功能
                             还没有多语言界面，贸然对其它语言用户展示未翻译的中文体验更差）。
                             x:Name 供 MainWindow.xaml.cs 在语言切换时动态控制 Visibility。 -->
                        <Button x:Name="NavExperimentalButton" Style="{StaticResource SideNavButton}" Click="NavExperimental_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Experimental}">
                            <StackPanel x:Name="NavExperimentalIconRow" Orientation="Horizontal">
                                <Border x:Name="NavExperimentalIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconFlask}"/>
                                </Border>
                                <TextBlock x:Name="NavExperimentalLabel" Text="{DynamicResource Str_Nav_Experimental}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Column="1" Margin="16">
            <Grid>
                <ContentControl x:Name="MainContent" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="MainContentTransform" Y="0"/>
                    </ContentControl.RenderTransform>
                </ContentControl>

                <!-- 「重新阅读协议并同意」：只有基本模式（RestrictedMode=true）下常驻显示。
                     点击后重新走一遍完整协议四步流程，同意即退出基本模式、恢复全部功能；
                     见 AppConfig.RestrictedMode 的注释与 MainWindow.xaml.cs 里的
                     ApplyRestrictedModeGating。
                     修复：原来固定在右上角，跟 HomePage 自己右上角那一排（语言/深浅色/
                     自动循环/普通模式/访客模式）胶囊按钮共用同一块屏幕区域——两者都是
                     "浮在内容区之上、右上角对齐"，首页显示时会直接叠在一起。现在挪到
                     左上角，跟内容区里任何页面自己的右上角控件都不会有重叠的可能。 -->
                <Button x:Name="ReReadAgreementsButton" Content="重新阅读协议并同意"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Style="{StaticResource PrimaryButton}" Padding="14,6"
                        Click="ReReadAgreements_Click" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ===== 进程内弹窗宿主层（OverlayHost） =====
             说明见 Services/OverlayDialogService.cs 顶部的整体设计注释。这里只放"容器"：
             Grid.ColumnSpan="2" 让遮罩盖住整个主窗口（包括左侧导航栏），不是只盖内容区，
             跟独立 Window 弹窗"挡住整个程序窗口"的观感一致。默认 Collapsed，没有弹窗时
             完全不占用视觉/命中测试（Visibility=Collapsed 的元素不会拦截鼠标事件）。 -->
        <Grid x:Name="OverlayRoot" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Focusable="False">
            <!-- 遮罩层：半透明黑，点击可选是否允许"点遮罩关闭"（由 OverlayDialogService 按每次
                 弹窗调用时的参数决定，见 OverlayOptions.DismissOnBackgroundClick）。 -->
            <Border x:Name="OverlayScrim" Background="#99000000" MouseLeftButtonUp="OverlayScrim_MouseLeftButtonUp"/>

            <!-- 弹窗内容容器：真正的弹窗 UserControl 通过 OverlayDialogService 塞进
                 OverlayContentHost.Content。外层 Border 提供跟原生 Window 弹窗一致的
                 卡片观感（圆角+PanelBrush 背景+阴影），弹窗自己的 XAML 不需要重复写这些。 -->
            <Border x:Name="OverlayCard" Background="{DynamicResource PanelBrush}" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="OverlayCardScale" CenterX="0.5" CenterY="0.5"/>
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <ContentControl x:Name="OverlayContentHost" Focusable="False"/>
            </Border>
        </Grid>

        <!-- ===== 拖拽提示层 =====
             层次说明（Grid 里后声明的在上层，等价于更大的 z-index）：
                 内容区 / 侧边栏  →  OverlayRoot（弹窗+遮罩）  →  拖拽提示  →  Toast
             拖拽提示要压在弹窗之上：用户在开着弹窗的时候拖文件进来，也应该看到提示，
             否则会以为拖拽没被接住。IsHitTestVisible=False 让它只是"贴一层视觉"，
             不拦截鼠标事件，拖放本身仍由 Window 级的 Drop 事件处理。 -->
        <Border x:Name="DragHintLayer" Grid.Column="0" Grid.ColumnSpan="2"
                Visibility="Collapsed" IsHitTestVisible="False"
                Background="#CC0B1220">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="40,32"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center">
                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconDownload}"
                          Width="44" Height="44" StrokeThickness="1.2"
                          Stroke="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="DragHintTitle" Text="{DynamicResource Str_Drop_Title}" FontSize="20" FontWeight="Bold"
                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DragHintDetail" FontSize="13" Margin="0,8,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Str_Drop_Hint}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== Toast 通知层（最顶层）=====
             "游戏启动成功"这类纯告知性提示不该做成需要点确定的模态框——那会把人锁住。
             改成右下角浮出、几秒后自动消失的 Toast。必须压在弹窗之上，
             否则弹窗打开时的操作反馈会被遮住看不见。
             同样 IsHitTestVisible=False（Toast 自己不需要交互），不影响下层点击。 -->
        <ItemsControl x:Name="ToastHost" Grid.Column="0" Grid.ColumnSpan="2"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,20,20" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- ===== 左下角"操作类"通知层 =====
             跟右下角纯告知性 Toast 不同，这里放的是"需要用户点一下按钮做选择、但又不想用
             模态弹窗打断"的提示——典型场景：加载器版本转换成功后，问用户"要不要删掉这次
             操作前的自动备份"。这类提示不会自动消失（要等用户点按钮），且必须能点击，
             所以单独开一层、不能沿用 IsHitTestVisible=False 的 ToastHost（WPF 里祖先元素
             IsHitTestVisible=False 会导致子元素即使自己设 True 也收不到鼠标事件）。
             放左下角是刻意跟右下角的普通 Toast 错开，避免两类提示同时出现时互相遮挡/混淆。 -->
        <ItemsControl x:Name="ActionToastHost" Grid.Column="0" Grid.ColumnSpan="2"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Margin="20,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        </Grid>
    </Grid>
</Window>
