<Window x:Class="XCL2.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:XCL2.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Str_Main_WindowTitlePrefix}" Height="640" Width="1000"
        MinHeight="480" MinWidth="854"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="MainWindow_DragOver" DragLeave="MainWindow_DragLeave" Drop="MainWindow_Drop"
        Background="{DynamicResource SideBrush}"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        StateChanged="MainWindow_StateChanged">
        <!-- ===== 自绘标题栏 =====
             需求："隐藏系统默认的 Win 标题条，自己做，这样主题（深色/浅色皮肤配色）
             能完整应用到标题栏这一整条上"——系统原生标题栏是 DWM 直接绘制的，就算之前
             WindowChromeService 调用 DWMWA_USE_IMMERSIVE_DARK_MODE 让它按深色规则绘制，
             颜色也是系统给的固定深色/浅色两档，没法跟着本项目自定义的配色皮肤（白/蓝/黄/
             紫/粉五套 SideBrush）走，所以只能整条换成自己画的。

             用 WindowStyle="None" 去掉系统标题栏/边框，同时挂上 WindowChrome
             （而不是简单粗暴地只设 WindowStyle=None）是"留出任务栏空间"这个要求的关键：
             WindowChrome 会接管 WM_GETMINMAXINFO，窗口最大化时自动按当前显示器的工作区
             （排除任务栏）计算尺寸；如果不用 WindowChrome，纯 WindowStyle=None 的窗口
             Maximized 时会直接撑满整个物理屏幕，把任务栏盖住。
             CaptionHeight 要跟下面 TitleBarRow 的高度一致（32，对齐系统标题栏原生高度），WindowChrome 才知道
             屏幕最上面这一条是"标题栏"：可以拖拽移窗口、双击最大化/还原、拖到屏幕边缘
             触发 Aero 半屏贴靠——这些系统级窗口手势不用另外写代码，全由 WindowChrome
             免费提供。真正需要接管点击（而不是被当成拖拽）的最小化/最大化/关闭按钮，
             逐个标了 shell:WindowChrome.IsHitTestVisibleInChrome="True"。
             GlassFrameThickness="0" 关掉 Win7 时代的玻璃扩展效果（新系统上无影响，
             写上是为了兼容极少数场景下的默认行为）；ResizeBorderThickness 保留 6px
             让贴着窗口四边仍然能拖拽改变大小（WindowStyle=None 后系统自带的 6px
             调整边框跟着一起消失了，得自己声明一份）。 -->
        <shell:WindowChrome.WindowChrome>
            <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"
                                 ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
        </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义毛玻璃背景必须作为真正的窗口底层，而不能再写到 Window.Background。
             Window.Background 会跟 DWM 的 Mica/Acrylic 合成层互相覆盖，尤其 Acrylic 下经常只剩
             系统毛玻璃而看不到用户图片。现在图片先在 WPF 内容树最底层铺满并做轻度模糊，
             上面的主题面板再以半透明画刷覆盖，视觉上就是“图片在毛玻璃下面”。 -->
        <Image x:Name="CustomBackgroundImageLayer" Grid.Row="0" Grid.RowSpan="2"
               Visibility="Collapsed" IsHitTestVisible="False" Stretch="UniformToFill"
               Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
            </Image.RenderTransform>
            <Image.Effect>
                <BlurEffect Radius="16" RenderingBias="Quality"/>
            </Image.Effect>
        </Image>
        <Border x:Name="CustomBackgroundTintLayer" Grid.Row="0" Grid.RowSpan="2"
                Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource SideBrush}" Opacity="0.16"/>

        <!-- ===== 自绘标题栏内容：图标 + 标题 + 最小化/最大化/关闭 ===== -->
        <Border x:Name="CustomTitleBar" Grid.Row="0" Background="{DynamicResource SideBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 应用图标：跟窗口图标（任务栏/Alt-Tab 那个）用同一套浅色/深色两张 .ico，
                     由 AppIconService 在窗口加载和每次主题切换时统一赋值，见
                     MainWindow.xaml.cs 构造函数和 AppIconService.ApplyToTitleBarImage 注释。
                     双击关闭、单击弹系统菜单是 Windows 标题栏图标的通行交互，一并实现。 -->
                <Image x:Name="TitleBarIconImage" x:FieldModifier="public" Grid.Column="0" Width="18" Height="18"
                       Margin="10,0,0,0" VerticalAlignment="Center"
                       MouseLeftButtonUp="TitleBarIcon_MouseLeftButtonUp"/>

                <TextBlock x:Name="TitleBarText" Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="12" Margin="10,0,8,0" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- 三个系统按钮：整条标题栏默认落在 WindowChrome 的 CaptionHeight 拖拽区内，
                     只有这三个显式标了 IsHitTestVisibleInChrome=True 的按钮会正常吃到点击，
                     不会被当成"拖动窗口"。 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- 下载列表按钮：放在最小化/最大化/关闭三个系统按钮左边。需求："下载的暂停、
                         取消等操作与启动按钮分开，而且在下载的时候也可以启动"——这个按钮弹出的下拉
                         列表只管下载任务的暂停/继续/取消，跟主界面里的"启动游戏"按钮完全独立，
                         互不阻塞。没有下载任务时按钮本身仍然可见（跟系统托盘/任务栏里"下载"图标常驻
                         一个道理），只是不显示数字角标、点开是空列表提示。 -->
                    <Grid x:Name="DownloadQueueButtonRoot" Margin="0,0,4,0" VerticalAlignment="Center"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="DownloadQueueButton" Style="{StaticResource CaptionButton}"
                                Click="DownloadQueueButton_Click" ToolTip="下载列表">
                            <Path Style="{StaticResource CaptionIconPath}" Data="{StaticResource IconDownload}"
                                  x:Name="DownloadQueueIconPath"/>
                        </Button>
                        <Border x:Name="DownloadQueueBadge" Background="{DynamicResource AccentBrush}"
                                CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="DownloadQueueBadgeText" Text="0" FontSize="9" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Popup x:Name="DownloadQueuePopup" PlacementTarget="{Binding ElementName=DownloadQueueButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Popup.Resources>
                                <!-- 默认收起（不显示详情行），MainWindow.ApplyDownloadPopupDetailMode()
                                     会在启动时和设置保存后按 AppConfig.DownloadPopupShowDetailStats
                                     把这个资源换成 Visible，气泡内所有条目的详情行统一跟着显示/隐藏。 -->
                                <Visibility x:Key="DownloadQueueDetailVisibility">Collapsed</Visibility>
                                <!-- 下载列表边缘拖拽调整大小用的透明 Thumb：默认 Thumb 模板自带一层灰色
                                     "夹点"外观，这里换成纯透明的 Border 模板，只保留可拖拽的命中区域，
                                     视觉上完全看不出来（跟系统窗口边缘"看不见但能拖"的手感一致）。 -->
                                <Style x:Key="DownloadQueueResizeThumbStyle" TargetType="Thumb">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Popup.Resources>
                            <Border x:Name="DownloadQueuePopupBorder" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                    BorderThickness="1" CornerRadius="6"
                                    Width="300" Height="340" MinWidth="260" MinHeight="140" MaxWidth="640" MaxHeight="640">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="下载列表" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,6"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="DownloadQueueItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SideBrush}" CornerRadius="4"
                                                                Padding="6" Margin="0,0,0,4">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <ProgressBar Height="4" Margin="0,4,0,4"
                                                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                             Minimum="0" Maximum="100"/>
                                                                <!-- 详情行：剩余时间/当前速度/大小，见 AppConfig.DownloadPopupShowDetailStats
                                                                     与 DownloadQueueItem.DetailText。默认隐藏，跟随
                                                                     DownloadQueueDetailVisibility 资源统一显隐。 -->
                                                                <TextBlock Text="{Binding DetailText, Mode=OneWay}" FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{DynamicResource DownloadQueueDetailVisibility}"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="1" Content="暂停/继续" FontSize="11" Padding="6,2"
                                                                            Margin="0,0,4,0" Click="DownloadItemPauseResume_Click"
                                                                            Tag="{Binding}"/>
                                                                    <Button Grid.Column="2" Content="取消" FontSize="11" Padding="6,2"
                                                                            Click="DownloadItemCancel_Click" Tag="{Binding}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    <TextBlock Grid.Row="2" x:Name="DownloadQueueEmptyHint" Text="暂无下载任务"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,10,0,4"/>

                                    <!-- 让下载列表面板可以用鼠标拖拽边缘调整大小：右边缘拖宽度、下边缘拖高度、
                                         右下角同时拖两者。三个 Thumb 都是 6px 宽/高的透明命中区域，叠在
                                         Border 对应边缘上，不遮挡内部内容的正常交互。Grid.RowSpan="3" 让它们
                                         横跨整个面板高度/宽度，不受行布局影响。 -->
                                    <Thumb x:Name="DownloadQueueResizeRightThumb" Grid.RowSpan="3" Width="6" HorizontalAlignment="Right" Margin="0,0,-3,0"
                                           Cursor="SizeWE" Style="{StaticResource DownloadQueueResizeThumbStyle}"
                                           DragDelta="DownloadQueueResizeRightThumb_DragDelta"/>
                                    <Thumb x:Name="DownloadQueueResizeBottomThumb" Grid.Row="2" Height="6" VerticalAlignment="Bottom" Margin="0,0,0,-3"
                                           Cursor="SizeNS" Style="{StaticResource DownloadQueueResizeThumbStyle}"
                                           DragDelta="DownloadQueueResizeBottomThumb_DragDelta"/>
                                    <Thumb x:Name="DownloadQueueResizeCornerThumb" Grid.Row="2" Width="12" Height="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                           Cursor="SizeNWSE" Style="{StaticResource DownloadQueueResizeThumbStyle}"
                                           DragDelta="DownloadQueueResizeCornerThumb_DragDelta"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <!-- 窗口控制三按钮必须是一个不可拆分的固定按钮组。之前 SizeChanged 里分别
                         给三个按钮叠加 2/22/42px 左外边距，窗口一缩小就像“分家”一样散开，
                         还会把最右侧按钮推出可视区。现在布局完全交给这个横向容器：三个按钮
                         都固定 46x32、Margin=0，任何窗口宽度下都紧挨在一起并始终保留在右上角。 -->
                    <StackPanel x:Name="WindowCaptionButtonPanel" Orientation="Horizontal"
                                Margin="0" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Margin="0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeButton_Click" ToolTip="{DynamicResource Str_Ui_Minimize}">
                            <Path Style="{StaticResource CaptionIconPath}" Data="{StaticResource IconWinMinimize}"/>
                        </Button>
                        <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButton}" Margin="0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeRestoreButton_Click" ToolTip="{DynamicResource Str_Ui_Maximize_Restore}">
                            <Path x:Name="MaximizeRestoreIcon" Style="{StaticResource CaptionIconPath}" Data="{StaticResource IconWinMaximize}"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Margin="0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseButton_Click" ToolTip="{DynamicResource Str_Ui_Close}">
                            <Path Style="{StaticResource CaptionCloseIconPath}" Data="{StaticResource IconWinClose}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="AppBodyGrid">
        <!-- 界面缩放（Ctrl+滚轮 / Ctrl+方向键）：LayoutTransform 而不是 RenderTransform，
             因为要的是"整体重新排版的缩放"（跟浏览器 Ctrl+滚轮页面缩放一样，缩放后各控件
             实际占用的布局空间也跟着变，能触发滚动条/换行），而不是只在视觉上拉伸像素。
             只套在这个 Grid（侧边栏+右侧内容区）上，不含 Grid.Row="0" 的自绘标题栏——
             标题栏（最小化/最大化/关闭按钮、拖拽区域）缩放会导致 WindowChrome 的按钮命中
             区域跟视觉位置对不上，所以刻意排除在缩放范围之外。ScaleTransform 的 ScaleX/ScaleY
             由 UiZoomService 统一读写，见该类注释。 -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiZoomTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <!-- 侧边栏宽度改成可变列（原来固定 180），配合 SidebarCollapseToggle_Click
                 在展开/收起(56，仅剩图标)两个宽度之间切换。 x:Name 供代码里读取/修改宽度。
                 展开态宽度随语言变化：简体中文等语言保持 180，只有微软中文（zh-microsoft）
                 的翻译文案更长，会加宽到 220 避免省略号截断（见 MainWindow.xaml.cs 里
                 SidebarExpandedWidth 的注释），所以这里不用写死具体数值。 -->
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="SidebarPanel" Margin="12">

                <!-- 顶部：Logo + 收起/展开切换按钮。收起后 Logo 隐藏，只留三横杠/圆点按钮，
                     跟图2/图6里"点了变成一个点"的交互一致。 -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LogoText" Grid.Column="0" Text="XCL2" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="6,10,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="SidebarCollapseToggle" Grid.Column="1" Style="{StaticResource SideNavButton}"
                            Padding="8,8" Click="SidebarCollapseToggle_Click" ToolTip="{DynamicResource Str_Ui_Collapse_Expand_Sidebar}"
                            HorizontalContentAlignment="Center">
                        <!-- 展开态显示"三横杠"，收起态（触发器）切换成"一个点"，跟需求描述一致。 -->
                        <Border x:Name="SidebarToggleIconBox" Style="{StaticResource NavIconBox}">
                            <Path x:Name="SidebarToggleIcon" Style="{StaticResource NavIconPath}"
                                  Data="{StaticResource IconMenu}"/>
                        </Border>
                    </Button>
                </Grid>

                <!-- 底部：账户/版本信息 + 进程控制 + 启动游戏。这一组明确不参与鼠标滚轮滑动
                     （需求原话："并不支持鼠标滚轮滑动"），所以放在 DockPanel.Dock="Bottom"，
                     不包在下面那个 ScrollViewer 里面。 -->
                <StackPanel x:Name="SidebarBottomPanel" DockPanel.Dock="Bottom">
                    <TextBlock x:Name="CurrentAccountText" Text="{DynamicResource Str_Launch_NoAccount}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CurrentVersionText" Text="{DynamicResource Str_Launch_NoVersion}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,10" TextWrapping="Wrap"/>

                    <!-- 展开态：一键关闭 / 关闭所选 / 关闭未响应 三个按钮都在（ProcessControlExpanded）。
                         收起态：按需求只保留"关闭所选"，文字缩成一个"关"字（CloseSelectedBtnCollapsed），
                         两组按钮做 Visibility 二选一联动，而不是在同一个按钮上动态换 Content，
                         这样两种状态各自的宽度/字号可以分别用最合适的写死值，不用在代码里拼字符串。 -->
                    <UniformGrid x:Name="ProcessControlExpanded" Columns="3" Margin="0,0,0,8">
                        <Button Content="{DynamicResource Str_Launch_CloseAll}" FontSize="10" Padding="2,6" Margin="0,0,2,0"
                                Style="{StaticResource SideNavButton}" Click="CloseAllGames_Click"
                                ToolTip="{DynamicResource Str_Ui_Close_All_Games_End_Every_Running_Game_P}"/>
                        <Button Content="{DynamicResource Str_Launch_CloseSelected}" FontSize="10" Padding="2,6" Margin="2,0,2,0"
                                Style="{StaticResource SideNavButton}" Click="CloseSelectedGame_Click"
                                ToolTip="{DynamicResource Str_Ui_Close_A_Specific_Game_Pick_A_Running_Gam}"/>
                        <Button Content="{DynamicResource Str_Launch_CloseUnresponsive}" FontSize="10" Padding="2,6" Margin="2,0,0,0"
                                Style="{StaticResource SideNavButton}" Click="CloseUnresponsiveGame_Click"
                                ToolTip="{DynamicResource Str_Ui_Close_An_Unresponsive_Game_Tick_It_Manua}"/>
                    </UniformGrid>
                    <Button x:Name="CloseSelectedBtnCollapsed" Content="{DynamicResource Str_Ui_Close}" FontSize="12" Padding="0,6" Margin="0,0,0,8"
                            Visibility="Collapsed" Style="{StaticResource SideNavButton}"
                            HorizontalContentAlignment="Center" Click="CloseSelectedGame_Click"
                            ToolTip="{DynamicResource Str_Ui_Close_A_Specific_Game_Pick_A_Running_Gam}"/>

                    <!-- 启动状态提示：从点击「启动游戏」到游戏窗口真正出现之间的过程展示
                         （"正在启动进程…"→"等待游戏窗口出现…"），默认隐藏，只在这段时间内可见。
                         收起态侧边栏太窄放不下这行文字，所以只在展开态显示。 -->
                    <TextBlock x:Name="LaunchStatusText" FontSize="11" Margin="6,0,0,4" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>

                    <!-- 展开态：跟原来一样的长条"启动游戏"按钮。
                         收起态：改成一个圆形的、里面是圆形图案的按钮（▶ 播放符号），
                         Visibility 二选一联动，两者共享同一个 Launch_Click 处理器。 -->
                    <Button x:Name="LaunchGameBtn" Content="{DynamicResource Str_Launch_Button}" Style="{StaticResource PrimaryButton}" FontSize="16" Padding="0,12"
                            Click="Launch_Click"/>
                    <Button x:Name="LaunchGameBtnCollapsed" Width="40" Height="40" Margin="0,0,0,0"
                            HorizontalAlignment="Center" Visibility="Collapsed" Click="Launch_Click"
                            Background="{DynamicResource AccentBrush}" BorderThickness="0"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            ToolTip="{DynamicResource Str_Launch_Button}" Cursor="Hand">
                        <!-- 不能直接复用 PrimaryButton 样式：那个模板把 CornerRadius 写死成 4，
                             不是通过 TemplateBinding 暴露出来的属性，没法在这里用 Setter 覆盖成
                             圆形。改成给这一个按钮单独写一个"圆形"的 ControlTemplate——
                             Border 用 CornerRadius="20"（等于按钮宽高的一半，正好是正圆），
                             里面放一个▶播放符号，对应需求里"里面图案是圆形的按钮"的收起态
                             启动游戏入口。 -->
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="20">
                                    <TextBlock Text="▶" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Effect" Value="{StaticResource GlowEffect}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- 中间：可滚动的导航按钮列表。用 ScrollViewer 包起来 + 附加属性开启
                     "鼠标滚轮滑动"（复用 ScrollWheelBehavior，跟设置页等长页面用的是同一套
                     快速滚轮逻辑，不用重新实现一遍）。仅限窗口模式（DockPanel 剩余空间自适应，
                     窗口够矮时才会真正出现滚动条，够高时跟原来一样不会有任何视觉变化）。 -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              services:ScrollWheelBehavior.EnableFastWheel="True">
                    <StackPanel x:Name="NavButtonsPanel">
                        <!-- 每个导航按钮内部改成 StackPanel(横排) + 独立的图标 TextBlock / 文字 TextBlock，
                             而不是原来单个 TextBlock 里塞两个 Run——收起侧边栏时只需要把"文字那一块"
                             Visibility=Collapsed，图标 TextBlock 保持不动即可，文字 TextBlock 上的
                             {DynamicResource Str_Nav_Xxx} 绑定全程不受影响，展开时自动恢复显示，
                             不需要在代码里手动缓存/还原文案字符串（避免和多语言切换出现绑定冲突）。 -->
                        <Button x:Name="NavHomeButton" Style="{StaticResource SideNavButton}" Click="NavHome_Click" ToolTip="{DynamicResource Str_Nav_Home}">
                            <StackPanel x:Name="NavHomeIconRow" Orientation="Horizontal">
                                <Border x:Name="NavHomeIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconHome}"/>
                                </Border>
                                <TextBlock x:Name="NavHomeLabel" Text="{DynamicResource Str_Nav_Home}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
