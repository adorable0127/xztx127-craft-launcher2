                        <!-- 下载图标：原来是 "⬇️"（箭头 + U+FE0F 变体选择符，强制彩色渲染），
                             在不完整支持该字体特性的环境下会被渲染得比其它图标明显小一圈甚至
                             缩成一条线——跟 ServerManagerPage 里同一个图标遇到的问题一样，
                             改成不带变体选择符的纯符号写法，大小才能跟其它导航图标保持一致。 -->
                        <Button x:Name="NavDownloadButton" Style="{StaticResource SideNavButton}" Click="NavDownload_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Download}">
                            <StackPanel x:Name="NavDownloadIconRow" Orientation="Horizontal">
                                <Border x:Name="NavDownloadIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconDownload}"/>
                                </Border>
                                <TextBlock x:Name="NavDownloadLabel" Text="{DynamicResource Str_Nav_Download}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavMultiplayerButton" Style="{StaticResource SideNavButton}" Click="NavMultiplayer_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Multiplayer}">
                            <StackPanel x:Name="NavMultiplayerIconRow" Orientation="Horizontal">
                                <Border x:Name="NavMultiplayerIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconGlobe}"/>
                                </Border>
                                <TextBlock x:Name="NavMultiplayerLabel" Text="{DynamicResource Str_Nav_Multiplayer}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavModManagerButton" Style="{StaticResource SideNavButton}" Click="NavModManager_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_ModManager}">
                            <StackPanel x:Name="NavModManagerIconRow" Orientation="Horizontal">
                                <Border x:Name="NavModManagerIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconPuzzle}"/>
                                </Border>
                                <TextBlock x:Name="NavModManagerLabel" Text="{DynamicResource Str_Nav_ModManager}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavServerManagerButton" Style="{StaticResource SideNavButton}" Click="NavServerManager_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_ServerManager}">
                            <StackPanel x:Name="NavServerManagerIconRow" Orientation="Horizontal">
                                <Border x:Name="NavServerManagerIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconServer}"/>
                                </Border>
                                <TextBlock x:Name="NavServerManagerLabel" Text="{DynamicResource Str_Nav_ServerManager}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- 新增「百宝箱」导航入口，跳到 ToolboxPage。 -->
                        <Button x:Name="NavToolboxButton" Style="{StaticResource SideNavButton}" Click="NavToolbox_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Toolbox}">
                            <StackPanel x:Name="NavToolboxIconRow" Orientation="Horizontal">
                                <Border x:Name="NavToolboxIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconToolbox}"/>
                                </Border>
                                <TextBlock x:Name="NavToolboxLabel" Text="{DynamicResource Str_Nav_Toolbox}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- 新增「基岩版启动」导航入口，跳到 BedrockPage。原来分散在「百宝箱」的
                             一个 Tab（内容管理/服务端下载）和「实验性功能」弹窗（唤起本机基岩版
                             客户端）两处的基岩版相关功能，现在整合进这一个独立侧边栏页面，
                             不用再去两个不相关的地方分别找。 -->
                        <Button x:Name="NavBedrockButton" Style="{StaticResource SideNavButton}" Click="NavBedrock_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Bedrock}">
                            <StackPanel x:Name="NavBedrockIconRow" Orientation="Horizontal">
                                <Border x:Name="NavBedrockIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconBedrock}"/>
                                </Border>
                                <TextBlock x:Name="NavBedrockLabel" Text="{DynamicResource Str_Nav_Bedrock}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- 新增「鸣谢与帮助」导航入口，跳到 AboutHelpPage（登录/购买/新手/报错帮助
                             + 作者赞助信息/开源仓库/感谢名单/赞助榜/哔哩哔哩粉丝墙）。 -->
                        <Button x:Name="NavAboutHelpButton" Style="{StaticResource SideNavButton}" Click="NavAboutHelp_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_AboutHelp}">
                            <StackPanel x:Name="NavAboutHelpIconRow" Orientation="Horizontal">
                                <Border x:Name="NavAboutHelpIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconHeart}"/>
                                </Border>
                                <TextBlock x:Name="NavAboutHelpLabel" Text="{DynamicResource Str_Nav_AboutHelp}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAccountsButton" Style="{StaticResource SideNavButton}" Click="NavAccounts_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Accounts}">
                            <StackPanel x:Name="NavAccountsIconRow" Orientation="Horizontal">
                                <Border x:Name="NavAccountsIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconAccount}"/>
                                </Border>
                                <TextBlock x:Name="NavAccountsLabel" Text="{DynamicResource Str_Nav_Accounts}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettingsButton" Style="{StaticResource SideNavButton}" Click="NavSettings_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Settings}">
                            <StackPanel x:Name="NavSettingsIconRow" Orientation="Horizontal">
                                <Border x:Name="NavSettingsIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconSettings}"/>
                                </Border>
                                <TextBlock x:Name="NavSettingsLabel" Text="{DynamicResource Str_Nav_Settings}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLogsButton" Style="{StaticResource SideNavButton}" Click="NavLogs_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Logs}">
                            <StackPanel x:Name="NavLogsIconRow" Orientation="Horizontal">
                                <Border x:Name="NavLogsIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconLogs}"/>
                                </Border>
                                <TextBlock x:Name="NavLogsLabel" Text="{DynamicResource Str_Nav_Logs}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- AI 助手导航按钮 -->
                        <Button x:Name="NavAiAssistantButton" Style="{StaticResource SideNavButton}" Click="NavAiAssistant_Click" Margin="0,4,0,0" ToolTip="AI 助手">
                            <StackPanel x:Name="NavAiAssistantIconRow" Orientation="Horizontal">
                                <Border x:Name="NavAiAssistantIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconAI}"/>
                                </Border>
                                <TextBlock x:Name="NavAiAssistantLabel" Text="AI 助手" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- 实验性功能导航按钮：仅当启动器界面语言是简体中文时显示（见
                             LocalizationService.ExperimentalFeaturesLanguageGate 的注释——这批功能
                             还没有多语言界面，贸然对其它语言用户展示未翻译的中文体验更差）。
                             x:Name 供 MainWindow.xaml.cs 在语言切换时动态控制 Visibility。 -->
                        <Button x:Name="NavExperimentalButton" Style="{StaticResource SideNavButton}" Click="NavExperimental_Click" Margin="0,4,0,0" ToolTip="{DynamicResource Str_Nav_Experimental}">
                            <StackPanel x:Name="NavExperimentalIconRow" Orientation="Horizontal">
                                <Border x:Name="NavExperimentalIcon" Style="{StaticResource NavIconBox}">
                                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconFlask}"/>
                                </Border>
                                <TextBlock x:Name="NavExperimentalLabel" Text="{DynamicResource Str_Nav_Experimental}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Column="1" Margin="16">
            <Grid>
                <ContentControl x:Name="MainContent" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <!-- TransformGroup 顺序：先缩放再位移，配合 MainWindow.SetMainContent
                             里的"高性能模式"过渡（缩放0.96->1 + 位移回弹），RenderTransformOrigin
                             居中保证缩放观感是"从中心轻微放大归位"而不是从左上角长出来。
                             低性能/普通模式下 Scale 恒为 1，等价于以前只有位移的写法。 -->
                        <TransformGroup>
                            <ScaleTransform x:Name="MainContentScaleTransform" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="MainContentTransform" Y="0"/>
                        </TransformGroup>
                    </ContentControl.RenderTransform>
                </ContentControl>

                <!-- 「重新阅读协议并同意」：只有基本模式（RestrictedMode=true）下常驻显示。
                     点击后重新走一遍完整协议四步流程，同意即退出基本模式、恢复全部功能；
                     见 AppConfig.RestrictedMode 的注释与 MainWindow.xaml.cs 里的
                     ApplyRestrictedModeGating。
                     修复：原来固定在右上角，跟 HomePage 自己右上角那一排（语言/深浅色/
                     自动循环/普通模式/访客模式）胶囊按钮共用同一块屏幕区域——两者都是
                     "浮在内容区之上、右上角对齐"，首页显示时会直接叠在一起。现在挪到
                     左上角，跟内容区里任何页面自己的右上角控件都不会有重叠的可能。 -->
                <Button x:Name="ReReadAgreementsButton" Content="重新阅读协议并同意"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Style="{StaticResource PrimaryButton}" Padding="14,6"
                        Click="ReReadAgreements_Click" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ===== 进程内弹窗宿主层（OverlayHost） =====
             说明见 Services/OverlayDialogService.cs 顶部的整体设计注释。这里只放"容器"：
             Grid.ColumnSpan="2" 让遮罩盖住整个主窗口（包括左侧导航栏），不是只盖内容区，
             跟独立 Window 弹窗"挡住整个程序窗口"的观感一致。默认 Collapsed，没有弹窗时
             完全不占用视觉/命中测试（Visibility=Collapsed 的元素不会拦截鼠标事件）。 -->
        <Grid x:Name="OverlayRoot" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Focusable="False">
            <!-- 遮罩层：半透明黑，点击可选是否允许"点遮罩关闭"（由 OverlayDialogService 按每次
                 弹窗调用时的参数决定，见 OverlayOptions.DismissOnBackgroundClick）。 -->
            <Border x:Name="OverlayScrim" Background="#99000000" MouseLeftButtonUp="OverlayScrim_MouseLeftButtonUp"/>

            <!-- 弹窗内容容器：真正的弹窗 UserControl 通过 OverlayDialogService 塞进
                 OverlayContentHost.Content。外层 Border 提供跟原生 Window 弹窗一致的
                 卡片观感（圆角+PanelBrush 背景+阴影），弹窗自己的 XAML 不需要重复写这些。 -->
            <Border x:Name="OverlayCard" Background="Transparent" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="OverlayCardScale" CenterX="0.5" CenterY="0.5"/>
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <!-- 背景层跟内容层拆成两个独立的 Grid 子元素叠放：Effect 属性单个控件只能挂一个，
                     外层 OverlayCard 已经用掉了投影阴影；磨砂(PopupBlurEffect)只糊在背景层
                     （PopupPanelBrush，一个纯色/半透明底），不会连带糊到 OverlayContentHost
                     里装载的弹窗文字/控件——跟 MainWindow.ApplyCustomBackgroundFrost 里
                     "背景图层单独模糊、文字/卡片层保持清晰"是同一个思路，只是背景层这里没有
                     图片，磨砂效果体现在半透明度叠加而不是纹理模糊。也不需要改任何一个具体
                     弹窗 UserControl 内部已经写好的 XAML（见 ThemeService.ApplyPopupAppearance）。 -->
                <Grid ClipToBounds="True">
                    <Border x:Name="OverlayCardBackgroundLayer" CornerRadius="7"
                            Background="{DynamicResource PopupPanelBrush}" Effect="{DynamicResource PopupBlurEffect}"/>
                    <ContentControl x:Name="OverlayContentHost" Focusable="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 拖拽提示层 =====
             层次说明（Grid 里后声明的在上层，等价于更大的 z-index）：
                 内容区 / 侧边栏  →  OverlayRoot（弹窗+遮罩）  →  拖拽提示  →  Toast
             拖拽提示要压在弹窗之上：用户在开着弹窗的时候拖文件进来，也应该看到提示，
             否则会以为拖拽没被接住。IsHitTestVisible=False 让它只是"贴一层视觉"，
             不拦截鼠标事件，拖放本身仍由 Window 级的 Drop 事件处理。 -->
        <Border x:Name="DragHintLayer" Grid.Column="0" Grid.ColumnSpan="2"
                Visibility="Collapsed" IsHitTestVisible="False"
                Background="#CC0B1220">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="40,32"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center">
                    <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconDownload}"
                          Width="44" Height="44" StrokeThickness="1.2"
                          Stroke="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="DragHintTitle" Text="{DynamicResource Str_Drop_Title}" FontSize="20" FontWeight="Bold"
                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DragHintDetail" FontSize="13" Margin="0,8,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Str_Drop_Hint}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== Toast 通知层（最顶层）=====
             "游戏启动成功"这类纯告知性提示不该做成需要点确定的模态框——那会把人锁住。
             改成右下角浮出、几秒后自动消失的 Toast。必须压在弹窗之上，
             否则弹窗打开时的操作反馈会被遮住看不见。
             同样 IsHitTestVisible=False（Toast 自己不需要交互），不影响下层点击。 -->
        <ItemsControl x:Name="ToastHost" Grid.Column="0" Grid.ColumnSpan="2"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,20,20" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- ===== 左下角"操作类"通知层 =====
             跟右下角纯告知性 Toast 不同，这里放的是"需要用户点一下按钮做选择、但又不想用
             模态弹窗打断"的提示——典型场景：加载器版本转换成功后，问用户"要不要删掉这次
             操作前的自动备份"。这类提示不会自动消失（要等用户点按钮），且必须能点击，
             所以单独开一层、不能沿用 IsHitTestVisible=False 的 ToastHost（WPF 里祖先元素
             IsHitTestVisible=False 会导致子元素即使自己设 True 也收不到鼠标事件）。
             放左下角是刻意跟右下角的普通 Toast 错开，避免两类提示同时出现时互相遮挡/混淆。 -->
        <ItemsControl x:Name="ActionToastHost" Grid.Column="0" Grid.ColumnSpan="2"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Margin="20,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- ===== 全局亮度遮罩层 =====
             需求：设置页加一个 0~200 的"亮度"设置。WPF/桌面窗口没有真正的显示器亮度接口，
             这里用最朴素也最不容易出兼容问题的办法模拟：盖一层跟窗口内容区等大的纯色遮罩，
             IsHitTestVisible=False 不拦截任何鼠标/触摸操作。放在悬浮球之前声明（悬浮球在它
             上面）：亮度遮罩只影响主界面内容，不刻意压暗/压亮悬浮球和之后可能出现的顶层
             提示，视觉上更接近"调整界面内容亮度"而不是"给整个窗口盖一层滤镜"。
                 100（默认）：Opacity=0，完全不遮，跟没有这个功能之前的观感一模一样；
                 <100：黑色遮罩，数值越低 Opacity 越高 → 整体变暗；
                 >100：白色遮罩，数值越高 Opacity 越高 → 整体变亮（发白，不是真的提升亮度，
                       是"变亮"这个视觉印象的近似模拟，见 ThemeService.ApplyBrightness 注释）。
             颜色（黑/白）和 Opacity 都由 ThemeService.ApplyBrightness 在设置页保存/启动时
             一次性算好赋值，这里 XAML 只声明容器，不写死任何具体数值。 -->
        <Border x:Name="BrightnessOverlay" Grid.Column="0" Grid.ColumnSpan="2"
                Background="Black" Opacity="0" IsHitTestVisible="False"/>

        <!-- ===== AI 助手右下角悬浮球 =====
             常驻在窗口右下角，点击打开 AI 助手面板。受设置页 "显示右下角常驻悬浮球入口" 控制。
             放在最上层 (Grid.ColumnSpan="2" 且声明在最后)，确保始终浮在内容区、侧边栏、弹窗之上。 -->
        <!-- ===== 愚人节小白旗 =====
             只有 4 月 1 日抽中过彩蛋、且今天还没点过这面旗时才会显示（AprilFoolsUi.Attach
             在代码里控制 Visibility，其余 364 天恒为 Collapsed）。放在最右下角、AI 悬浮球
             左边一点，不遮挡悬浮球。ToolTip 按需求写死这句话，不解释这面旗具体对应哪个彩蛋
             （彩蛋本身就是"惊喜"，点之前不用剧透）。 -->
        <Button x:Name="AprilFoolsFlagButton" Grid.Column="0" Grid.ColumnSpan="2"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="36" Height="36" Margin="0,0,66,22"
                Background="Transparent" BorderThickness="0" Cursor="Hand"
                Click="AprilFoolsFlagButton_Click"
                ToolTip="点击小白旗就不会受到折磨了"
                Visibility="Collapsed" Panel.ZIndex="999">
            <TextBlock Text="🏳" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <Button x:Name="AiFloatingButton" Grid.Column="0" Grid.ColumnSpan="2"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="40" Height="40" Margin="0,0,20,20"
