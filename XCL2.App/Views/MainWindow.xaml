<Window x:Class="XCL2.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XCL2 - xztx127-craft-launcher 2" Height="640" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/app.ico"
        Background="{StaticResource SideBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{StaticResource SideBrush}" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="XCL2" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="6,10,0,20"/>
                    <Button Content="🏠 主页" Style="{StaticResource SideNavButton}" Click="NavHome_Click"/>
                    <Button Content="📁 版本选择" Style="{StaticResource SideNavButton}" Click="NavVersions_Click" Margin="0,4,0,0"/>
                    <Button Content="⬇ 下载" Style="{StaticResource SideNavButton}" Click="NavDownload_Click" Margin="0,4,0,0"/>
                    <Button Content="🧩 Mod 管理" Style="{StaticResource SideNavButton}" Click="NavModManager_Click" Margin="0,4,0,0"/>
                    <Button Content="🖥 服务端管理" Style="{StaticResource SideNavButton}" Click="NavServerManager_Click" Margin="0,4,0,0"/>
                    <Button Content="👤 账户管理" Style="{StaticResource SideNavButton}" Click="NavAccounts_Click" Margin="0,4,0,0"/>
                    <Button Content="⚙ 设置" Style="{StaticResource SideNavButton}" Click="NavSettings_Click" Margin="0,4,0,0"/>
                    <Button Content="📜 日志" Style="{StaticResource SideNavButton}" Click="NavLogs_Click" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="CurrentAccountText" Text="未选择账户" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CurrentVersionText" Text="未选择版本" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,10" TextWrapping="Wrap"/>

                    <!-- 游戏进程控制按钮组：一键关闭 / 关闭所选 / 关闭未响应 -->
                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <Button Content="一键关闭" FontSize="10" Padding="2,6" Margin="0,0,2,0"
                                Style="{StaticResource SideNavButton}" Click="CloseAllGames_Click"
                                ToolTip="一键关闭游戏：结束所有正在运行的游戏进程"/>
                        <Button Content="关闭所选" FontSize="10" Padding="2,6" Margin="2,0,2,0"
                                Style="{StaticResource SideNavButton}" Click="CloseSelectedGame_Click"
                                ToolTip="关闭所选的游戏：从列表中选择一个正在运行的游戏并关闭"/>
                        <Button Content="关闭未响应" FontSize="10" Padding="2,6" Margin="2,0,0,0"
                                Style="{StaticResource SideNavButton}" Click="CloseUnresponsiveGame_Click"
                                ToolTip="关闭未响应的游戏：需要先手动勾选确认无响应，再强制结束，避免误杀"/>
                    </UniformGrid>

                    <Button x:Name="LaunchGameBtn" Content="启动游戏" Style="{StaticResource PrimaryButton}" FontSize="16" Padding="0,12"
                            Click="Launch_Click"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Column="1" Margin="16">
            <ContentControl x:Name="MainContent" RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="MainContentTransform" Y="0"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Border>
    </Grid>
</Window>
