<local:OverlayDialogControl x:Class="XCL2.App.Views.DeviceCodeWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            MinWidth="520"
                            MaxWidth="520">
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <!-- 修复"深色主题下标题/提示文字显示不全"：原来 Width 固定 460，标题在部分系统字体/
         DPI 缩放下实际渲染宽度会超出可用内容区，看起来像文字被裁切。这里加宽窗口并让标题
         也支持自动换行，从根本上避免裁切。 -->
    <StackPanel Margin="28" VerticalAlignment="Top">
        <TextBlock Text="{DynamicResource Str_Ui_Complete_The_Sign_In_In_Your_Browser}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6"/>
        <TextBlock Text="{DynamicResource Str_Ui_The_Sign_In_Page_Has_Been_Opened_And_The}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

        <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="CodeText" Text="XXXX-XXXX" FontSize="32" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                           FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource Str_Ui_Copy_Code}" Style="{StaticResource PrimaryButton}" Click="CopyCode_Click" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Reopen_Browser}" Click="ReopenBrowser_Click" Padding="12,8"/>
        </Grid>

        <TextBlock x:Name="StatusText" Text="{DynamicResource Str_Ui_Waiting_For_Sign_In}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,4,0,10"/>

        <Button Content="{DynamicResource Str_Ui_Cancel_Sign_In}" HorizontalAlignment="Center" Click="Cancel_Click" Padding="10,4"
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
</local:OverlayDialogControl>
