<Window x:Class="XCL2.App.Views.DeviceCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微软账户登录" Height="320" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PanelBrush}">
    <StackPanel Margin="28" VerticalAlignment="Center">
        <TextBlock Text="请在浏览器中完成登录" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
        <TextBlock Text="已自动打开登录页面，并将下方代码复制到剪贴板，直接粘贴即可" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

        <Border Background="{StaticResource SideBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="CodeText" Text="XXXX-XXXX" FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                           FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="📋 复制代码" Style="{StaticResource PrimaryButton}" Click="CopyCode_Click" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="重新打开浏览器" Click="ReopenBrowser_Click" Padding="12,8"/>
        </Grid>

        <TextBlock x:Name="StatusText" Text="等待登录完成..." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,4,0,10"/>

        <Button Content="取消登录" HorizontalAlignment="Center" Click="Cancel_Click"
                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"/>
    </StackPanel>
</Window>
