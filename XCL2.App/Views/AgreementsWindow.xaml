<local:OverlayDialogControl x:Class="XCL2.App.Views.AgreementsWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="780"
                            MaxWidth="780"
                            MinHeight="640"
                            MaxHeight="640">
    <!-- 首次启动协议页：三页依次展示《用户协议》《隐私协议》《开源协议》。
         第 1、2 页是法律性文本：「同意并继续」按钮需要同时满足"已经阅读 5 秒"和
         "已滚动到页面最底部"两个条件才可点击；第 3 页（开源协议）不强制，
         但如果停留不足 3 秒就点同意，页面底部会出现"用人话说"的备注（善意使用 vs
         过度使用）。每页底部都有一段"用人话说"的通俗说明。
         按 Esc 不可关闭（调用方以 OverlayDialogService.ShowModal 的 dismissOnEsc:false
         锁死），只能点「同意并继续」或「不同意」表态——防止法律流程被按键跳过。
         布局、配色、Overlay 约定照抄 FirstRunWizardWindow（见其 XAML 顶部注释）。 -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock x:Name="HeaderTitle" Text="欢迎使用 XCL2" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="HeaderSubtitle" Text="首次使用前，请逐一阅读并同意以下四步：用户协议 → 隐私协议 → 开源协议 → 基本模式（如适用）。前两份需要拖到页面最底部并完整阅读 5 秒后即可继续；第三份（开源协议）不强制。"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- 人话版开关：全局生效于当前显示的这一页，切到"总结全章正常条款"的通俗版本；
                 只读模式（设置里"阅读协议"）与基本模式协议页也共用同一个开关。样式复用
                 App.xaml 里全局的 GuestModeToggleStyle 胶囊按钮（跟首页"自动循环"等开关
                 视觉统一），不用默认 ToggleButton 那种方框勾选框外观。
                 修复：原来这个按钮紧贴标题区文字右边缘，标题副标题较长时两者会挤在一起、
                 看起来像叠在一行文字上。给左侧标题 StackPanel 加 16px 右 Margin 空出间距，
                 这里再顶着列右边缘对齐，两者之间始终留有固定间隙，不随文字长度变化。 -->
            <ToggleButton Grid.Column="1" x:Name="PlainLanguageToggle" VerticalAlignment="Top" HorizontalAlignment="Right"
                          Style="{StaticResource GuestModeToggleStyle}" Click="PlainLanguageToggle_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#128172;" FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock Text="人话版" FontSize="13"/>
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- 步骤指示条：只读模式/基本模式单页流程下隐藏，不需要"第几步"的概念 -->
        <UniformGrid x:Name="StepDots" Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border x:Name="StepDot1" CornerRadius="6" Height="6" Margin="0,0,4,0" Background="{DynamicResource AccentBrush}"/>
            <Border x:Name="StepDot2" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="{DynamicResource DividerBrush}"/>
            <Border x:Name="StepDot3" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="{DynamicResource DividerBrush}"/>
            <Border x:Name="StepDot4" CornerRadius="6" Height="6" Margin="4,0,0,0" Background="{DynamicResource DividerBrush}" Visibility="Collapsed"/>
        </UniformGrid>

        <!-- 协议内容区 -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="24">
            <ScrollViewer x:Name="DocScroll" VerticalScrollBarVisibility="Auto"
                          services:ScrollWheelBehavior.EnableFastWheel="True" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- 第 1 页：用户协议（需拖到底部 + 满 5 秒） -->
                    <StackPanel x:Name="Page1Panel" Visibility="Visible">
                        <TextBlock Text="《用户协议》" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="Page1Text" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" LineHeight="22"/>
                        <!-- 人话版：开关打开时替代上面的正式条文全文显示，总结每章的正常条款 -->
                        <TextBlock x:Name="Page1PlainText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" LineHeight="22" Visibility="Collapsed"/>
                        <!-- 说人话的备注：放在本页滚动内容的最底部 -->
                        <Border Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,4">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="21">
                                <Run FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="用人话说："/><LineBreak/>
                                这份《用户协议》主要是一份"使用守则"：XCL2 是免费开源的第三方启动器，不是
                                Mojang/微软的官方软件；请别用它作弊、外挂、攻击服务器，也别拿它干违法的事；
                                你自己下载安装的模组、整合包内容，风险自担。其余条款就是把这几句话展开成法律语言。
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- 第 2 页：隐私协议（需拖到底部 + 满 5 秒） -->
                    <StackPanel x:Name="Page2Panel" Visibility="Collapsed">
                        <TextBlock Text="《隐私协议》" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="Page2Text" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" LineHeight="22"/>
                        <TextBlock x:Name="Page2PlainText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" LineHeight="22" Visibility="Collapsed"/>
                        <!-- 说人话的备注：放在本页滚动内容的最底部 -->
                        <Border Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,4">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="21">
                                <Run FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="用人话说："/><LineBreak/>
                                XCL2 以 AGPL-3.0 协议开源，源代码公开可查；本软件不收集任何个人信息——
                                配置、日志、账户标识都只保存在你自己的电脑上。只有在你主动使用
                                「下载游戏 / 微软登录 / 模组查询」等功能时，才会访问对应的下载源、
                                微软官方或模组平台，且不会在后台偷偷上传任何东西。
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- 第 3 页：开源协议（不强制阅读；停留不足 3 秒点同意会揭示底部备注） -->
                    <StackPanel x:Name="Page3Panel" Visibility="Collapsed">
                        <TextBlock Text="《开源协议》" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="Page3Text" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" LineHeight="22"/>
                        <TextBlock x:Name="Page3PlainText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" LineHeight="22" Visibility="Collapsed"/>
                        <!-- 说人话的备注（善意使用 vs 过度使用）：默认折叠，停留不足 3 秒就点
                             「同意并继续」时自动展开并滚动到这里，要求用户再确认一次。 -->
                        <Border x:Name="OpenSourceNote" Background="{DynamicResource SideBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="14" Margin="0,20,0,4" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,0,6">
                                    <Run Text="用人话说——什么算善意使用，什么算过度使用："/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="21">
                                    <Run FontWeight="Bold" Text="善意使用（没问题）："/>学习、研究、自用；在自己的项目里
                                    参考/改编"部分代码"并标注出处；非商业用途，遵守 AGPL-3.0 许可证。<LineBreak/>
                                    <Run FontWeight="Bold" Text="过度使用（不行）："/><LineBreak/>
                                    ① 直接大段抄袭却不标注原作者；<LineBreak/>
                                    ② 抄袭过多代码，把整个项目"换皮"成自己的；<LineBreak/>
                                    ③ 盗版：未经许可搬运、破解、使用非授权内容；<LineBreak/>
                                    ④ 收费分发：把免费的源码成果打包转卖牟利。<LineBreak/>
                                    拿不准的时候，多写一行"部分代码参考/改编自 XCL2 启动器"，并遵守 AGPL-3.0，
                                    就不会越界。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 第 4 步：《基本模式协议》。仅在两种情况下显示：① 用户在任意一页点「不同意」
                         并在三选一里选择「使用基本模式」时，流程跳转到这一步；② 单独以
                         "仅基本模式协议"模式打开本窗口（每次以基本模式启动、尚未同意过基本模式
                         协议时，由 MainWindow 弹出）。这一页不强制阅读（协议正文本身只有约
                         1000 字，见 AgreementsText.BasicModeAgreementText 的设计说明），
                         进入即可点击「同意」；点「不同意」也不会卡住——继续以基本模式使用。 -->
                    <StackPanel x:Name="Page4Panel" Visibility="Collapsed">
                        <TextBlock Text="《基本模式协议》" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="Page4Text" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" LineHeight="22"/>
                        <TextBlock x:Name="Page4PlainText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" LineHeight="22" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BackBtn" Content="返回" Padding="16,8" Click="Back_Click" IsEnabled="False"/>
            <Button Grid.Column="1" x:Name="DisagreeBtn" Content="不同意" Padding="16,8" Margin="8,0,0,0" Click="Disagree_Click"/>
            <!-- 「去基本模式」：不想看完整协议时的快捷入口，效果等价于在「不同意」的三选一里
                 选择「使用基本模式」，只是省得用户先点不同意再选。第 1~3 页（完整协议流程）
                 才显示；只读模式与基本模式协议页本身都不需要它。 -->
            <Button Grid.Column="2" x:Name="GoBasicModeBtn" Content="去基本模式" Padding="16,8" Margin="8,0,0,0" Click="GoBasicMode_Click"/>
            <!-- 「去完整模式」：跟「去基本模式」互斥显示——只在当前正展示《基本模式协议》
                 （WindowMode.BasicModeOnly，即"以基本模式启动、需要确认这份专属协议"的场景）
                 时出现在协议旁边，让用户不必先关掉这个弹窗、再去主界面点「重新阅读协议并同意」，
                 一步直接切回完整四步协议流程。跟 GoBasicModeBtn 共用同一个 Grid.Column，
                 两者可见性互斥，不会叠在一起占地方。 -->
            <Button Grid.Column="2" x:Name="GoFullModeBtn" Content="去完整模式" Padding="16,8" Margin="8,0,0,0"
                    Click="GoFullMode_Click" Visibility="Collapsed" IsEnabled="False"/>

            <!-- 前两页由代码在"已拖到底部 + 满 5 秒"后启用；第三页进入即为可用 -->
            <Button Grid.Column="4" x:Name="AgreeBtn" Content="同意并继续" Style="{StaticResource PrimaryButton}"
                    Padding="20,8" Click="Agree_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</local:OverlayDialogControl>