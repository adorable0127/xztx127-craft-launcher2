<UserControl x:Class="XCL2.App.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:XCL2.App.Services"
             xmlns:models="clr-namespace:XCL2.App.Models">
    <UserControl.Resources>
        <!-- 只有离线账户(Type=Offline)才需要显示"皮肤"按钮；微软账户的皮肤由 Mojang 托管。 -->
        <models:AccountTypeToOfflineVisibilityConverter x:Key="AccountTypeToOfflineVisibilityConverter"/>
        <!-- "账户页面"按钮只对微软/皮肤站账户显示：离线账户点了没有任何反应（见转换器注释）。 -->
        <models:AccountTypeToNonOfflineVisibilityConverter x:Key="AccountTypeToNonOfflineVisibilityConverter"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_Nav_Accounts}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox x:Name="OfflineNameBox" Width="200" Padding="8" VerticalContentAlignment="Center" Text="Player"/>
                <Button Content="{DynamicResource Str_Ui_Add_Offline_Account}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddOffline_Click"/>
                <Button Content="{DynamicResource Str_Ui_Add_Microsoft_Account_Browser_Sign_In_2}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddMicrosoft_Click"/>
                <Button Content="{DynamicResource Str_Ui_Add_Microsoft_Account_Embedded_Sign_In_N}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddMicrosoftEmbedded_Click"/>
            </StackPanel>

            <!-- 认证服务器（皮肤站）登录：跟上面离线/微软账户完全独立的一套输入框，
                 不影响上面两种账户类型任何已有的按钮/事件。 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Authlib_Skin_Server_Sign_In}" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Str_Ui_Sign_In_With_A_Third_Party_Auth_Server_A}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AuthServerRootBox" Padding="8" VerticalContentAlignment="Center"
                                 ToolTip="{DynamicResource Str_Ui_Auth_Server_Api_Root_E_G_Https_Example_C}"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Str_Ui_Auth_Server_Address_Api_Root}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="AuthServerUsernameBox" Width="200" Padding="8" VerticalContentAlignment="Center"
                                 ToolTip="{DynamicResource Str_Ui_Skin_Server_Email_Or_Username}"/>
                        <PasswordBox x:Name="AuthServerPasswordBox" Width="200" Padding="8" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                        <Button Content="{DynamicResource Str_Ui_Sign_In}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddAuthServer_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" x:Name="StatusText" Foreground="{DynamicResource AccentBrush}"
                       Margin="0,0,0,10" TextWrapping="Wrap"/>

            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_Ui_Saved_Accounts_Offline_And_Microsoft_Acc}" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox x:Name="AccountListBox" BorderThickness="0">
                <ListBox.Resources><services:AccountAvatarConverter x:Key="AccountAvatarConverter"/></ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="32" Height="32" Margin="0,0,10,0" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Source="{Binding Converter={StaticResource AccountAvatarConverter}}"/>
                                <StackPanel><TextBlock Text="{Binding DisplayLabel}" FontSize="15"/>
                                <TextBlock Text="{Binding Uuid}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- 皮肤按钮只对离线账户显示：微软账户的皮肤由 Mojang 托管，启动器不应该干预。 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                                <Button Content="3D 纸娃娃" Tag="{Binding}" Click="SkinModel_Click" Margin="0,0,6,0"
                                        ToolTip="查看皮肤三维模型、动态姿态，拖拽旋转视角"/>
                                <Button Content="{DynamicResource Str_Ui_Skin}" Tag="{Binding}" Click="Skin_Click"
                                        Visibility="{Binding Type, Converter={StaticResource AccountTypeToOfflineVisibilityConverter}}"/>
                            </StackPanel>
                            <!-- 头像照片：跟上面的"皮肤"完全独立——皮肤是游戏里显示的角色外观，
                                 这里导入的是任意一张图片（自拍/头像图都行），只用来替换列表最左边
                                 这一小张头像，不影响游戏内实际显示的皮肤。任何账户类型都能设置。 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                                <Button Content="导入头像照片" Tag="{Binding}" Click="ImportAvatarPhoto_Click" Margin="0,0,6,0"
                                        ToolTip="选一张任意图片（自拍/头像图都行）作为这个账户在列表里显示的头像，跟游戏内皮肤无关。"/>
                                <Button Content="清除头像照片" Tag="{Binding}" Click="ClearAvatarPhoto_Click"
                                        ToolTip="清除已导入的头像照片，改回按皮肤/史蒂夫默认头像显示。"/>
                            </StackPanel>
                             <Button Grid.Column="3" Content="{DynamicResource Str_Ui_Use}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                     Tag="{Binding}" Click="SelectAccount_Click"/>
                              <Button Grid.Column="4" Content="复制 UUID" Margin="0,0,8,0" Tag="{Binding}" Click="CopyUuid_Click"/>
                              <Button Grid.Column="5" Content="账户页面" Margin="0,0,8,0" Tag="{Binding}" Click="OpenAccountPortal_Click"
                                      Visibility="{Binding Type, Converter={StaticResource AccountTypeToNonOfflineVisibilityConverter}}"/>
                              <Button Grid.Column="6" Content="{DynamicResource Str_Common_Delete}" Tag="{Binding}" Click="RemoveAccount_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
