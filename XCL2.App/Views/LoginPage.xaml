<UserControl x:Class="XCL2.App.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:XCL2.App.Models">
    <UserControl.Resources>
        <!-- 只有离线账户(Type=Offline)才需要显示"皮肤"按钮；微软账户的皮肤由 Mojang 托管。 -->
        <models:AccountTypeToOfflineVisibilityConverter x:Key="AccountTypeToOfflineVisibilityConverter"/>
    </UserControl.Resources>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="账户管理" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox x:Name="OfflineNameBox" Width="200" Padding="8" VerticalContentAlignment="Center" Text="Player"/>
                <Button Content="添加离线账户" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddOffline_Click"/>
                <Button Content="添加微软账户 (浏览器登录)" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddMicrosoft_Click"/>
                <Button Content="添加微软账户 (内嵌登录，免复制验证码)" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddMicrosoftEmbedded_Click"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" x:Name="StatusText" Foreground="{StaticResource AccentBrush}"
                       Margin="0,0,0,10" TextWrapping="Wrap"/>

            <TextBlock DockPanel.Dock="Top" Text="已保存的账户（离线与微软账户可共存，随时切换）" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox x:Name="AccountListBox" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayLabel}" FontSize="15"/>
                                <TextBlock Text="{Binding Uuid}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <!-- 皮肤按钮只对离线账户显示：微软账户的皮肤由 Mojang 托管，启动器不应该干预。 -->
                            <Button Grid.Column="1" Content="皮肤" Tag="{Binding}" Click="Skin_Click"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding Type, Converter={StaticResource AccountTypeToOfflineVisibilityConverter}}"/>
                            <Button Grid.Column="2" Content="选用" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Tag="{Binding}" Click="SelectAccount_Click"/>
                            <Button Grid.Column="3" Content="删除" Tag="{Binding}" Click="RemoveAccount_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
