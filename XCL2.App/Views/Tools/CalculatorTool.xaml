<UserControl x:Class="XCL2.App.Views.Tools.CalculatorTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" Loaded="CalculatorTool_Loaded" PreviewKeyDown="CalculatorTool_PreviewKeyDown">
    <StackPanel MaxWidth="360" HorizontalAlignment="Left">
        <!-- 显示区：上一行是表达式/历史，下一行是当前输入或结果 -->
        <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" MinHeight="86">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock x:Name="ExprText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Right" TextWrapping="NoWrap" Height="18"/>
                <TextBox x:Name="DisplayBox" Text="0" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontSize="26" FontWeight="SemiBold" TextAlignment="Right"
                         Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="Transparent"
                         PreviewMouseDown="DisplayBox_PreviewMouseDown"/>
            </StackPanel>
        </Border>

        <UniformGrid Rows="5" Columns="4" Margin="0,10,0,0">
            <Button Content="C" Tag="C" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="⌫" Tag="Back" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="%" Tag="%" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="÷" Tag="÷" FontSize="18" Padding="0,12" Margin="0,0,0,6" Click="CalcKey_Click"/>

            <Button Content="7" Tag="7" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="8" Tag="8" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="9" Tag="9" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="×" Tag="×" FontSize="18" Padding="0,12" Margin="0,0,0,6" Click="CalcKey_Click"/>

            <Button Content="4" Tag="4" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="5" Tag="5" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="6" Tag="6" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="−" Tag="−" FontSize="18" Padding="0,12" Margin="0,0,0,6" Click="CalcKey_Click"/>

            <Button Content="1" Tag="1" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="2" Tag="2" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="3" Tag="3" FontSize="16" Padding="0,12" Margin="0,0,6,6" Click="CalcKey_Click"/>
            <Button Content="+" Tag="+" FontSize="18" Padding="0,12" Margin="0,0,0,6" Click="CalcKey_Click"/>

            <Button Content="±" Tag="±" FontSize="16" Padding="0,12" Margin="0,0,6,0" Click="CalcKey_Click"/>
            <Button Content="0" Tag="0" FontSize="16" Padding="0,12" Margin="0,0,6,0" Click="CalcKey_Click"/>
            <Button Content="." Tag="." FontSize="18" Padding="0,12" Margin="0,0,6,0" Click="CalcKey_Click"/>
            <Button Content="=" Tag="=" FontSize="18" Padding="0,12" Margin="0,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="CalcKey_Click"/>
        </UniformGrid>

        <TextBlock x:Name="CalcStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="2,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>