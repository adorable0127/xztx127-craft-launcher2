<UserControl x:Class="XCL2.App.Views.Tools.Web2BrowserTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="Web2BrowserTool_Unloaded">
    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
        <Border Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Web2" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="使用内嵌浏览器 (WebView2) 打开指定网址，也可以选择用系统默认浏览器打开。"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="网址" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="UrlBox" Padding="8,6" Margin="0,0,0,10"
                         Text="https://xztx127.dpdns.org/xztx127gjx"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenEmbeddedButton" Content="在启动器内打开" Style="{StaticResource PrimaryButton}"
                            Padding="14,7" Margin="0,0,10,0" Click="OpenEmbeddedButton_Click"/>
                    <Button x:Name="OpenExternalButton" Content="在浏览器中打开" Padding="14,7" Click="OpenExternalButton_Click"/>
                </StackPanel>

                <TextBlock x:Name="Web2StatusText" FontSize="11" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border x:Name="BrowserCard" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="6" Visibility="Collapsed">
            <Grid x:Name="BrowserHost" MinHeight="560"/>
        </Border>
    </StackPanel>
</UserControl>
