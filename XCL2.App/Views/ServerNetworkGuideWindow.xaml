<Window x:Class="XCL2.App.Views.ServerNetworkGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="如何让好友从外网连进你的服务器"
        Width="640" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="服务器已启动，让好友从外网连进来" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="服务器现在只能在你自己的局域网内访问。想让不在同一个 WiFi/网络下的好友也能连进来，需要做下面几步之一。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="方法一：内网穿透（最简单，适合临时和好友一起玩）" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8">
                            <Run Text="内网穿透工具会在公网上给你分配一个临时地址，帮你把公网流量转发到你电脑上正在运行的服务器端口，不需要登录路由器、不需要公网 IP，几分钟就能配置好，适合偶尔和朋友联机。缺点是免费额度通常有带宽/连接数限制，长期稳定运营不如下面的路由器方案。"/>
                        </TextBlock>
                        <TextBlock Text="常见步骤：" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Text="1. 注册一个内网穿透服务账号，下载对应客户端安装到这台跑服务器的电脑上。"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Text="2. 新建一条 TCP 隧道，本地端口填服务器的端口（默认 25565，具体以「服务器列表」卡片上显示的连接地址为准）。"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Text="3. 穿透工具会给你一个类似 xxx.xxx.com:12345 的公网地址，把这个地址发给好友，让TA在 Minecraft 的“多人游戏-添加服务器”里填这个地址即可。"/>
                        <TextBlock Text="常见的内网穿透服务（任选一个即可，不分先后）：" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap">
                            <Run Text="• "/>
                            <Hyperlink NavigateUri="https://www.natfrp.com/" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="NatFrp（开源 frp 面板，国内 Minecraft 圈常用）"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap">
                            <Run Text="• "/>
                            <Hyperlink NavigateUri="https://www.oray.com/" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="花生壳（向日葵同厂商，图形化界面，新手友好）"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="12" TextWrapping="Wrap">
                            <Run Text="• "/>
                            <Hyperlink NavigateUri="https://ngrok.com/" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="ngrok（国际通用，海外好友联机可选）"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="方法二：路由器端口映射（适合长期开服，需要公网 IP）" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Text="如果你的宽带有公网 IPv4/IPv6 地址（可以问运营商，或者在路由器管理页的“WAN 状态”里查看是不是内网地址如 100.x/10.x/192.168.x 开头，如果是就属于运营商 NAT，需要先联系运营商申请公网 IP 或改用方法一/三），可以在路由器上做端口映射，把公网端口转发到这台电脑的服务器端口，不依赖第三方服务、没有带宽限制，但配置门槛比内网穿透稍高。"/>
                        <TextBlock Text="常见步骤：" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Text="1. 登录路由器管理后台（通常是浏览器打开 192.168.1.1 或 192.168.0.1，具体看路由器背面标签）。"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Text="2. 找到“端口映射/端口转发/虚拟服务器”（不同品牌叫法不同），新增一条规则：外部端口和内部端口都填服务器端口（默认 25565），内部 IP 填这台电脑在局域网里的 IP（可以在系统设置或者路由器的“已连接设备”列表里看到）。"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Text="3. 好友用你的公网 IP + 端口连接即可；如果公网 IP 会变化（大多数家庭宽带是动态 IP），建议再配合一个动态域名解析(DDNS)服务，把域名和你会变化的 IP 自动绑在一起，不用每次变了都重新告诉好友。"/>
                        <TextBlock FontSize="12" TextWrapping="Wrap">
                            <Run Text="• "/>
                            <Hyperlink NavigateUri="https://www.dynv6.com/" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="dynv6（免费 DDNS，适合动态公网 IP）"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="方法三：云服务器中转（最稳定，但需要额外花钱租云服务器）" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="买一台便宜的云服务器（阿里云/腾讯云/华为云等都有），本身自带公网 IP，用 frp 之类的工具把你本地服务器的流量通过云服务器中转出去，或者干脆把整个服务器核心搬到云服务器上运行。稳定性和速度通常好于免费内网穿透，缺点是需要付费，配置也相对复杂，适合长期稳定运营、追求低延迟的场景。"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="安全提醒：不管用哪种方法把服务器暴露到公网，都建议在上面的「服务器设置」里打开“正版验证”，避免陌生人蹭进服务器；如果只是和熟悉的朋友玩，也可以配合“启用白名单”限制能加入的玩家。"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <CheckBox x:Name="DontShowAgainCheck" Content="以后启动服务器不再自动弹出此教程" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="CloseBtn" Content="我知道了" Width="100" Style="{DynamicResource PrimaryButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
