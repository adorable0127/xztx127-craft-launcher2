<local:OverlayDialogControl x:Class="XCL2.App.Views.ServerNetworkGuideWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="640"
                            MaxWidth="640"
                            MinHeight="600"
                            MaxHeight="600">
                            <!-- MinHeight 必须给：这个弹窗的布局里有 RowDefinition Height="*"。
                                 原来是 Window 且有固定 Height 时，"*"行能拿到剩余高度；
                                 改成挂在自适应 OverlayCard 里的 UserControl 之后，
                                 测量高度是无穷大，"*"行会塌陷成内容的期望高度——
                                 列表为空/WebView2 这种没有期望尺寸的控件会直接塌成 0，
                                 表现就是弹窗里一片空白。MinHeight 用回原来的设计高度即可。 -->
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Str_Ui_Server_Is_Up_Let_Friends_Connect_From_Ou}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Right_Now_Your_Server_Is_Only_Reachable_}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>

                <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Ui_Option_1_Tunnelling_Easiest_Good_For_Pla}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8">
                            <Run Text="{DynamicResource Str_Ui_A_Tunnelling_Tool_Gives_You_A_Temporary_}"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource Str_Ui_Common_Steps}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Text="{DynamicResource Str_Ui_1_Sign_Up_With_A_Tunnelling_Service_And_}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Text="{DynamicResource Str_Ui_2_Create_A_Tcp_Tunnel_And_Set_The_Local_}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Text="{DynamicResource Str_Ui_3_The_Tunnelling_Tool_Gives_You_A_Public}"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Common_Tunnelling_Services_Pick_Any_One_}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap">
                            <Run Text="• "/>
                            <Hyperlink NavigateUri="https://www.natfrp.com/" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{DynamicResource Str_Ui_Natfrp_Open_Source_Frp_Panel_Widely_Used}"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap">
                            <Run Text="• "/>
                            <Hyperlink NavigateUri="https://www.oray.com/" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{DynamicResource Str_Ui_Oray_Same_Vendor_As_Sunlogin_Graphical_U}"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="12" TextWrapping="Wrap">
                            <Run Text="• "/>
                            <Hyperlink NavigateUri="https://ngrok.com/" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{DynamicResource Str_Ui_Ngrok_Works_Worldwide_Good_For_Overseas_}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Ui_Option_2_Router_Port_Forwarding_Good_For}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Text="{DynamicResource Str_Ui_If_Your_Connection_Has_A_Public_Ipv4_Or_}"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Common_Steps}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Text="{DynamicResource Str_Ui_1_Sign_In_To_Your_Router_S_Admin_Page_Us}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Text="{DynamicResource Str_Ui_2_Find_Port_Forwarding_Port_Mapping_Or_V}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Text="{DynamicResource Str_Ui_3_Friends_Connect_Using_Your_Public_Ip_A}"/>
                        <TextBlock FontSize="12" TextWrapping="Wrap">
                            <Run Text="• "/>
                            <Hyperlink NavigateUri="https://www.dynv6.com/" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{DynamicResource Str_Ui_Dynv6_Free_Ddns_Good_For_A_Changing_Publ}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Ui_Option_3_Relay_Through_A_Cloud_Server_Mo}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="{DynamicResource Str_Ui_Rent_A_Cheap_Cloud_Server_It_Comes_With_}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Str_Ui_Security_Note_Whichever_Method_You_Use_T}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <CheckBox x:Name="DontShowAgainCheck" Content="{DynamicResource Str_Ui_Don_T_Show_This_Guide_Automatically_Agai}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="CloseBtn" Content="{DynamicResource Str_Ui_Got_It}" Width="100" Style="{DynamicResource PrimaryButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</local:OverlayDialogControl>
