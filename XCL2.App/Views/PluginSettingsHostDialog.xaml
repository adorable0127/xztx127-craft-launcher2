<local:OverlayDialogControl x:Class="XCL2.App.Views.PluginSettingsHostDialog"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            MinWidth="480" MaxWidth="560" MinHeight="200" MaxHeight="560">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <ContentControl x:Name="HostContent"/>
  </ScrollViewer>

  <!-- 修复"配置完插件没地方保存"：之前这里只有一个"关闭"按钮，配置面板里改完的东西
       要么全靠插件自己在每个控件的事件里手动调 ctx.Config.Set（改一个存一个），要么用户
       压根不知道改完要不要点关闭才算数、心里没底。现在统一加一个"保存"按钮：如果面板
       实现了 IPluginSettingsPanel，点保存时调用它的 Save() 做一次批量落盘，成功后用
       ToastService 给一个"已保存"的即时反馈且不关闭弹窗（方便继续改其它项）；没实现这个
       接口的面板（包括"改一个存一个"风格的，以及没有图形界面时展示的只读 JSON 预览）
       点保存也不会报错，只是单纯提示"已保存"——因为它们要么已经是实时落盘，要么本来就
       没有可保存的输入。 -->
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Save_Click"/>
   <Button Content="取消" Click="Close_Click"/>
  </StackPanel>
 </Grid>
</local:OverlayDialogControl>
