<local:OverlayDialogControl x:Class="XCL2.App.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="440">
    <!-- 迁移自原 ProgressWindow（独立 Window，非模态显示）。进度弹窗保持非模态语义：
         不阻塞调用方代码执行（下载/安装在后台 Task 里跑），只是把原来"顶层 Window
         悬浮在桌面上"变成"Overlay 卡片盖在启动器窗口上"，用户仍然只能看着进度条，
         不能操作被遮罩挡住的其它区域（这跟原来独立 Window 之上没有 Owner 交互限制
         其实是不同的——原版严格来说不阻塞对其它窗口的操作，但实际使用中下载进行时
         去操作别的页面容易引发状态混乱，所以这个"顺带模态化"的副作用是符合预期的
         改进，不是缺陷）。 -->
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
        <ProgressBar x:Name="Bar" Height="18" Minimum="0" Maximum="100" Value="0"/>
        <TextBlock x:Name="DetailText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</local:OverlayDialogControl>
