<local:OverlayDialogControl x:Class="XCL2.App.Views.CreateServerWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="520"
                            MaxWidth="520"
                            MinHeight="620"
                            MaxHeight="620">
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True" Padding="28,24">
        <StackPanel>
            <TextBlock x:Name="HeaderTitleText" Text="{DynamicResource Str_Ui_Create_Server_2}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Downloads_The_Server_Core_And_Creates_Th}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,18" TextWrapping="Wrap"/>

            <TextBlock Text="{DynamicResource Str_Ui_Server_Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

            <TextBlock Text="{DynamicResource Str_Ui_Loader}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <!-- 原来是横向 StackPanel，5 个按钮还不会溢出；现在加到 11 个必须换 WrapPanel，
                 让按钮在放不下时自动换到下一行，而不是被裁掉看不见。 -->
            <WrapPanel Margin="0,0,0,14">
                <RadioButton x:Name="CoreVanilla" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                             Content="Vanilla" Checked="CoreType_Checked" Tag="Vanilla" Margin="0,0,6,6"/>
                <RadioButton x:Name="CorePaper" Style="{StaticResource DownloadCategoryButton}"
                             Content="Paper" Checked="CoreType_Checked" Tag="Paper" Margin="0,0,6,6"/>
                <RadioButton x:Name="CoreFolia" Style="{StaticResource DownloadCategoryButton}"
                             Content="Folia" Checked="CoreType_Checked" Tag="Folia" Margin="0,0,6,6"/>
                <RadioButton x:Name="CorePurpur" Style="{StaticResource DownloadCategoryButton}"
                             Content="Purpur" Checked="CoreType_Checked" Tag="Purpur" Margin="0,0,6,6"/>
                <RadioButton x:Name="CoreSpigot" Style="{StaticResource DownloadCategoryButton}"
                             Content="Spigot" Checked="CoreType_Checked" Tag="Spigot" Margin="0,0,6,6"/>
                <RadioButton x:Name="CoreFabric" Style="{StaticResource DownloadCategoryButton}"
                             Content="Fabric" Checked="CoreType_Checked" Tag="Fabric" Margin="0,0,6,6"/>
                <RadioButton x:Name="CoreForge" Style="{StaticResource DownloadCategoryButton}"
                             Content="Forge" Checked="CoreType_Checked" Tag="Forge" Margin="0,0,6,6"/>
                <RadioButton x:Name="CoreNeoForge" Style="{StaticResource DownloadCategoryButton}"
                             Content="NeoForge" Checked="CoreType_Checked" Tag="NeoForge" Margin="0,0,6,6"/>
                <RadioButton x:Name="CoreVelocity" Style="{StaticResource DownloadCategoryButton}"
                             Content="Velocity" Checked="CoreType_Checked" Tag="Velocity" Margin="0,0,6,6"/>
                <RadioButton x:Name="CoreWaterfall" Style="{StaticResource DownloadCategoryButton}"
                             Content="Waterfall" Checked="CoreType_Checked" Tag="Waterfall" Margin="0,0,6,6"/>
            </WrapPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Str_Ui_Minecraft_Version}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="McVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"
                              SelectionChanged="McVersionCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" x:Name="BuildVersionPanel">
                    <TextBlock x:Name="BuildVersionLabel" Text="{DynamicResource Str_Ui_Build}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="BuildVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Str_Ui_Install_Location}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TargetDirBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,8,0"/>
                <Button x:Name="BrowseTargetDirBtn" Grid.Column="1" Content="{DynamicResource Str_Ui_Browse}" Style="{StaticResource PrimaryButton}" Click="BrowseTargetDir_Click"/>
            </Grid>

            <TextBlock Text="{DynamicResource Str_Ui_Java_Path}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="JavaListCombo" Margin="0,0,0,8" Padding="6" Height="34"
                      DisplayMemberPath="DisplayText" SelectionChanged="JavaListCombo_SelectionChanged"
                      ToolTip="{DynamicResource Str_Ui_Pick_A_Java_For_This_Server_From_The_Lis}"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="JavaPathBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Auto_Detect}" Style="{StaticResource PrimaryButton}" Click="AutoDetectJava_Click"/>
            </Grid>
            <TextBlock x:Name="JavaRequirementHintText" FontSize="12" Margin="0,-10,0,14" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>

            <TextBlock Text="{DynamicResource Str_Ui_Memory_Limit_Mb}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Str_Ui_Min_Xms}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBox x:Name="MinMemoryBox" Style="{StaticResource SearchTextBox}" Height="34" Text="1024"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Str_Ui_Max_Xmx}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBox x:Name="MaxMemoryBox" Style="{StaticResource SearchTextBox}" Height="34" Text="4096"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Str_Ui_Cpu_Limit_Blank_Unlimited}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBox x:Name="CpuLimitBox" Style="{StaticResource SearchTextBox}" Height="34"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Str_Ui_Disk_Limit_Mb_Blank_Unlimited}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBox x:Name="DiskLimitBox" Style="{StaticResource SearchTextBox}" Height="34"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource Str_Ui_About_The_Disk_Limit_Windows_Can_T_Enfor}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,18"/>

            <!-- 进度展示 -->
            <StackPanel x:Name="ProgressPanel" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="ProgressStageText" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="ProgressDetailText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <ProgressBar x:Name="ProgressBarCtl" Height="8" Minimum="0" Maximum="1"/>
            </StackPanel>

            <Button x:Name="CreateBtn" Content="{DynamicResource Str_Ui_Create_Server_2}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Padding="0,12" Click="Create_Click"/>
        </StackPanel>
    </ScrollViewer>
</local:OverlayDialogControl>
