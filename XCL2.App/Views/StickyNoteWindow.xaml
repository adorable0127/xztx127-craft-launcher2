<Window x:Class="XCL2.App.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面便签" Width="300" Height="320" MinWidth="200" MinHeight="160"
        WindowStyle="None" AllowsTransparency="False" Background="#FFF9C4"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Closing="StickyNoteWindow_Closing">
    <Window.Resources>
        <!-- 标题栏上的圆形小按钮（置顶/关闭）：去掉 WPF 默认 Button 的方形灰边框和难看的
             hover/pressed 灰底，换成跟随主题色、真正圆形的 hover 高亮，跟系统原生便签
             App（比如 Windows 的"便笺"）常见的圆角小按钮观感更接近。 -->
        <Style x:Key="NoteTitleBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 之前这里是 Grid Margin="10" + NoteCard 套 DropShadowEffect + Window
         AllowsTransparency="True"，靠"分层窗口+特效阴影"做出圆角悬浮卡片的视觉效果。
         修复"便签弹出后整块显示成纯灰色方块、看不到标题栏/文字/按钮"：这是
         AllowsTransparency 分层窗口在部分机器上（没有硬件加速合成、远程桌面、
         某些独显驱动）跟 Effect 一起用时的已知渲染失败模式——分层窗口合成失败后，
         WPF 只能画出窗口本身的不透明背景，所有指望"透过分层窗口透明合成"才能显示的
         子内容全部不可见，症状正是"一块纯色方框，边角是直角不是圆角，什么都看不见"。
         去掉 AllowsTransparency + Effect，改成普通的不透明窗口（Window.Background
         直接用便签底色，见 ApplyStyle 里新增的 this.Background 赋值），标题栏/正文
         就是普通控件正常绘制，不再依赖分层窗口合成这条容易在个别机器上失败的路径。
         代价是没有了投影和四角圆角（NoteCard 仍保留 CornerRadius，但窗口本身是直角，
         只是窗口背景色跟 NoteCard 背景色一致，四个角上几乎看不出差异）。 -->
    <Grid>
        <Border x:Name="NoteCard" CornerRadius="10" Background="#FFF9C4" ClipToBounds="True">
            <Border.BorderBrush>
                <SolidColorBrush Color="#00000000"/>
            </Border.BorderBrush>
            <!-- 右键菜单兜底："关闭便签"跟标题栏 ✕ 走同一个 CloseBtn_Click。
                 标题栏那个 ✕ 是自绘的小圆按钮，AllowsTransparency 窗口在个别机器/
                 截屏软件上偶尔会整体渲染异常（分层窗口显示成一块实色方块，看起来
                 像"标题栏和关闭按钮都不见了"）——这时候右键菜单是系统原生弹出的
                 独立窗口，不受同一个渲染问题影响，始终能关掉，不用非得点中那个
                 可能显示不出来的小按钮。 -->
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="切换便签样式" Click="StyleBtn_Click"/>
                    <MenuItem Header="切换是否置顶" Click="PinBtn_Click"/>
                    <Separator/>
                    <MenuItem Header="关闭便签" Click="CloseBtn_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏：按住拖动窗口；右侧样式/置顶/关闭按钮 -->
                <Border x:Name="TitleBar" Grid.Row="0" Background="#F7E28A"
                        MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                            <Button x:Name="StyleBtn" Content="🎨" Style="{StaticResource NoteTitleBtnStyle}"
                                    ToolTip="切换便签样式" Click="StyleBtn_Click"/>
                            <Button x:Name="PinBtn" Content="📌" Style="{StaticResource NoteTitleBtnStyle}"
                                    ToolTip="切换是否置顶" Click="PinBtn_Click"/>
                            <Button Content="✕" Style="{StaticResource NoteTitleBtnStyle}" FontSize="12"
                                    ToolTip="关闭（自动保存）" Click="CloseBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TitleText" Text="桌面便签" VerticalAlignment="Center" Margin="12,0,4,0"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#6B5B1E"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <!-- 内容编辑区：自动保存到便签文件 -->
                    <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Background="#FFFDF0" Foreground="#3D3D3D"
                             FontSize="14" Padding="12,10,20,18" CaretBrush="#3D3D3D" SelectionBrush="#F0DE84"
                             TextChanged="ContentBox_TextChanged" LostFocus="ContentBox_LostFocus"/>

                    <!-- 右下角缩放手柄作为叠层，不再挤占正文编辑区。 -->
                    <ResizeGrip x:Name="NoteResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                                Foreground="#B8A45A" Width="14" Height="14" Background="Transparent"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>