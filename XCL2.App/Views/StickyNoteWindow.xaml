<Window x:Class="XCL2.App.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面便签" Width="300" Height="320" MinWidth="200" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Closing="StickyNoteWindow_Closing">
    <Window.Resources>
        <!-- 标题栏上的圆形小按钮（置顶/关闭）：去掉 WPF 默认 Button 的方形灰边框和难看的
             hover/pressed 灰底，换成跟随主题色、真正圆形的 hover 高亮，跟系统原生便签
             App（比如 Windows 的"便笺"）常见的圆角小按钮观感更接近。 -->
        <Style x:Key="NoteTitleBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 最外层留一点透明边距专门给阴影用；AllowsTransparency + 阴影特效让便签看起来
         是"悬浮"在桌面上的一张卡片，而不是一块生硬的方框。 -->
    <Grid Margin="10">
        <Border CornerRadius="10" Background="#FFF9C4" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="18" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <Border.BorderBrush>
                <SolidColorBrush Color="#00000000"/>
            </Border.BorderBrush>
            <DockPanel>
                <!-- 标题栏：按住拖动窗口；右侧置顶/关闭按钮 -->
                <Border DockPanel.Dock="Top" Height="34" MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FDEDA0" Offset="0"/>
                            <GradientStop Color="#F7E28A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                            <Button x:Name="PinBtn" Content="📌" Style="{StaticResource NoteTitleBtnStyle}"
                                    ToolTip="切换是否置顶" Click="PinBtn_Click"/>
                            <Button Content="✕" Style="{StaticResource NoteTitleBtnStyle}" FontSize="12"
                                    ToolTip="关闭（自动保存）" Click="CloseBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TitleText" Text="桌面便签" VerticalAlignment="Center" Margin="12,0,4,0"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#6B5B1E"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </DockPanel>
                </Border>

                <!-- 内容编辑区：自动保存到便签文件 -->
                <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Background="#FFFDF0" Foreground="#3D3D3D"
                         FontSize="14" Padding="12,10" CaretBrush="#3D3D3D" SelectionBrush="#F0DE84"
                         TextChanged="ContentBox_TextChanged" LostFocus="ContentBox_LostFocus"/>

                <!-- 右下角缩放手柄 -->
                <ResizeGrip DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,0,4,4"
                            Foreground="#B8A45A" Width="14" Height="14" Background="Transparent"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>