<UserControl x:Class="XCL2.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:XCL2.App.Services">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
        <StackPanel x:Name="SettingsRootPanel">
            <TextBlock Text="{DynamicResource Str_Settings_Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- 设置搜索：设置页条目太多，靠肉眼从上滑到下找一个开关越来越费劲。这里只做
                 "在本页已有控件里查找文字并跳转/高亮"，不重新组织页面结构——每敲一个字符
                 防抖 300ms 后重新搜一次，命中就把第一个匹配项滚动到可视区域并临时高亮，
                 方便看清楚具体是哪一项。 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="SettingsSearchBox" Padding="8,6"
                             TextChanged="SettingsSearchBox_TextChanged"/>
                    <TextBlock x:Name="SettingsSearchPlaceholder" Text="在此搜索设置项"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.72"/>
                </Grid>
                <TextBlock x:Name="SettingsSearchResultText" Grid.Column="1" Margin="10,0,0,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>


            <!-- 普通/高手模式：这是全局唯一的模式设置入口。勾选后当前设置页会立即切换
                 Java 高级选项的显隐作为预览，但配置仍遵循本页统一保存策略：自动保存关闭时
                 需要点击底部“保存设置”，开启自动保存时由统一防抖逻辑保存。 -->
            <CheckBox x:Name="AdvancedModeCheck" Content="{DynamicResource Str_Ui_Expert_Mode_Tweak_The_Java_Version_Archi}"
                      Margin="0,0,0,4" Checked="AdvancedModeCheck_Changed" Unchecked="AdvancedModeCheck_Changed"/>
            <TextBlock x:Name="AdvancedModeHintText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,16" TextWrapping="Wrap"/>

            <!-- 启动器界面语言：跟下面「游戏内语言」是两个独立设置，见 AppConfig.LauncherLanguage
                 和 Resources/Lang/README.md 的说明。这里跟首页顶部的"🌐 语言"按钮打开的是
                 同一个 LanguageSelectDialog，共享同一份切换逻辑，两处操作互相同步。 -->
            <TextBlock Text="{DynamicResource Str_Settings_LanguageSection_Title}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Settings_LanguageSection_Hint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <Button x:Name="OpenLanguagePickerBtn" Content="{DynamicResource Str_Settings_LanguageSection_OpenPicker}"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,8"
                    Margin="0,0,0,20" Click="OpenLanguagePicker_Click"/>

            <Button Content="{DynamicResource Str_Ui_Reopen_Setup_Wizard}" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,16"
                    Click="ReopenWizard_Click"/>

            <!-- 窗口与托盘：点击标题栏叉号时的默认行为 + 开机自启动。
                 这些项目跟其它普通设置一样统一由“保存设置/自动保存”流程持久化。 -->
            <TextBlock Text="窗口与托盘" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="点击标题栏叉号(关闭按钮)时" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CloseActionCombo" Width="260" HorizontalAlignment="Left" Margin="0,0,0,10"
                      SelectionChanged="CloseActionCombo_SelectionChanged">
                <ComboBoxItem Content="直接关闭启动器"/>
                <ComboBoxItem Content="最小化到系统托盘"/>
                <ComboBoxItem Content="最小化（仅收进任务栏，不显示托盘图标）"/>
                <ComboBoxItem Content="每次都弹窗询问"/>
            </ComboBox>
            <Grid Margin="0,0,0,10" MaxWidth="620" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox x:Name="AutoStartOnBootCheck" Content="开机自启动" VerticalAlignment="Center"
                          Checked="AutoStartOnBootCheck_Changed" Unchecked="AutoStartOnBootCheck_Changed"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="自启动后" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="AutoStartLaunchBehaviorCombo" Width="190" Padding="6">
                        <ComboBoxItem Content="弹出主界面"/>
                        <ComboBoxItem Content="最小化到任务栏"/>
                        <ComboBoxItem Content="隐藏到系统托盘"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="游戏启动成功后，启动器窗口" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="PostGameLaunchActionCombo" Width="300" HorizontalAlignment="Left" Margin="0,0,0,20"
                      SelectionChanged="PostGameLaunchActionCombo_SelectionChanged">
                <ComboBoxItem Content="保持不变（默认）"/>
                <ComboBoxItem Content="最小化到任务栏"/>
                <ComboBoxItem Content="最小化到系统托盘"/>
                <ComboBoxItem Content="直接关闭启动器"/>
            </ComboBox>

            <!-- 普通模式下才显示：简化版 Java 版本选择，只给 Java 8 / 17 / 21 / 25 四个选项，
                 每个选项对应一段能大致覆盖的游戏版本区间，帮用户不用去查资料就能选对。
                 选中项直接决定"一键下载 Java"下载哪个版本；不涉及架构/安装方式，
                 这两项在普通模式下走固定的推荐值（当前系统架构 + 便携安装），
                 Java 8 除外——它默认使用 32 位，其余版本默认使用 64 位（见下方架构提示）。 -->
            <StackPanel x:Name="SimpleJavaPanel" Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource Str_Ui_Java_Version}" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <ComboBox x:Name="SimpleJavaVersionCombo" Width="260" HorizontalAlignment="Left">
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Java_8_For_Versions_Before_1_16}" Tag="8"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Java_17_For_Versions_Before_1_20_5}" Tag="17"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Java_21_For_Versions_Before_1_21_11}" Tag="21"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Java_25_For_26_1_And_Later}" Tag="25"/>
                </ComboBox>
                <TextBlock Text="{DynamicResource Str_Ui_Note_Java_8_Defaults_To_32_Bit_And_Every}"
                           Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 高级模式下才显示：Java 版本 / 架构 / 安装方式选择。
                 放在"下载 Java"按钮上面——因为高级模式下点"下载 Java"读的就是这里选的版本/架构/
                 安装方式，选择应该在动作之前，原来的顺序是反的（选项在下载按钮下面），容易让人先
                 点了下载才看到还有版本可选，现在调整成先选、后点下载，符合从上到下的操作顺序。 -->
            <StackPanel x:Name="AdvancedJavaPanel" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Str_Ui_Java_Version_Architecture_Install_Type_A}" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="JavaVersionCombo" Width="110" Margin="0,0,8,0"/>
                    <ComboBox x:Name="JavaArchCombo" Width="90" Margin="0,0,8,0">
                        <ComboBoxItem Content="x64" Tag="x64"/>
                        <ComboBoxItem Content="x86" Tag="x86"/>
                    </ComboBox>
                    <ComboBox x:Name="JavaInstallModeCombo" Width="160">
                        <ComboBoxItem Content="{DynamicResource Str_Ui_Portable_Zip_No_Installer}" Tag="Portable"/>
                        <ComboBoxItem Content="{DynamicResource Str_Ui_Install_System_Wide_Msi}" Tag="System"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="{DynamicResource Str_Ui_Note_The_Officially_Released_Versions_Ar}"
                           Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <!-- 需求 5：高手模式下不做任何自动选择/校验，只把版本-游戏版本区间的对应关系
                     提示出来，由用户自己判断该给哪个游戏版本配哪个 Java（跟普通模式的四选一
                     不同，高手模式可以选 8~26 之间任意版本号，所以这里只是提示，不是选项）。 -->
                <TextBlock Text="{DynamicResource Str_Ui_For_Reference_Java_8_Covers_Versions_Bef}"
                           Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <!-- 强制使用匹配 Java：默认关闭，只是"建议"（弹窗可以选择仍然使用）。打开后启动前
                     检测到 Java 版本不匹配会直接自动切换，不再提供"仍然使用"的选项。
                     见 MainWindow.xaml.cs LaunchInternalAsync 里的版本匹配检查。 -->
                <CheckBox x:Name="EnforceJavaVersionMatchCheck" Content="{DynamicResource Str_Ui_Always_Use_The_Matching_Java_Switch_Auto}"
                          Margin="0,10,0,0"/>
            </StackPanel>

            <!-- 需求：去掉这里单独的"Java 路径"输入框——下面的"Java 列表（多 Java 共存）"区块已经
                 能承担同样的作用（浏览选择/自动探测/全盘扫描都能直接把结果加入列表，并且可以登记
                 任意多个、按版本/服务器分别指定），保留这个单独的路径框反而是冗余的重复入口，
                 容易让用户搞不清"这个框"和"下面的列表"到底是什么关系。
                 "下载 Java"按钮保留，但下载完成后不再写回这里（这个框已经不存在），直接跟以前一样
                 自动登记进下面的 Java 列表（DownloadJava_Click 里本来就有这一步，没有依赖这个框）。 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Str_Ui_Downloaded_Java_Runtimes_Are_Added_To_Th}"
                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" x:Name="DownloadJavaBtn" Content="{DynamicResource Str_Ui_Download_Java}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,8" Click="DownloadJava_Click"/>
            </Grid>

            <!-- 全盘扫描默认不开启：只在用户主动点击后才弹二次确认，说明扫描范围，
                 同意后才会真正开始遍历磁盘；默认行为(FindJava)完全不受影响，只看默认路径。 -->
            <Button x:Name="ScanDiskForJavaBtn" Content="{DynamicResource Str_Ui_Scan_The_Whole_Disk_For_Java_Optional_Of}"
                    HorizontalAlignment="Left" Padding="10,6" Margin="0,4,0,16"
                    Click="ScanDiskForJava_Click"/>

            <!-- Java 列表：多个 Java 运行时可以同时登记在案（多 Java 共存），
                 客户端每个版本、服务器每个实例都能各自从这个列表里选择要用哪一个。 -->
            <TextBlock Text="{DynamicResource Str_Ui_Java_List_Multiple_Java_Runtimes}" FontSize="14" FontWeight="Bold" Margin="0,4,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Once_Several_Java_Runtimes_Are_Registere}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <ListBox x:Name="JavaListBox" Height="120" Margin="0,0,0,8"
                     DisplayMemberPath="DisplayText"/>

            <!-- 优先级排序：上移/下移调整 Java 列表顺序，FindJava 自动匹配(没有为某个版本/服务器
                 单独指定 Java 时)会按这个顺序从高到低依次尝试，选第一个跟当前 MC 版本兼容的那个。
                 之前只能通过"全局默认 Java"强制指定一个，覆盖不到所有场景(比如同时有需要
                 Java 21 的新版本和需要 Java 8 的老 mod)；现在维护一份优先级列表，不同版本各自
                 匹配到列表里排最靠前、又满足版本要求的那个，不需要来回手动切换。 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{DynamicResource Str_Ui_Move_Up}" Padding="10,6" Margin="0,0,8,0" Click="MoveJavaUp_Click"
                        ToolTip="{DynamicResource Str_Ui_Move_The_Selected_Java_One_Place_Up_Auto}"/>
                <Button Content="{DynamicResource Str_Ui_Move_Down}" Padding="10,6" Click="MoveJavaDown_Click"
                        ToolTip="{DynamicResource Str_Ui_Move_The_Selected_Java_One_Place_Down}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{DynamicResource Str_Ui_Refresh_Auto_Detect}" Padding="10,6" Margin="0,0,8,0" Click="RefreshDetectJava_Click"
                        ToolTip="{DynamicResource Str_Ui_Quickly_Checks_The_Usual_Places_For_Inst}"/>
                <Button Content="{DynamicResource Str_Ui_Add_Browse}" Padding="10,6" Margin="0,0,8,0" Click="AddJavaByBrowse_Click"/>
                <Button Content="{DynamicResource Str_Ui_Rename}" Padding="10,6" Margin="0,0,8,0" Click="RenameJava_Click"/>
                <Button Content="{DynamicResource Str_Ui_Remove}" Padding="10,6" Click="RemoveJava_Click"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource Str_Ui_Global_Default_Java_Used_When_A_Version_}" Margin="0,0,0,4"/>
            <ComboBox x:Name="DefaultJavaCombo" Margin="0,0,0,16" Padding="8"
                      DisplayMemberPath="DisplayText"
                      ToolTip="{DynamicResource Str_Ui_Pick_One_From_The_Java_List_Above_As_The}"/>


            <TextBlock Text="{DynamicResource Str_Ui_Min_Memory_Mb}" Margin="0,0,0,4"/>
            <TextBox x:Name="MinMemBox" Padding="8" Margin="0,0,0,16"/>

            <TextBlock Text="{DynamicResource Str_Ui_Max_Memory_Mb}" Margin="0,0,0,4"/>
            <TextBox x:Name="MaxMemBox" Padding="8" Margin="0,0,0,16"/>

            <TextBlock Text="{DynamicResource Str_Ui_Game_Window_Size}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox x:Name="WidthBox" Width="90" Padding="8"/>
                <TextBlock Text=" x " VerticalAlignment="Center" Margin="6,0"/>
                <TextBox x:Name="HeightBox" Width="90" Padding="8"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource Str_Ui_Download_Source}" Margin="0,0,0,4"/>
            <ComboBox x:Name="SourceCombo" Width="220" Margin="0,0,0,20">
                <ComboBoxItem Content="{DynamicResource Str_Ui_Bmclapi_Mirror_Recommended_Faster_In_Mai}"/>
                <ComboBoxItem Content="{DynamicResource Str_Ui_Official_Mojang}"/>
            </ComboBox>

            <!-- CurseForge 地图下载功能使用内置 API Key（见 CurseForgeKeyService.BuiltInKey），
                 不需要用户自己申请/填写。这里之前有过一个"填 Key"输入框，但内置 key 本来就够用，
                 输入框常年空着不影响任何功能——反而容易让用户误以为"不填就用不了"，
                 实际去 CurseForge 官网申请一圈，回来发现填不填都一样，被当成 bug 反馈。
                 已去掉这个输入框；如果以后确实需要支持用户自定义 key（比如内置 key 被限流/失效），
                 CurseForgeKeyService.SaveKey/ClearKey 方法还在，直接手动编辑
                 xcl2/curseforge_key.txt 这个文件仍然生效，只是不再放显眼的设置项引导普通用户去填。 -->


            <!-- 游戏内语言：控制 Minecraft 客户端本体的显示语言（写入 options.txt 的 lang 字段），
                 跟启动器界面本身的语言无关。之前版本完全没有这个选项，导致游戏语言只能依赖
                 Minecraft 自己的系统语言探测，中文 Windows 上偶尔仍会回退成英文且用户无法手动纠正。 -->
            <TextBlock Text="{DynamicResource Str_Ui_In_Game_Language}" Margin="0,0,0,4"/>
            <ComboBox x:Name="GameLanguageCombo" Width="220" Margin="0,0,0,20">
                <ComboBoxItem Content="{DynamicResource Str_Ui_Label_2}" Tag="zh_cn"/>
                <ComboBoxItem Content="{DynamicResource Str_Ui_Label_3}" Tag="zh_tw"/>
                <ComboBoxItem Content="English (US)" Tag="en_us"/>
                <ComboBoxItem Content="{DynamicResource Str_Ui_Label}" Tag="ja_jp"/>
                <ComboBoxItem Content="한국어" Tag="ko_kr"/>
            </ComboBox>

            <!-- 游戏内左下角"版本类型"水印文字：对应启动参数 versionType（Minecraft 客户端
                 原生会把这个值渲染在主菜单/游戏内左下角），见 AppConfig.GameVersionTypeLabel 注释。
                 默认 "XCL2"，用户可以改成任意文字，留空则退回官方原始的 "release"。 -->
            <TextBlock Text="{DynamicResource Str_Ui_In_Game_Watermark_Text_Shown_In_The_Bott}" Margin="0,0,0,4"/>
            <TextBox x:Name="GameVersionTypeLabelBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,20"/>

            <!-- 界面切换动画开关：控制左侧导航栏切页时右侧内容区的淡入过渡效果。
                 默认开启；觉得切页慢/动画多余的用户可以关掉，关闭后切页恢复瞬间直接替换，
                 不跑任何动画。见 MainWindow.SetMainContent。 -->
            <CheckBox x:Name="PageAnimationsCheck" Content="{DynamicResource Str_Ui_Page_Transition_Animation_The_Fade_When_}"
                      Margin="0,0,0,8"/>

            <CheckBox x:Name="InjectionScanCheck" Content="{DynamicResource Str_Ui_Enable_Injection_Scanning_Checks_For_Sus}"
                      Margin="0,0,0,8"/>

            <CheckBox x:Name="GameConsoleWindowCheck" Content="{DynamicResource Str_Ui_Open_A_Separate_Console_Window_On_Launch}"
                      Margin="0,0,0,8"/>

            <!-- 下载中心 Mod 搜索结果的图标显示开关：图标从 Modrinth/CurseForge 抓取，
                 默认显示；网络较差或者不喜欢列表里混图片的用户可以关掉，只影响图标渲染，
                 不影响搜索/下载本身。 -->
            <CheckBox x:Name="ShowModIconsCheck" Content="{DynamicResource Str_Ui_Show_Mod_Icons_In_Search_Results_Fetched}"
                      Margin="0,0,0,8"/>

            <!-- 服务器启动后的外网访问教程弹窗开关：介绍内网穿透/路由器端口映射/云服务器中转，
                 帮不熟悉这些操作的用户开服后知道下一步该做什么，默认开启，用户可以在这里关掉，
                 也可以在教程弹窗里直接勾选"不再提示"（效果和这里是同一个开关）。 -->
            <CheckBox x:Name="ShowServerNetworkGuideCheck" Content="{DynamicResource Str_Ui_Show_The_Opening_Your_Server_To_The_Inte}"
                      Margin="0,0,0,8"/>

            <CheckBox x:Name="IsolateVersionsCheck" Content="{DynamicResource Str_Ui_Keep_Mods_Resource_Packs_Data_Packs_And_}"
                      Margin="0,0,0,8"/>

            <!-- ===================== 拖拽安装 =====================
                 对应需求："均可以在设置项里调整默认值"。
                 这四项决定把文件拖进启动器窗口时默认怎么处理；
                 拖拽本身的识别逻辑见 Services/DragDropInstallService.cs。 -->
            <TextBlock Text="{DynamicResource Str_Drop_SectionTitle}" FontWeight="Bold" FontSize="14" Margin="0,18,0,4"/>
            <TextBlock FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{DynamicResource Str_Ui_Drag_Mods_Resource_Packs_Shaders_Worlds_}"/>

            <CheckBox x:Name="ModpackDropNewInstanceCheck" Margin="0,0,0,10"
                      Content="{DynamicResource Str_Ui_Create_A_Separate_Instance_When_A_Modpac}"
                      ToolTip="{DynamicResource Str_Ui_Turning_This_Off_Restores_The_Old_Behavi}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource Str_Ui_When_A_Dropped_Zip_Can_T_Be_Identified}" VerticalAlignment="Center" Width="200"/>
                <ComboBox x:Name="ZipDropDefaultCombo" Width="220" SelectionChanged="DragDropSetting_Changed">
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Ask_Every_Time_Recommended}" Tag="Ask" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Always_Treat_As_Modpack}" Tag="Modpack"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Always_Treat_As_Resource_Pack}" Tag="ResourcePack"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource Str_Ui_Dropping_Jar_On_The_Server_Management_Pa}" VerticalAlignment="Center" Width="200"/>
                <ComboBox x:Name="ServerJarDropCombo" Width="220" SelectionChanged="DragDropSetting_Changed">
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Install_To_Server_Recommended}" Tag="Server" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Install_To_Current_Instance}" Tag="CurrentInstanceMods"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Ask_Every_Time}" Tag="Ask"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource Str_Ui_Dropping_Jar_On_Other_Pages}" VerticalAlignment="Center" Width="200"/>
                <ComboBox x:Name="DefaultJarDropCombo" Width="220" SelectionChanged="DragDropSetting_Changed">
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Install_To_Current_Instance_Recomm}" Tag="CurrentInstanceMods" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Install_To_Server}" Tag="Server"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Ask_Every_Time}" Tag="Ask"/>
                </ComboBox>
            </StackPanel>

            <!-- 资源包下载作用域：独立于上面的"版本隔离"总开关。默认勾选(材质包/数据包/光影包都
                 按版本隔离，装进各自版本目录下，互不共用)；取消勾选后改为全局共用一份，装进
                 .minecraft 根目录的 resourcepacks/shaderpacks，不用每个版本各下一次。
                 数据包不受这个开关影响，数据包本来就必须挂在具体存档下才生效。
                 可在「版本选择」页为单个版本单独覆盖，跟上面"版本隔离"覆盖是同一个模式。 -->
            <CheckBox x:Name="IsolateResourcePacksCheck" Content="{DynamicResource Str_Ui_Keep_Resource_Data_And_Shader_Packs_Sepa}"
                      Margin="0,0,0,20"/>

            <!-- 访客模式：开启后主页/启动游戏永远使用一个只存在于本次运行的临时离线账户，
                 不使用、也不暴露账户管理页里保存的任何真实账户；关闭启动器时会清理本次会话
                 新产生的游戏日志/临时下载文件（不影响已安装的游戏本体、mods、存档等）。
                 适合在别人电脑上临时借用的场景。需要点下面的"保存设置"才会生效。 -->
            <TextBlock Text="{DynamicResource Str_Ui_Privacy}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <CheckBox x:Name="GuestModeCheck" Content="{DynamicResource Str_Ui_Guest_Mode_Launches_With_A_Temporary_Acc}"
                      ToolTip="{DynamicResource Str_Ui_When_On_The_Launch_Button_Always_Uses_A_}"
                      Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Guest_Mode_Only_Affects_Temporary_Accoun}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <!-- 保存行为：是否允许设置页改动后自动保存，不需要每次都点"保存设置"按钮。
                 默认关闭，见 AppConfig.SettingsAutoSaveWithoutConfirm 注释。 -->
            <TextBlock Text="保存行为" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <CheckBox x:Name="SettingsAutoSaveCheck"
                      Content="修改设置后自动保存，无需点击下方的“保存设置”按钮（默认关闭）"
                      ToolTip="开启后每次改动会在短暂延迟后自动保存，并在左下角保留可点击“回退”的操作提示；关闭时改动只会先留在界面上，需要手动保存或在提示里点“保存”。"
                      Margin="0,0,0,20"/>

            <!-- Windows 11 新视觉效果 + 窗口透明度：都是纯装饰性的新功能，默认关闭，
                 需要用户在这里手动开启才会生效，避免升级后老用户界面突然"变样"。
                 见 AppConfig.EnableWin11VisualEffects / EnableWindowTransparency 注释、
                 Services/Win11EffectsService.cs 的具体实现。 -->
            <TextBlock Text="外观与视觉效果" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <CheckBox x:Name="Win11EffectsCheck"
                      Content="启用 Windows 11 新光效设计（云母材质背景 / 窗口圆角 / 沉浸光感过渡，仅 Windows 11 生效，默认关闭）"
                      ToolTip="依赖 Windows 11 才有的 DWM 特性；在 Windows 10 或更早系统上会被自动忽略，不影响正常使用。"
                      Margin="0,0,0,8" Checked="VisualEffectsToggle_Changed" Unchecked="VisualEffectsToggle_Changed"/>
            <CheckBox x:Name="WinUi3DesignCheck"
                      Content="启用 WinUI 3 新设计"
                      Margin="0,0,0,4" Checked="WinUi3DesignCheck_Changed" Unchecked="WinUi3DesignCheck_Changed"/>
            <TextBlock Text="Windows 11 才提供完整支持；Windows 10 仍可开启，但系统没有对应 API 时可能没有视觉变化。此功能不会联网或向 GitHub 报告。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel x:Name="BackdropMaterialPanel" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="背景材质" VerticalAlignment="Center" Width="200"/>
                <ComboBox x:Name="BackdropMaterialCombo" Style="{StaticResource TallPopupComboBox}"
                          Width="220" SelectionChanged="VisualEffectsToggle_Changed"
                          ToolTip="Mica：贴合桌面壁纸的柔和渐变（系统默认风格）。云母加深版：层次更明显。毛玻璃：真正的亚克力磨砂模糊，透感最强。">
                    <ComboBoxItem Content="云母 Mica（默认）" Tag="Mica"/>
                    <ComboBoxItem Content="云母加深版 Mica Alt" Tag="MicaAlt"/>
                    <ComboBoxItem Content="毛玻璃 Acrylic（磨砂模糊，透感更强）" Tag="Acrylic"/>
                </ComboBox>
            </StackPanel>

            <!-- 界面字体：跟 WinUi3 开关是两个独立维度，见 AppConfig.AppFontFamily /
                 ThemeService.ApplyFontFamily 注释。"跟随系统"以外的选项在候选链末尾都会
                 强制带上中文字体兜底，修复个别环境下部分中文字符显示不全（被裁掉一点底）
                 的问题；选好之后点下面的"保存设置"立即生效，不需要重启。 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="界面字体" VerticalAlignment="Center" Width="200"/>
                <ComboBox x:Name="AppFontCombo" Style="{StaticResource TallPopupComboBox}" Width="220"
                          ToolTip="修改部分中文字符（尤其是带下沉笔画的字）显示不全，可以尝试切换成明确的中文字体。">
                    <ComboBoxItem Content="跟随系统" Tag=""/>
                    <ComboBoxItem Content="微软雅黑 UI" Tag="MicrosoftYaHeiUI"/>
                    <ComboBoxItem Content="微软雅黑" Tag="MicrosoftYaHei"/>
                    <ComboBoxItem Content="等线" Tag="DengXian"/>
                    <ComboBoxItem Content="思源黑体" Tag="SourceHanSans"/>
                    <ComboBoxItem Content="苹方" Tag="PingFang"/>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="选中的字体如果本机没有安装，会自动回退到系统默认中西文字体，不会显示成方块字。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <!-- 字体分层/分块设置：在上面"界面字体"（全局、几个固定预置候选）之外，
                 额外允许标题栏 / 侧边导航栏 / 右侧内容区 三个区块分别单独指定一款
                 本机已安装的系统字体（不限于预置候选），只影响对应区块，不影响其它区块，
                 也不影响上面的全局设置——三个区块留空即"跟随全局"。
                 见 Services/FontService.cs 顶部注释了解具体实现原理。 -->
            <TextBlock x:Name="SettingsSectionFontLayers" Text="字体分层设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="可按区块单独指定一款本机已安装的字体，覆盖上面的&quot;界面字体&quot;；选择&quot;跟随全局&quot;即取消覆盖。选好之后点下面的&quot;保存设置&quot;生效。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="标题栏字体" VerticalAlignment="Center" Width="200"/>
                <ComboBox x:Name="TitleBarFontCombo" Style="{StaticResource TallPopupComboBox}" Width="260"
                          ToolTip="只影响自绘标题栏（图标/标题文字/下载列表按钮等），不影响侧边栏和内容区。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="侧边栏字体" VerticalAlignment="Center" Width="200"/>
                <ComboBox x:Name="SidebarFontCombo" Style="{StaticResource TallPopupComboBox}" Width="260"
                          ToolTip="只影响左侧导航栏（Logo/导航按钮/账户版本信息/启动按钮等），不影响标题栏和内容区。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="内容区字体" VerticalAlignment="Center" Width="200"/>
                <ComboBox x:Name="ContentFontCombo" Style="{StaticResource TallPopupComboBox}" Width="260"
                          ToolTip="只影响右侧内容区（首页/设置/下载中心等各个页面），不影响标题栏和侧边栏。"/>
            </StackPanel>

            <!-- 亮度：0~200，100 为默认（不调整）。不是真的调整显示器亮度，是在界面上盖一层
                 半透明黑/白遮罩模拟"变暗/变亮"的视觉效果，见 ThemeService.ApplyBrightness 注释。 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                        ToolTip="100 为默认不调整；调低整体变暗，调高整体发白变亮。这是软件内部的视觉效果模拟，不会真的改变显示器/系统亮度。">
                <TextBlock Text="界面亮度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="BrightnessSlider" Width="220" Minimum="0" Maximum="200"
                        TickFrequency="10" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="BrightnessSlider_ValueChanged"/>
                <TextBlock x:Name="BrightnessValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>

            <CheckBox x:Name="WindowTransparencyCheck"
                      Content="启用窗口透明度（侧栏 / 卡片等面板呈现半透明玻璃质感，默认关闭）"
                      Margin="0,0,0,4" Checked="VisualEffectsToggle_Changed" Unchecked="VisualEffectsToggle_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="毛玻璃背景图片" VerticalAlignment="Center" Width="200"/>
                <TextBox x:Name="CustomBackgroundImagePathBox" Width="180" Padding="6" IsReadOnly="True"/>
                <Button Content="导入" Margin="8,0,0,0" Padding="10,5" Click="ImportBackgroundImage_Click"/>
                <Button Content="清除" Margin="8,0,0,0" Padding="10,5" Click="ClearBackgroundImage_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                        ToolTip="25% 接近透明/清晰，100% 为最强磨砂；拖动时立即预览，保存设置后重启仍保持。">
                <TextBlock Text="背景磨砂度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="CustomBackgroundFrostSlider" Width="220" Minimum="25" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="CustomBackgroundFrostSlider_ValueChanged"/>
                <TextBlock x:Name="CustomBackgroundFrostValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="面板透明度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="WindowOpacitySlider" Width="220" Minimum="20" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="WindowOpacitySlider_ValueChanged"/>
                <TextBlock x:Name="WindowOpacityValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>

            <CheckBox x:Name="GlobalWindowTransparencyCheck"
                      Content="启用整窗全局透明（连标题栏/边框一起透明，能透出后方桌面，默认关闭）"
                      Margin="0,0,0,4" Checked="VisualEffectsToggle_Changed" Unchecked="VisualEffectsToggle_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="整窗透明度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="GlobalWindowOpacitySlider" Width="220" Minimum="50" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="GlobalWindowOpacitySlider_ValueChanged"/>
                <TextBlock x:Name="GlobalWindowOpacityValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                        ToolTip="只调整主要文字的可见度，不改变背景；背景很通透时可以单独提高文字清晰度。">
                <TextBlock Text="文字透明度设置" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="TextOpacitySlider" Width="220" Minimum="50" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="TextOpacitySlider_ValueChanged"/>
                <TextBlock x:Name="TextOpacityValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>
            <TextBlock Text="背景过于通透时建议保持较高文字透明度；该选项与面板/整窗透明度相互独立。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <!-- 弹窗（所有确认框/选择框等）与抽屉（AI 助手侧栏面板）的独立外观：默认关闭，
                 跟随主界面的面板透明度设置；用户开启后可以单独给弹窗/抽屉设置不同于主界面的
                 透明度、磨砂度、文字透明度。见 AppConfig.Popup*/Drawer* 字段注释和
                 ThemeService.ApplyPopupAppearance/ApplyDrawerAppearance。 -->
            <TextBlock Text="弹窗与抽屉外观" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="默认弹窗（确认框/选择框等）和抽屉（AI 助手侧栏）都跟随上面的主界面外观；开启下面的开关后可以单独设置，互不影响。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <CheckBox x:Name="PopupCustomAppearanceCheck"
                      Content="弹窗使用独立外观（不勾选则跟随主界面面板透明度）"
                      Margin="0,0,0,4" Checked="PopupAppearanceControl_Changed" Unchecked="PopupAppearanceControl_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="弹窗背景透明度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="PopupOpacitySlider" Width="220" Minimum="20" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="PopupAppearanceSlider_ValueChanged"/>
                <TextBlock x:Name="PopupOpacityValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="弹窗磨砂度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="PopupFrostSlider" Width="220" Minimum="0" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="PopupAppearanceSlider_ValueChanged"/>
                <TextBlock x:Name="PopupFrostValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="弹窗文字透明度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="PopupTextOpacitySlider" Width="220" Minimum="40" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="PopupAppearanceSlider_ValueChanged"/>
                <TextBlock x:Name="PopupTextOpacityValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>

            <CheckBox x:Name="DrawerCustomAppearanceCheck"
                      Content="抽屉（AI 助手）使用独立外观（不勾选则跟随主界面面板透明度）"
                      Margin="0,0,0,4" Checked="DrawerAppearanceControl_Changed" Unchecked="DrawerAppearanceControl_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="抽屉背景透明度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="DrawerOpacitySlider" Width="220" Minimum="20" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="DrawerAppearanceSlider_ValueChanged"/>
                <TextBlock x:Name="DrawerOpacityValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="抽屉磨砂度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="DrawerFrostSlider" Width="220" Minimum="0" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="DrawerAppearanceSlider_ValueChanged"/>
                <TextBlock x:Name="DrawerFrostValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="抽屉文字透明度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="DrawerTextOpacitySlider" Width="220" Minimum="40" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="DrawerAppearanceSlider_ValueChanged"/>
                <TextBlock x:Name="DrawerTextOpacityValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
            </StackPanel>


            <!-- 低性能模式：关闭动画、阴影、透视效果，减少渲染负担，提升流畅度。
                 勾选后界面将变得更基础，但启动器在老旧硬件上将更流畅运行。 -->
            <CheckBox x:Name="LowPerformanceModeCheck"
                      Content="启用低性能模式（关闭动画、阴影、透视效果）"
                      Margin="0,0,0,4"
                      Checked="LowPerformanceModeCheck_Changed"
                      Unchecked="LowPerformanceModeCheck_Changed"/>
            <!-- 高性能模式：跟"低性能模式"相反，追加更强的切页/交互动效（缩放+位移+回弹缓动，
                 类似 macOS/游戏 UI 那种"约束感"动画），不做自动降级——用户自己权衡，只在
                 FrameRateMonitorService 检测到持续低帧率时用一次性 Toast 提醒可以关闭，
                 不会强制关闭。跟低性能模式同时开启时以低性能模式为准（见 MainWindow.SetMainContent
                 判断顺序），毕竟"关闭动效"和"加强动效"同时打开没有意义，低性能模式的诉求更明确。 -->
            <CheckBox x:Name="HighPerformanceModeCheck" Content="启用高性能模式（更强的界面动效，可能增加渲染开销）"
                      Margin="0,0,0,4"/>
            <TextBlock Text="（低配设备上如果持续掉帧，启动器会用一次提示建议你关闭这个开关，不会自动关）"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-2,0,4" TextWrapping="Wrap"/>
            <CheckBox x:Name="AlwaysOnTopCheck" Content="启动器始终置顶（F3 可临时切换，本次会话有效）"
                      Margin="0,0,0,8"/>

            <TextBlock Text="鼠标滚轮" FontSize="14" FontWeight="Bold" Margin="0,10,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="滚轮灵敏度" VerticalAlignment="Center" Width="200"/>
                <Slider x:Name="MouseWheelSensitivitySlider" Width="220" Minimum="50" Maximum="200"
                        TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        ValueChanged="MouseWheelSensitivitySlider_ValueChanged"/>
                <TextBlock x:Name="MouseWheelSensitivityValueText" VerticalAlignment="Center" Margin="8,0,0,0" Width="48"/>
            </StackPanel>
            <TextBlock Text="100% 为基准速度；默认 90%，比旧版固定滚动速度稍慢一点。拖动时立即预览，保存后下次启动继续使用。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <!-- 界面缩放快捷键：总开关 + 绑定方式（可多选：滚轮/方向键）+ 当前缩放比例。
                 跟浏览器 Ctrl+滚轮缩放页面是同一套习惯，具体实现见 UiZoomService。 -->
            <TextBlock Text="界面缩放快捷键" FontSize="14" FontWeight="Bold" Margin="0,10,0,4"/>
            <CheckBox x:Name="UiZoomEnabledCheck" Content="启用 Ctrl + 滚轮 / Ctrl + 方向键 缩放界面"
                      Margin="0,0,0,6" Checked="UiZoomEnabledCheck_Changed" Unchecked="UiZoomEnabledCheck_Changed"/>
            <StackPanel x:Name="UiZoomBindingsPanel" Orientation="Horizontal" Margin="20,0,0,6">
                <CheckBox x:Name="UiZoomWheelCheck" Content="Ctrl + 鼠标滚轮" Margin="0,0,18,0"
                          Checked="UiZoomBinding_Changed" Unchecked="UiZoomBinding_Changed"/>
                <CheckBox x:Name="UiZoomArrowCheck" Content="Ctrl + 方向键（上下）"
                          Checked="UiZoomBinding_Changed" Unchecked="UiZoomBinding_Changed"/>
            </StackPanel>
            <StackPanel x:Name="UiZoomLevelPanel" Orientation="Horizontal" Margin="20,0,0,8">
                <TextBlock Text="当前缩放" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="UiZoomSlider" Width="180" Minimum="40" Maximum="300" TickFrequency="10"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="UiZoomSlider_ValueChanged"/>
                <TextBlock x:Name="UiZoomPercentText" Text="100%" VerticalAlignment="Center" Margin="10,0,0,0" Width="42"/>
                <Button Content="重置为 100%" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="10,0,0,0"
                        Click="UiZoomReset_Click"/>
            </StackPanel>
            <TextBlock Text="没按住 Ctrl 时滚轮/方向键完全不受影响，两种绑定方式可以同时启用。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-2,0,10" TextWrapping="Wrap"/>

            <TextBlock Text="实例定时备份" FontSize="14" FontWeight="Bold" Margin="0,10,0,4"/>
            <CheckBox x:Name="ScheduledBackupCheck" Content="定时备份当前选择的实例" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="间隔（小时）" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ScheduledBackupIntervalBox" Width="60" Padding="5"/>
                <TextBlock Text="保留数量" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <TextBox x:Name="ScheduledBackupRetentionBox" Width="60" Padding="5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox x:Name="BackupOnStartupCheck" Content="每次启动时备份实例" Margin="0,0,18,0"/>
                <CheckBox x:Name="BackupOnCloseCheck" Content="每次关闭时备份实例"/>
            </StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="启动/关闭备份目标" VerticalAlignment="Center"/>
                <ComboBox x:Name="LifecycleBackupTargetModeCombo" Grid.Column="1" Padding="6"
                          SelectionChanged="LifecycleBackupTargetModeCombo_SelectionChanged">
                    <ComboBoxItem Content="单一（当前选中的实例）" Tag="Single"/>
                    <ComboBoxItem Content="多个（按下面实例 ID 列表）" Tag="Multiple"/>
                    <ComboBoxItem Content="满足任意一（存在的候选都备份）" Tag="Any"/>
                    <ComboBoxItem Content="满足所有（候选必须全部存在）" Tag="All"/>
                </ComboBox>
            </Grid>
            <Grid x:Name="LifecycleBackupTargetsPanel" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="候选实例 ID" VerticalAlignment="Top" Margin="0,7,0,0"/>
                <StackPanel Grid.Column="1">
                    <TextBox x:Name="LifecycleBackupVersionIdsBox" Height="58" Padding="7" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    <TextBlock Text="多个 ID 用逗号、分号或换行分隔；只在当前选择的游戏文件夹中查找。"
                               FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- 配色皮肤：色系(White/Blue/Yellow/Purple/Pink)，跟明暗是两个独立维度。
                 具体显示成浅色版还是深色版由 IsDarkMode 决定。这里选的只是色相，不管深浅。
                 “自定义”不会替换/隐藏原来的预设选择控件，只在 UiSkinCombo 正下方展开独立
                 CustomThemeSettingsPanel；用户真正选定/应用颜色之前也不算一次已提交的设置修改。 -->
            <TextBlock Text="{DynamicResource Str_Ui_Colour_Theme}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox x:Name="UiSkinCombo" Style="{StaticResource TallPopupComboBox}" Padding="8" Margin="0,0,0,20" HorizontalAlignment="Left" MinWidth="180"
                      SelectionChanged="UiSkinCombo_SelectionChanged"
                      ToolTip="{DynamicResource Str_Ui_Changes_The_Launcher_S_Colour_Family_Eac}"/>

            <!-- “自定义”只负责展开下方的调色区域，不会在用户尚未挑选/应用颜色时就把 Custom
                 当成一次已决定的设置并触发自动保存。真正选择预设色块、使用 RGB 或应用合法颜色后
                 才提交为自定义主题。面板固定显示在“配色皮肤”下方，不替换任何预设主题位置。 -->
            <Border x:Name="CustomThemeSettingsPanel" Visibility="Collapsed" Margin="0,8,0,14" Padding="14"
                    services:ScrollWheelBehavior.ContainWheel="True"
                    Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="10" MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="自定义颜色" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="选择颜色后会同时应用到强调色、按钮、悬停和光晕，选好后会立即预览；保存设置后下次启动继续使用。"
                                       Margin="0,3,18,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border x:Name="CustomAccentColorPreview" Grid.Column="1" Width="36" Height="36" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" ToolTip="当前自定义主题颜色"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="颜色值" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="CustomAccentColorBox" Grid.Column="1" Padding="7" ToolTip="例如 #4C9AFF，输入/粘贴后会自动预览生效"
                                 TextChanged="CustomAccentColorBox_TextChanged"/>
                        <Button Grid.Column="2" Content="应用主题" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,6"
                                Click="CustomAccentColorApply_Click"/>
                    </Grid>

                    <TextBlock Text="预设颜色" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <UniformGrid Columns="6" Rows="2" Margin="0,0,0,10">
                        <Button Tag="#4C9AFF" Background="#4C9AFF" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#4C9AFF"/>
                        <Button Tag="#7C5CFC" Background="#7C5CFC" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#7C5CFC"/>
                        <Button Tag="#D946EF" Background="#D946EF" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#D946EF"/>
                        <Button Tag="#EC4899" Background="#EC4899" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#EC4899"/>
                        <Button Tag="#EF4444" Background="#EF4444" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#EF4444"/>
                        <Button Tag="#F97316" Background="#F97316" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#F97316"/>
                        <Button Tag="#EAB308" Background="#EAB308" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#EAB308"/>
                        <Button Tag="#22C55E" Background="#22C55E" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#22C55E"/>
                        <Button Tag="#14B8A6" Background="#14B8A6" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#14B8A6"/>
                        <Button Tag="#06B6D4" Background="#06B6D4" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#06B6D4"/>
                        <Button Tag="#64748B" Background="#64748B" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#64748B"/>
                        <Button Tag="#111827" Background="#111827" Height="30" Margin="2" Click="AccentSwatch_Click" ToolTip="#111827"/>
                    </UniformGrid>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <TextBlock Text="R" VerticalAlignment="Center"/>
                        <Slider x:Name="AccentRSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="AccentRgbSlider_ValueChanged"/>
                        <TextBlock x:Name="AccentRText" Grid.Column="2" Text="76" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <TextBlock Text="G" VerticalAlignment="Center"/>
                        <Slider x:Name="AccentGSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="AccentRgbSlider_ValueChanged"/>
                        <TextBlock x:Name="AccentGText" Grid.Column="2" Text="154" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <TextBlock Text="B" VerticalAlignment="Center"/>
                        <Slider x:Name="AccentBSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="AccentRgbSlider_ValueChanged"/>
                        <TextBlock x:Name="AccentBText" Grid.Column="2" Text="255" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border x:Name="AccentPickerPreview" Width="38" Height="30" CornerRadius="6" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"/>
                        <Button Content="使用 RGB 颜色" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="AccentPickerUse_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="选择预设主题会立即预览对应配色；选择“自定义”只展开下方调色区域，选定颜色后才算真正修改。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <!-- 自动循环：开启后由系统时间自动决定深浅色模式，不需要手动点主界面的
                 「模式设置」按钮。这两个小时数只在这里设置，主界面按钮只负责开关这个功能
                 本身和临时手动覆盖。 -->
            <TextBlock Text="{DynamicResource Str_Ui_Auto_Light_Dark_Cycle}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Enables_The_Auto_Cycle_Button_On_The_Mai}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <Grid Margin="0,0,0,4" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Ui_Light_Mode_Starts_At}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="AutoThemeLightStartHourCombo" Grid.Column="1" Padding="8" MinWidth="70"
                          ToolTip="{DynamicResource Str_Ui_Switch_To_Light_Mode_At_This_Hour_Each_D}"/>
                <TextBlock Grid.Column="3" Text="{DynamicResource Str_Ui_Dark_Mode_Starts_At}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="AutoThemeDarkStartHourCombo" Grid.Column="4" Padding="8" MinWidth="70"
                          ToolTip="{DynamicResource Str_Ui_Switch_To_Dark_Mode_At_This_Hour_Each_Da}"/>
            </Grid>
            <TextBlock Text="{DynamicResource Str_Ui_Default_Light_Mode_From_08_00_To_19_00_A}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <!-- 万能皮肤补丁(authlib-injector) 使用的皮肤服务地址：默认使用内置公共服务，
                 有自己皮肤站的用户可以在这里替换成自己的 API Root。只影响"离线账户选择了
                 自定义皮肤"这一种场景，史蒂夫/艾利克斯默认皮肤不受影响。 -->
            <TextBlock Text="{DynamicResource Str_Ui_Offline_Skin_Service_Url_Customskinloade}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SkinApiRootBox" Grid.Column="0" Padding="8" Margin="0,0,8,0"
                         ToolTip="{DynamicResource Str_Ui_Offline_Accounts_Set_To_Use_A_Custom_Ski}"/>
                <!-- 需求：皮肤站可以自动 API 查询，不用手动查完整 API Root 再填。
                     只需要填皮肤站主页地址（如 littleskin.cn），点这个按钮自动探测出真正的
                     API Root（复用登录页"认证服务器登录"同一套探测逻辑，见
                     AuthServerAuthService.DetectApiRootAsync），探测成功直接回填输入框，
                     不需要用户自己去皮肤站后台/文档里翻 API 地址。 -->
                <Button x:Name="DetectSkinApiRootBtn" Grid.Column="1" Content="自动检测"
                        Style="{StaticResource SecondaryButton}" Padding="12,8" Click="DetectSkinApiRoot_Click"/>
            </Grid>
            <TextBlock Text="{DynamicResource Str_Ui_Only_Affects_Offline_Accounts_Set_To_Use}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="填皮肤站主页地址后点「自动检测」即可自动查出完整 API 地址；也可以直接手动填写完整 API Root。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <!-- AI 助手设置入口 -->
            <TextBlock Text="AI 助手" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="配置 API Key、模型档位、上下文压缩、悬浮球显示等" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <Button x:Name="AiAssistantSettingsBtn" Content="AI 助手设置" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Padding="14,8" Click="AiAssistantSettingsBtn_Click" Margin="0,0,0,20"/>

            <!-- 实验性功能入口：第一次点击会先弹一个不能跳过、强制等待 10 秒的确认窗口
                 （ExperimentalGateWindow），确认过一次之后（cfg.ExperimentalFeaturesUnlocked=true）
                 之后再点直接打开实验性功能面板，不需要每次都重新等待。
                 换肤功能已经全部做完，不再放在这里面（见上面「配色皮肤」区块），
                 这里现在只剩"初步测试版"这一层更不成熟的功能（比如多加载器合装）。 -->
            <TextBlock Text="{DynamicResource Str_Nav_Experimental}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Contains_Features_Still_In_Development_O}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <Button x:Name="ExperimentalFeaturesBtn" Content="{DynamicResource Str_Ui_Experimental_Features}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Padding="14,8" Click="ExperimentalFeatures_Click" Margin="0,0,0,20"/>


            <!-- 下载性能：多线程下载 + 限速。默认多线程开启(8线程)、不限速——大多数用户不需要动这里，
                 只有网络环境特殊（比如共享宽带、怕抢占其他人/其他程序带宽）的用户才需要调整。
                 三项是独立开关：可以只开多线程不限速，也可以关掉多线程但仍然手动限速（限速对
                 单线程场景同样生效，只是此时"总速度"等于"这一个连接的速度"）。 -->
            <TextBlock Text="{DynamicResource Str_Ui_Download_Performance}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <CheckBox x:Name="MultiThreadDownloadCheck" Content="{DynamicResource Str_Ui_Enable_Multi_Threaded_Downloads_Fetches_}"
                      Margin="0,0,0,8" Checked="MultiThreadDownloadCheck_Changed" Unchecked="MultiThreadDownloadCheck_Changed"/>
            <StackPanel x:Name="ThreadCountPanel" Orientation="Horizontal" Margin="20,0,0,8">
                <TextBlock Text="{DynamicResource Str_Ui_Threads}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ThreadCountBox" Width="60" Padding="6"/>
                <TextBlock Text="{DynamicResource Str_Ui_1_32_Recommended_Default_8}" VerticalAlignment="Center" Margin="8,0,0,0"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource Str_Ui_Download_Limit_Kb_S_0_Unlimited}" Margin="0,0,0,4"/>
            <TextBox x:Name="SpeedLimitBox" Width="120" Padding="8" Margin="0,0,0,4" HorizontalAlignment="Left"/>
            <TextBlock Text="{DynamicResource Str_Ui_The_Limit_Applies_To_All_Connections_Com}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <CheckBox x:Name="SmartThrottleCheck"
                      Content="{DynamicResource Str_Ui_Smart_Throttling_Watches_What_Other_Prog}"
                      Margin="0,0,0,20"/>

            <!-- 下载完成后提示方式：下载完成后是否弹出气泡提示、仅显示角标还是使用Windows通知。
                 分类设置：游戏版本、社区资源、整合包各自独立开关，互不影响。 -->
            <TextBlock Text="下载完成后提示" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <CheckBox x:Name="GameVersionNoPopupCheck" Content="游戏版本下载完成后不弹窗提示"
                      Margin="0,0,0,4"/>
            <TextBlock Text="（已装的版本不会再次弹出完成提示）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-2,0,0"/>
            <CheckBox x:Name="CommunityResourceNoPopupCheck" Content="社区资源下载完成后不弹窗提示"
                      Margin="0,0,0,4"/>
            <TextBlock Text="（Mod/材质包/地图等）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-2,0,0"/>
            <CheckBox x:Name="ModpackNoPopupCheck" Content="整合包下载完成后不弹窗提示"
                      Margin="0,0,0,4"/>
            <TextBlock Text="（整合包安装完成后不会再次弹出）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-2,0,0"/>
            <ComboBox x:Name="DownloadNotifyModeCombo" Width="160" Margin="0,4,0,4" HorizontalAlignment="Left">
                <ComboBoxItem Content="气泡提示" Tag="0" IsSelected="True"/>
                <ComboBoxItem Content="仅显示角标" Tag="1"/>
                <ComboBoxItem Content="Windows 通知" Tag="2"/>
                <ComboBoxItem Content="不提示（完全静默）" Tag="3"/>
            </ComboBox>

            <!-- 社区资源下载后的文件命名样式：查到中文名（见 ModDisplayNameResolver）时，
                 按这里选的样式把中文名拼进文件名；查不到中文名时不管选哪种样式都只用原始文件名。 -->
            <TextBlock Text="社区资源文件命名" FontSize="14" FontWeight="Bold" Margin="0,16,0,4"/>
            <TextBlock Text="下载 Mod 后，如果能查到中文名，用什么格式拼进文件名（查不到中文名时始终使用原始文件名）"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <ComboBox x:Name="ModFileNamingStyleCombo" Width="220" Margin="0,0,0,4" HorizontalAlignment="Left">
                <ComboBoxItem Content="【中文名】原始文件名" Tag="FullBracket"/>
                <ComboBoxItem Content="[中文名] 原始文件名" Tag="SquareBracket" IsSelected="True"/>
                <ComboBoxItem Content="中文名-原始文件名" Tag="DashPrefix"/>
                <ComboBoxItem Content="原始文件名-中文名" Tag="DashSuffix"/>
                <ComboBoxItem Content="保持原始文件名" Tag="Original"/>
            </ComboBox>

            <!-- 下载列表详情：标题栏下载气泡（点右上角下载图标弹出的那个列表）里是否额外
                 显示一行"剩余时间/当前速度/大小"，开启后气泡整体放大60%留出空间，
                 见 AppConfig.DownloadPopupShowDetailStats / DownloadPopupSizeDisplayMode
                 和 MainWindow.ApplyDownloadPopupDetailMode。 -->
            <TextBlock Text="下载列表详情" FontSize="14" FontWeight="Bold" Margin="0,12,0,4"/>
            <CheckBox x:Name="DownloadPopupDetailCheck" Content="下载列表显示剩余时间/当前速度/大小（列表会放大60%）"
                      Margin="0,0,0,4"/>
            <ComboBox x:Name="DownloadPopupSizeModeCombo" Width="200" Margin="0,0,0,4" HorizontalAlignment="Left">
                <ComboBoxItem Content="显示剩余大小" Tag="0" IsSelected="True"/>
                <ComboBoxItem Content="显示已下载大小" Tag="1"/>
                <ComboBoxItem Content="两者都显示" Tag="2"/>
            </ComboBox>

            <!-- 功能隐藏：勾选的功能项在界面上不再显示（导航按钮/子页面按钮/特定功能入口）。
                 分组和 key 定义在 Services/FeatureVisibilityService.cs 里，这里用 ItemsControl
                 动态渲染，不用为每个功能手写一个 CheckBox——新增/删减功能项时只改那边的 C# 数组，
                 这里的 XAML 不用跟着改。按 F12 可以在任意界面临时把隐藏的功能全部显示出来
                 （不影响这里的勾选状态，只是"临时看得见"，见 MainWindow 的全局按键处理）。 -->
            <TextBlock Text="{DynamicResource Str_Ui_Hide_Features}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_You_Can_Hide_Pages_You_Don_T_Need_Or_Swi}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <ItemsControl x:Name="FeatureHideList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding GroupLabel}" Width="110" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" Tag="{Binding Key}"
                                                  Margin="0,0,16,6" Checked="FeatureHideCheck_Changed"
                                                  Unchecked="FeatureHideCheck_Changed"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 协议：只读查看当前协议全文（不影响任何配置），以及"注销应用"——主动放弃已同意的
                 协议状态，下次启动会重新走一遍协议流程。两者都对应 AgreementsWindow/AppConfig 里
                 已有的协议版本号机制，见各自 Click 处理函数上的注释。 -->
            <TextBlock Text="协议与账户" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="ReadAgreementsButton" Content="阅读协议" Padding="14,8" Click="ReadAgreements_Click"/>
                <Button x:Name="DeregisterButton" Content="注销应用（暂时不同意协议）" Padding="14,8" Margin="8,0,0,0"
                        Click="Deregister_Click"/>
            </StackPanel>

            <!-- 正版账户令牌保留时效：见 AppConfig.AccountTokenGracePeriodDays 与
                 MainWindow 里微软账户刷新失败后的降级处理。0 = 关闭这个降级。 -->
            <TextBlock Text="正版账户令牌保留时效" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="微软账户令牌过期且暂时联系不上认证服务器时，只要账户最近一次成功验证距今不超过这个天数，就允许直接用本地缓存的正版信息离线启动（0 = 关闭，服务不可用时直接要求重新登录）。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBox x:Name="AccountTokenGraceDaysBox" Width="80" Padding="8"/>
                <TextBlock Text="天" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 注册表功能：见 RegistryConfigService / RegistrySyncedFields / ConfigService 里
                 危险操作三个方法的详细注释。这里只是把已有能力接到界面上。 -->
            <TextBlock Text="注册表存储" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="部分设置（是否同意协议、基本模式、配色等）会同时保存到 Windows 注册表 HKEY_LOCAL_MACHINE\SOFTWARE\XCL2（或当前用户分支），跟 config.json 互为镜像，其中一处丢失时仍能从另一处恢复。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <CheckBox x:Name="UseMachineWideRegistryCheck" Content="使用全设备范围（HKEY_LOCAL_MACHINE，需要以管理员身份运行才会真正生效，未提权时自动改写当前用户分支）"
                      Margin="0,0,0,4"/>
            <TextBlock x:Name="RegistryStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,10" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,0,0,10">
                <Button x:Name="UpdateConfigDefaultsBtn" Content="更新配置文件" Padding="14,8" Margin="0,0,8,8"
                        ToolTip="把新版本引入的设置默认值补丁进当前配置，不会覆盖你已经改过的任何设置"
                        Click="UpdateConfigDefaults_Click"/>
                <Button x:Name="ExportRegBtn" Content="导出注册表 (.reg)" Padding="14,8" Margin="0,0,8,8" Click="ExportReg_Click"/>
                <Button x:Name="ExportAllConfigBtn" Content="导出所有配置" Padding="14,8" Margin="0,0,8,8" Click="ExportAllConfig_Click"/>
                <Button x:Name="ImportConfigBtn" Content="导入配置" Padding="14,8" Margin="0,0,8,8" Click="ImportConfig_Click"/>
            </WrapPanel>
            <!-- 拖拽导入：把导出的 .xclconfig.json 归档文件直接拖到这个区域即可，
                 跟点"导入配置"按钮走同一套解析/写回逻辑（见 SettingsPage.xaml.cs 的
                 ImportConfigArchiveFile 方法），只是入口多一种。 -->
            <Border x:Name="ImportDropZone" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14" Margin="0,0,0,20"
                    AllowDrop="True" Drop="ImportDropZone_Drop" DragOver="ImportDropZone_DragOver">
                <TextBlock Text="也可以把「导出所有配置」生成的归档文件拖到这里直接导入" HorizontalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>

            <!-- 帮助/小贴士：一些不太好从界面本身看出来的行为，集中放在这里说明，
                 免得用户翻文档或者猜。目前只有 .NOXCL 这一条，以后陆续增加同类条目
                 可以继续往这个 StackPanel 里加 TextBlock，不用专门开新分区。 -->
            <TextBlock Text="帮助" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="排除某个目录不被自动扫描到" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="在某个文件夹目录下新建一个名为 "/>
                        <Run Text=".NOXCL" FontFamily="Consolas" FontWeight="Bold"/>
                        <Run Text=" 的文件或文件夹（内容不重要，存在即可），启动器下次自动扫描时就会跳过这个目录，不会把它当成 .minecraft 目录自动收进列表，也不会再往它内部继续查找。如果是通过「添加已有文件夹」手动加进来的，不受这个标记影响，依然可以正常启动、管理。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="危险操作" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="以下操作需要输入确认码 xztx127 才能执行，且都不可撤销；只会影响 XCL2 自身的配置/注册表数据，不会触碰 .minecraft 游戏目录或系统其它设置。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,0,0,20">
                <Button x:Name="DisableRegistryBtn" Content="关闭注册表功能" Padding="14,8" Margin="0,0,8,8" Click="DisableRegistry_Click"/>
                <Button x:Name="DeleteRegistryBtn" Content="删除所有新增的启动器注册表项" Padding="14,8" Margin="0,0,8,8" Click="DeleteRegistry_Click"/>
                <Button x:Name="ClearTracesBtn" Content="清除本机痕迹" Padding="14,8" Margin="0,0,8,8" Click="ClearTraces_Click"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" Margin="0,0,0,8">
                <Button Content="{DynamicResource Str_Ui_Save_Settings}" Style="{StaticResource PrimaryButton}" MinWidth="140" Padding="18,9" Click="Save_Click" Margin="0,0,10,6"/>
                <Button Content="一键恢复到默认设置" Style="{StaticResource SecondaryButton}" MinWidth="190" Padding="18,9" Click="ResetToDefaults_Click" Margin="0,0,0,6"
                        ToolTip="恢复启动器设置为默认值"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
