<Window x:Class="XCL2.App.Views.ModDependencyWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现前置模组问题" Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="⚠ 发现了问题" FontSize="18" FontWeight="Bold" Foreground="#D9822B"/>
            <TextBlock Text="下面这些 Mod 缺少运行必需的前置模组，直接启动游戏大概率会闪退或卡在加载界面。"
                       TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="查看日志" Style="{StaticResource SideNavButton}" Padding="14,8" Margin="0,0,8,0" Click="ViewLogs_Click"/>
            <Button Content="提交问题报告" Style="{StaticResource SideNavButton}" Padding="14,8" Margin="0,0,8,0" Click="SubmitReport_Click"/>
            <Button Content="我知道了，仍要继续" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="Continue_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MissingList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SideBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <Run Text="缺少前置模组："/><Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="被以下 Mod 依赖："/><Run Text="{Binding RequiredByText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                           Text="{Binding VersionHint, Mode=OneWay}"/>

                                <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,8" TextWrapping="Wrap">
                                    <Run Text="解决方法：下载并安装这个前置模组之后再启动，或者删除依赖它的那些 Mod。"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="下载这个前置模组" Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="0,0,8,0"
                                            Tag="{Binding}" Click="DownloadDependency_Click"
                                            IsEnabled="{Binding CanDownload}"/>
                                    <Button Content="删除依赖它的 Mod" Padding="10,6"
                                            Tag="{Binding}" Click="DeleteDependents_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
