<local:OverlayDialogControl x:Class="XCL2.App.Views.ModDependencyWarningWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="620"
                            MaxWidth="620"
                            MinHeight="520"
                            MaxHeight="520">
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Str_Ui_Problems_Found}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}"/>
            <TextBlock Text="{DynamicResource Str_Ui_The_Mods_Below_Are_Missing_Required_Depe}"
                       TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Str_Ui_View_Log}" Style="{StaticResource SideNavButton}" Padding="14,8" Margin="0,0,8,0" Click="ViewLogs_Click"/>
            <Button Content="{DynamicResource Str_Ui_Report_An_Issue}" Style="{StaticResource SideNavButton}" Padding="14,8" Margin="0,0,8,0" Click="SubmitReport_Click"/>
            <Button Content="{DynamicResource Str_Ui_I_Understand_Continue_Anyway}" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="Continue_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
            <ItemsControl x:Name="MissingList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <Run Text="{DynamicResource Str_Ui_Missing_Dependency}"/><Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{DynamicResource Str_Ui_Required_By_These_Mods}"/><Run Text="{Binding RequiredByText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                                           Text="{Binding VersionHint, Mode=OneWay}"/>

                                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,8" TextWrapping="Wrap">
                                    <Run Text="{DynamicResource Str_Ui_Fix_Install_This_Dependency_And_Then_Lau}"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Str_Ui_Download_This_Dependency}" Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="0,0,8,0"
                                            Tag="{Binding}" Click="DownloadDependency_Click"
                                            IsEnabled="{Binding CanDownload}"/>
                                    <Button Content="{DynamicResource Str_Ui_Remove_The_Mods_That_Need_It}" Padding="10,6"
                                            Tag="{Binding}" Click="DeleteDependents_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</local:OverlayDialogControl>
