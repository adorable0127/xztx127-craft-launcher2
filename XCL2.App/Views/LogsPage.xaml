<UserControl x:Class="XCL2.App.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Str_Nav_Logs}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <CheckBox x:Name="ShowLogCheck" Content="{DynamicResource Str_Ui_Show_The_Log_Panel_Hidden_By_Default_Tic}"
                          Margin="20,0,0,0" VerticalAlignment="Center" Checked="ShowLogCheck_Changed" Unchecked="ShowLogCheck_Changed"/>
            </StackPanel>

            <Grid Grid.Row="1" Visibility="{Binding Visibility, ElementName=LogTabs}">
                <TabControl x:Name="LogTabs" Visibility="Collapsed">
                    <TabItem Header="{DynamicResource Str_Ui_Game_Log}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                                <TextBlock Text="{DynamicResource Str_Ui_Choose_A_Running_Or_Recent_Game_Process}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ProcessCombo" Width="220" Margin="8,0,8,0"
                                          SelectionChanged="ProcessCombo_SelectionChanged"/>
                                <Button Content="{DynamicResource Str_Common_Refresh}" Style="{StaticResource SideNavButton}" Padding="10,4" Click="RefreshGameLog_Click"/>
                                <!-- 需求：游戏崩溃后日志不应该瞬间清空/消失，要保留到用户自己点这个按钮手动清空为止。
                                 这个按钮只清空"当前这个视图里显示的文本"，不会动 GameProcessInfo.OutputBuffer
                                 本身（那份缓冲区是进程管理/其它面板还要用的底层数据），也不会影响磁盘上的
                                 latest.log —— 纯粹是这一个 TextBox 的可见内容归零，语义上等价于"清屏"。 -->
                                <Button Content="{DynamicResource Str_Ui_Clear_This_View}" Style="{StaticResource SideNavButton}" Padding="10,4" Margin="8,0,0,0" Click="ClearGameLogView_Click"/>
                                <Button Content="AI 分析当前游戏日志" Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="8,0,0,0"
                                        ToolTip="将当前游戏日志脱敏后提交给已配置的 AI 服务分析" Click="AnalyzeCurrentGameLogWithAi_Click"/>
                            </WrapPanel>
                            <TextBox x:Name="GameLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource Str_Ui_Launcher_Log}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                                <Button Content="{DynamicResource Str_Common_Refresh}" Style="{StaticResource SideNavButton}" Padding="10,4"
                                        Click="RefreshLauncherLog_Click"/>
                                <Button Content="AI 分析启动器日志" Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="8,0,0,0"
                                        ToolTip="将当前启动器异常日志脱敏后提交给已配置的 AI 服务分析" Click="AnalyzeLauncherLogWithAi_Click"/>
                            </WrapPanel>
                            <TextBox x:Name="LauncherLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        </Grid>
                    </TabItem>

                <TabItem Header="{DynamicResource Str_Ui_Crash_Report_Analysis}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                            <TextBlock Text="{DynamicResource Str_Ui_Crash_File}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CrashFileCombo" Width="300" Margin="8,0,8,0"
                                      SelectionChanged="CrashFileCombo_SelectionChanged"/>
                            <Button Content="{DynamicResource Str_Ui_Rescan}" Style="{StaticResource SideNavButton}" Padding="10,4" Click="RescanCrash_Click"/>
                            <Button Content="AI 分析崩溃报告" Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="8,0,0,0"
                                    ToolTip="需要先在 AI 助手设置中允许读取崩溃报告" Click="AnalyzeCrashLogWithAi_Click"/>
                        </WrapPanel>
                        <Border Grid.Row="1" Background="{DynamicResource WarningBannerBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <TextBlock x:Name="CrashFindingsText" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{DynamicResource Str_Ui_Pick_A_Crash_File_Above_And_The_Automati}"/>
                        </Border>
                        <TextBox x:Name="CrashRawBox" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Str_Ui_Injection_Scan}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                            <TextBlock Text="{DynamicResource Str_Ui_Select_A_Running_Game_Process}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ScanProcessCombo" Width="220" Margin="8,0,8,0"/>
                            <Button Content="{DynamicResource Str_Ui_Scan_Now}" Style="{StaticResource PrimaryButton}" Padding="12,4" Click="ScanNow_Click"/>
                            <Button Content="AI 分析注入日志" Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="8,0,0,0"
                                    ToolTip="先执行注入检测，再将扫描结果提交给 AI 分析" Click="AnalyzeInjectionLogWithAi_Click"/>
                        </WrapPanel>
                        <!-- 修复"注入检测结果列表不管深色/浅色主题永远是白底黑字"：ListView 在这个项目里
                             没有任何全局隐式样式（跟 Button/CheckBox/ComboBox 不一样，App.xaml 里没有
                             针对 ListView/GridView 的模板），所以走的是 WPF 默认的系统 Aero 白色列表样式，
                             完全不跟随 ThemeService 切换的深浅色/色系。这里显式绑定面板画刷 + 文字画刷，
                             并给 ListViewItem/GridViewColumnHeader 各自补一个跟随主题的最小样式，
                             让这个列表跟页面其它地方一样能正确显示深色模式。 -->
                        <ListView x:Name="ModuleListView" Grid.Row="1"
                                  Background="{DynamicResource PanelBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Risk}" Width="70" DisplayMemberBinding="{Binding RiskLabel}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Module_File}" Width="180" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Matched_Rule}" Width="200" DisplayMemberBinding="{Binding MatchedRule}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Vendor}" Width="120" DisplayMemberBinding="{Binding CompanyName}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Path}" Width="260" DisplayMemberBinding="{Binding FullPath}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Str_Ui_Full_Launcher_Log}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button Content="{DynamicResource Str_Common_Refresh}" Style="{StaticResource SideNavButton}" Padding="10,4"
                                    Click="RefreshFullLauncherLog_Click"/>
                            <!-- 需求："在选择完整启动器日志的页面，加入一个按钮，可以独立出一个启动器日志，
                                 不依附于咱们的进程。这样的话，就可以在进行启动器操作的时候查看日志"。
                                 见 LauncherLogWindowService 类头注释：这里弹出的是一个真正独立的 cmd 进程，
                                 不是同进程内的第二个 WPF 窗口，主窗口卡死/被关闭都不会影响它。 -->
                            <Button Content="{DynamicResource Str_Ui_Open_In_Independent_Window}" Style="{StaticResource SideNavButton}" Padding="10,4"
                                    Margin="10,0,0,0" Click="OpenLauncherLogInIndependentWindow_Click"/>
                            <Button Content="AI 分析完整日志" Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="10,0,0,0"
                                    ToolTip="汇总当前会话与磁盘日志，脱敏并提交给 AI 分析" Click="AnalyzeFullLauncherLogWithAi_Click"/>
                        </StackPanel>
                        <TextBox x:Name="FullLauncherLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </Grid>
                </TabItem>
                </TabControl>
            </Grid>

            <TextBlock x:Name="HiddenHint" Grid.Row="1" Text="{DynamicResource Str_Ui_The_Log_Panel_Is_Hidden_Tick_The_Box_Abo}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,20,0,0"/>
        </Grid>
    </Border>
</UserControl>
