<UserControl x:Class="XCL2.App.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="日志" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <CheckBox x:Name="ShowLogCheck" Content="显示日志面板（默认不显示，勾选后小白模式也能查看）"
                          Margin="20,0,0,0" VerticalAlignment="Center" Checked="ShowLogCheck_Changed" Unchecked="ShowLogCheck_Changed"/>
            </StackPanel>

            <TabControl x:Name="LogTabs" Grid.Row="1" Visibility="Collapsed">
                <TabItem Header="🎮 游戏日志">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                            <TextBlock Text="选择正在运行/最近的游戏进程：" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ProcessCombo" Width="260" Margin="8,0,8,0"
                                      SelectionChanged="ProcessCombo_SelectionChanged"/>
                            <Button Content="刷新" Style="{StaticResource SideNavButton}" Padding="10,4" Click="RefreshGameLog_Click"/>
                        </StackPanel>
                        <TextBox x:Name="GameLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </Grid>
                </TabItem>

                <TabItem Header="🖥 启动器日志">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="刷新" Style="{StaticResource SideNavButton}" Padding="10,4"
                                HorizontalAlignment="Left" Margin="0,8,0,8" Click="RefreshLauncherLog_Click"/>
                        <TextBox x:Name="LauncherLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </Grid>
                </TabItem>

                <TabItem Header="💥 崩溃报告分析">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                            <TextBlock Text="崩溃文件：" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CrashFileCombo" Width="360" Margin="8,0,8,0"
                                      SelectionChanged="CrashFileCombo_SelectionChanged"/>
                            <Button Content="重新扫描" Style="{StaticResource SideNavButton}" Padding="10,4" Click="RescanCrash_Click"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#FFF7E6" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <TextBlock x:Name="CrashFindingsText" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="选择上方的崩溃文件后，这里会显示自动分析出的中文提示。"/>
                        </Border>
                        <TextBox x:Name="CrashRawBox" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </Grid>
                </TabItem>

                <TabItem Header="🛡 注入检测">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                            <TextBlock Text="选择正在运行的游戏进程：" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ScanProcessCombo" Width="260" Margin="8,0,8,0"/>
                            <Button Content="立即扫描" Style="{StaticResource PrimaryButton}" Padding="12,4" Click="ScanNow_Click"/>
                        </StackPanel>
                        <ListView x:Name="ModuleListView" Grid.Row="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="风险" Width="70" DisplayMemberBinding="{Binding RiskLabel}"/>
                                    <GridViewColumn Header="模块文件名" Width="180" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="命中规则" Width="200" DisplayMemberBinding="{Binding MatchedRule}"/>
                                    <GridViewColumn Header="厂商" Width="120" DisplayMemberBinding="{Binding CompanyName}"/>
                                    <GridViewColumn Header="路径" Width="260" DisplayMemberBinding="{Binding FullPath}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="HiddenHint" Grid.Row="1" Text="日志面板当前已隐藏。勾选上方复选框可查看游戏日志、启动器日志、崩溃分析和注入检测。"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,20,0,0"/>
        </Grid>
    </Border>
</UserControl>
