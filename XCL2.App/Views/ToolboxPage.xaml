                                    <ComboBoxItem Content="survival（生存）"/>
                                    <ComboBoxItem Content="creative（创造）"/>
                                    <ComboBoxItem Content="adventure（冒险）"/>
                                    <ComboBoxItem Content="spectator（旁观）"/>
