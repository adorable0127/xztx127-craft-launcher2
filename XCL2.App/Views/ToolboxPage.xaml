                                <TextBlock Text="时间" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmdTimeCombo" Width="200" HorizontalAlignment="Left" Margin="0,0,0,10" SelectedIndex="0" SelectionChanged="CmdGenOption_Changed">
