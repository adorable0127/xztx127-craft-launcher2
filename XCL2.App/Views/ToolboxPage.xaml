                            </Border>
                            <Button Content="复制指令" Padding="12,6" HorizontalAlignment="Left" Click="CmdGenCopy_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 21：Base64 编码/解码 ===== -->
                <TabItem Header="Base64编解码">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="Base64 文本编码 / 解码" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="通用文本工具，跟 Minecraft 本身没有强绑定——皮肤站接口返回值、部分 Mod 的配置字段偶尔会用到 Base64，这里可以直接互转，按 UTF-8 处理文本。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="原文" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="B64PlainBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Padding="8" Margin="0,0,0,10" TextChanged="B64PlainBox_TextChanged"/>

                            <TextBlock Text="Base64" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="B64EncodedBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Padding="8" Margin="0,0,0,10" FontFamily="Consolas" TextChanged="B64EncodedBox_TextChanged"/>

                            <TextBlock x:Name="B64StatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="复制 Base64" Padding="12,6" Margin="0,0,10,0" Click="B64CopyEncoded_Click"/>
                                <Button Content="复制原文" Padding="12,6" Margin="0,0,10,0" Click="B64CopyPlain_Click"/>
                                <Button Content="清空" Padding="12,6" Click="B64Clear_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 22：游戏内时间换算器 ===== -->
                <TabItem Header="游戏时间换算">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="游戏内时间 / 现实时间换算" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Minecraft 里一个整天是 24000 tick，按 20 tick/秒运行，正好对应现实 20 分钟——填游戏 tick（比如 /time query daytime 查到的数值）能换算出对应现实分钟数和大致时刻（0 点=日出），也支持反过来从现实分钟数推算 tick。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="游戏 Tick（0 ~ 23999）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="GtTickBox" Width="160" HorizontalAlignment="Left" Padding="6,5" Text="0" Margin="0,0,0,14" TextChanged="GtTickBox_TextChanged"/>

                            <TextBlock Text="现实分钟数（从当天日出开始算）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="GtMinuteBox" Width="160" HorizontalAlignment="Left" Padding="6,5" Margin="0,0,0,14" TextChanged="GtMinuteBox_TextChanged"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="GtResultText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 23：物品堆叠 / 箱子格子计算器 ===== -->
                <TabItem Header="堆叠格子计算器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="物品数量 / 箱子格子换算" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="填物品总数和每组堆叠上限（大多数物品是 64，药水/装备/工具等不可堆叠物品填 1），算出需要多少组、多少个单箱（27 格）和双箱（54 格）才装得下。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="物品总数" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="StackCountBox" Width="160" HorizontalAlignment="Left" Padding="6,5" Text="1000" Margin="0,0,0,14" TextChanged="StackCalc_TextChanged"/>

                            <TextBlock Text="每组堆叠上限" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="StackSizeCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,14" SelectedIndex="0" SelectionChanged="StackCalc_SelectionChanged">
                                <ComboBoxItem Content="64（大多数物品）"/>
                                <ComboBoxItem Content="16（雪球/鸡蛋/告示牌等）"/>
                                <ComboBoxItem Content="1（工具/装备/药水等）"/>
                            </ComboBox>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="StackResultText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 24：RGB 转 MC 文本颜色代码 ===== -->
                <TabItem Header="RGB颜色转换">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="RGB / 十六进制 转 Minecraft 文本颜色代码" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="1.16 以后聊天文本、书本、记分板支持任意 RGB 自定义颜色，格式是 &amp;#RRGGBB（部分服务端插件用 &amp;x&amp;R&amp;R&amp;G&amp;G&amp;B&amp;B 这种逐字符写法，下面两种都给出）。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="十六进制颜色（如 FF8800，不带 #）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="RgbHexBox" Width="200" HorizontalAlignment="Left" Padding="6,5" Text="FF8800" Margin="0,0,0,14" TextChanged="RgbConvert_TextChanged"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <Border x:Name="RgbSwatch" Height="36" CornerRadius="4"/>
                            </Border>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="&amp;#RRGGBB 格式" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="RgbShortText" FontSize="14" FontFamily="Consolas" Margin="0,0,0,8"/>
                                    <TextBlock Text="&amp;x 逐字符格式" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="RgbLongText" FontSize="14" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 25：红石中继器延时计算器 ===== -->
                <TabItem Header="红石延时计算器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="红石中继器链延时计算" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="每个中继器有 1~4 档延时，每档 1 红石 tick（0.1 秒，游戏内 2 游戏 tick）。填中继器个数和每个用第几档，算出这一串总共延时多少红石 tick、多少秒——搭时序电路/自动农场常用。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="中继器数量" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="RedstoneCountBox" Width="160" HorizontalAlignment="Left" Padding="6,5" Text="4" Margin="0,0,0,14" TextChanged="RedstoneCalc_TextChanged"/>

                            <TextBlock Text="每个的档位（1~4）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="RedstoneTickCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,14" SelectedIndex="0" SelectionChanged="RedstoneCalc_SelectionChanged">
                                <ComboBoxItem Content="1 档（最短）"/>
                                <ComboBoxItem Content="2 档"/>
                                <ComboBoxItem Content="3 档"/>
                                <ComboBoxItem Content="4 档（最长）"/>
                            </ComboBox>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="RedstoneResultText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 26：随机玩家名生成器 ===== -->
                <TabItem Header="随机玩家名生成器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="随机玩家名生成器" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="纯本地按词根拼接生成，只保证符合 Minecraft 用户名规则（3~16 位，仅字母/数字/下划线），不保证这个名字在正版没被注册，正式使用前建议自己去核实一下是否可用。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="NameGenBtn" Content="生成一批（8 个）" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="NameGen_Click"/>
                            </StackPanel>

                            <ItemsControl x:Name="NameGenList"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 27：服务器 MOTD 长度检查器 ===== -->
                <TabItem Header="MOTD长度检查">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="服务器 MOTD 长度 / 换行检查" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="server.properties 里的 motd 每行在多人游戏列表通常只能显示约 45 个西文字符（中文按 2 个宽度算），超出会被截断或挤压显示；用 \n 表示换行，最多两行。下面按输入内容实时估算每行显示宽度是否超限。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="MOTD 内容（用 \n 表示换行）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="MotdInputBox" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="50" Padding="8" Margin="0,0,0,10"
                                     Text="§6我的服务器\n§a欢迎加入游玩！" TextChanged="MotdInputBox_TextChanged"/>

                            <ItemsControl x:Name="MotdLineList"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 28：时间戳转换器 ===== -->
                <TabItem Header="时间戳转换器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="Unix 时间戳 / 日期时间互转" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="服务器日志、崩溃报告、部分 Mod 配置里常见的是秒级或毫秒级 Unix 时间戳，这里按本机所在时区互相换算，方便对照日志时间线。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="Unix 时间戳（自动识别秒/毫秒）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBox x:Name="TsInputBox" Width="220" Padding="6,5" TextChanged="TsInputBox_TextChanged"/>
                                <Button Content="填入当前时间" Padding="10,5" Margin="8,0,0,0" Click="TsNow_Click"/>
                            </StackPanel>

                            <TextBlock Text="本地日期时间（yyyy-MM-dd HH:mm:ss）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TsDateBox" Width="220" HorizontalAlignment="Left" Padding="6,5" Margin="0,0,0,14" TextChanged="TsDateBox_TextChanged"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="TsResultText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 29：服务器地址解析器 ===== -->
                <TabItem Header="服务器地址解析">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="服务器地址解析 / 格式校验" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="粘贴 host:port 或纯域名/IP，拆出主机名和端口并做基本格式校验（端口范围、IPv4 格式），添加服务器之前先确认一下格式没写错。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="服务器地址" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="AddrParseInputBox" Margin="0,0,0,14" Padding="6,5" Text="play.example.com:25565" TextChanged="AddrParseInputBox_TextChanged"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="主机名 / IP" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="AddrParseHostText" FontSize="14" FontFamily="Consolas" Margin="0,0,0,8"/>
                                    <TextBlock Text="端口" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="AddrParsePortText" FontSize="14" FontFamily="Consolas" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="AddrParseStatusText" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 30：药水持续时间换算 ===== -->
                <TabItem Header="药水时长换算">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="药水效果持续时间换算" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="/effect give 指令里的时间参数单位是秒，游戏内部按 tick（20 tick=1 秒）计时，这里互相换算，同时给出常见的延长型/浓缩型药水时长参考倍率提示。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="秒" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PotionSecBox" Width="160" HorizontalAlignment="Left" Padding="6,5" Text="180" Margin="0,0,0,14" TextChanged="PotionSecBox_TextChanged"/>

                            <TextBlock Text="游戏 Tick" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PotionTickBox" Width="160" HorizontalAlignment="Left" Padding="6,5" Margin="0,0,0,14" TextChanged="PotionTickBox_TextChanged"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="PotionResultText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 31：颜色代码速查表 ===== -->
                <TabItem Header="颜色代码速查表">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="Java 版聊天颜色 / 格式代码对照表" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="纯静态参考，跟前面「颜色代码编辑器」不同——那个用来实时编辑预览一整句话，这里是完整的代码-颜色-十六进制对照速查，需要查具体某个代码对应哪个颜色时更快。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <ItemsControl x:Name="ColorRefList"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 32：附魔台书架数量对照 ===== -->
                <TabItem Header="附魔书架计算器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="附魔台书架数量对照" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="附魔台周围（间隔 1 格、高 2 层）摆放的书架数量决定能开出的最高附魔等级上限，最多 15 个书架即可达到满级 30 级台面，超过 15 个没有额外效果。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="书架数量（0~15）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="BookshelfCountBox" Width="160" HorizontalAlignment="Left" Padding="6,5" Text="15" Margin="0,0,0,14" TextChanged="BookshelfCountBox_TextChanged"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="BookshelfResultText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 「基岩版」原来在这里的 Tab（内容管理/服务端下载）已经和「实验性功能」弹窗
                     里的"启动基岩版"按钮一起，整合搬到左侧导航栏的独立入口「基岩版启动」
                     （BedrockPage.xaml），不再放在百宝箱里——见 MainWindow.xaml 里
                     NavBedrockButton 的注释。这里不再保留这个 Tab，避免同一个功能出现在
                     两个地方、显示口径可能不一致。 -->

            </TabControl>
        </Grid>
    </Border>
</UserControl>
