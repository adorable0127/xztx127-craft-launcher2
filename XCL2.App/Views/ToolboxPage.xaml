<UserControl x:Class="XCL2.App.Views.ToolboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:XCL2.App.Services"
             xmlns:tools="clr-namespace:XCL2.App.Views.Tools">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Str_Ui_Toolbox}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Str_Ui_A_Set_Of_Small_Everyday_Tools_These_Are_}" FontSize="12" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <TabControl Grid.Row="1">

                <!-- ===== Tab 1：成就图片生成器 ===== -->
                <TabItem Header="{DynamicResource Str_Ui_Advancement_Image}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Str_Ui_Custom_Advancement_Image_Generator_Engli}" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Item_Id}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <TextBox x:Name="AchItemIdBox" Padding="6,5" Text="minecraft:diamond"
                                         TextChanged="AchItemIdBox_TextChanged" GotFocus="AchItemIdBox_GotFocus"
                                         LostFocus="AchItemIdBox_LostFocus"/>
                                <!-- 中/英文搜索建议下拉：输完关键字（比如"钻石""红石块"或英文 id 片段）
                                     实时列出匹配到的方块/物品，点一下就能直接填进输入框，
                                     不用自己去猜到底有没有这个方块、拼得对不对，从根上减少
                                     "填了个不存在的方块结果只画出兜底图标，看着像没生效/还是预设"的情况。 -->
                                <Popup x:Name="AchSuggestPopup" PlacementTarget="{Binding ElementName=AchItemIdBox}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="2"
                                            Width="{Binding ActualWidth, ElementName=AchItemIdBox}">
                                        <ListBox x:Name="AchSuggestList" BorderThickness="0" MaxHeight="220"
                                                 MouseLeftButtonUp="AchSuggestList_MouseLeftButtonUp"/>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock Text="{DynamicResource Str_Ui_Advancement}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="AchNameBox" Margin="0,0,0,10" Padding="6,5" Text="Achievement Get!"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Line_1}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="AchLine1Box" Margin="0,0,0,10" Padding="6,5" Text="Diamonds!"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Line_2_Optional}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="AchLine2Box" Margin="0,0,0,14" Padding="6,5"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,6"
                                    HorizontalAlignment="Left">
                                <Grid Width="520" Height="80">
                                    <Image x:Name="AchPreviewImage" Stretch="None" HorizontalAlignment="Left"/>
                                    <!-- 生成过程要联网找真实贴图，慢的时候能到几秒——之前是直接在
                                         UI 线程同步跑，界面在这几秒里完全卡死、点不动也拖不动。
                                         现在挪到后台线程跑，这里用一个转圈+"生成中…"提示占位，
                                         界面本身不会再卡住。 -->
                                    <TextBlock x:Name="AchGeneratingText" Text="{DynamicResource Str_Ui_Generating}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AchStatusText" FontSize="11" Margin="0,0,0,14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AchPreviewButton" Content="{DynamicResource Str_Ui_Preview_Image}" Padding="14,7" Margin="0,0,10,0" Click="AchPreview_Click"/>
                                <Button x:Name="AchSaveButton" Content="{DynamicResource Str_Ui_Save_Image}" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="AchSave_Click"/>
                            </StackPanel>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Margin="0,14,0,0"
                                    HorizontalAlignment="Left">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="设置自己已经安装好的MC基岩版" Padding="12,6" Click="AchSetBedrockDir_Click"/>
                                        <Button Content="清除" Padding="12,6" Margin="8,0,0,0" Click="AchClearBedrockDir_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AchBedrockDirText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="560" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 2：皮肤头像生成器 ===== -->
                <TabItem Header="{DynamicResource Str_Ui_Skin_Avatar}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Str_Ui_Skin_Avatar_Generator}" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Avatar_Size}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="AvatarSizeCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,14" SelectedIndex="1" SelectionChanged="AvatarSizeCombo_SelectionChanged">
                                <ComboBoxItem Content="32x32"/>
                                <ComboBoxItem Content="64x64"/>
                                <ComboBoxItem Content="128x128"/>
                                <ComboBoxItem Content="256x256"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Width="140" Height="140">
                                    <Image x:Name="AvatarPreviewImage" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AvatarSourceText" Text="{DynamicResource Str_Ui_No_Skin_File_Selected}" TextWrapping="Wrap" MaxWidth="300"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Str_Ui_Choose_Skin}" Padding="14,7" Margin="0,0,10,0" Click="AvatarSelectSkin_Click"/>
                                <Button Content="{DynamicResource Str_Ui_Save_Avatar}" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="AvatarSave_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 3：下载自定义文件 / 正版皮肤下载 ===== -->
                <TabItem Header="{DynamicResource Str_Ui_File_Download}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="680" HorizontalAlignment="Left">

                            <TextBlock Text="{DynamicResource Str_Ui_Download_A_Custom_File}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Download_Any_Direct_Link_Note_That_Some_}"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Download_Url}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="DlUrlBox" Margin="0,0,0,10" Padding="6,5"/>

                            <TextBlock Text="{DynamicResource Str_Ui_User_Agent_Optional}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="DlUserAgentBox" Margin="0,0,0,10" Padding="6,5"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Save_To}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DlSaveDirBox" Grid.Column="0" Padding="6,5" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Select}" Padding="12,5" Click="DlBrowseDir_Click"/>
                            </Grid>

                            <TextBlock Text="{DynamicResource Str_Ui_File_Name_Leave_Blank_To_Auto_Dete}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="DlFileNameBox" Margin="0,0,0,10" Padding="6,5"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="DlStartBtn" Content="{DynamicResource Str_Ui_Start_Download}" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,10,0" Click="DlStart_Click"/>
                                <Button Content="{DynamicResource Str_Ui_Open_Folder}" Padding="14,7" Click="DlOpenFolder_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="DlStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Download_A_Premium_Player_S_Skin}" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Premium_Username}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="OfficialPlayerNameBox" Margin="0,0,0,10" Padding="6,5"/>
                            <Button Content="{DynamicResource Str_Ui_Save_Skin}" Padding="14,7" HorizontalAlignment="Left" Click="OfficialSkinSave_Click"/>
                            <TextBlock x:Name="OfficialSkinStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 4：加载器 Jar 单独下载 ===== -->
                <TabItem Header="{DynamicResource Str_Ui_Loader_Downloads}">
                    <Grid Margin="4,12,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="6">
                            <ListBox x:Name="LoaderListBox" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="LoaderListBox_SelectionChanged">
                                <ListBoxItem Content="Minecraft" IsEnabled="False" FontWeight="Bold"/>
                                <ListBoxItem Content="OptiFine" Tag="OptiFine"/>
                                <ListBoxItem Content="Forge" Tag="Forge"/>
                                <ListBoxItem Content="NeoForge" Tag="NeoForge"/>
                                <ListBoxItem Content="Cleanroom" Tag="Cleanroom"/>
                                <ListBoxItem Content="Fabric" Tag="Fabric"/>
                                <ListBoxItem Content="Legacy Fabric" Tag="LegacyFabric"/>
                                <ListBoxItem Content="Quilt" Tag="Quilt"/>
                                <ListBoxItem Content="LabyMod" Tag="LabyMod"/>
                                <ListBoxItem Content="LiteLoader" Tag="LiteLoader"/>
                            </ListBox>
                        </Border>

                        <StackPanel Grid.Column="2" MaxWidth="520" HorizontalAlignment="Left">
                            <TextBlock x:Name="LoaderTitleText" Text="{DynamicResource Str_Ui_Select_A_Loader_On_The_Left}" FontWeight="Bold" FontSize="16" Margin="0,0,0,14"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Minecraft_Version}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="LoaderMcVersionCombo" Margin="0,0,0,10" SelectionChanged="LoaderMcVersionCombo_SelectionChanged"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Loader_Installer_Version}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="LoaderVersionCombo" Margin="0,0,0,14" SelectionChanged="LoaderVersionCombo_SelectionChanged"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LoaderDownloadBtn" Content="{DynamicResource Str_Ui_Download_Jar}" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,10,0" Click="LoaderDownload_Click" IsEnabled="False"/>
                                <Button Content="{DynamicResource Str_Ui_Open_Folder}" Padding="14,7" Click="LoaderOpenFolder_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="LoaderStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ===== Tab 5：清理 / 快捷方式 / 启动计数 / 内存优化 ===== -->
                <TabItem Header="{DynamicResource Str_Ui_System_Tools}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="680" HorizontalAlignment="Left">

                            <TextBlock Text="{DynamicResource Str_Ui_Clean_Junk_Files}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Removes_Temporary_Files_From_This_Minecr}"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="{DynamicResource Str_Ui_Scan_Junk}" Padding="14,7" Margin="0,0,10,0" Click="JunkScan_Click"/>
                                <Button x:Name="JunkCleanBtn" Content="{DynamicResource Str_Ui_Clean_Junk_Files}" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="JunkClean_Click" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock x:Name="JunkStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="{DynamicResource Str_Ui_Create_Shortcut}" Padding="14,7" Margin="0,0,10,0" Click="CreateShortcut_Click"/>
                                <Button Content="{DynamicResource Str_Ui_Launch_Count}" Padding="14,7" Click="ShowLaunchCount_Click"/>
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                            <TextBlock Text="{DynamicResource Str_Ui_Memory_Optimization}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource Str_Ui_When_On_Xms_And_Xmx_Are_Recalculated_Fro}"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="MemOptCheck" Content="{DynamicResource Str_Ui_Optimise_Memory_Allocation_Before_}" Checked="MemOptCheck_Changed" Unchecked="MemOptCheck_Changed" Margin="0,0,0,10"/>
                            <Button Content="{DynamicResource Str_Ui_Preview_Recommended_Values}" Padding="14,7" HorizontalAlignment="Left" Click="MemOptPreview_Click"/>
                            <TextBlock x:Name="MemOptStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 6：计算器 ===== -->
                <TabItem Header="{DynamicResource Str_Ui_Calculator}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4">
                            <TextBlock Text="{DynamicResource Str_Ui_Calculator_Desc}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"
                                       MaxWidth="640" HorizontalAlignment="Left"/>
                            <tools:CalculatorTool HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 7：桌面便签 ===== -->
                <TabItem Header="{DynamicResource Str_Ui_Sticky_Notes}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4">
                            <TextBlock Text="{DynamicResource Str_Ui_Sticky_Notes_Desc}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"
                                       MaxWidth="640" HorizontalAlignment="Left"/>
                            <tools:StickyNotesTool/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 8：电脑清理 ===== -->
                <TabItem Header="电脑清理">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="清理电脑临时垃圾" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="扫描并清理系统临时文件夹(%TEMP%、Windows\Temp)和常见浏览器缓存。只清理超过 6 小时未修改、确定是缓存/临时性质的文件，不会碰你的文档、下载、桌面等任何个人数据，正被占用的文件会自动跳过。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="扫描" Padding="14,7" Margin="0,0,10,0" Click="SysJunkScan_Click"/>
                                <Button x:Name="SysJunkCleanBtn" Content="清理" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="SysJunkClean_Click" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock x:Name="SysJunkStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 9：服务器测速 ===== -->
                <TabItem Header="服务器测速">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="Minecraft 服务器测速 / MOTD 查询" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="填入服务器地址，实测连接延迟、MOTD、在线人数和版本号——跟游戏里多人游戏列表看到的信息是同一套协议，不需要真的进游戏就能查。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <TextBlock Text="服务器地址" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PingHostBox" Padding="6,5" Text="mc.hypixel.net"/>
                                <TextBox x:Name="PingPortBox" Grid.Column="1" Padding="6,5" Margin="8,0,0,0" Text="25565"/>
                            </Grid>

                            <Button x:Name="PingGoBtn" Content="开始测速" Style="{StaticResource PrimaryButton}"
                                    Padding="14,7" HorizontalAlignment="Left" Click="PingGo_Click"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="PingResultText" FontSize="13" TextWrapping="Wrap"
                                               Text="还没有测速结果。" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 10：下界坐标换算 ===== -->
                <TabItem Header="坐标换算">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="480" HorizontalAlignment="Left">
                            <TextBlock Text="主世界 / 下界坐标换算" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="下界里的 1 格对应主世界的 8 格，挖下界隧道传送是快速跨大陆移动的常用手段——填一边，另一边自动算出来（Y 坐标两边一致，不参与换算）。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="主世界坐标 (X, Z)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBox x:Name="OverworldXBox" Width="140" Padding="6,5" Text="0" TextChanged="OverworldCoord_TextChanged"/>
                                <TextBox x:Name="OverworldZBox" Width="140" Padding="6,5" Margin="10,0,0,0" Text="0" TextChanged="OverworldCoord_TextChanged"/>
                            </StackPanel>

                            <TextBlock Text="下界坐标 (X, Z)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="NetherXBox" Width="140" Padding="6,5" Text="0" TextChanged="NetherCoord_TextChanged"/>
                                <TextBox x:Name="NetherZBox" Width="140" Padding="6,5" Margin="10,0,0,0" Text="0" TextChanged="NetherCoord_TextChanged"/>
                            </StackPanel>

                            <TextBlock x:Name="CoordStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 11：聊天颜色代码编辑器 ===== -->
                <TabItem Header="颜色代码编辑器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="聊天 / MOTD 颜色代码编辑器" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="点下面的色块把 § 颜色代码插入光标处，右侧实时预览游戏里的显示效果——服务器 MOTD、告示牌、记分板标题这些地方都能用这套代码。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <WrapPanel x:Name="ColorSwatchPanel" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="FormatSwatchPanel" Margin="0,0,0,10"/>

                            <TextBox x:Name="ColorCodeInputBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="70" Padding="8" FontSize="13" Margin="0,0,0,10"
                                     Text="&amp;6欢迎来到 &amp;l&amp;c我的服务器&amp;r&amp;6！"
                                     TextChanged="ColorCodeInputBox_TextChanged"/>

                            <TextBlock Text="预览" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="#2B2B2B" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <TextBlock x:Name="ColorCodePreviewText" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas"/>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="复制代码" Padding="12,6" Margin="0,0,10,0" Click="ColorCodeCopy_Click"/>
                                <Button Content="清空" Padding="12,6" Click="ColorCodeClear_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 12：系统内存监视 / 一键释放 ===== -->
                <TabItem Header="系统内存监视">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="系统内存监视 / 一键释放" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="跟上面「内存优化」不同——那个只影响给游戏本身分配的 -Xms/-Xmx，这里看的是整台电脑当前的物理内存占用，「一键释放」会尝试让其它正在运行的桌面程序把暂时用不到的内存工作集交还给系统（不会关闭或影响它们的运行），适合开了很多软件、内存快见底时应急用一下。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="内存占用" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="MemMonPercentText" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Text="--%"/>
                                    </Grid>
                                    <ProgressBar x:Name="MemMonBar" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="MemMonDetailText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="刷新" Padding="14,7" Margin="0,0,10,0" Click="MemMonRefresh_Click"/>
                                <Button x:Name="MemMonTrimBtn" Content="一键释放内存" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="MemMonTrim_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="MemMonStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 13：离线 UUID 生成器 ===== -->
                <TabItem Header="离线UUID生成器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="离线（正版无关）UUID 生成器" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="按 Minecraft 离线模式的算法（对 &quot;OfflinePlayer:用户名&quot; 取 MD5，再按 UUID v3 规则改写版本/变体位）本地算出这个用户名对应的离线 UUID——跟你开一个离线账户实际拿到的 UUID完全一致，不需要联网查询，纯本地计算，同一个用户名任何时候算出来的结果都一样。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="用户名" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="OfflineUuidNameBox" Width="220" Padding="6,5" Text="Steve" TextChanged="OfflineUuidNameBox_TextChanged"/>
                            </StackPanel>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="离线 UUID（带短横线）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="OfflineUuidDashedText" FontSize="14" FontFamily="Consolas" Margin="0,0,0,8"/>
                                    <TextBlock Text="离线 UUID（无短横线）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="OfflineUuidPlainText" FontSize="14" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>

                            <Button Content="复制带短横线格式" Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OfflineUuidCopy_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 14：JVM 参数生成器 ===== -->
                <TabItem Header="JVM参数生成器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="JVM 启动参数生成器" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="按分配给游戏的内存大小、CPU 核数、游戏版本三个条件，生成一套业界常用的 G1 垃圾回收调优参数（俗称 Aikar's Flags 的简化版），能明显减少长时间游玩后的卡顿/掉帧。生成结果可以直接复制粘贴到「设置」页的自定义 JVM 参数里，不需要自己去查每个参数是什么意思。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="分配内存 (GB)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="JvmMemCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10" SelectionChanged="JvmGenOption_Changed">
                                <ComboBoxItem Content="2 GB" Tag="2"/>
                                <ComboBoxItem Content="4 GB" Tag="4" IsSelected="True"/>
                                <ComboBoxItem Content="6 GB" Tag="6"/>
                                <ComboBoxItem Content="8 GB" Tag="8"/>
                                <ComboBoxItem Content="12 GB" Tag="12"/>
                                <ComboBoxItem Content="16 GB" Tag="16"/>
                            </ComboBox>

                            <TextBlock Text="CPU 核心数" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="JvmCoreCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10" SelectionChanged="JvmGenOption_Changed">
                                <ComboBoxItem Content="2 核" Tag="2"/>
                                <ComboBoxItem Content="4 核" Tag="4" IsSelected="True"/>
                                <ComboBoxItem Content="6 核" Tag="6"/>
                                <ComboBoxItem Content="8 核及以上" Tag="8"/>
                            </ComboBox>

                            <TextBlock Text="游戏版本" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="JvmVersionCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,14" SelectionChanged="JvmGenOption_Changed">
                                <ComboBoxItem Content="1.17 及以上（现代版本）" Tag="modern" IsSelected="True"/>
                                <ComboBoxItem Content="1.16 及以下（旧版本）" Tag="legacy"/>
                            </ComboBox>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <TextBox x:Name="JvmResultText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <Button Content="复制参数" Padding="12,6" HorizontalAlignment="Left" Click="JvmGenCopy_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 15：材质包/资源包完整性校验 ===== -->
                <TabItem Header="资源包完整性校验">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="资源包 / 材质包完整性校验" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="选一个 .zip 格式的资源包文件，计算它的 SHA1 值（服务器 server.properties 里的 resource-pack-sha1、或对方发给你的\u201c官方校验值\u201d用的就是这个），同时读取包内 pack.mcmeta 的 pack_format 版本号，可以粘贴一个\u201c期望的 SHA1\u201d进来自动比对是否一致，用来确认下载到的资源包文件没有被损坏或篡改。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="选择资源包 (.zip)" Padding="14,7" Margin="0,0,10,0" Click="RpVerifyBrowse_Click"/>
                                <TextBlock x:Name="RpVerifyFileText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Text="尚未选择文件"/>
                            </StackPanel>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="pack_format" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="RpVerifyFormatText" FontSize="13" Margin="0,0,0,8" Text="--"/>
                                    <TextBlock Text="计算出的 SHA1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="RpVerifySha1Text" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap" Text="--"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="期望的 SHA1（可选，留空则只显示计算结果不比对）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="RpVerifyExpectedBox" Margin="0,0,0,10" Padding="6,5" FontFamily="Consolas" TextChanged="RpVerifyExpectedBox_TextChanged"/>

                            <TextBlock x:Name="RpVerifyResultText" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 16：快捷键速查表 ===== -->
                <TabItem Header="快捷键速查表">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="常用快捷键速查表" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="纯静态参考表，不需要联网，游戏里记不清按键的时候切过来看一眼就行。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <ItemsControl x:Name="KeyRefList"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 17：随机种子生成器 ===== -->
                <TabItem Header="随机种子生成器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="随机存档种子生成器" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="一键生成一个随机的存档种子，创建新世界时可以直接粘贴到\u201c种子\u201d输入框——纯本地随机数生成，不是查已有地图的种子。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="SeedNumericRadio" Content="纯数字种子" GroupName="SeedType" IsChecked="True" Margin="0,0,20,0" Checked="SeedTypeRadio_Changed"/>
                                <RadioButton x:Name="SeedStringRadio" Content="字符串种子" GroupName="SeedType" Checked="SeedTypeRadio_Changed"/>
                            </StackPanel>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <TextBlock x:Name="SeedResultText" FontSize="16" FontFamily="Consolas" Text="点下面的按钮生成一个种子"/>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SeedGenBtn" Content="生成种子" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,10,0" Click="SeedGen_Click"/>
                                <Button Content="复制" Padding="14,7" Click="SeedCopy_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 18：经验等级计算器 ===== -->
                <TabItem Header="经验等级计算器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="经验等级 / 经验值互算" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="按官方公式换算等级和累计经验值（Experience Orb 总量），两边填一边、另一边自动算，附带算出升到下一级还差多少经验。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="经验等级" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="XpLevelBox" Width="160" HorizontalAlignment="Left" Padding="6,5" Text="30" Margin="0,0,0,14" TextChanged="XpLevelBox_TextChanged"/>

                            <TextBlock Text="累计经验值（总经验）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="XpTotalBox" Width="160" HorizontalAlignment="Left" Padding="6,5" Margin="0,0,0,14" TextChanged="XpTotalBox_TextChanged"/>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="XpResultText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 19：三维坐标距离计算器 ===== -->
                <TabItem Header="坐标距离计算器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="520" HorizontalAlignment="Left">
                            <TextBlock Text="两点坐标距离计算" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="填入两个坐标点，算出直线距离（含 Y 轴）和水平距离（只算 X/Z，不看高度差）——找基地、算鞘翅飞行路程、判断信标/出生点范围时都用得上。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="坐标点 A (X, Y, Z)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBox x:Name="DistAxBox" Width="100" Padding="6,5" Text="0" TextChanged="DistBox_TextChanged"/>
                                <TextBox x:Name="DistAyBox" Width="100" Padding="6,5" Margin="8,0,0,0" Text="64" TextChanged="DistBox_TextChanged"/>
                                <TextBox x:Name="DistAzBox" Width="100" Padding="6,5" Margin="8,0,0,0" Text="0" TextChanged="DistBox_TextChanged"/>
                            </StackPanel>

                            <TextBlock Text="坐标点 B (X, Y, Z)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBox x:Name="DistBxBox" Width="100" Padding="6,5" Text="100" TextChanged="DistBox_TextChanged"/>
                                <TextBox x:Name="DistByBox" Width="100" Padding="6,5" Margin="8,0,0,0" Text="64" TextChanged="DistBox_TextChanged"/>
                                <TextBox x:Name="DistBzBox" Width="100" Padding="6,5" Margin="8,0,0,0" Text="100" TextChanged="DistBox_TextChanged"/>
                            </StackPanel>

                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="直线距离（3D）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="Dist3DText" FontSize="16" FontFamily="Consolas" Margin="0,0,0,8"/>
                                    <TextBlock Text="水平距离（仅 X/Z）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="DistXZText" FontSize="16" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 20：常用指令生成器 ===== -->
                <TabItem Header="指令生成器">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="常用作弊指令生成器" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="挑一种指令、填好参数，下面直接拼出完整指令，游戏里打开聊天栏粘贴回车即可，不用自己记参数顺序。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="指令类型" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmdTypeCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,14" SelectedIndex="0" SelectionChanged="CmdGenOption_Changed">
                                <ComboBoxItem Content="给予物品 /give"/>
                                <ComboBoxItem Content="传送 /tp"/>
                                <ComboBoxItem Content="切换游戏模式 /gamemode"/>
                                <ComboBoxItem Content="设置时间 /time set"/>
                                <ComboBoxItem Content="设置天气 /weather"/>
                            </ComboBox>

                            <!-- /give 参数 -->
                            <StackPanel x:Name="CmdGivePanel">
                                <TextBlock Text="玩家名（留空则用 @p 最近玩家）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="CmdGivePlayerBox" Margin="0,0,0,10" Padding="6,5" TextChanged="CmdGenOption_TextChanged"/>
                                <TextBlock Text="物品 ID" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="CmdGiveItemBox" Margin="0,0,0,10" Padding="6,5" Text="minecraft:diamond" TextChanged="CmdGenOption_TextChanged"/>
                                <TextBlock Text="数量" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="CmdGiveCountBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="6,5" Text="1" TextChanged="CmdGenOption_TextChanged"/>
                            </StackPanel>

                            <!-- /tp 参数 -->
                            <StackPanel x:Name="CmdTpPanel" Visibility="Collapsed">
                                <TextBlock Text="玩家名（留空则用 @p 最近玩家）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="CmdTpPlayerBox" Margin="0,0,0,10" Padding="6,5" TextChanged="CmdGenOption_TextChanged"/>
                                <TextBlock Text="目标坐标 (X Y Z)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="CmdTpXBox" Width="100" Padding="6,5" Text="0" TextChanged="CmdGenOption_TextChanged"/>
                                    <TextBox x:Name="CmdTpYBox" Width="100" Padding="6,5" Margin="8,0,0,0" Text="64" TextChanged="CmdGenOption_TextChanged"/>
                                    <TextBox x:Name="CmdTpZBox" Width="100" Padding="6,5" Margin="8,0,0,0" Text="0" TextChanged="CmdGenOption_TextChanged"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- /gamemode 参数 -->
                            <StackPanel x:Name="CmdGamemodePanel" Visibility="Collapsed">
