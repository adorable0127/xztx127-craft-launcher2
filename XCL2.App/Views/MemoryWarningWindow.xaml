<Window x:Class="XCL2.App.Views.MemoryWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内存不足警告" Height="440" Width="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource DangerBrush}"
                    VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="系统内存即将耗尽" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>

        <TextBlock x:Name="DetailText" Grid.Row="1" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>

        <Border Grid.Row="2" Background="{DynamicResource WarningBannerBrush}" CornerRadius="8"
                Padding="12" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="继续运行可能导致游戏卡死、启动器无响应，极端情况下会导致系统卡顿甚至蓝屏重启。"
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="正在运行的游戏进程：" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <ListBox x:Name="ProcessListBox" BorderThickness="1" MaxHeight="150"
                         SelectionMode="Extended"
                         BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource SideBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding TitleLine}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding SubLine}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="建议立即关闭游戏，保存好的游戏进度以最近一次自动/手动存档为准。"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="IgnoreBtn" Content="忽略（本次不再提醒）" Padding="12,8" Margin="0,0,8,0"
                    Click="Ignore_Click"/>
            <Button x:Name="CloseSelectedBtn" Content="关闭所选进程" Padding="12,8" Margin="0,0,8,0"
                    Click="CloseSelected_Click"/>
            <Button x:Name="CloseAllBtn" Content="立即关闭全部游戏" Padding="14,8"
                    Style="{StaticResource PrimaryButton}" Background="{DynamicResource DangerBrush}"
                    Click="CloseAll_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
