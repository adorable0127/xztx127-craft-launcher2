<local:OverlayDialogControl x:Class="XCL2.App.Views.MemoryWarningWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            MinWidth="480"
                            MaxWidth="480"
                            MinHeight="440"
                            MaxHeight="440">
                            <!-- MinHeight 必须给：这个弹窗的布局里有 RowDefinition Height="*"。
                                 原来是 Window 且有固定 Height 时，"*"行能拿到剩余高度；
                                 改成挂在自适应 OverlayCard 里的 UserControl 之后，
                                 测量高度是无穷大，"*"行会塌陷成内容的期望高度——
                                 列表为空/WebView2 这种没有期望尺寸的控件会直接塌成 0，
                                 表现就是弹窗里一片空白。MinHeight 用回原来的设计高度即可。 -->
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource DangerBrush}"
                    VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource Str_Ui_System_Memory_Almost_Exhausted}" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>

        <TextBlock x:Name="DetailText" Grid.Row="1" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>

        <Border Grid.Row="2" Background="{DynamicResource WarningBannerBrush}" CornerRadius="8"
                Padding="12" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Ui_Carrying_On_May_Freeze_The_Game_Or_The_L}"
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource Str_Ui_Running_Game_Processes}" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <ListBox x:Name="ProcessListBox" BorderThickness="1" MaxHeight="150"
                         SelectionMode="Extended"
                         BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource SideBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding TitleLine}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding SubLine}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{DynamicResource Str_Ui_Close_The_Game_Now_Your_Progress_Will_Be}"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="IgnoreBtn" Content="{DynamicResource Str_Ui_Ignore_Don_T_Ask_Again_This_Time}" Padding="12,8" Margin="0,0,8,0"
                    Click="Ignore_Click"/>
            <Button x:Name="CloseSelectedBtn" Content="{DynamicResource Str_Ui_Close_Selected_Process}" Padding="12,8" Margin="0,0,8,0"
                    Click="CloseSelected_Click"/>
            <Button x:Name="CloseAllBtn" Content="{DynamicResource Str_Ui_Close_All_Games_Now}" Padding="14,8"
                    Style="{StaticResource PrimaryButton}" Background="{DynamicResource DangerBrush}"
                    Click="CloseAll_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</local:OverlayDialogControl>
