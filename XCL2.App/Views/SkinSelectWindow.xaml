<Window x:Class="XCL2.App.Views.SkinSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择皮肤"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SideBrush}">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20" Margin="10">
        <StackPanel>
            <TextBlock Text="选择离线皮肤" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="离线账户可以选择内置的史蒂夫/艾利克斯骨架，或上传自己的皮肤图片。"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <RadioButton x:Name="SteveRadio" Content="史蒂夫（默认骨架）" GroupName="SkinType"
                         Margin="0,0,0,10" Checked="SkinTypeRadio_Checked"/>
            <RadioButton x:Name="AlexRadio" Content="艾利克斯（纤细手臂骨架）" GroupName="SkinType"
                         Margin="0,0,0,10" Checked="SkinTypeRadio_Checked"/>
            <RadioButton x:Name="CustomRadio" Content="自定义上传" GroupName="SkinType"
                         Margin="0,0,0,10" Checked="SkinTypeRadio_Checked"/>

            <Border x:Name="CustomPanelBorder" Background="{DynamicResource SideBrush}" CornerRadius="8"
                    Padding="14" Margin="20,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BrowseSkinBtn" Content="选择 PNG 图片..." Click="BrowseSkin_Click" Padding="10,6"/>
                        <TextBlock x:Name="SkinFileNameText" Text="未选择文件" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <CheckBox x:Name="SlimArmCheck" Content="纤细手臂（Alex 骨架，适用于部分自定义皮肤）"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="IndianRed" FontSize="12"
                       Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock Text="提示：自定义皮肤需要借助“万能皮肤补丁”才能在离线模式下正常显示，下载/启动游戏时会自动处理，无需手动操作。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,16,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="OkBtn" Content="保存" Width="80" Style="{DynamicResource PrimaryButton}"
                        Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
