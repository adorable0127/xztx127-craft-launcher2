<local:OverlayDialogControl x:Class="XCL2.App.Views.PluginTemplatePromptDialog"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="460" MaxWidth="460" MinHeight="300" MaxHeight="420">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <TextBlock Grid.Row="0" Text="生成插件项目模板" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

  <!-- 修复：固定 MaxHeight=300 时，三个输入字段 + 目录选择行叠起来的实际高度常常超过
       可用空间，导致"生成到哪个目录"这一行和下面的错误提示被裁掉、看不全。这里给中间
       内容套一层可滚动的 ScrollViewer（复用全局统一的滚轮手感 EnableFastWheel），
       内容超出时可以直接用鼠标滚轮上下滚动看全，不用再手动拉伸/放大窗口。 -->
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                services:ScrollWheelBehavior.EnableFastWheel="True">
   <StackPanel Margin="0,0,4,0">
    <TextBlock Text="插件 Id（建议“你的名字.插件名”，之后不要再改）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
    <TextBox x:Name="PluginIdBox" Padding="6,5" Margin="0,0,0,10" Text="yourname.my-plugin"/>

    <TextBlock Text="插件显示名称" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
    <TextBox x:Name="DisplayNameBox" Padding="6,5" Margin="0,0,0,10" Text="我的插件"/>

    <TextBlock Text="生成到哪个目录（必须是空目录）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBox x:Name="TargetDirBox" Grid.Column="0" Padding="6,5" Margin="0,0,8,0" IsReadOnly="True"/>
     <Button Grid.Column="1" Content="选择…" Padding="12,5" Click="BrowseDir_Click"/>
    </Grid>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </ScrollViewer>

  <Grid Grid.Row="2" Margin="0,14,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <Button Grid.Column="1" Content="取消" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
   <Button Grid.Column="2" Content="生成" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="Generate_Click"/>
  </Grid>
 </Grid>
</local:OverlayDialogControl>
