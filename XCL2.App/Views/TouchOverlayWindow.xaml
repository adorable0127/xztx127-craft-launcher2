<Window x:Class="XCL2.App.Views.TouchOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XCL2 触屏悬浮层"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        Width="1280" Height="720" Left="0" Top="0">

    <!-- 排版参考 FCL(Fold Craft Launcher) 的默认虚拟键盘布局：
         左下方向摇杆区(WASD)、右下动作区(跳跃/潜行/丢弃/攻击/使用)、
         顶部功能键条(ESC/F3/DEL...)、底部快捷栏数字条、中间大片区域为视角拖动区。
         所有控件都不是 WPF 的 Button，而是 Border——Button 自带焦点/点击语义，
         在"永不激活"的无焦点窗口里反而会带来一堆奇怪行为；这里只需要"按下/抬起"
         两个时机，Border + 手动处理触摸与鼠标事件最干净，也天然支持多点同时按住
         （比如一边按 W 一边按跳跃，Button 的点击模型是做不到的）。 -->

    <Window.Resources>
        <!-- 普通按键外观：半透明深色圆角块 + 白字，跟 FCL 的观感一致，
             不挡视线，同时在明亮的雪地/沙漠场景下也能看清。 -->
        <Style x:Key="PadKeyStyle" TargetType="Border">
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Width" Value="62"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 小号功能键（顶部功能条、快捷栏数字）：同样的观感，尺寸更小，占屏面积更少。 -->
        <Style x:Key="SmallKeyStyle" TargetType="Border" BasedOn="{StaticResource PadKeyStyle}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- 主要动作键（跳跃）：做大一圈，方便盲按。 -->
        <Style x:Key="BigKeyStyle" TargetType="Border" BasedOn="{StaticResource PadKeyStyle}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="CornerRadius" Value="40"/>
            <Setter Property="Background" Value="#73000000"/>
        </Style>

        <Style x:Key="KeyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="SmallKeyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource KeyTextStyle}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <!-- 画面输入区不缩放；只缩放按钮，保证任意 DPI/按钮尺寸下客户区都可点到。 -->
    <Grid x:Name="RootGrid">
        <Border x:Name="ViewPad" Background="#01000000"/>
        <Canvas x:Name="ControlCanvas" Background="{x:Null}" ClipToBounds="True"/>
        <Border x:Name="RestoreKey" Style="{StaticResource SmallKeyStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                Background="#B3000000" Visibility="Collapsed">
            <TextBlock Style="{StaticResource SmallKeyTextStyle}" Text="显示"/>
        </Border>
    </Grid>
</Window>
