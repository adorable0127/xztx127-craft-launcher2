<local:OverlayDialogControl x:Class="XCL2.App.Views.FirstRunWizardWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="720"
                            MaxWidth="720"
                            MinHeight="560"
                            MaxHeight="560">
                            <!-- MinHeight 必须给：这个弹窗的布局里有 RowDefinition Height="*"。
                                 原来是 Window 且有固定 Height 时，"*"行能拿到剩余高度；
                                 改成挂在自适应 OverlayCard 里的 UserControl 之后，
                                 测量高度是无穷大，"*"行会塌陷成内容的期望高度——
                                 列表为空/WebView2 这种没有期望尺寸的控件会直接塌成 0，
                                 表现就是弹窗里一片空白。MinHeight 用回原来的设计高度即可。 -->
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Str_Home_Welcome}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource Str_Ui_Work_Through_The_Steps_Below_And_You_Ll_}"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 步骤指示条 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border x:Name="StepDot1" CornerRadius="6" Height="6" Margin="0,0,4,0" Background="{DynamicResource AccentBrush}"/>
            <Border x:Name="StepDot2" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="{DynamicResource DividerBrush}"/>
            <Border x:Name="StepDot3" CornerRadius="6" Height="6" Margin="4,0,4,0" Background="{DynamicResource DividerBrush}"/>
            <Border x:Name="StepDot4" CornerRadius="6" Height="6" Margin="4,0,0,0" Background="{DynamicResource DividerBrush}"/>
        </UniformGrid>

        <!-- 步骤内容区 -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="24">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- 步骤 1：模式选择 + Java -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible">
                    <!-- 模式选择：放在第一步最上面，用户一进向导就先确定"普通/高手"这个贯穿全程的
                         基础设置，后续步骤（尤其是以后可能加的自定义 JVM 参数等高手专属选项）
                         都依赖这个开关。选完立即写回配置，不用等向导走完，即使中途"跳过引导"
                         这个选择也已经生效。 -->
                    <Border Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Ui_Choose_A_Mode}" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                            <RadioButton x:Name="WizardSimpleModeRadio" GroupName="WizardMode"
                                         Content="{DynamicResource Str_Ui_Normal_Mode_Recommended_Works_With_Zero_}"
                                         IsChecked="True" Margin="0,0,0,6" Checked="WizardMode_Changed"/>
                            <RadioButton x:Name="WizardAdvancedModeRadio" GroupName="WizardMode"
                                         Content="{DynamicResource Str_Ui_Expert_Mode_Tweak_The_Java_Version_Custo}"
                                         Checked="WizardMode_Changed"/>
                            <TextBlock Text="{DynamicResource Str_Ui_You_Can_Change_This_Again_At_Any_Time_In}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource Str_Ui_Step_1_Set_Up_Java}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                        Minecraft 需要 Java 才能运行。如果你不确定电脑上有没有装、装的版本对不对，
                        直接点「一键安装推荐版本」即可，XCL2 会自动下载合适的便携版 Java，不影响你电脑上已有的其他 Java。
                    </TextBlock>

                    <TextBlock x:Name="JavaStatusText" Text="{DynamicResource Str_Ui_Detecting_Installed_Java}" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <Button x:Name="AutoInstallJavaBtn" Content="{DynamicResource Str_Ui_Install_The_Recommended_Java}" Style="{StaticResource PrimaryButton}"
                            Width="220" HorizontalAlignment="Left" Padding="0,10" Click="AutoInstallJava_Click"/>

                    <TextBlock Text="{DynamicResource Str_Ui_Advanced_Users_Can_Skip_This_And_Set_The}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- 步骤 2：游戏文件夹 + 语言 -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Ui_Step_2_Game_Folder_Amp_Language}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                        游戏文件（存档、mod、资源包等）都会保存在这个文件夹里。不确定就用默认的就行，以后随时能在「版本选择」页里添加更多文件夹。
                    </TextBlock>

                    <TextBlock Text="{DynamicResource Str_Ui_Game_Folder_Location}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPathBox" Padding="8"/>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Common_Browse}" Margin="8,0,0,0" Padding="12,8" Click="BrowseFolder_Click"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Ui_In_Game_Language}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LanguageCombo" Width="220" HorizontalAlignment="Left">
                        <ComboBoxItem Content="{DynamicResource Str_Ui_Label_2}" Tag="zh_cn"/>
                        <ComboBoxItem Content="{DynamicResource Str_Ui_Label_3}" Tag="zh_tw"/>
                        <ComboBoxItem Content="English (US)" Tag="en_us"/>
                        <ComboBoxItem Content="{DynamicResource Str_Ui_Label}" Tag="ja_jp"/>
                        <ComboBoxItem Content="한국어" Tag="ko_kr"/>
                    </ComboBox>
                </StackPanel>

                <!-- 步骤 3：账户 -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Ui_Step_3_Create_Or_Choose_An_Account}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                        没有正版账户也没关系，可以先用离线账户体验（仅能进单机/离线服务器）；
                        以后随时可以在「账户管理」页里登录微软正版账户。
                    </TextBlock>

                    <TextBlock x:Name="AccountStatusText" Text="" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>

                    <TextBlock Text="{DynamicResource Str_Ui_Offline_Username}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OfflineNameBox" Padding="8" Text="Player"/>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Create_Offline_Account}" Margin="8,0,0,0" Padding="12,8" Click="CreateOffline_Click"/>
                    </Grid>

                    <!-- 需求变更：微软登录不再强制跳转到账户管理页，直接在向导内完成
                         （照抄 QuickStartWizardWindow/LoginPage 的登录逻辑），减少"半路跳出向导"
                         打断新手引导流程的情况；仍然保留跳转按钮作为不想在弹窗里登录的备选项。 -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str_Ui_Add_Microsoft_Account_Browser_Sign_In}" Padding="10,6" Click="MicrosoftLoginBrowser_Click"/>
                        <Button Content="{DynamicResource Str_Ui_Add_Microsoft_Account_Embedded_Sig}" Margin="8,0,0,0" Padding="10,6" Click="MicrosoftLoginEmbedded_Click"/>
                    </StackPanel>
                    <Button Content="{DynamicResource Str_Ui_Sign_In_From_The_Accounts_Page_Instead}" HorizontalAlignment="Left" Padding="10,6" Margin="0,8,0,0" Click="GotoMicrosoftLogin_Click"/>
                </StackPanel>

                <!-- 步骤 4：完成 -->
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Ui_All_Set}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" LineHeight="24">
                        Java、游戏文件夹、语言、账户都已经配置好了。
                        <LineBreak/>
                        接下来可以在「版本选择」页下载一个 Minecraft 版本，然后点左下角「启动游戏」开始游玩。
                    </TextBlock>
                    <TextBlock x:Name="SummaryText" Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>

                <!-- 一键完成时的进度覆盖层 -->
                <Border x:Name="AutoRunOverlay" Background="{DynamicResource PanelBrush}" Visibility="Collapsed" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                        <TextBlock Text="{DynamicResource Str_Ui_Running_The_Setup_Wizard_Automatically}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <ProgressBar x:Name="AutoRunBar" Height="10" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="AutoRunText" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{DynamicResource Str_Ui_Skip_Wizard}" Padding="12,8" Click="Skip_Click"/>

            <Button Grid.Column="2" x:Name="OneClickBtn" Content="{DynamicResource Str_Ui_Do_It_All_For_Me_Recommended}" Style="{StaticResource PrimaryButton}"
                    Padding="16,8" Margin="0,0,12,0" Click="OneClickComplete_Click"/>

            <Button Grid.Column="3" x:Name="BackBtn" Content="{DynamicResource Str_Ui_Back}" Padding="16,8" Margin="0,0,8,0" Click="Back_Click" IsEnabled="False"/>
            <Button Grid.Column="4" x:Name="NextBtn" Content="{DynamicResource Str_Common_Next}" Style="{StaticResource PrimaryButton}" Padding="16,8" Click="Next_Click"/>
        </Grid>
    </Grid>
</local:OverlayDialogControl>
