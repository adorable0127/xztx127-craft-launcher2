<Window x:Class="XCL2.App.Views.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="使用 Microsoft 登录" Height="640" Width="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <wv2:WebView2 x:Name="Browser"/>
        <TextBlock x:Name="FallbackText" Visibility="Collapsed" Margin="24" TextWrapping="Wrap"
                   Text="内嵌登录组件初始化失败（可能未安装 WebView2 运行时）。请改用「浏览器登录」按钮。"/>
    </Grid>
</Window>
