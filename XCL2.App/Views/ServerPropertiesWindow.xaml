<Window x:Class="XCL2.App.Views.ServerPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:XCL2.App.Services"
        Title="服务器设置"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="服务器设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="快捷设置您的服务器基本设置。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>
                <TextBlock Text="server.properties" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource MonoFontFamily}" Margin="0,0,0,2"/>
                <TextBlock Text="server.properties 文件快捷设置。设置后需要重启才能生效。"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="最大玩家数量" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="MaxPlayersBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="出生点保护" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SpawnProtectionBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="OP权限等级" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="OpPermissionLevelBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="世界类型" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="LevelTypeBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="最大世界规格" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="MaxWorldSizeBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="玩家空闲超时时间" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PlayerIdleTimeoutBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="生成设置" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="GeneratorSettingsBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="服务器难度（1.6.X-1.14.X）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DifficultyOldCombo" Style="{DynamicResource FilterComboBox}" Height="34" Margin="0,0,0,14">
                            <ComboBoxItem Content="和平" Tag="peaceful"/>
                            <ComboBoxItem Content="简单" Tag="easy"/>
                            <ComboBoxItem Content="普通" Tag="normal"/>
                            <ComboBoxItem Content="困难" Tag="hard"/>
                        </ComboBox>

                        <TextBlock Text="游戏模式（1.6.X-1.14.X）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="GameModeOldCombo" Style="{DynamicResource FilterComboBox}" Height="34" Margin="0,0,0,14">
                            <ComboBoxItem Content="生存模式" Tag="survival"/>
                            <ComboBoxItem Content="创造模式" Tag="creative"/>
                            <ComboBoxItem Content="冒险模式" Tag="adventure"/>
                            <ComboBoxItem Content="旁观模式" Tag="spectator"/>
                        </ComboBox>

                        <CheckBox x:Name="AllowFlightCheck" Content="允许飞行" Margin="0,0,0,4"/>
                        <TextBlock Text="是否允许服务器有玩家处于飞行状态(Mod/特殊状态的飞行)，不包括鞘翅。"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <CheckBox x:Name="WhiteListCheck" Content="启用白名单" Margin="0,0,0,14"/>

                        <CheckBox x:Name="GenerateStructuresCheck" Content="启用生成结构" Margin="0,0,0,14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="视距" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ViewDistanceBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="服务器标语" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="MotdBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"
                                 ToolTip="支持 Minecraft 颜色/格式代码，例如 §a 表示绿色文字，§l 表示加粗。"/>

                        <TextBlock Text="世界名字" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="LevelNameBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,2"/>
                        <TextBlock Text="如果您已有存档数据，建议不要修改此选项" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,14"/>

                        <TextBlock Text="世界种子" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="LevelSeedBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="网络包压缩" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NetworkCompressionBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="资源包URL" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ResourcePackBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="服务器难度（1.14.X+）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DifficultyNewCombo" Style="{DynamicResource FilterComboBox}" Height="34" Margin="0,0,0,14">
                            <ComboBoxItem Content="和平" Tag="peaceful"/>
                            <ComboBoxItem Content="简单" Tag="easy"/>
                            <ComboBoxItem Content="普通" Tag="normal"/>
                            <ComboBoxItem Content="困难" Tag="hard"/>
                        </ComboBox>

                        <TextBlock Text="游戏模式（1.14.X+）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="GameModeNewCombo" Style="{DynamicResource FilterComboBox}" Height="34" Margin="0,0,0,14">
                            <ComboBoxItem Content="生存模式" Tag="survival"/>
                            <ComboBoxItem Content="创造模式" Tag="creative"/>
                            <ComboBoxItem Content="冒险模式" Tag="adventure"/>
                            <ComboBoxItem Content="旁观模式" Tag="spectator"/>
                        </ComboBox>

                        <CheckBox x:Name="OnlineModeCheck" Content="正版验证" Margin="0,0,0,4"/>
                        <TextBlock Text="关闭后玩家无需正版账号即可登录（离线模式），请注意安全风险。"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <CheckBox x:Name="EnableCommandBlockCheck" Content="启用命令方块" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ForceGameModeCheck" Content="强制游戏模式" Margin="0,0,0,14"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="CancelBtn" Content="取消" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="保存" Width="90" Style="{DynamicResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
