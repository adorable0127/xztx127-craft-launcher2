<local:OverlayDialogControl x:Class="XCL2.App.Views.ServerPropertiesWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="720"
                            MaxWidth="720"
                            MinHeight="640"
                            MaxHeight="640">
                            <!-- MinHeight 必须给：这个弹窗的布局里有 RowDefinition Height="*"。
                                 原来是 Window 且有固定 Height 时，"*"行能拿到剩余高度；
                                 改成挂在自适应 OverlayCard 里的 UserControl 之后，
                                 测量高度是无穷大，"*"行会塌陷成内容的期望高度——
                                 列表为空/WebView2 这种没有期望尺寸的控件会直接塌成 0，
                                 表现就是弹窗里一片空白。MinHeight 用回原来的设计高度即可。 -->
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Str_Ui_Server_Settings}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Quickly_Configure_The_Basics_For_Your_Se}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>
                <TextBlock Text="server.properties" FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource MonoFontFamily}" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Str_Ui_Quick_Editor_For_Server_Properties_Chang}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_Ui_Max_Players}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="MaxPlayersBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Spawn_Protection}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SpawnProtectionBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Op_Permission_Level}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="OpPermissionLevelBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_World_Type}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="LevelTypeBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Max_World_Size}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="MaxWorldSizeBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Player_Idle_Timeout}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PlayerIdleTimeoutBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Generator_Settings}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="GeneratorSettingsBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Difficulty_1_6_X_1_14_X}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DifficultyOldCombo" Style="{DynamicResource FilterComboBox}" Height="34" Margin="0,0,0,14">
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Peaceful}" Tag="peaceful"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Easy}" Tag="easy"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Normal}" Tag="normal"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Hard}" Tag="hard"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource Str_Ui_Game_Mode_1_6_X_1_14_X}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="GameModeOldCombo" Style="{DynamicResource FilterComboBox}" Height="34" Margin="0,0,0,14">
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Survival}" Tag="survival"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Creative}" Tag="creative"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Adventure}" Tag="adventure"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Spectator}" Tag="spectator"/>
                        </ComboBox>

                        <CheckBox x:Name="AllowFlightCheck" Content="{DynamicResource Str_Ui_Allow_Flight}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Str_Ui_Whether_Players_May_Fly_On_The_Server_Mo}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <CheckBox x:Name="WhiteListCheck" Content="{DynamicResource Str_Ui_Enable_Whitelist}" Margin="0,0,0,14"/>

                        <CheckBox x:Name="GenerateStructuresCheck" Content="{DynamicResource Str_Ui_Generate_Structures}" Margin="0,0,0,14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Str_Ui_Render_Distance}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ViewDistanceBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Server_Motd}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="MotdBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"
                                 ToolTip="{DynamicResource Str_Ui_Supports_Minecraft_Colour_And_Formatting}"/>

                        <TextBlock Text="{DynamicResource Str_Ui_World_Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="LevelNameBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,2"/>
                        <TextBlock Text="{DynamicResource Str_Ui_If_You_Already_Have_World_Data_It_S_Best}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_World_Seed}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="LevelSeedBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Network_Compression}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NetworkCompressionBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Resource_Pack_Url}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ResourcePackBox" Style="{DynamicResource SearchTextBox}" Height="34" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Str_Ui_Difficulty_1_14_X}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DifficultyNewCombo" Style="{DynamicResource FilterComboBox}" Height="34" Margin="0,0,0,14">
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Peaceful}" Tag="peaceful"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Easy}" Tag="easy"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Normal}" Tag="normal"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Hard}" Tag="hard"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource Str_Ui_Game_Mode_1_14_X}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="GameModeNewCombo" Style="{DynamicResource FilterComboBox}" Height="34" Margin="0,0,0,14">
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Survival}" Tag="survival"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Creative}" Tag="creative"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Adventure}" Tag="adventure"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Spectator}" Tag="spectator"/>
                        </ComboBox>

                        <CheckBox x:Name="OnlineModeCheck" Content="{DynamicResource Str_Ui_Online_Mode}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Str_Ui_With_This_Off_Players_Can_Join_Without_A}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <CheckBox x:Name="EnableCommandBlockCheck" Content="{DynamicResource Str_Ui_Enable_Command_Blocks}" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ForceGameModeCheck" Content="{DynamicResource Str_Ui_Force_Gamemode}" Margin="0,0,0,14"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="{DynamicResource Str_Common_Save}" Width="90" Style="{DynamicResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</local:OverlayDialogControl>
