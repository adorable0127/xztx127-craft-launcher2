<Window x:Class="XCL2.App.Views.ServerConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器控制台" Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0" Text="服务器控制台" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="StopBtn" Grid.Column="1" Content="■ 停止服务器" Style="{StaticResource PrimaryButton}"
                    Background="{DynamicResource DangerBrush}" Click="Stop_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="10">
            <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="OutputText" Background="Transparent" Foreground="#D4D4D4"
                         FontFamily="Consolas" FontSize="12" BorderThickness="0"
                         IsReadOnly="True" TextWrapping="Wrap" IsUndoEnabled="False"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="36"
                     Margin="0,0,8,0" KeyDown="CommandBox_KeyDown"
                     ToolTip="输入命令后回车发送，例如 say hello / list / gamemode creative Steve"/>
            <Button Grid.Column="1" Content="发送" Style="{StaticResource PrimaryButton}" Click="SendCommand_Click"/>
        </Grid>
    </Grid>
</Window>
