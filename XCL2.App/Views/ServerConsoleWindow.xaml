<local:OverlayDialogControl x:Class="XCL2.App.Views.ServerConsoleWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            MinWidth="720"
                            MaxWidth="720"
                            MinHeight="560"
                            MaxHeight="560">
                            <!-- MinHeight 必须给：这个弹窗的布局里有 RowDefinition Height="*"。
                                 原来是 Window 且有固定 Height 时，"*"行能拿到剩余高度；
                                 改成挂在自适应 OverlayCard 里的 UserControl 之后，
                                 测量高度是无穷大，"*"行会塌陷成内容的期望高度——
                                 列表为空/WebView2 这种没有期望尺寸的控件会直接塌成 0，
                                 表现就是弹窗里一片空白。MinHeight 用回原来的设计高度即可。 -->
    <!-- 由独立 Window 迁移为进程内 Overlay 弹窗（见 IOverlayDialog.cs /
         OverlayDialogService.cs 顶部注释）。Title/WindowStartupLocation/ResizeMode/
         Background 这些"窗口级"属性已全部移除——居中、圆角卡片背景、阴影都由
         MainWindow.xaml 里的 OverlayCard 统一提供，弹窗自己只关心内部布局。
         原来的 Width/Height 转成了 MinWidth/MaxWidth/MaxHeight：Overlay 是按内容
         自适应的，写死 Height 会把内容截断。 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0" Text="{DynamicResource Str_Ui_Server_Console}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="StopBtn" Grid.Column="1" Content="{DynamicResource Str_Ui_Stop_Server}" Style="{StaticResource PrimaryButton}"
                    Background="{DynamicResource DangerBrush}" Click="Stop_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="10">
            <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="OutputText" Background="Transparent" Foreground="#D4D4D4"
                         FontFamily="Consolas" FontSize="12" BorderThickness="0"
                         IsReadOnly="True" TextWrapping="Wrap" IsUndoEnabled="False"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="36"
                     Margin="0,0,8,0" KeyDown="CommandBox_KeyDown"
                     ToolTip="{DynamicResource Str_Ui_Type_A_Command_And_Press_Enter_E_G_Say_H}"/>
            <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Send}" Style="{StaticResource PrimaryButton}" Click="SendCommand_Click"/>
        </Grid>
    </Grid>
</local:OverlayDialogControl>
