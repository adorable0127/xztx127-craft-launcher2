<UserControl x:Class="XCL2.App.Views.BedrockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:XCL2.App.Services">
    <!-- 「基岩版启动」侧边栏独立页：原来分散在两处——
         1) 「百宝箱」页第 6 个 Tab（内容管理/服务端下载，正式功能）；
         2) 「实验性功能」弹窗里的"启动基岩版"按钮（轻量跳转，唤起本机已装的 Minecraft
            for Windows）。
         需求是把这两处整合成一个统一的侧边栏入口，不用用户在"百宝箱的某个 Tab"和
         "实验性功能弹窗"两个完全不相关的地方分别找。这里把两处原有的 UI 和事件处理
         代码原样搬过来（没有改动任何业务逻辑/Service 调用），只是换了个容器：
         从 TabItem 内容 / OverlayDialogControl 里的按钮，变成一个独立的 UserControl 页面，
         跟其它侧边栏页（ToolboxPage/AboutHelpPage 等）用同样的形状，好接入 MainWindow
         的 SetMainContent 导航。 -->
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Str_Nav_Bedrock}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Str_Ui_Bedrock_Page_Subtitle}" FontSize="12" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          services:ScrollWheelBehavior.EnableFastWheel="True">
                <StackPanel Margin="0,0,4,0">

                    <TextBlock Text="{DynamicResource Str_Ui_Bedrock_Client}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock x:Name="BedrockStatusText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"
                               Text="{DynamicResource Str_Ui_Detecting}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BedrockLaunchBtn" Content="{DynamicResource Str_Ui_Launch_Bedrock}" Padding="14,7"
                                Style="{StaticResource PrimaryButton}"
                                Click="BedrockLaunch_Click" IsEnabled="False"/>
                        <Button Content="{DynamicResource Str_Ui_Re_Detect}" Padding="14,7" Margin="10,0,0,0"
                                Click="BedrockDetect_Click"/>
                        <Button Content="{DynamicResource Str_Ui_Open_Data_Folder}" Padding="14,7" Margin="10,0,0,0"
                                Click="BedrockOpenDataDir_Click"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Str_Ui_Note_The_Bedrock_Client_Is_Distributed_T}"/>

                    <!-- 基岩版客户端下载 -->
                    <TextBlock Text="{DynamicResource Str_Ui_Bedrock_Client_Download}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Str_Ui_Bedrock_Client_Download_Desc}"/>

                    <!-- 客户端默认下载路径 -->
                    <TextBlock Text="{DynamicResource Str_Ui_Default_Download_Folder_Client}" FontSize="12" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="BedrockClientDefaultDirBox" Width="320" IsReadOnly="True"
                                 Text="{DynamicResource Str_Ui_Not_Set_Will_Ask_Every_Time}"/>
                        <Button Content="{DynamicResource Str_Ui_Browse}" Padding="14,7" Margin="10,0,0,0"
                                Click="BedrockClientBrowseDefaultDir_Click"/>
                        <Button Content="{DynamicResource Str_Ui_Clear}" Padding="14,7" Margin="10,0,0,0"
                                Click="BedrockClientClearDefaultDir_Click"/>
                    </StackPanel>

                    <!-- 渠道选择 -->
                    <TextBlock Text="{DynamicResource Str_Ui_Channel_Client}" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="BedrockClientChannelCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"
                              SelectionChanged="BedrockClientChannelCombo_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Str_Ui_Stable}" IsSelected="True"/>
                        <ComboBoxItem Content="{DynamicResource Str_Ui_Preview}"/>
                    </ComboBox>

                    <!-- 版本选择：暂不支持多版本（禁用），只保留渠道选择，下载始终用该渠道的最新版 -->
                    <TextBlock Text="{DynamicResource Str_Ui_Version_Select}" FontSize="12" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="BedrockClientVersionCombo" Width="260" HorizontalAlignment="Left"
                                  IsEditable="False" IsEnabled="False" Margin="0,0,10,0"/>
                        <Button Content="{DynamicResource Str_Ui_Refresh_Version_List}" Padding="14,7"
                                Click="BedrockClientRefreshVersions_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BedrockClientDownloadBtn" Content="{DynamicResource Str_Ui_Download_Bedrock_Client}" Padding="14,7"
                                Click="BedrockClientDownload_Click"/>
                        <Button x:Name="BedrockClientLaunchDownloadedBtn" Content="{DynamicResource Str_Ui_Launch_Downloaded_Client}" Padding="14,7"
                                Margin="10,0,0,0" Click="BedrockClientLaunchDownloaded_Click" IsEnabled="False"/>
                    </StackPanel>

                    <!-- 已下载客户端实例列表 -->
                    <TextBlock Text="{DynamicResource Str_Ui_Installed_Client_Instances}" FontWeight="Bold" FontSize="13" Margin="0,10,0,4"/>
                    <ListBox x:Name="BedrockClientInstanceList" Height="90"
                             SelectionChanged="BedrockClientInstanceList_SelectionChanged"/>

                    <TextBlock x:Name="BedrockClientStatusText" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <Separator Margin="0,14,0,14" Background="{DynamicResource BorderBrush}"/>

                    <TextBlock Text="{DynamicResource Str_Ui_Import_Content}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Str_Ui_Supports_Mcworld_Worlds_Mcpack_Resource_}"/>
                    <Button Content="{DynamicResource Str_Ui_Choose_Files_To_Import}" Padding="14,7" HorizontalAlignment="Left"
                            Click="BedrockImport_Click" Margin="0,0,0,18"/>

                    <TextBlock Text="{DynamicResource Str_Ui_Bedrock_Dedicated_Server}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Str_Ui_Bedrock_Dedicated_Server_Is_Published_Fr}"/>

                    <!-- 默认下载文件夹：不用每次下载都弹选择框，保存下来下次直接用。 -->
                    <TextBlock Text="{DynamicResource Str_Ui_Default_Download_Folder}" FontSize="12" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="BedrockServerDefaultDirBox" Width="320" IsReadOnly="True"
                                 Text="{DynamicResource Str_Ui_Not_Set_Will_Ask_Every_Time}"/>
                        <Button Content="{DynamicResource Str_Ui_Browse}" Padding="14,7" Margin="10,0,0,0"
                                Click="BedrockServerBrowseDefaultDir_Click"/>
                        <Button Content="{DynamicResource Str_Ui_Clear}" Padding="14,7" Margin="10,0,0,0"
                                Click="BedrockServerClearDefaultDir_Click"/>
                    </StackPanel>

                    <!-- 渠道：正式版/预览版是官方唯二两条独立分发线，各自维护自己的最新版本号。
                         版本选择：暂不支持多版本（禁用），只保留渠道选择，下载始终用该渠道的最新版。 -->
                    <TextBlock Text="{DynamicResource Str_Ui_Channel}" FontSize="12" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ComboBox x:Name="BedrockServerChannelCombo" Width="160" Margin="0,0,10,0"
                                  SelectionChanged="BedrockServerChannelCombo_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Stable}" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource Str_Ui_Preview}"/>
                        </ComboBox>
                        <Button x:Name="BedrockServerRefreshVersionsBtn" Content="{DynamicResource Str_Ui_Refresh_Version_List}" Padding="14,7"
                                Click="BedrockServerRefreshVersions_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Version_Select}" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="BedrockServerVersionCombo" Width="280" HorizontalAlignment="Left" Margin="0,0,0,10"
                              IsEnabled="False"
                              ToolTip="{DynamicResource Str_Ui_Bedrock_Server_Version_Tip}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BedrockServerDownloadBtn" Content="{DynamicResource Str_Ui_Download_Bedrock_Server}" Padding="14,7"
                                Click="BedrockServerDownload_Click"/>
                        <Button x:Name="BedrockServerLaunchBtn" Content="{DynamicResource Str_Ui_Launch_Server}" Padding="14,7"
                                Margin="10,0,0,0" Click="BedrockServerLaunch_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="BedrockServerStatusText" FontSize="12" Margin="0,10,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- 已安装实例列表：下过不止一个版本时，选哪个启动一目了然。 -->
                    <TextBlock Text="{DynamicResource Str_Ui_Installed_Instances}" FontWeight="Bold" FontSize="13" Margin="0,14,0,4"/>
                    <ListBox x:Name="BedrockServerInstanceList" Height="90"
                             SelectionChanged="BedrockServerInstanceList_SelectionChanged"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
