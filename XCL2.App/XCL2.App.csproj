<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>XCL2</AssemblyName>
    <RootNamespace>XCL2.App</RootNamespace>

    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>

    <!-- 图标 -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- 运行时 -->
    <GenerateErrorReport>true</GenerateErrorReport>
    <RollForward>LatestMinor</RollForward>

    <!-- ================= 发布配置 ================= -->

    <!-- 单文件 -->
    <PublishSingleFile>true</PublishSingleFile>

    <!-- 自包含（真正单文件） -->
    <SelfContained>true</SelfContained>

    <!-- 平台 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 不裁剪（WPF 不建议开启） -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Native DLL 打包 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- 压缩 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- 不生成调试文件 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Terracotta\terracotta-0.4.2-windows-x86_64.exe">
      <LogicalName>XCL2.App.Resources.Terracotta.terracotta-0.4.2-windows-x86_64.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>